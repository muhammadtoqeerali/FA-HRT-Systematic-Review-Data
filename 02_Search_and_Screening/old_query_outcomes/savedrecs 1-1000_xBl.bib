@article{ WOS:001825827700001,
Author = {Movahhed, Sevda Rezazadeh and Hamed, Mohammad Ali},
Title = {Optimized Output Feedback Fault-Tolerant Control Structure Based on
   Robust Sliding Mode Observer for Nonlinear Dynamics of Rudderless
   Flying-Wing UAVs},
Journal = {RESULTS IN CONTROL AND OPTIMIZATION},
Year = {2026},
Volume = {24},
Month = {SEP},
Abstract = {In this paper, a robust fault-tolerant optimized hybrid sliding mode
   controller-observer structure with integral action is designed for
   output tracking control of rudderless flying-wing unmanned aerial
   vehicles (UAVs) with nonlinear dynamics. The robust Edwards-Spurgeon
   sliding mode observer is implemented to estimate the system states under
   uncertainty and actuator faults which enables accurate state estimation
   based on limited sensor measurements, ensuring effective output-feedback
   control in the presence of matched uncertainties. Rudderless flying-wing
   UAVs, which lack traditional horizontal and vertical stabilizers,
   present significant challenges in maintaining stability,
   maneuverability, and estimation accuracy under dynamic uncertainties and
   actuator degradation. To address these challenges, the control system
   incorporates an optimized sliding hyperplane design and an integral
   action to ensure robust tracking and disturbance rejection in the
   presence of both matched and unmatched uncertainties. A mixed
   time-varying actuator fault model is incorporated to evaluate system
   resilience under realistic fault scenarios. In order to compensate the
   high-frequency noise effects, the low-pass filters are implemented on
   the input signals of the observer and actuators. The presented sliding
   mode observerfilter configuration complements the hybrid controller by
   accurately estimating the full state vector of the system despite
   modeling errors, external disturbances, noisy sensor measurements, and
   severe actuator faults. The results confirm that the proposed hybrid
   controller-observer system achieves high-precision tracking,
   fault-tolerant performance, and effective noise suppression across
   longitudinal, lateral, and simultaneous maneuvers demonstrating the
   strong robustness, adaptability, and practical feasibility of the
   proposed structure for real-time flight control applications.},
DOI = {10.1016/j.rico.2026.100780},
EarlyAccessDate = {JUL 2026},
Article-Number = {100780},
EISSN = {2666-7207},
Unique-ID = {WOS:001825827700001},
}

@article{ WOS:001145159700001,
Author = {Farina, Bibiana and Toledo, Jonay and Acosta, Leopoldo},
Title = {Improving odometric sensor performance by real-time error processing and
   variable covariance☆},
Journal = {MECHATRONICS},
Year = {2024},
Volume = {98},
Month = {APR},
Abstract = {This paper presents a new method to increase odometric sensor accuracy
   by systematic and non-systematic errors processing. Mobile robot
   localization is improved combining this technique with a filter that
   fuses the information from several sensors characterized by their
   covariance. The process focuses on calculating the odometric speed
   difference with respect to the filter to implement an error type
   detection module in real time. The correction of systematic errors
   consists in an online parameter adjustment using the previous
   information and conditioned by the filter accuracy. This data is also
   applied to design a variable odometric covariance which describes the
   sensor reliability and determines the influence of both errors on the
   robot localization. The method is implemented in a low-cost autonomous
   wheelchair with a LIDAR, IMU and encoders fused by an UKF algorithm. The
   experimental results prove that the estimated poses are closer to the
   real ones than using other well-known previous methods.},
DOI = {10.1016/j.mechatronics.2023.103123},
EarlyAccessDate = {DEC 2023},
Article-Number = {103123},
