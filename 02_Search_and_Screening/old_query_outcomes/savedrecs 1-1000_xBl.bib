@article{ WOS:001730887500001,
Author = {Zhao, Jinsong and Lin, Yan},
Title = {Adaptive output feedback tracking control for linear systems with sensor
   fault},
Journal = {AUTOMATICA},
Year = {2026},
Volume = {188},
Month = {JUN},
Abstract = {This paper focuses on a long standing problem of adaptive output
   feedback fault-tolerant control (FTC) for linear systems: to make the
   system output track a reference signal as closely as possible under the
   condition that the measurement output fails to follow the system output
   due to the multiplicative sensor fault. To solve the problem, a new
   approach is presented based on a control structure so that the sensor
   fault and other system parameters can be estimated separately. An
   observer with a time-varying gain is designed, which not only gives the
   system state estimation but also paves the way for estimating the sensor
   fault. Then, a parameter estimation method is proposed with which a
   sensor fault estimation (SFE) algorithm is developed. The SFE algorithm
   is independent of the adaptive estimation in the controller design and
   can estimate the sensor fault accurately without using persistent
   excitation (PE) condition. By combining the estimated sensor fault with
   the reference signal, the adaptive output feedback controller can make
   the tracking error converge to an arbitrarily small residual set and
   thus, in comparison with the current adaptive FTC schemes for sensor
   faults, significantly improves the tracking performance. (c) 2026
   Elsevier Ltd. All rights are reserved, including those for text and data
   mining, AI training, and similar technologies.},
DOI = {10.1016/j.automatica.2026.112945},
Article-Number = {112945},
ISSN = {0005-1098},
EISSN = {1873-2836},
ORCID-Numbers = {Sơn, Nguyễn/0009-0005-4527-5803},
Unique-ID = {WOS:001730887500001},
}

@article{ WOS:001832628900001,
Author = {Fan, Kangjia and Pang, Guochen and Chen, Xiangyong and Cao, Jinde and
   Qiu, Jianlong},
Title = {DoS-resilient fault-tolerant control of multi-agent systems integrating
   a Fourier-series observer and proactive protection},
Journal = {JOURNAL OF THE FRANKLIN INSTITUTE},
Year = {2026},
Volume = {363},
Number = {13},
Month = {AUG 15},
Abstract = {This paper investigates the leader-follower consensus problem for
   multi-agent systems (MASs) affected at both the network layer and the
   physical layer. At the network layer, denial-of-service (DoS) attacks
   may block information channels and render some agents completely
   disconnected from the leader for a certain period of time. At the
   physical layer, the actuators of the agents may suffer from periodic
   intermittent faults with abrupt jumps and may also be affected by
   external disturbances. To model and compensate for such periodic faults,
   a Fourier-series-based observer is proposed, where a rotating exosystem
   is introduced to transform the estimation of unknown Fourier
   coefficients into an initial-state estimation problem. Based on the
   observer, a corresponding fault-tolerant control (FTC) scheme is
   constructed. Furthermore, to address DoS attacks, which are common in
   practical networked systems but difficult to characterize accurately, an
   active defense strategy based on switching among backup communication
   topologies is developed. With this strategy, even if some agents are
   temporarily disconnected from the leader during an attack, MASs can
   restore communication through topology switching and maintain consensus
   without relying on the commonly used a priori constraints on attack
   frequency and duration. Finally, simulation studies on a formation of
   five aircraft demonstrate that the proposed approach can achieve stable
   and reliable leader-follower consensus under multiple practical adverse
   factors, thereby verifying its feasibility and practical value.},
DOI = {10.1016/j.jfranklin.2026.108933},
EarlyAccessDate = {JUL 2026},
Article-Number = {108933},
ISSN = {0016-0032},
EISSN = {1879-2693},
ResearcherID-Numbers = {Qiu, Jianlong/M-9984-2014},
Unique-ID = {WOS:001832628900001},
}

@article{ WOS:001242977200001,
Author = {Wang, Fanxun and Zhao, Mingzhuo and Shen, Tong and Cai, Guoshun and
   Liang, Jinhao and Wang, Yan and Yin, Guodong},
Title = {A Robust Adaptive Fault-Tolerant Estimator for Sideslip Angle and Tire
   Cornering Stiffness With Multiple Missing Data},
Journal = {IEEE-ASME TRANSACTIONS ON MECHATRONICS},
Year = {2024},
Volume = {29},
Number = {6},
Pages = {4800-4813},
Month = {DEC},
Abstract = {The accurate estimation of crucial state parameters, such as sideslip
   angle and tire cornering stiffness, plays a vital role in ensuring the
   efficacy of active safety technology and motion control for distributed
   drive electric vehicles. To address the challenges posed by missing
   measurements from multiple sensors and dynamic model mismatch during the
   estimation process, this article proposes a novel robust adaptive
   fault-tolerant estimator (RAFTE). Based on the four-wheel nonlinear
   vehicle model, the model parameters from the RAFTE are continuously
   adjusted by adaptive forgetting factor recursive least squares, which
   provides a more accurate dynamic model. Huber's robust M-estimation
   theory is integrated into the standard cubature Kalman filter, which
   adjusts the measurement noise covariance and innovation covariance to
   mitigate the effects of missing data. Then, an optimal adaptive factor
   is introduced to alleviate the issues of model mismatch and unmodeled
   dynamic characteristics that arise from the strong coupling nonlinear
   system. Finally, simulations and experiments are conducted to validate
   the estimation accuracy, convergence, and robustness of the proposed
   algorithm.},
DOI = {10.1109/TMECH.2024.3384958},
EarlyAccessDate = {JUN 2024},
ISSN = {1083-4435},
EISSN = {1941-014X},
