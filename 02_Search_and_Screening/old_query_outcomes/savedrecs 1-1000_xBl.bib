@article{ WOS:000798029100006,
Author = {Zhang, Zeyu and Li, Hongran and Zhang, Heng and Zhang, Jian and Zhong,
   Zhaoman and Xu, Weiwei},
Title = {Model-free predictive control of nonlinear systems under False Data
   Injection attacks?},
Journal = {COMPUTERS \& ELECTRICAL ENGINEERING},
Year = {2022},
Volume = {100},
Month = {MAY},
Abstract = {The control systems attacked by False Data Injection (FDI) force the
   equipment out of action. This paper presents a model-free predictive
   control framework based on polynomial regressors that attenuates adverse
   effects of FDI attacks on control systems modeled by the nonlinear
   systems. An FDI attacker targets at tampering the state estimation
   results, thereby destroy the security of control systems. In order to
   guarantee its stability, the polynomial regression vectors are
   considered. The novel point of this paper is the improvement of existing
   attack datasets by the polynomial regression which combines previous
   recorded datasets and attack datasets. The polynomial regression vectors
   can ensure the stable operation of the nonlinear systems guaranteed
   under FDI attacks. Finally, the simulation is employed to verify our
   points.},
DOI = {10.1016/j.compeleceng.2022.107977},
EarlyAccessDate = {APR 2022},
