@article{ WOS:001722997300002,
Author = {Liu, Chenjun and Liu, Jason J. R. and Sun, Yaping and Su, Housheng},
Title = {Adaptive Fault-Tolerant Affine Formation Maneuver Control of Disturbed
   High-Order Multi-Agent Systems Over Directed Networks},
Journal = {IEEE TRANSACTIONS ON SIGNAL AND INFORMATION PROCESSING OVER NETWORKS},
Year = {2026},
Volume = {12},
Pages = {374-387},
Abstract = {For disturbed high-order multi-agent systems with actuator faults, this
   paper investigates the problem of affine formation maneuver control
   under directed networks. A two-layer control framework incorporating
   virtual ideal followers is proposed to decouple controller gains from
   the asymmetric communication network. First, a distributed adaptive
   proportional-integral (PI) controller is designed for the virtual
   followers to track leaders and maintain affine maneuvering of the
   nominal formation. Then, a decentralized fault-tolerant controller based
   on adaptive PI control with nonlinear compensation (APIC-NC) is
   developed for actual followers, effectively compensating for unknown
   bias faults, partial loss of effectiveness faults, and disturbances. The
   incorporation of the \$\textbackslash{}sigma\$-modification technique
   ensures asymptotically convergent performance. For undirected networks,
   the APIC-NC method enables distributed fault-tolerant formation without
   virtual followers, reducing control cost while preserving control
   performance. The modified framework also ensures
   noise-to-state-practically stability in probability under general noise.
   Finally, numerical simulations are conducted to verify the effectiveness
   of the aforementioned control approaches.},
DOI = {10.1109/TSIPN.2026.3672350},
