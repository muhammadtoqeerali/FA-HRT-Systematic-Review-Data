@article{ WOS:001618903300009,
Author = {Zhou, Chao and Mao, Zehui and Xie, Xiangpeng and Jiang, Bin and Li,
   Wenbo},
Title = {Encoding-Decoding-Based Fault-Tolerant Consensus Control for Multi-Agent
   Systems With Markovian Switching Topologies and Logarithmic Quantizers},
Journal = {IEEE TRANSACTIONS ON AUTOMATION SCIENCE AND ENGINEERING},
Year = {2025},
Volume = {22},
Pages = {23984-23995},
Abstract = {This paper focuses on the fault-tolerant consensus problem of
   multi-agent systems under an encoding-decoding framework with Markovian
   switching topologies. Due to the influence of complex environments, the
   communication network changes over time, and thus, a Markov chain is
   introduced to describe the random topology switching. Under the
   stochastic characteristics and encoding-decoding framework, Lyapunov's
   second method is applied for the first time instead of the original
   matrix analysis method, with both uniform and logarithmic quantizers
   considered. To obtain the unmeasurable states and the unknown sensor
   faults in the form of first-order differences, augmented estimation is
   performed, followed by encoding-transmission-reception-decoding for
   controller design. Under uniform quantization, the relationship between
   the scaling function and the parameters in the Riccati inequality is
   established, enabling boundedness analysis of data transmission. Under
   logarithmic quantization, a quantization-dependent Lyapunov function is
   constructed, and its rationality is rigorously proven. Finally,
   numerical simulations under both uniform and logarithmic quantization
   are provided to demonstrate the achievement of consensus and
   poly-quadratically stable in mean square sense. Note to
   Practitioners-For engineers designing complex multi-agent systems, such
   as UAV swarms, autonomous vehicle networks, or industrial IoT, achieving
   reliable coordination is often hampered by two real-world challenges:
   unpredictable communication links and faulty sensors. This paper
   provides a practical and mathematically rigorous toolkit to address both
   simultaneously. The key takeaway for practitioners is the choice between
   two distinct, ready-to-implement quantization strategies, each tailored
   to different design priorities: For systems with strict bandwidth
   constraints (Uniform Quantization): This work enables effective
   management and prediction of data transmission rates by establishing a
   clear analytical relationship between system stability (via a Riccati
   inequality) and the quantizer's scaling function. For systems where
   performance is paramount (Logarithmic Quantization): The analysis of
   logarithmic quantizers provides a rigorous framework for achieving high
   control performance in scenarios with broad signal dynamic ranges. A
   novel quantization-dependent Lyapunov function is constructed, which
   formally establishes poly-quadratic stability. Moreover, Lyapunov's
   second method, as employed in this work, offers a more flexible
   framework for analyzing stability under multiple simultaneous random
   effects (such as Markovian topology switching and sensor faults). The
   proposed augmented state estimation technique also provides a clear
   procedure for handling unmeasurable states and unknown faults, making
   the overall framework robust and applicable to real-world scenarios
   where perfect information is unavailable.},
DOI = {10.1109/TASE.2025.3631522},
ISSN = {1545-5955},
EISSN = {1558-3783},
ResearcherID-Numbers = {Xie, Xiangpeng/ABD-7974-2021
   jiang, bin/OWA-4153-2025
   Zhou, Chao/LTE-3672-2024},
ORCID-Numbers = {Jiang, Bin/0000-0002-9153-4360
   Xie, Xiangpeng/0000-0003-4822-3134
   jiang, bin/0000-0003-2696-5436
   Zhou, Chao/0000-0003-2623-4406},
Unique-ID = {WOS:001618903300009},
}

@article{ WOS:000437883400046,
Author = {Yu, James J. Q. and Hou, Yunhe and Li, Victor O. K.},
Title = {Online False Data Injection Attack Detection With Wavelet Transform and
   Deep Neural Networks},
Journal = {IEEE TRANSACTIONS ON INDUSTRIAL INFORMATICS},
Year = {2018},
Volume = {14},
Number = {7},
Pages = {3271-3280},
Month = {JUL},
Abstract = {State estimation is critical to the operation and control of modern
   power systems. However, many cyber-attacks, such as false data injection
   attacks, can circumvent conventional detection methods and interfere the
   normal operation of grids. While there exists research focusing on
   detecting such attacks in dc state estimation, attack detection in ac
   systems is also critical, since ac state estimation is more widely
   employed in power utilities. In this paper, we propose a new false data
   injection attack detection mechanism for ac state estimation. When
   malicious data are injected in the state vectors, their spatial and
   temporal data correlations may deviate from those in normal operating
   conditions. The proposed mechanism can effectively capture such
   inconsistency by analyzing temporally consecutive estimated system
   states using wavelet transform and deep neural network techniques. We
   assess the performance of the proposed mechanism with comprehensive case
   studies on IEEE 118- and 300-bus power systems. The results indicate
   that the mechanism can achieve a satisfactory attack detection accuracy.
   Furthermore, we conduct a preliminary sensitivity test on the control
   parameters of the proposed mechanism.},
DOI = {10.1109/TII.2018.2825243},
ISSN = {1551-3203},
EISSN = {1941-0050},
