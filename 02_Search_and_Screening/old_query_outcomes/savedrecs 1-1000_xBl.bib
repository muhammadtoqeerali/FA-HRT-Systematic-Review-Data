}

@article{ WOS:001028978200001,
Author = {Fu, Shui and Wang, Rui and Tang, Wentao and Sun, Xi-Ming},
Title = {Robust Fault-Tolerant Control Based on L8 Design for
   Discrete-Time Systems With Parameter Uncertainty},
Journal = {IEEE CONTROL SYSTEMS LETTERS},
Year = {2023},
Volume = {7},
Pages = {2509-2514},
Abstract = {In this letter, a robust fault-tolerant controller is proposed for
   discrete-time systems with parameter uncertainty. First, the state and
   fault are estimated by an observer based on the Loo design. The
   stability of the Loo observer is proved and the error system is robust
   against unknown disturbances. Then, on the basis of fault and state
   estimation, Loo technique is applied to design the robust fault-tolerant
   controller to recover the performance of the system affected by the
   actuator fault. Based on the proposed method, the compensated state can
   be bounded by the designed Loo index, which guarantees the safety of the
   system. Finally, the proposed robust fault tolerant controller is
   applied to the simulation of a dual rotor aero-engine system model, and
   its effectiveness is verified.},
DOI = {10.1109/LCSYS.2023.3288088},
