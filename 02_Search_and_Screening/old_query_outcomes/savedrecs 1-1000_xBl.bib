Unique-ID = {WOS:000961290800001},
}

@article{ WOS:000748916300001,
Author = {Wang, Zhiwen and Zhang, Bin and Xu, Xiangnan and Usman and Li, Long},
Title = {Research on cyber-physical system control strategy under false data
   injection attack perception},
Journal = {TRANSACTIONS OF THE INSTITUTE OF MEASUREMENT AND CONTROL},
Year = {2022},
Month = {2022 JAN 12},
Abstract = {This paper investigates the security control problem of the
   cyber-physical system under false data injection attacks. A model
   predictive switching control strategy based on attack perception is
   proposed to compensate for the untrusted sequence of data caused by
   false data injection attacks. First, the binary attack detector is
   applied whether the system has suffered the attack. If the attack
   occurs, multistep correction is carried out for the future data
   according to the previous time data, and the waiting period T is set.
   The input and output sequence of the controller is reconstructed, and
   the system is modeled as a constant time-delay switched system.
   Subsequently, the Lyapunov methods and average-dwell time are combined
   to provide sufficient conditions for the asymptotical stability of
   closed-loop switched system. Finally, the simulation of the networked
   first-order inverted pendulum model reveals that the control technique
   can efficiently suppress the influence of the attacks.},
DOI = {10.1177/01423312211069371},
EarlyAccessDate = {JAN 2022},
ISSN = {0142-3312},
EISSN = {1477-0369},
