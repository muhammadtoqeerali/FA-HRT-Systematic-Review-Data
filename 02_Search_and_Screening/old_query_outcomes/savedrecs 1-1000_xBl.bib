@article{ WOS:001732568600001,
Author = {Rotondo, Damiano and Ahmed-Ali, Tarek},
Title = {A virtual actuator and sensor approach for fault tolerant control of a
   class of sampled-data control systems☆},
Journal = {AUTOMATICA},
Year = {2026},
Volume = {188},
Month = {JUN},
Abstract = {Digital technologies have led to the widespread adoption of hybrid
   control systems, where sampleddata mechanisms introduce challenges in
   state estimation and control. While inter-sample predictorbased
   observers address these issues, they typically assume fault-free
   operation. In practice, sensor and actuator faults can degrade
   performance or cause instability. This paper proposes a fault-tolerant
   sampled-data control system that integrates virtual actuator and virtual
   sensor components within the inter-sample predictor framework. The
   virtual actuator follows a standard fault-hiding approach, while the
   virtual sensor employs a faulty inter-sample predictor that continuously
   reconstructs correct output samples, ensuring proper reinitialization of
   the nominal inter-sample predictor. This approach enhances robustness
   while preserving the benefits of inter-sample prediction. However, fault
   tolerance imposes a stricter constraint on the maximum allowable
   sampling time. Theoretical analysis and numerical simulations
   demonstrate the effectiveness of the proposed method. (c) 2026 The
   Authors. Published by Elsevier Ltd. This is an open access article under
   the CC BY license (http://creativecommons.org/licenses/by/4.0/).},
DOI = {10.1016/j.automatica.2026.112946},
Article-Number = {112946},
ISSN = {0005-1098},
EISSN = {1873-2836},
Unique-ID = {WOS:001732568600001},
}

@article{ WOS:000464580000010,
Author = {Li, Li and Yang, Huan and Xia, Yuanqing and Yang, Hongjiu},
Title = {State estimation for linear systems with unknown input and random false
   data injection attack},
Journal = {IET CONTROL THEORY AND APPLICATIONS},
Year = {2019},
Volume = {13},
Number = {6},
Pages = {823-831},
Month = {APR 16},
Abstract = {This study focuses on the state estimation problem for a linear system
   with unknown input and random false data injection attack. The unknown
   input is treated as a process with a non-informative prior. A
   residue-based \$\textbackslash{}chi <\^{}>\{2\}\$chi 2 detector is used
   to improve security of the linear system due to the randomness of the
   attack. Based on different detection information scenarios provided by
   the detector, a novel state estimator against the false data injection
   attack is proposed. Convergence and stability on the state estimation
   are investigated, and sufficient conditions are established to ensure
   boundedness of mean error covariance. Finally, the effectiveness of the
   proposed method is demonstrated by a numerical example.},
DOI = {10.1049/iet-cta.2018.5954},
