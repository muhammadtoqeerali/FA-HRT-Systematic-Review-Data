}

@article{ WOS:001741014600009,
Author = {Jian, Qiuwei and Ma, Qinglu and Wang, Xinyu and Ullah, Saleem},
Title = {JONA-SLAM: Tightly Coupled SLAM With Joint Observation and Normal-Aware
   Loop Closure},
Journal = {IEEE SENSORS JOURNAL},
Year = {2026},
Volume = {26},
Number = {8},
Pages = {12503-12511},
Month = {APR 15},
Abstract = {In the field of autonomous navigation, accurate localization and mapping
   are of paramount importance, especially for autonomous vehicles
   operating in global navigation satellite system (GNSS)-challenged or
   denied environments. This article presents joint observation and
   normal-aware (JONA)-simultaneous localization and mapping (SLAM), a
   tightly coupled light detection and ranging (LiDAR)-visual-inertial SLAM
   system designed to enhance state estimation robustness for autonomous
   driving platforms in complex scenarios such as urban canyons and
   tunnels. Building upon our previous research on point-line feature
   extraction, the proposed system strengthens spatial constraints by
   constructing a LiDAR-visual joint observation factor. This factor
   enables the tight coupling of LiDAR-derived geometric information with
   visual texture features at the feature level, effectively addressing the
   observation degradation common in GNSS-denied areas. Furthermore, a
   normal-aware hybrid loop closure detection method is proposed,
   incorporating point cloud normal consistency verification to
   significantly improve loop identification reliability and suppress false
   positives in challenging semistructured scenes. Evaluation results on 22
   public sequences and a self-collected campus dataset demonstrate that
   JONA-SLAM achieves superior or competitive performance compared to
   state-of-the-art methods. Across 23 experimental test cases, the
   proposed method reduces the trajectory error {[}root mean square error
   (RMSE)] by an average of 35.02\%. While maintaining real-time
   performance, the system demonstrates superior environmental adaptability
   and global consistency, providing a high-precision and robust
   localization solution for autonomous driving and versatile mobile
   platforms in degraded environments.},
