@article{ WOS:001575799700014,
Author = {Xu, Chongcong and Zheng, Fangfang and Guo, Ge},
Title = {Stealthy False Data Injection Attacks in Multi-Channel Vehicular
   Communication: White-Box and Gray-Box Strategies},
Journal = {IEEE TRANSACTIONS ON VEHICULAR TECHNOLOGY},
Year = {2025},
Volume = {74},
Number = {9},
Pages = {13402-13416},
Month = {SEP},
Abstract = {Understanding the vulnerabilities of vehicular networks from an
   attacker's perspective is crucial for identifying stealthy false data
   injection (FDI) attacks and developing robust defense methods. This
   paper investigates stealthy FDI attacks in multi-channel vehicular
   communication systems. We construct a multi-source state estimation
   system using a sequential Kalman filter to integrate and estimate
   redundant state information transmitted by preceding vehicles across
   multiple channels. To enhance the system's resilience against FDI
   attacks, we incorporate a Sage-Husa adaptive filter and a chi-squared
   detector, which dynamically estimate and detect channel noise based on
   estimation errors. Within this framework, we utilize real-time state
   information and channel transmission residual to determine the
   probability of an attack window occurring. The attack process is divided
   into three phases, during which critical noise disturbances are
   introduced to create attack windows, allowing the attack to
   progressively align with the target state. Based on this analysis, we
   develop an optimization model for attack generation with complete
   channel information (AG-with-CCI) to facilitate a white-box attack.
   Additionally, acknowledging that attackers may not have access to
   real-time information from all channels, we analyze the iterative
   equations of state estimation errors and residuals to establish the
   conditions under which stealthy FDI attacks can be successfully
   executed, enabling the attack generation with attacked channel
   information (AG-with-ACI) to achieve a gray-box attack. Numerical
   simulations demonstrate that both attack methods can evade current
   detection mechanisms and achieve their intended objectives.},
DOI = {10.1109/TVT.2025.3560185},
ISSN = {0018-9545},
EISSN = {1939-9359},
ORCID-Numbers = {Xu, Chongcong/0009-0005-8770-3001
   Guo, Ge/0000-0003-4752-4920
   zheng, fangfang/0000-0002-0150-6711},
Unique-ID = {WOS:001575799700014},
}

@article{ WOS:001616258900008,
Author = {Liu, Hao and Huang, Zixin},
Title = {Resilient Distributed Set-Based Estimation for Cyber-Physical Systems
   Under False-Data-Injection Attacks},
Journal = {IEEE TRANSACTIONS ON INFORMATION FORENSICS AND SECURITY},
Year = {2025},
Volume = {20},
Pages = {12066-12079},
Abstract = {In this paper, resilient distributed set-based estimation is
   investigated for cyber-physical systems (CPSs) with unknown-but-bounded
   (UBB) noises which are characterized by constrained polynomial zonotopes
   (CPZs). Both generalized intersection of CPZs and diffusion strategy are
   developed to calculate the measurement update and obtain the estimation
   set. When the system is vulnerable to malicious false-data-injection
   (FDI) attacks, the encoding-decoding approach is proposed to preserve
   privacy, which can also be utilized to improve the attack detection
   rate. After detecting attacks, the corresponding resilient estimation
   algorithm is provided to alleviate the impact introduced by attacks.
   Finally, numerical simulations are provided to illustrate the validity
   of the presented approaches.},
DOI = {10.1109/TIFS.2025.3630874},
ISSN = {1556-6013},
EISSN = {1556-6021},
ResearcherID-Numbers = {Liu, Hao/AAN-2159-2020},
ORCID-Numbers = {Liu, Hao/0000-0001-7339-3763},
Unique-ID = {WOS:001616258900008},
}

@article{ WOS:000981914800006,
Author = {Guo, Haibin and Sun, Jian and Pang, Zhong-Hua},
Title = {Residual-Based False Data Injection Attacks Against Multi-Sensor
   Estimation Systems},
Journal = {IEEE-CAA JOURNAL OF AUTOMATICA SINICA},
Year = {2023},
Volume = {10},
Number = {5},
Pages = {1181-1191},
Month = {MAY},
Abstract = {This paper investigates the security issue of multi-sensor remote
   estimation systems. An optimal stealthy false data injection (FDI)
   attack scheme based on historical and current residuals, which only
   tampers with the measurement residuals of partial sensors due to limited
   attack resources, is proposed to maximally degrade system estimation
   performance. The attack stealthiness condition is given, and then the
   estimation error covariance in compromised state is derived to quantify
   the system performance under attack. The optimal attack strategy is
   obtained by solving several convex optimization problems which maximize
   the trace of the compromised estimation error covariance subject to the
   stealthiness condition. Moreover, due to the constraint of attack
   resources, the selection principle of the attacked sensor is provided to
   determine which sensor is attacked so as to hold the most impact on
   system performance. Finally, simulation results are presented to verify
   the theoretical analysis.},
DOI = {10.1109/JAS.2023.123441},
ISSN = {2329-9266},
EISSN = {2329-9274},
ResearcherID-Numbers = {Rachmad, Yoesoep Edhie/GRE-6442-2022
   Guo, Haibin/GQA-8587-2022},
