@article{ WOS:001724619600001,
Author = {Shan, Hua-Sheng and Li, Yi-Gang and An, Liwei and Ren, Xiu-Xiu and Li,
   Dong},
Title = {Optimal non-strictly stealthy attacks against remote state estimation in
   multi-sensor with the resource constraint},
Journal = {JOURNAL OF THE FRANKLIN INSTITUTE},
Year = {2025},
Volume = {362},
Number = {15},
Month = {OCT 1},
Abstract = {For assessing the vulnerability of the multi-sensor systems in the
   adversarial cyber-environment, this work investigates the non-strictly
   stealthy attack design problem with the resource constraint. Different
   from related results which design strictly stealthy attacks under the
   chi 2 detector to deteriorate the multi-sensor system performance, the
   attack model is proposed under the resource constraint which slightly
   changes the statistical characteristics of the innovation to further
   improve the attack effect, while the attack stealthiness is guaranteed
   even if detection mechanisms are unknown. Subsequently, the iteration of
   error covariance is analyzed for the purpose of quantifying the effect
   of the proposed attack. Based on the characterization of the attack
   stealthiness by introducing the Kullback-Leibler divergence, the
   stealthiness condition under the attack scenario in this work is derived
   according to the structural characteristics of the partitioned matrix,
   which is more complicated because the elements in the parameter matrix
   related to the unattacked sensors are not able to be modified under the
   existence of the resource constraint. For the multi-variable non-convex
   optimization problem which contains more decision variables, the optimal
   attack parameters and location are respectively obtained by utilizing
   the Lagrange multiplier method, semi-definite programming and a simple
   search procedure. Furthermore, based on the analysis of the parameters
   characteristics, the optimal attack strategy is proven to be
   time-invariant. Finally, some simulation examples are given to verify
   the validity of the results.},
DOI = {10.1016/j.jfranklin.2025.108000},
Article-Number = {108000},
ISSN = {0016-0032},
EISSN = {1879-2693},
ResearcherID-Numbers = {Li, Yi-Gang/HKW-6495-2023
   Shan, Hua-Sheng/MEQ-0636-2025},
ORCID-Numbers = {Shan, Hua-Sheng/0009-0003-3187-7411},
Unique-ID = {WOS:001724619600001},
}

@article{ WOS:000581169700011,
Author = {Zhang, Xiangming and Zhu, Fanglai and Guo, Shenghui},
Title = {Actuator fault detection for uncertain systems based on the combination
   of the interval observer and asymptotical reduced-order observer},
Journal = {INTERNATIONAL JOURNAL OF CONTROL},
Year = {2020},
Volume = {93},
Number = {11, SI},
Pages = {2653-2661},
Month = {NOV 1},
Abstract = {This paper investigates the problems of the residual-based actuator
   fault detection based on observer design for a class of uncertain linear
   systems. First, a reduced-order observer, which can estimate the
   original system states asymptotically when the system does not suffer
   from actuator faults, is designed. Second, an auxiliary system with both
   disturbances and actuator faults is constructed and its corresponding
   autonomous system is actually an asymptotical stable system. Third, for
   the auxiliary uncertain system, an interval observer, which is robust to
   disturbances but sensitive to actuator faults in a sense of interval
   estimation, is developed. Furthermore, based on the interval observer, a
   computation of the interval estimation of the output is given and then a
   residual-based actuator fault detection scheme is proposed. Finally, a
   simulation example is given to verify the effectiveness of the proposed
   methods.},
DOI = {10.1080/00207179.2019.1620329},
ISSN = {0020-7179},
EISSN = {1366-5820},
ResearcherID-Numbers = {GUO, SHENGHUI/PGA-3258-2026},
Unique-ID = {WOS:000581169700011},
}

@article{ WOS:001487378500002,
Author = {Cheng, Peng and Cai, Chenxiao and Park, Poogyeon},
Title = {Finite frequency distributed fault detection in sensor networks with
   memory event-triggered scheme and deception attacks},
Journal = {ISA TRANSACTIONS},
Year = {2025},
Volume = {161},
Pages = {24-35},
Month = {JUN},
Abstract = {This paper concentrates on the finite frequency distributed fault
   detection (FD) problem for discrete-time nonlinear switched systems
   (SSs) with time-varying delays through sensor networks. First, the
   switching mechanism is described by the so-called sojourn probability
   method. Next, a distributed memory event-triggered scheme (METS) is
   employed to alleviate the network bandwidth load, and the adverse
   effects of malicious deception attacks are considered and analyzed.
   Furthermore, a finite frequency distributed FD filter (FDF) subject to
   METS and deception attacks is developed corresponding to each sensor
   node, and the existence conditions of the FDF are offered in the form of
   linear matrix inequalities. Lyapunov stability analysis shows that the
   resulting augmented filter system is mean-square stable and meets the
   specified full-frequency HPo level bound and finite-frequency H\_ level
   bound. Comparative simulations demonstrate that the proposed
   finite-frequency distributed FDF can detect unknown faults in nonlinear
   SSs on sensor networks more quickly and accurately than some existing
   full-frequency solutions.},
DOI = {10.1016/j.isatra.2025.03.008},
EarlyAccessDate = {MAY 2025},
ISSN = {0019-0578},
EISSN = {1879-2022},
ResearcherID-Numbers = {Cheng, Peng/KFQ-8946-2024
   Cai, Chenxiao/JDC-5308-2023},
ORCID-Numbers = {Park, PooGyeon/0000-0002-8249-5427
   },
Unique-ID = {WOS:001487378500002},
}

@article{ WOS:000873894800039,
Author = {Fei, Zhongyang and Yang, Liu and Sun, Xi-Ming and Ren, Shunqing},
Title = {Zonotopic Set-Membership State Estimation for Switched Systems With
   Restricted Switching},
Journal = {IEEE TRANSACTIONS ON AUTOMATIC CONTROL},
Year = {2022},
Volume = {67},
Number = {11},
Pages = {6127-6134},
Month = {NOV},
Abstract = {In this article, a novel set-membership state estimation method based on
   zonotopes is proposed for switched systems subject to
   unknown-but-bounded disturbance with average dwell time (ADT) switching.
   By testing the consistency between the system model and measured output,
   an intersection zonotope is constructed based on mode-dependent and
   semitime-dependent correction matrix. Then, by constructing
   semitime-dependent P-radius functions, the issue of L, disturbance
   attenuation performance for the intersection zonotope is addressed.
   Finally, a numerical example is presented to illustrate the
   effectiveness of the proposed approach.},
DOI = {10.1109/TAC.2021.3131545},
