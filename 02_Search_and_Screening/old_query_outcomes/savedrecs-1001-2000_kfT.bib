Pages = {2468-2470},
Month = {MAY},
Abstract = {This letter proposes a statistical consistency check-based imperfect
   false data injection attacks detector that is more effective than the
   conventional residual-based methods. It is shown that the proposed
   detector could detect attacks with high probability by using a limited
   number of secure PMU measurements even if the probability of the false
   alarm is low. Numerical results validate its effectiveness and
   practicability.},
