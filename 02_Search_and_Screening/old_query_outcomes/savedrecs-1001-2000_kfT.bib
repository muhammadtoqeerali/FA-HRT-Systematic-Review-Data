@article{ WOS:000963357800001,
Author = {Li, Heng and Kaleem, Muaaz Bin and Chiu, I-Ju and Gao, Dianzhu and Peng,
   Jun and Huang, Zhiwu},
Title = {An intelligent digital twin model for the battery management systems of
   electric vehicles},
Journal = {INTERNATIONAL JOURNAL OF GREEN ENERGY},
Year = {2024},
Volume = {21},
Number = {3},
Pages = {461-475},
Month = {FEB 19},
Abstract = {Battery management systems (BMS) are crucial for electric vehicles
   because effective battery management is essential to their safe and
   reliable operation. However, BMS experience some problems like high
   cost, reduced space, low efficiency, and high failure rates. This paper
   proposes an intelligent digital twin model for the BMS which utilized
   the historical battery data obtained from real driving scenarios to
   measure, estimate, predict, and diagnose the battery pack states. The
   digital twin model consists of two parts, one is the state estimation
   based on the regression model and the second one is the fault diagnosis.
   The regression model between the variables of BMS is developed using a
   back propagation neural network (BPNN). Moreover, a whale optimization
   algorithm (WOA) is utilized to further optimize the parameters of the
   regression model. A threshold-based fault detection method is applied to
   diagnose the faults in the BMS. The dataset gathered from an electric
   vehicle with one year duration is utilized to evaluate the performance
   of the proposed method. Experiment results verify that the proposed
   model achieved over 95\% prediction accuracy and can effectively
   diagnose the faults in the BMS.},
DOI = {10.1080/15435075.2023.2199330},
EarlyAccessDate = {APR 2023},
ISSN = {1543-5075},
EISSN = {1543-5083},
ResearcherID-Numbers = {Li, Heng/AFI-9652-2022
   Bin Kaleem, Muaaz/JQV-7972-2023},
ORCID-Numbers = {Bin Kaleem, Muaaz/0000-0002-0277-7214},
Unique-ID = {WOS:000963357800001},
}

@article{ WOS:001795875700005,
Author = {Xia, Wei and Yang, Kaidi and Feng, Xuefei and Zhou, Mengqing},
Title = {Resilient Distributed Extended Object Tracking Under FDI Attacks},
Journal = {IEEE TRANSACTIONS ON AEROSPACE AND ELECTRONIC SYSTEMS},
Year = {2026},
Volume = {62},
Pages = {11071-11087},
Abstract = {In this article, we consider tracking an extended object modeled by an
   ellipse with an adversarial network, each node of which may be
   compromised by false data injection (FDI) attacks. We develop a
   resilient distributed extended object tracking (DEOT) algorithm with
   enhanced tracking accuracy, leveraging the diffusion strategy.
   Specifically, we develop an attack detection and defense mechanism such
   that each node could determine whether it is compromised or not, so as
   to restrain the propagation of malicious data owing to FDI attacks. We
   further propose a computationally efficient DEOT algorithm for secure
   networks as a by-product. Moreover, we analyze the computational
   complexity of the proposed algorithms. Illustrative simulation results
   validate the efficacy of the proposed algorithm for adversarial networks
   under FDI attacks, especially under potentially time-varying attacks.},
DOI = {10.1109/TAES.2026.3694040},
ISSN = {0018-9251},
EISSN = {1557-9603},
ResearcherID-Numbers = {Xia, Wei/ABQ-7387-2022
   },
ORCID-Numbers = {Yang, Kaidi/0009-0005-4366-4389},
Unique-ID = {WOS:001795875700005},
}

@article{ WOS:000403513900046,
Author = {Archanjo Dutra, Dimas Abreu and Soares Teixeira, Bruno Otavio and
   Aguirre, Luis Antonio},
Title = {Joint maximum a posteriori state path and parameter estimation in
   stochastic differential equations},
Journal = {AUTOMATICA},
Year = {2017},
Volume = {81},
Pages = {403-408},
Month = {JUL},
Abstract = {In this article, we introduce the joint maximum a posteriori state path
   and parameter estimator (JME) for continuous-time systems described by
   stochastic differential equations (SDEs). This estimator can be applied
   to nonlinear systems with discrete-time (sampled) measurements with a
   wide range of measurement distributions. We also show that the
   minimum-energy state path and parameter estimator (MEE) obtains the
   joint maximum a posteriori noise path, initial conditions, and
   parameters. These estimators are demonstrated in simulated experiments,
   in which they are compared to the prediction error method (PEM) using
   the unscented Kalman filter and smoother. The experiments show that the
   MEE is biased for the damping parameters of the drift function.
   Furthermore, for robust estimation in the presence of outliers, the JME
   attains lower state estimation errors than the PEM. (C) 2017 Elsevier
   Ltd. All rights reserved.},
DOI = {10.1016/j.automatica.2017.03.035},
ISSN = {0005-1098},
