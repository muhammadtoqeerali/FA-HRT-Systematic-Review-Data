Unique-ID = {WOS:000814541300001},
}

@article{ WOS:001010396300001,
Author = {Prakash, Rahul and Dheer, Dharmendra Kumar},
Title = {Vehicle state estimation using a maximum likelihood based robust
   adaptive extended kalman filter considering unknown white Gaussian
   process and measurement noise signal},
Journal = {ENGINEERING RESEARCH EXPRESS},
Year = {2023},
Volume = {5},
Number = {2},
Month = {JUN 1},
Abstract = {The stochastic nature of noise signals affects the vehicle's internal
   states and the outputs, resulting in the difficulty in estimation. The
   unknown or time-varying nature of noise signals if not taken into
   account for estimation, the results will diverge and be highly
   deteriorated. In this paper, a maximum likelihood principle (MLP) based
   adaptive robust extended kalman filter for estimating the states of the
   adopted non-linear vehicle model is proposed. An observability test is
   done for the purpose of estimation. A covariance matching (CM) based
   robust adaptive high forgetting factor based fault tolerant technique is
   also employed on the robust adaptive extended and unscented kalman
   filters for comparison purpose. The Robustness of the filter is analyzed
   by varying the parameter of the vehicle through a local sensitivity
   analysis. The results show that the MLP based approach to the extended
   kalman filter performs well in three simulations for sinusoidal
   steering, Double Lance Change, J-Turn, Fishhook, Slalom maneuver in
   comparison to robust adaptive unscented kalman filter. Friction
   coefficient of 0.8 (dry road) and 0.4 (wet road) is chosen for the
   simulation. The sideslip angle RMSE value for MLP based estimation is
   obtained as 2.62e-05, 4.545e-06 for Sine and DLC maneuver.},
DOI = {10.1088/2631-8695/acd73e},
Article-Number = {025066},
ISSN = {2631-8695},
ResearcherID-Numbers = {Prakash, Rahul/MGA-7065-2025},
Unique-ID = {WOS:001010396300001},
}

@article{ WOS:000697155000031,
Author = {Su, Qingyu and Wang, Handong and Sun, Chaowei and Li, Bo and Li, Jian},
Title = {Cyber-attacks against cyber-physical power systems security: State
   estimation, attacks reconstruction and defense strategy},
Journal = {APPLIED MATHEMATICS AND COMPUTATION},
Year = {2022},
Volume = {413},
Month = {JAN 15},
Abstract = {In modern power systems, the connection between cyber part and physical
   part is more and more close and deeply coupled, while cyber-physical
   power systems (CPPS) can exactly describe the dynamic process of modern
   power grids. The problem of secure state estimation and attack
   reconstruction of cyber-attacks corrupting states of CPPS is addressed.
   First, the classical small signal model of CPPS under disturbance and
   cyber-attacks is established. Then, an intermediate observer is proposed
   to realize the security state estimation and state attack reconstruction
   of CPPS under cyber-attacks, meanwhile, the linear matrix inequality
   (LMI) is used to solve the parameters of the intermediate observer.
   Finally, an attack defense strategy satisfying optimal economic dispatch
   is proposed. Case studies are presented to assess the effectiveness of
   intermediate observer reconstruction and the effectiveness of defense
   strategy. (C) 2021 Elsevier Inc. All rights reserved.},
DOI = {10.1016/j.amc.2021.126639},
EarlyAccessDate = {SEP 2021},
Article-Number = {126639},
ISSN = {0096-3003},
EISSN = {1873-5649},
ResearcherID-Numbers = {Su, Qingyu/S-6773-2017},
Unique-ID = {WOS:000697155000031},
}

@article{ WOS:001808985600044,
Author = {Karim, Atieh and Taher, Seyed Abbas and Shafieirad, Mohsen},
Title = {Integrated Finite-Time Fault-Tolerance Terminal Sliding Mode Control of
   Brushless DC Motors (BLDC) Based on Finite-Time Fault Detection and
   Estimation},
Journal = {IEEE ACCESS},
Year = {2026},
Volume = {14},
Pages = {96815-96839},
Abstract = {This study introduces an innovative control framework for enhancing the
   reliability and performance of Brushless DC Motors through advanced
   fault-tolerant techniques. The developed methodology combines terminal
   sliding mode control with a dual-estimation scheme to achieve
   simultaneous finite-time convergence of system states, disturbances, and
   fault signals. Departing from conventional approaches, the proposed
   solution uniquely decouples and independently estimates fault conditions
   and external disturbances within guaranteed time bounds while ensuring
   rapid convergence of motor outputs to reference trajectories. The
   architecture employs a novel composite observer structure, coupled with
   a robust adaptive controller that features integral sliding surfaces.
   This method enables precise state estimation and continuous control
   action while reducing chattering effects. Key innovations include: 1)
   unified finite-time convergence of four critical control objectives -
   disturbance estimation, fault identification, observer stability, and
   speed regulation; 2) a subsystem decomposition strategy for efficient
   fault/disturbance identification; and 3) adaptive compensation
   mechanisms for estimation error mitigation. Numerical validation
   demonstrates the framework's effectiveness in maintaining precise speed
   control under various fault scenarios and modeling uncertainties.
   Comparative results show significant improvements in transient response
   and disturbance rejection over existing methods, particularly in
   applications demanding high reliability and rapid response times.},
DOI = {10.1109/ACCESS.2026.3706256},
ISSN = {2169-3536},
ResearcherID-Numbers = {Shafieirad, Mohsen/MBH-7396-2025},
Unique-ID = {WOS:001808985600044},
}

@article{ WOS:001203475100001,
Author = {Garcia-Calva, Tomas and Morinigo-Sotelo, Daniel and Mwata-Velu, Tat'y
   and Garcia-Perez, Arturo and Uribe-Murcia, Karen},
Title = {Rotor speed estimation for half-broken bar detection in induction motors
   using Kalman filtering},
Journal = {MEASUREMENT SCIENCE AND TECHNOLOGY},
Year = {2024},
Volume = {35},
Number = {7},
Month = {JUL 1},
Abstract = {This study addresses the early detection of half-broken bars in
   induction motors (IMs). Most research on fault detection focuses on
   current signature analysis because it can provide online and remote
   monitoring at a low cost. However, errors caused by spectral leakage
   around the fundamental frequency supply reduce its reliability for fault
   diagnosis at the incipient stages. The proposed detection technique is
   based on a spectral analysis of the motor speed. To detect a half-broken
   bar, measurements of stator voltages and currents are processed by an
   adaptive extended Kalman filter for system state estimation. Then, a
   spectral analysis is applied to the estimated motor speed to obtain its
   power spectral distribution. Finally, the fault harmonic amplitude at 2
   s f s is used as fault indicator for fault diagnosis. The proposed
   approach has three main advantages: (1) speed estimation is unaltered by
   spectral leakage around the main frequency supply, (2) the cost of speed
   sensors is avoided, and (3) the absence of connecting shaft couplings
   prevents corruption of speed data by mechanical interference. Numerical
   simulations and experimental results were carried out for the squirrel
   cage IM to provide encouraging validation of the proposed early fault
   detection technique.},
DOI = {10.1088/1361-6501/ad3496},
Article-Number = {076115},
ISSN = {0957-0233},
EISSN = {1361-6501},
ResearcherID-Numbers = {Mwata-Velu, Tat'y/AIE-9101-2022
   Garcia-Calva, Tomas/GLT-9920-2022
   GARCIA-PEREZ, ARTURO/L-7288-2016},
ORCID-Numbers = {Mwata-Velu, Tat'y/0000-0002-4346-8055
   Uribe Murcia, karen Julieth/0000-0001-5680-5447
   Garcia-Calva, Tomas/0000-0001-8191-7600
   GARCIA-PEREZ, ARTURO/0000-0001-7070-1855},
Unique-ID = {WOS:001203475100001},
}

@article{ WOS:001279533800001,
Author = {Hu, Pengfei and Gao, Wengen and Li, Yunfei and Guo, Xinxin and Hua, Feng
   and Qiao, Lina},
Title = {Anomaly Detection and State Correction in Smart Grid Using EKF and Data
   Compensation Techniques},
Journal = {IEEE SENSORS JOURNAL},
Year = {2024},
Volume = {24},
Number = {8},
Pages = {12995-13009},
Month = {APR 15},
Abstract = {The smart grid is built on an integrated and high-speed communication
   network, which renders it more vulnerable to cyber-attacks. False data
   injection attacks (FDIAs) and sudden load changes (SLCs) can bias state
   estimation (SE), causing the system to make incorrect decisions or
   provide incorrect outputs. For this reason, this article proposes a
   novel outlier detection and state correction strategy. To detect
   outliers, we propose an extended Kalman filter (EKF) based on
   forecast-assisted SE (FASE) to generate estimations. By modifying the
   prediction step in FASE into the form of adaptively adjusting the
   smoothing parameters, the accuracy of the state estimation can be
   improved. Then, outliers are detected using the deviation of the state
   estimate between the EKF and the weighted least squares (WLS) compared
   with a detection threshold determined offline at a specific false alarm
   rate. In addition, to recover the measurements and correction states in
   time, this article proposes a data compensation strategy with a sliding
   window to compensate the measurements. Then, the compensated
   measurements are used to reconstruct the state equation and the
   measurement equation of the system. The IEEE 14-bus system and the IEEE
   30-bus system are simulated to demonstrate the performance of the
   proposed algorithm in anomaly detection and state correction. Numerical
   examples show that our algorithm can accurately detect and correct
   states when anomalies are present.},
DOI = {10.1109/JSEN.2024.3372973},
ISSN = {1530-437X},
EISSN = {1558-1748},
ORCID-Numbers = {Hu, Pengfei/0000-0001-7332-7096
   li, yunfei/0000-0003-0234-6251},
Unique-ID = {WOS:001279533800001},
}

@article{ WOS:001843636900001,
Author = {Muthusamy, Vijayakumar and Chihi, Ines},
Title = {Fault Decoupling Through State Estimation Using Observer-Based
   Physics-Informed Neural Network},
Journal = {IEEE TRANSACTIONS ON CYBERNETICS},
Year = {2026},
Month = {2026 AUG 5},
Abstract = {In the context of fault diagnosis in smart manufacturing, fault
   decoupling has become a critical component, enabling systems to
   distinguish between various sources of anomalies, such as actuator
   faults, sensor faults, and external disturbances. This article proposes
   a joint state and fault estimation for linear time-invariant (LTI)
   systems affected by multiple faults and disturbances. First, the design
   of dual proportional-integral fading unknown input observers (PIFUIOs)
   is implemented to estimate the system states and fault signals under a
   structurally decoupled framework. Necessary and sufficient conditions
   are derived to guarantee the existence of the observers and to ensure
   mutual decoupling between faults and disturbances. Next, a
   physics-informed neural network (PINN) is framed, in which the loss
   functions are constructed based on the observer design to enhance
   estimation accuracy and incorporate physical knowledge of the observer
   into the learning process. In addition, sufficient conditions based on
   Lyapunov stability theory to ensure asymptotic convergence and
   attenuation of faults and disturbances are formulated using linear
   matrix inequalities (LMIs). Finally, the effectiveness of the proposed
   approach is validated via a DC motor model.},
