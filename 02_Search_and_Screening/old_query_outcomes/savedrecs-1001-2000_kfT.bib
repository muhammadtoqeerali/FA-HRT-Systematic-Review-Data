@article{ WOS:000388777400075,
Author = {Cheng, Shuyao and Yang, Hao and Jiang, Bin},
Title = {An integrated fault estimation and accommodation design for a class of
   complex networks},
Journal = {NEUROCOMPUTING},
Year = {2016},
Volume = {216},
Pages = {797-804},
Month = {DEC 5},
Abstract = {This paper proposes an integrated fault estimation and accommodation
   method for a class of linearly interconnected complex network systems.
   In order to simultaneously estimate the unknown state and fault(s)
   information, a set of novel distributed adaptive estimators are
   designed, based on which a decentralized fault accommodation scheme is
   further constructed to stabilize the whole interconnected system. An
   example of a network consisting of three one-link manipulators is
   presented to demonstrate the effectiveness of our proposed method. (C)
   2016 Elsevier B.V. All rights reserved.},
DOI = {10.1016/j.neucom.2016.08.043},
