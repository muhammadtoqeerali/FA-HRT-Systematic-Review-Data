Unique-ID = {WOS:001464050200020},
}

@article{ WOS:000399998000078,
Author = {Zhao, Junbo and Zhang, Gexiang and Jabr, Rabih A.},
Title = {Robust Detection of Cyber Attacks on State Estimators Using Phasor
