@article{ WOS:000698617800001,
Author = {Sun, Jie and Shen, Bo and Qi, Jie and Liu, Yufei},
Title = {Stubborn H∞ state estimation for nonlinear distributed
   parameter systems subject to measurement outliers},
Journal = {INTERNATIONAL JOURNAL OF ROBUST AND NONLINEAR CONTROL},
Year = {2022},
Volume = {32},
Number = {1},
Pages = {13-28},
Month = {JAN 10},
Abstract = {In this article, the H-infinity state estimation problem is investigated
   for a class of distributed parameter systems (DPSs). In order to
   estimate the state of DPSs, we give a partition of spatial interval with
   a finite sequence and, on each subinterval, one sensor is placed to
   receive the measurements from the DPS. Due to the unexpected environment
   changes, the measurements will probably contain some outliers. To
   eliminate the effects of the possibly occurring outliers, we construct a
   stubborn state estimator where the innovation is constrained by a
   saturation function. By using Lyapunov functional, Wirtinger inequality
   and piecewise integration, some sufficient conditions are obtained under
   which the resulting estimation error system is exponentially stable and
   the H-infinity performance requirement is satisfied. According to the
   obtained analysis results, the desired H-infinity state estimator is
   designed in terms of the solution to a set of matrix inequalities.
   Finally, a numerical simulation example is given to verify the
   effectiveness of the proposed state estimation scheme.},
DOI = {10.1002/rnc.5801},
EarlyAccessDate = {SEP 2021},
ISSN = {1049-8923},
EISSN = {1099-1239},
ResearcherID-Numbers = {Qi, Jiexing/JZE-4852-2024
   Shen, Bo/AEZ-9103-2022},
ORCID-Numbers = {Shen, Bo/0000-0003-3482-5783},
Unique-ID = {WOS:000698617800001},
}

@article{ WOS:001726665800001,
Author = {Qi, Hui and Wu, Huaiyu and Zheng, Xiujuan and Zhu, Yancheng and Hu, Mian},
Title = {Periodic-Hybrid-Attacks-Resistant Recursive State Estimation for
   Nonlinear Complex Networks with Random Mixed Couplings: An Adaptive
   Event-Triggered Approach},
Journal = {CIRCUITS SYSTEMS AND SIGNAL PROCESSING},
Year = {2026},
Month = {2026 MAR 28},
Abstract = {This paper aims to investigate the issue of adaptive event-triggered
   recursive state estimation (RSE) for a class of nonlinear complex
   networks with periodic hybrid cyber attacks (PHCAs) and random mixed
   couplings (RMCs). The phenomenon of RMCs is characterized by both random
   outer coupling and random inner coupling, with the former modeled by a
   sequence of random variables uniformly distributed over a given interval
   and the latter by multiplicative noise. Taking into account periodic
   denial-of-service (DoS) attacks and periodic false data injection (FDI)
   attacks, a novel periodic hybrid attack model is introduced. In this
   model, the DoS and FDI components have their own attack cycles, each
   comprising an active period and a dormant period. To alleviate the
   communication burden, an adaptive event-triggered mechanism is adopted
   to regulate the data transmission frequency in the node-to-node channel.
   Accordingly, a novel adaptive event-triggered RSE strategy is proposed,
   accounting for both RMCs and PHCAs. Specifically, an upper bound on the
   estimation error covariance is presented, and then the estimator gain
   that minimizes this upper bound is constructed. Furthermore, the upper
   bound on the estimation error covariance is proved to be uniformly
   bounded in mean-square sense via rigorous theoretical analysis. Finally,
   simulation experiments are carried out to reveal the availability of the
   developed RSE scheme.},
DOI = {10.1007/s00034-026-03557-8},
EarlyAccessDate = {MAR 2026},
ISSN = {0278-081X},
EISSN = {1531-5878},
ResearcherID-Numbers = {Hu, Mian/JDV-8871-2023},
Unique-ID = {WOS:001726665800001},
}

@article{ WOS:000965344100001,
Author = {Wan, Xiongbo and Zhan, Chi and Zhang, Chuan-Ke and Wu, Min},
Title = {Finite-Time Fault Detection Under Deception Attacks: A Hybrid Dynamic
   Variables-Dependent Event-Based Scheme},
Journal = {IEEE TRANSACTIONS ON NETWORK SCIENCE AND ENGINEERING},
Year = {2023},
Volume = {10},
Number = {2},
Pages = {766-779},
Month = {MAR-APR},
Abstract = {This article deals with the dynamic event-based finite-time fault
   detection (FD) issue for singularly perturbed systems under deception
   attacks. A hybrid dynamic variables-dependent event-triggered mechanism
   (ETM) is proposed, which contains both additive and multiplicative
   internal dynamic variables (IDVs). Such a new dynamic ETM (DETM) is
   employed to decide whether the measurement data packet should be
   released or not at each time instant. A Bernoulli random variable is
   utilized to describe the deception attack that occurs during the
   measurement data packet transmission. Attention is to design an FD
   filter (FDF) which guarantees that the resultant error dynamics of
   filtering on FD is stochastically H-8 finite-time bounded. Based on a
   new Lyapunov function containing two IDVs, sufficient conditions are
   derived to ensure the existence of the FDF whose parameters are designed
   by resorting to the feasible solutions of several matrix inequalities.
   Two examples are presented to demonstrate the effectiveness of the
   DETM-based FDF design method. It is revealed that the devised DETM has
   superiority over some existing ETMs in saving network resources while
   not degrading the FD filtering performance.},
DOI = {10.1109/TNSE.2022.3223040},
ISSN = {2327-4697},
ResearcherID-Numbers = {Zhang, Chuan-Ke/L-7727-2016},
ORCID-Numbers = {Wu, Min/0000-0002-0668-8315
   Zhan, Chi/0000-0002-8315-2952
   },
Unique-ID = {WOS:000965344100001},
}

@article{ WOS:000659552700060,
Author = {Rigatos, Gerasimos and Abbaszadeh, Masoud},
Title = {Fault Diagnosis for a PDE Suspended-Bridge Model With Kalman Filter and
   Statistical Decision Making},
Journal = {IEEE SYSTEMS JOURNAL},
Year = {2021},
Volume = {15},
Number = {2},
Pages = {2137-2147},
Month = {JUN},
Abstract = {This article proposes a fault diagnosis method for the partial
   differential equation (PDE) model that describes the interaction between
   a suspended-bridge and a moving vehicle. Using semidiscretization and
   the finite differences approach, and considering a grid of N equidistant
   points on the bridge's longitudinal axis, the PDE that describes the
   spatiotemporal dynamics of the bridge is decomposed into a set of N
   ordinary differential equations (ODEs). Thus, a state-space model of the
   bridge and vehicle interaction is obtained comprising N + 2 ordinary
   differential equations. Equivalently, one can obtain a matrix
   description of this state-space model of dimension 2N + 4. Moreover, by
   denoting transformed control inputs, this state-space model is finally
   written in the canonical Brunovsky form which is known to be observable.
   For the latter state-space representation of the bridge-vehicle system
   in the canonical form, state estimation is performed with the use of
   Kalman filtering. Next, by comparing the outputs of the Kalman Filter
   with the real-time outputs of the bridge-vehicle system, the residuals
   sequence is generated. It is demonstrated that the sum of the squares of
   the residuals vectors weighted by the inverse of their covariance matrix
   stands for a stochastic variable, which follows the chi(2) distribution.
   Thus, by exploiting the 96\% or the 98\% confidence intervals of the
   chi(2) distribution one can define fault thresholds which show in an
   almost infallible manner, whether the bridge retains its structural
   integrity or whether it has been subjected to a fault.},
DOI = {10.1109/JSYST.2020.3000445},
ISSN = {1932-8184},
EISSN = {1937-9234},
ResearcherID-Numbers = {Rigatos, Gerasimos/AAO-4726-2020},
ORCID-Numbers = {Abbaszadeh, Masoud/0000-0002-9440-1563
   },
Unique-ID = {WOS:000659552700060},
}

@article{ WOS:000722098600003,
Author = {Rana, Md Masud},
Title = {Attack Resilient Wireless Sensor Networks for Smart Electric Vehicles},
Journal = {IEEE SENSORS LETTERS},
Year = {2017},
Volume = {1},
Number = {2},
Month = {APR},
Abstract = {The loss of lateral stability of autonomous electric vehicles can lead
   to fatal accidents. In order to control the electric vehicle, the
   sideslip angle needs to be estimated and regulated. To do this, the
   vehicle dynamics are represented by a state-space framework where the
   internet-of-things (IoT) enabled sensors are deployed to obtain
   measurements. The local estimation results are transmitted to the fusion
   center, where the cyber-attacks occur during the transmission of
   signals. In order to minimize cyber-attacks, the convex state estimation
   algorithm is proposed in the context of smart electric vehicles.
   Afterward, the optimal feedback controller considering packet losses is
   proposed to stabilize the system states. Simulation results verify the
   effectiveness of the proposed algorithm.},
DOI = {10.1109/LSENS.2017.2690907},
Article-Number = {5500204},
ISSN = {2475-1472},
Unique-ID = {WOS:000722098600003},
}

@article{ WOS:001073550500001,
Author = {Shahid, Muhammad Awais and Ahmad, Fiaz and Nawaz, Rehan and Khan, Saad
   Ullah and Wadood, Abdul and Albalawi, Hani},
Title = {A Novel False Measurement Data Detection Mechanism for Smart Grids},
Journal = {ENERGIES},
Year = {2023},
Volume = {16},
Number = {18},
Month = {SEP},
Abstract = {With the growing cyber-infrastructure of smart grids, the threat of
   cyber-attacks has intensified, posing an increased risk of compromised
   communication links. Of particular concern is the false data injection
   (FDI) attack, which has emerged as a highly dangerous cyber-attack
   targeting smart grids. This paper addresses the limitations of the
   variable dummy value model proposed in the authors previous work and
   presents a novel defense methodology called the nonlinear function-based
   variable dummy value model for the AC power flow network. The proposed
   model is evaluated using the IEEE 14-bus test system, demonstrating its
   effectiveness in detecting FDI attacks. It has been shown that previous
   detection techniques are unable to detect FDI attacks, whereas the
   proposed method is shown to be successful in the detection of such
   attacks, guaranteeing the security of the smart grid's measurement
   infrastructure.},
