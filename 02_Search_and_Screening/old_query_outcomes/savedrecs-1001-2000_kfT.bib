   BESBES, Mongi/0000-0003-0953-356X
   },
Unique-ID = {WOS:000468821100014},
}

@article{ WOS:000756571000011,
Author = {Hassan, Ayman E. O. and Mohammed, Tasnim A. A. and Demirkol, Askin},
Title = {Fault detection in a three-tank hydraulic system using unknown input
   observer and extended Kalman filter},
Journal = {JOURNAL OF ENGINEERING RESEARCH},
Year = {2021},
Volume = {9},
Number = {4A},
Pages = {161-173},
Month = {DEC},
Abstract = {This paper presents the problem of fault diagnosis in a three-tank
   hydraulic system. A mathematical model of the system is developed in
   order to apply two different observing algorithms. Unknown Input
   Observer (UIO) and Extended Kalman Filter (EKF) have been used to detect
   and isolate actuator and sensor faults. For Unknown Input Observer
   (UIO), residuals are calculated from the measured and estimated output
   according to the eigenvalues of the system after processed by Linear
   Matrix Inequality (LMI). Extended Kalman filter uses process and
   measurement noise variances for state estimation. Unknown Input Observer
   and Extended Kalman Filter's performance in fault estimation and
   isolation is evaluated under different scenarios. Using Extended Kalman
   Filter (EKF), faults can be diagnosed effectively in the presence of
   noise, while Unknown Input Observer (UIO) is working better in the
   absence of noise, and simulation results illustrate that clearly.},
DOI = {10.36909/jer.8985},
ISSN = {2307-1877},
EISSN = {2307-1885},
ResearcherID-Numbers = {ELFATIH OSMAN HASSAN, AYMAN/GRY-6731-2022
