@article{ WOS:001794425800001,
Author = {Li, Mu and Yang, Jian and Wang, Hongying and Li, Yanfeng and Zhao, Dong},
Title = {A high-accuracy pose estimation visual guidance system for body-in-white
   based on multi-camera hierarchical optimization},
Journal = {ROBOTICS AND AUTONOMOUS SYSTEMS},
Year = {2026},
Volume = {204},
Month = {OCT},
Abstract = {Fixture-free body-in-white (BIW) welding requires a vision guidance
   system that can reliably estimate six-degree-of-freedom body pose under
   non-overlapping field-of-view (NFOV) constraints, where
   rotation-translation coupling and weak depth (Z-axis) observability are
   the two principal algorithmic challenges. We propose a multi-camera NFOV
   pose-estimation framework that deploys four fixed cameras to
   independently observe local BIW regions. A unified multi-camera
   projection model is established, and an overdetermined linear system
   (weighted least-squares with lightweight RANSAC outlier screening)
   provides a robust initial pose. Pose is then refined through a
   three-stage hierarchical decoupling optimization (rotation-XY
   translation-Z translation with adaptive regularization), which
   eliminates residual rotation-translation coupling and stabilizes the
   ill-conditioned depth step. A dual robust mechanism-point-level Huber
   loss and camera-level adaptive consistency weighting-jointly suppresses
   isolated feature outliers and systematic view-level disturbances caused
   by metallic reflections. Industrial experiments on a real BIW welding
   station with a Volkswagen Golf body yield +/- 0.016 mm repeatability
   (3), a 95th-percentile spatial deviation of 0.7525 mm, and all 1620
   evaluated measurements within +/- 1 mm guidance tolerance.},
DOI = {10.1016/j.robot.2026.105556},
Article-Number = {105556},
ISSN = {0921-8890},
EISSN = {1872-793X},
ResearcherID-Numbers = {yang, jian/QUU-5977-2026},
Unique-ID = {WOS:001794425800001},
}

@article{ WOS:001506650000045,
Author = {Li, Guoqiang and Li, Zhenyang and Lu, Yu and Wang, Zhenpo},
Title = {Learning-Based Optimal Adaptive Resilient Control for Safe Autonomous
   Driving Under Cyberattacks},
Journal = {IEEE INTERNET OF THINGS JOURNAL},
Year = {2025},
Volume = {12},
Number = {12},
Pages = {20858-20869},
Month = {JUN 15},
Abstract = {The malicious cyberattack in connected automated vehicles leads to a
   major threat to the safety and security of autonomous driving. Different
   from traditional approaches which generally require perfect knowledge of
   system models and state measurements, in this article, a novel
   learning-based adaptive resilient control framework is proposed to
   defend against various false data injection attacks on the steering
   system to improve safe driving for automated vehicles. First, a robust
   nonlinear state estimation method is developed to provide accurate
   observation of unmeasured state variables for feedback control with
   limited onboard sensors. Then, an active model learning approach is
   proposed to present the vehicle driving behavior under different attacks
   to improve the dynamic model for state prediction over receding horizon.
   Finally, a data-driven attack-resilient method is designed to optimize
   the vehicle motion for autonomous driving. The derived control policy
   can be adapted to different scenarios for safety. MATLAB/Simulink and
   CarSim co-simulation platform is applied to evaluate the effectiveness
   and robustness of the proposed method on state estimation, model
   learning and accurate tracking control under various attack conditions.},
DOI = {10.1109/JIOT.2025.3546962},
ISSN = {2327-4662},
ResearcherID-Numbers = {Wang, Zhenpo/JPA-0865-2023},
ORCID-Numbers = {li, Guoqiang/0000-0002-2843-704X
   Li, Zhenyang/0009-0002-5624-1180
   },
Unique-ID = {WOS:001506650000045},
}

@article{ WOS:001660434000001,
Author = {Markovsky, Ivan and Muixi, Alba and Zlotnik, Sergio and Diez, Pedro},
Title = {A behavioral approach to direct data-driven fault detection},
Journal = {MECHANICAL SYSTEMS AND SIGNAL PROCESSING},
Year = {2026},
Volume = {245},
Month = {FEB 1},
Abstract = {Efficient and reliable fault detection methods are needed for monitoring
   and evaluation of processes, e.g., in structural health assessment.
   Existing methods rely on an a priori given model. Obtaining a model is
   nontrivial and is often the bottleneck in applications. Direct
   data-driven methods were recently developed in signal processing and
   control. These methods avoid parametric model identification and may
   outperform state-of-the-art model-based methods. This paper presents a
   direct data-driven method for fault detection. The monitored process is
   modeled as a linear time-invariant system with an unobserved
   deterministic disturbance. The behavioral approach to systems theory is
   used in order to define a representation invariant measure for the
   distance between data and model. The main contribution of the paper is a
   method for computing the distance directly from offline and online data
   without parametric model identification. Another contribution is a
   direct data-driven input estimation. The method is validated empirically
   on simulated data of a flexible beam with a crack, where the objective
   is to detect the crack.},
DOI = {10.1016/j.ymssp.2025.113802},
EarlyAccessDate = {JAN 2026},
