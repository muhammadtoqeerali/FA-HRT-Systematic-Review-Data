@article{ WOS:001850123300006,
Author = {Wang, Yu and Peng, Gaoliang and Liu, Tianchen and Wang, Jinghan and
   Chen, Zhao and Jin, Kang and Li, Hang},
Title = {Multilevel Estimation Framework of Articulated Vehicle Sideslip Angles
   via Data-Model Fusion},
Journal = {IEEE SENSORS JOURNAL},
Year = {2026},
Volume = {26},
Number = {16},
Pages = {25109-25121},
Month = {AUG 15},
Abstract = {Accurate sideslip angle estimation of articulated vehicles plays a
   crucial role in enhancing active safety and ensuring road transportation
   security. However, this task remains challenging because of the
   multiunit structure and the intermittent sensor anomalies triggered by
   operational disturbances. To address these issues, this article proposes
   a multilevel state estimation framework based on data-model fusion.
   First, raw sensor data undergo preprocessing via an improved
   fault-tolerant filtering technique to effectively identify and eliminate
   intermittent outliers. Subsequently, a virtual sensor module is designed
   by integrating convolutional long short-term memory (ConvLSTM) networks
   and deep ensemble learning. The module generates accurate preliminary
   angle estimates and corresponding uncertainty quantification for each
   unit. Finally, the outputs from the virtual sensor are fused with the
   filtered measurements using an adaptive unscented Kalman filter (AUKF),
   achieving high-accuracy, robust sideslip angle estimation for all
   articulated vehicle units. Extensive experiments are conducted using the
   TruckSim simulation platform and in real-world tests. The results
   demonstrate that the proposed framework substantially outperforms
   several classical approaches in terms of estimation precision,
   robustness, and generalizability. This validates the framework's
   effectiveness and practical applicability under complex driving
   conditions and in the presence of anomalous interference scenarios.},
DOI = {10.1109/JSEN.2026.3708879},
ISSN = {1530-437X},
EISSN = {1558-1748},
ResearcherID-Numbers = {Liu, Tianchen/PDW-5254-2025
   Jin, Kang/IUX-0749-2023},
Unique-ID = {WOS:001850123300006},
}

@article{ WOS:000404046600068,
Author = {Zhao, Junbo and Netto, Marcos and Mili, Lamine},
Title = {A Robust Iterated Extended Kalman Filter for Power System Dynamic State
   Estimation},
Journal = {IEEE TRANSACTIONS ON POWER SYSTEMS},
Year = {2017},
Volume = {32},
Number = {4},
Pages = {3205-3216},
Month = {JUL},
Abstract = {This paper develops a robust iterated extended Kalman filter (EKF) based
   on the generalized maximum likelihood approach (termed GM-IEKF) for
   estimating power system state dynamics when subjected to disturbances.
   The proposed GM-IEKF dynamic state estimator is able to track system
   transients in a faster and more reliable way than the conventional EKF
   and the unscented Kalman filter (UKF) thanks to its batch-mode
   regression form and its robustness to innovation and observation
   outliers, even in position of leverage. Innovation outliers may be
   caused by impulsive noise in the dynamic state model while observation
   outliers may be due to large biases, cyber attacks, or temporary loss of
   communication links of PMUs. Good robustness and high statistical
   efficiency under Gaussian noise are achieved via the minimization of the
   Huber convex cost function of the standardized residuals. The latter is
   weighted via a function of robust distances of the two-time sequence of
   the predicted state and innovation vectors and calculated by means of
   the projection statistics. The state estimation error covariance matrix
   is derived using the total influence function, resulting in a robust
   state prediction in the next time step. Simulation results carried out
   on the IEEE 39-bus test system demonstrate the good performance of the
   GM-IEKF under Gaussian and non-Gaussian process and observation noise.},
DOI = {10.1109/TPWRS.2016.2628344},
ISSN = {0885-8950},
EISSN = {1558-0679},
ResearcherID-Numbers = {Netto, Marcos/E-4758-2016
   Zhao, Junbo/R-8341-2019},
ORCID-Numbers = {Netto, Marcos/0000-0001-7002-3345
   Zhao, Junbo/0000-0002-8498-9666},
Unique-ID = {WOS:000404046600068},
}

@article{ WOS:001163833200001,
Author = {Li, Haifang and Zhou, Bin and Michiels, Wim},
Title = {Prescribed-time sensor fault estimation for linear systems with unknown
   inputs by periodic delayed observers},
Journal = {INTERNATIONAL JOURNAL OF ROBUST AND NONLINEAR CONTROL},
Year = {2024},
Volume = {34},
Number = {10, SI},
Pages = {6636-6658},
Month = {JUL 10},
Abstract = {This paper studies the problem of sensor fault estimation for linear
   systems in the presence of unknown inputs in both input and output
   channels. Relying on matrix equation theory, the unknown inputs are
   first removed from the output channel. Second, an augmented descriptor
   system is constructed by treating both system state and sensor fault as
   (pseudo)-state variables. Third, the augmented descriptor system is
   transformed into a regular one, followed by the elimination of the
   unknown input from the state equation. Finally, a reduced-order
   prescribed-time sensor fault estimator is obtained by using periodic
   delayed observers. This matrix equation based approach is then
   complemented by an alternative one, which relies on successive
   transformations of state, input and outputs. This approach sheds light
   on the adopted solvability conditions throughout the paper and on the
   role of different directions in the output space in handling unknown
   inputs, sensor faults and the core state estimation problem. Finally,
   two numerical examples are presented to illustrate the effectiveness of
   the proposed methodologies.},
DOI = {10.1002/rnc.7250},
EarlyAccessDate = {FEB 2024},
