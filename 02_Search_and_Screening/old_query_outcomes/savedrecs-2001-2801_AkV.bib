Unique-ID = {WOS:000401525400001},
}

@article{ WOS:000472692900032,
Author = {Alhalali, Safoan and Nielsen, Christopher and ElShatshat, Ramadan},
Title = {Mitigation of cyber-physical attacks in multi-area automatic generation
   control},
Journal = {INTERNATIONAL JOURNAL OF ELECTRICAL POWER \& ENERGY SYSTEMS},
Year = {2019},
Volume = {112},
Pages = {362-369},
Month = {NOV},
Abstract = {In recent years, several cyber-attacks have been recorded against
   sensitive monitoring systems. Among them is the automatic generation
   control (AGC) system, a fundamental control system used in all power
   networks. AGC systems keep the network frequency at its desired value
   and maintain the tie-line power exchanges at their scheduled values.
   Motivated by the increasing need for robust and safe operation of AGCs,
   we introduce an attack resilient control scheme for the AGC system based
   on attack detection using state estimation. The proposed approach
   requires redundancy of sensors available at the transmission level in
   the power network and leverages recent results on attack detection using
   mixed integer linear programming (MILP). The proposed algorithm detects
   and identifies the sensors under attack in the presence of noise. The
   non-attacked sensors are then averaged and made available to the
   feedback controller. No assumptions about the nature of the attack
   signal are made. The proposed method is simulated using a large range of
   attack signals and uncertain sensors measurements.},
DOI = {10.1016/j.ijepes.2019.05.014},
ISSN = {0142-0615},
EISSN = {1879-3517},
Unique-ID = {WOS:000472692900032},
}

@article{ WOS:000474423900001,
Author = {Yang, Cheng and Shi, Wenzhong and Chen, Wu},
Title = {Robust M-M unscented Kalman filtering for GPS/IMU navigation},
Journal = {JOURNAL OF GEODESY},
Year = {2019},
Volume = {93},
Number = {8},
Pages = {1093-1104},
Month = {AUG},
Abstract = {In this paper, a robust unscented Kalman filter (UKF) based on the
   generalized maximum likelihood estimation (M-estimation) is proposed to
   improve the robustness of the integrated navigation system of Global
   Navigation Satellite System and Inertial Measurement Unit. The UKF is a
   variation of Kalman filter by which the Jacobian matrix calculation in a
   nonlinear system state model is not necessary. The proposed robust M-M
   unscented Kalman filter (RMUKF) applies the M-estimation principle to
   both functional model errors and measurement errors. Hence, this robust
   filter attenuates the influences of disturbances in the dynamic model
   and of measurement outliers without linearizing the nonlinear state
   space model. In addition, an equivalent weight matrix, composed of the
   bi-factor shrink elements, is proposed in order to keep the original
   correlation coefficients of the predicted state unchanged. Furthermore,
   a nonlinear error model is used as the dynamic equation to verify the
   performance of the proposed RMUKF with a simulation and field test.
   Compared with the conventional UKF, the impacts of measurement outliers
   and system disturbances on the state estimation are both controlled by
   RMUKF.},
DOI = {10.1007/s00190-018-01227-5},
ISSN = {0949-7714},
EISSN = {1432-1394},
ResearcherID-Numbers = {Chen, Wu/B-5326-2011
   YANG, Cheng/GWR-3651-2022},
ORCID-Numbers = {Chen, Wu/0000-0002-1787-5191
   },
Unique-ID = {WOS:000474423900001},
}

@article{ WOS:000395831200036,
Author = {Xiang, Yingmeng and Ding, Zhilu and Zhang, Yichi and Wang, Lingfeng},
Title = {Power System Reliability Evaluation Considering Load Redistribution
   Attacks},
Journal = {IEEE TRANSACTIONS ON SMART GRID},
Year = {2017},
Volume = {8},
Number = {2},
Pages = {889-901},
Month = {MAR},
Abstract = {The increased complexity of power system makes the power dispatch
   heavily rely on the condition monitoring and state estimation functions.
   However, with the massive deployment of cyber technologies, the power
   grid is becoming more vulnerable to malicious cyber attacks, including
   various kinds of false data injection attacks. This paper quantifies the
   influence of load redistribution (LR) attack on the long-term power
   supply reliability. The intrusion process for manipulating the
   measurements is modeled by the semi-Markov models. Considering the
   practical cross-check for suspicious measurements, the regional LR
   attack model is proposed. A holistic framework incorporating the
   physical failures and the LR attack is proposed for cyber-physical power
   system reliability evaluation. The simulation is carried out on the IEEE
   RTS79 system. The influences of critical factors and strategies are
   analyzed. It is concluded that the LR attacks have a non-negligible
   impact on the power system reliability.},
DOI = {10.1109/TSG.2016.2569589},
ISSN = {1949-3053},
EISSN = {1949-3061},
ResearcherID-Numbers = {Wang, Lin/D-4021-2009},
Unique-ID = {WOS:000395831200036},
}

@article{ WOS:001850123300021,
Author = {Wang, Zhiheng and Sun, Shujie and Zhang, Xuanrui and Wang, Shengchun and
   Wang, Liang},
Title = {Sleeper-Encoded Localization Method: A Mileage Precision Localization
   Approach for Railway Maintenance},
Journal = {IEEE SENSORS JOURNAL},
Year = {2026},
Volume = {26},
Number = {16},
Pages = {24578-24586},
Month = {AUG 15},
Abstract = {High-precision mileage localization is a critical prerequisite for
   railway maintenance, requiring inspection data to be mapped to physical
   targets with high deterministic precision. However, bridging the gap
   between continuous sensor measurements and discrete track infrastructure
   remains challenging. Conventional odometry-based methods suffer from
   cumulative drift, while state-of-the-art deep learning (DL) pipelines,
   despite fast inference, often face system-level latency dominated by
   CPU-bound data preparation (e.g., voxelization or projection). To
   address these issues, this article proposes sleeper-encoded localization
   (SEL), a bounded-drift localization paradigm that reformulates
   along-track positioning as a hierarchical geometric filtering process. A
   micro-scale geometric filter segments sleepers from decoupled 2-D
   profiles (with theoretical validity on curved tracks), while a
   macroscale topological filter enforces global indexing consistency using
   physically plausible spacing constraints. Experiments on an operational
   high-speed railway segment show that SEL achieves 0.22 ms/profile on a
   standard CPU, effectively mitigating the data restructuring bottleneck
   commonly observed in 3-D DL pipelines. On the evaluated trajectory, SEL
   maintains consistent sleeper indexing and constrains the longitudinal
   error within a bounded interval determined by sleeper spacing and local
   detection ambiguity. In addition, stress tests with physically motivated
   degradations (e.g., sparsity and localized occlusion) illustrate
   robustness in realistic regimes and graceful degradation as conditions
   become more challenging. Overall, SEL provides a fast and lightweight
   sleeper-indexed longitudinal reference that complements
   odometer/GNSS/INS-based absolute positioning in resource-constrained
   maintenance workflows, rather than serving as an independent absolute
   mileage measurement sensor.},
DOI = {10.1109/JSEN.2026.3709488},
ISSN = {1530-437X},
EISSN = {1558-1748},
Unique-ID = {WOS:001850123300021},
}

@article{ WOS:001672685700001,
Author = {Zhang, Baoqiang and Zu, Guoqiang and Ma, Shikun and Hong, Jichao and Li,
   Kerui and Liang, Fengwei and Chen, Yuan},
Title = {Research on intelligent safety of real-world vehicle power battery based
   on charging pile data},
Journal = {JOURNAL OF ENERGY STORAGE},
Year = {2026},
Volume = {150},
Month = {MAR 10},
Abstract = {The safety management of power batteries is the key to ensuring the
   reliable operation of electric vehicles. The traditional onboard battery
   management system is complex in comprehensively assessing battery health
   and predicting potential faults due to the limited coverage of working
   conditions. This study innovatively utilizes data with higher temporal
   resolution collected from charging piles to provide a new technological
   path for the intelligent safety management of power batteries.
   High-accuracy prediction of battery state is achieved through a long
   short-term memory neural network. State of health estimation is carried
   out using constant-current charging segments. Existing fault diagnosis
   methods are attempted to be applied to charging pile data. In addition,
   a vehicle-pile interaction strategy is proposed to achieve vehicle
   identification through charging curve shape matching. The results show
   that the proposed method performs well in state prediction, health state
   estimation, and fault diagnosis. Its novelty and practicality provide a
   unique perspective for intelligent safety management during electric
   vehicles charging.},
DOI = {10.1016/j.est.2026.120472},
EarlyAccessDate = {JAN 2026},
Article-Number = {120472},
ISSN = {2352-152X},
EISSN = {2352-1538},
ResearcherID-Numbers = {Liang, Fengwei/KII-6620-2024
   HONG, JICHAO/V-1394-2019},
ORCID-Numbers = {Liang, Fengwei/0009-0006-7636-6844
   },
Unique-ID = {WOS:001672685700001},
}

@article{ WOS:001476460500031,
Author = {Zhang, Yu-Qing and Liu, Da-Yan and Boutat, Driss and Wu, Ze-Hao},
Title = {Nonasymptotic and Robust Distributed Algebraic Estimation for Linear
   Time-Varying Systems},
Journal = {IEEE TRANSACTIONS ON AUTOMATIC CONTROL},
Year = {2025},
Volume = {70},
Number = {5},
Pages = {3386-3393},
Month = {MAY},
Abstract = {This article investigates the nonasymptotic and robust distributed
   algebraic state estimation for linear time-varying systems using a
   network of sensors in noisy environments. First, at each sensor node,
   the system state is transformed into a linear combination of a group of
   nodes' local observable states, allowing for distributed estimation by
   estimating a reduced-order state for each node. Second, without
   requiring initial conditions, the estimation scheme based on generalized
   modulating functions is employed to estimate each node's local
   observable state variables through algebraic integral formulas, which
   are robust against corrupting noises. Subsequently, leveraging the
   obtained distributed state expression and cross-agent communications
   with networked delays, a nonasymptotic and robust distributed state
   estimator is designed. Furthermore, an estimation error bound in noisy
   cases is provided. Finally, two simulation examples are presented to
   illustrate the effectiveness of our proposed approach.},
DOI = {10.1109/TAC.2024.3519037},
ISSN = {0018-9286},
EISSN = {1558-2523},
ResearcherID-Numbers = {Liu, Da-Yan/A-2294-2017
   },
ORCID-Numbers = {Liu, Da-Yan/0000-0003-2853-0129
   Wu, Ze-Hao/0000-0003-4109-1757},
Unique-ID = {WOS:001476460500031},
}

@article{ WOS:001596627700001,
Author = {Liu, Jingxiang and Chen, Pin-Hsun and Chen, Junghui},
Title = {Advanced batch monitoring: auto-segmentation of complex processes using
   slow feature partial least squares},
Journal = {ADVANCED ENGINEERING INFORMATICS},
Year = {2026},
Volume = {69},
Number = {B},
Month = {JAN},
Abstract = {Accurate monitoring of batch processes is crucial for state estimation
   and early fault detection. Traditional datadriven models often assume
   statistical independence among latent variables, which limits their
   performance in dynamic systems. This study proposes a novel
   auto-segmentation method combining Slow Feature Partial Least Squares
   (SFPLS) and Partial Least Squares (PLS) to address challenges in
   processes with multiple operational phases. SFPLS captures slow-varying
   dynamic features, while PLS models static inputs and outputs. The
   approach segments data into static and dynamic regions, creating
   localized models for each phase. A numerical case study achieved a
   99.32\% fault detection rate for fault batch, and 100\% in a real-world
   polyvinyl chloride synthesis application. Compared to conventional
   methods, the proposed auto-segmentation method with SFPLS and PLS
   modeling significantly outperforms in the case studies. This method
   improves monitoring accuracy, safety, and economic performance by
   effectively handling the complexities of dynamic batch processes.},
