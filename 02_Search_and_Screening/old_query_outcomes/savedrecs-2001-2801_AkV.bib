}

@article{ WOS:001648557100038,
Author = {Yang, Xiaoteng and Li, Li and Chen, Shuolong and Wang, Binbing and Shu,
   Shuangwei and Pan, Yifeng and Xie, Hong},
Title = {River2: A Tightly Coupled Multiradar Multi-IMU Velocity Estimator Based
   on Continuous-Time Optimization},
Journal = {IEEE TRANSACTIONS ON INSTRUMENTATION AND MEASUREMENT},
Year = {2025},
Volume = {74},
Abstract = {This article presents River2, a tightly coupled multiradar and
   multi-inertial measurement unit (IMU) velocity estimation framework
   based on continuous-time optimization. By utilizing a robust map-free
   estimation approach, River2 introduces two major innovations to enable
   more robust and precise fusion of ego-velocity estimates in multisensor
   systems. The first innovation extends both the initialization state and
   batch estimation procedures to a multisensor framework. This allows for
   the continuous estimation of body-frame velocity by optimizing velocity
   and rotation B-splines, even in the event of a single sensor fault,
   significantly enhancing system robustness and resilience to
   interference. The use of multiple radars expands the field of view
   (FOV), further enhancing the system's robustness. The second innovation
   incorporates flexible outlier removal and zero-velocity update
   strategies into the system, improving its ability to operate
   continuously and accurately in complex environments. Experiments on
   simulations, open-source data, and our own collected datasets
   demonstrate that River2 exhibits high accuracy, robustness, and
   continuity in ego-velocity estimation, validating the effectiveness of
   the algorithm across diverse scenarios. We open-source our
   implementations at (https://github.com/xtyang16/River2) to benefit the
   research community.},
DOI = {10.1109/TIM.2025.3643092},
Article-Number = {8516116},
ISSN = {0018-9456},
EISSN = {1557-9662},
ResearcherID-Numbers = {Yang, Xiaoteng/PMF-8783-2026
