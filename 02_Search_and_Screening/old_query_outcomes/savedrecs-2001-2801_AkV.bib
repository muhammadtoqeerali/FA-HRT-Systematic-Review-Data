Unique-ID = {WOS:001214545400033},
}

@article{ WOS:000836704000001,
Author = {Li, Jitao and Wang, Zhenhua and Shen, Yi and Xie, Lihua},
Title = {Security Synthesis for Cyber-Physical Systems},
Journal = {IEEE TRANSACTIONS ON SYSTEMS MAN CYBERNETICS-SYSTEMS},
Year = {2023},
Volume = {53},
Number = {2},
Pages = {1027-1037},
Month = {FEB},
Abstract = {This article studies the security synthesis of cyber-physical systems
   subject to stealthy attacks via zonotopic set theory. The set is used to
   quantify the effect of potential stealthy attacks on systems. Control
   performance and security level are characterized using L-infinity
   performance index and the radius of the attack-induced state set,
   respectively. Sufficient design conditions are given to optimize the
   security while guaranteeing a prescribed level of control performance.
   Simulation examples are conducted to demonstrate the effectiveness of
   the proposed method.},
