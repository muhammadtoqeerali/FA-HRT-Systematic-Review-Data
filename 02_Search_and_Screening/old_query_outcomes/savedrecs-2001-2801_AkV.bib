ORCID-Numbers = {Abbaszadeh, Masoud/0000-0002-9440-1563
   Siano, Pierluigi/0000-0002-0975-0241
   },
Unique-ID = {WOS:000984596900001},
}

@article{ WOS:000524255900020,
Author = {Lei, Ming and Baehr, Christophe and Jing, Zhongliang},
Title = {Generalized LMMSE Filtering with Out-of-Sequence Observations in
   Arbitrary Constant Delay},
Journal = {CHINESE JOURNAL OF ELECTRONICS},
Year = {2019},
Volume = {28},
Number = {6},
Pages = {1217-1226},
Month = {NOV},
Abstract = {Focusing on the problem of state estimation in the presence of sensor
   faults and Out-of-sequence measurement (OOSM) observations
   synchronously, we derive a formulation of Linear minimum mean squared
   error (LMMSE) filter with the arbitrary time delay of OOSM, the
   generalization of the present work lies in simultaneous treatment of
   correlated faults together with OOSMs that arrive at an arbitrary delay
   in a linear-optimal manner. The approach is demonstrated in a numerical
   comparison.},
DOI = {10.1049/cje.2019.08.005},
ISSN = {1022-4653},
EISSN = {2075-5597},
ORCID-Numbers = {BAEHR, CHRISTOPHE/0000-0002-1230-893X},
