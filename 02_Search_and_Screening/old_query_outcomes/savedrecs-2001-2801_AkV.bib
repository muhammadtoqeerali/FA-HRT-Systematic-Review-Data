   Wang, Ziyun/0000-0002-3058-3054
   Wang, Zhenhua/0000-0003-4923-9381},
Unique-ID = {WOS:001600847000001},
}

@article{ WOS:000623420700055,
Author = {Kamal, Mohasinina and Farajollahi, Mohammad and Nazaripouya, Hamidreza
   and Mohsenian-Rad, Hamed},
Title = {Cyberattacks Against Event-Based Analysis in Micro-PMUs: Attack Models
   and Counter Measures},
Journal = {IEEE TRANSACTIONS ON SMART GRID},
Year = {2021},
Volume = {12},
Number = {2},
Pages = {1577-1588},
Month = {MAR},
Abstract = {The recent advent of distribution-level phasor measurement units
   (D-PMUs), a.k.a., micro-PMUs, has introduced a wide range of new
   applications in power distribution systems. A sub-class of such emerging
   applications are called event-based methods. These methods focus on the
   analysis of events in the stream of micro-PMU measurements to achieve
   situational awareness, enhance load modeling, integrate distributed
   energy resources, etc. In this article, we explore a scenario, where a
   cyberattack compromises the micro-PMU measurements during an event. Such
   a targeted attack could be limited in scope but result in a major impact
   on the operation of the power grid by highly deviating the outcome of
   the event-based methods. First, we investigate and model two types of
   such attacks, event-unsynchronized (basic) attacks and
   event-synchronized (advanced) attacks. We then conduct a geometric
   analysis to understand each attack type, in a setting where the events
   are represented in the phasor domain in a differential mode. Next, we
   introduce a novel method to detect the presence of the attack and then
   identify which micro-PMUs are compromised so as to discard the
   compromised measurements as a defense mechanism. The proposed approach
   makes critical use of magnitude as well as phase angle measurements from
   micro-PMUs. The method is tested on the IEEE 33-bus power distribution
   test system.},
DOI = {10.1109/TSG.2020.3029937},
ISSN = {1949-3053},
EISSN = {1949-3061},
ResearcherID-Numbers = {Nazari Pouya, Hamid/AAO-8067-2020
   Kamal, Mohasinina/U-8504-2019
   },
ORCID-Numbers = {Nazari Pouya, Hamid/0000-0001-6555-9997
   Kamal, Mohasinina/0000-0001-8965-4227
   Farajollahi, Mohammad/0000-0003-2073-4979},
Unique-ID = {WOS:000623420700055},
}

@article{ WOS:001781479800001,
Author = {Han, Jian and Liu, Xiuhua and Zhu, Xiaodan and Wu, Yanming},
Title = {Adaptive dimension adjustable observer design for the nonlinear system
   with unknown Lipschitz constant},
Journal = {EUROPEAN JOURNAL OF CONTROL},
Year = {2026},
Volume = {90},
Month = {JUL},
Abstract = {This paper focuses on the state estimation problem for systems with
   Lipschitz nonlinearity, and the dimension adjustable adaptive observer
   design approach is discussed. The Lipschitz nonlinearity is decomposed
   into two components, and the effects on estimation results are decoupled
   via the design of appropriate observer parameters and compensated
   through the inclusion of an additional adaptive term, respectively.
   Different from the classical state estimation results, the Lipschitz
   constant may be unknown in our method, which helps to reduce the
   conservatism caused by the introduction of the Lipschitz constant in the
   observer gain calculation process. The designed observer enables the
   selection of a suitable dimension within a specific range, thereby
   achieving a trade-off between estimation accuracy and estimation cost
   and gaining more design degrees of freedom. Besides, the obtained result
   is extended to solving the state reconstruction problem with
   disturbance. At the end, examples are provided to show the discussed
   method.},
DOI = {10.1016/j.ejcon.2026.101531},
Article-Number = {101531},
ISSN = {0947-3580},
EISSN = {1435-5671},
Unique-ID = {WOS:001781479800001},
}

@article{ WOS:000657182500007,
Author = {Tokel, Halil Alper and Al Halaseh, Rana and Alirezaei, Gholamreza and
   Mathar, Rudolf},
Title = {A Co-Simulation Framework for Integrated Planning and Analysis of Wide
   Area Measurement and Protection Systems},
Journal = {JOURNAL OF COMMUNICATIONS SOFTWARE AND SYSTEMS},
Year = {2018},
Volume = {14},
Number = {1, SI},
Pages = {40-50},
Month = {MAR},
Abstract = {The recent efforts to extend measurement and communication
   infrastructures in power grids have brought about new potentials for a
   more efficient and optimized grid operation using the data which become
   available. Due to this integration, on the other hand, not only the
   network expansion and planning but also the development of new
   applications must be carried out under consideration of the
   interdependencies between the power grid and the underlying
   communication network. In this work, we present a co-simulation
   environment and tool chain to enable integrated planning and subsequent
   performance analysis of a wide area measurement system. In the first
   part of the paper, we investigate the performance of PMU-based state
   estimation techniques under several power system and communication
   network scenarios. In the second part of the paper, furthermore, the
   presented setup is extended for co-simulative investigations of the
   machine learning-based fault detection and classification techniques in
   power systems. The presented results not only validate the developed
   software solution for similar research studies but also scrutinize the
   impact of communication network performance on power system state
   estimation and PMU-based decision-making for fault detection and
   classification.},
DOI = {10.24138/jcomss.v14i1.444},
ISSN = {1845-6421},
EISSN = {1846-6079},
ResearcherID-Numbers = {Alirezaei, Gholamreza/G-3222-2015},
ORCID-Numbers = {Tokel, Halil Alper/0000-0001-6976-4197
   },
Unique-ID = {WOS:000657182500007},
}

@article{ WOS:001310822800011,
Author = {de Andrade, Gustavo A. and Biazetto, Paulo H. F. and Normey-Rico, Julio
   E.},
Title = {A simplified dynamic model of direct stem generation solar plants for
   state estimation and control applications},
Journal = {IFAC PAPERSONLINE},
Year = {2024},
Volume = {58},
Number = {14},
Pages = {61-66},
Note = {12th IFAC Symposium on Advanced Control of Chemical Processes (ADCHEM),
   Toronto, CANADA, JUL 14-17, 2024},
Organization = {Int Federat Automatic Control (IFAC); Chemical Process Control, TC 6.1;
   TC 2.3. Non-Linear Control Systems; TC 2.4. Optimal Control; TC 5.2.
   Management \& Control Manufacturing \& Logistics; TC 6.2. Mining,
   Mineral \& Metal Processing; TC 6.3. Power \& Energy Systems; TC 6.4.
   Fault Detection, Supervision \& Safety Tech. Processes-SAFEPROCESS; TC
   8.2. Biol \& Med Systems; TC 8.4. Biosystems \& Bioprocesses; Yokogawa;
   Sartorius; McMaster Univ; Toronto Metropolitan Univ; Memorial Univ; Univ
   British Columbia; Queens Univ; Univ Waterloo; Univ Alberta},
Abstract = {In this work, we propose a simplified model for direct steam generation
   parabolic trough collector solar plants consisting of a system coupled
   partial differential equations (PDEs) and ordinary differential
   equations (ODEs). Particularly, the PDEs represent the behavior of the
   two-phase gas-liquid flow in the collector field, which was obtained
   assuming a quasi-equilibrium on the mixture momentum balance of the
   classical transient homogeneous equilibrium model. The gas-liquid
   separator is given by ODEs obtained from the mass and energy balance
   laws. This formulation makes the model attractive for optimization and
   control applications since it is simpler than other approaches in the
   literature. Finally, in view of the obtained simulation results, the
   main uses and applications of the developed model are drawn describing a
   simulation example that proves how the closed-loop operation allows for
   obtaining higher production rates. Copyright (C)2024 The Authors. This
   is an open access article under the CC BY-NC-ND license
   (htips://creativecommons.org/licenses/by-nc-nd/4.0/)},
DOI = {10.1016/j.ifacol.2024.08.314},
EarlyAccessDate = {SEP 2024},
ISSN = {2405-8963},
ResearcherID-Numbers = {Normey-Rico, Julio/Q-7242-2019
   de Andrade, Gustavo/PGU-3482-2026},
Unique-ID = {WOS:001310822800011},
}

@article{ WOS:000781039500003,
Author = {Kayhani, Navid and Zhao, Wenda and McCabe, Brenda and Schoellig, Angela
   P.},
Title = {Tag-based visual-inertial localization of unmanned aerial vehicles in
   indoor construction environments using an on-manifold extended Kalman
   filter},
Journal = {AUTOMATION IN CONSTRUCTION},
Year = {2022},
Volume = {135},
Month = {MAR},
Abstract = {Automated visual data collection using autonomous unmanned aerial
   vehicles (UAVs) can improve the accessibility and accuracy of the
   frequent data required for indoor construction inspections and tracking.
   However, robust localization, as a critical enabler for autonomy, is
   challenging in ever-changing, cluttered, GPS-denied indoor construction
   environments. Rapid alterations and repetitive low-texture areas on
   indoor construction sites jeopardize the reliability of typical
   vision-based solutions. This research proposes a tag-based
   visual-inertial localization method for off-the-shelf UAVs with only a
   camera and an inertial measurement unit (IMU). Given that tag locations
   are known in the BIM, the proposed method estimates the UAV's global
   pose by fusing inertial data and tag measurements using an on-manifold
   extended Kalman filter (EKF). The root-mean-square error (RMSE) achieved
   in our experiments in laboratory and simulation, being as low as 2 - 5
   cm, indicates the potential of deploying the proposed method for
   autonomous navigation of low-cost UAVs in indoor construction
   environments.},
DOI = {10.1016/j.autcon.2021.104112},
EarlyAccessDate = {JAN 2022},
Article-Number = {104112},
ISSN = {0926-5805},
EISSN = {1872-7891},
ResearcherID-Numbers = {Schoellig, Angela/D-2358-2016
   },
ORCID-Numbers = {Schoellig, Angela/0000-0003-4012-4668
   Kayhani, Navid/0000-0001-8139-7254},
Unique-ID = {WOS:000781039500003},
}

@article{ WOS:001738620400001,
Author = {Mumcu, Yelda Karatepe},
Title = {Deployment Readiness of Artificial Neural Networks in Power Systems
   (2020-2024): A Bibliometric and Engineering Assessment Using a
   Domain-Level Evaluation Framework},
Journal = {ENERGIES},
Year = {2026},
Volume = {19},
Number = {7},
Month = {MAR 25},
Abstract = {The rapid integration of renewable generation, distributed energy
   resources, and advanced monitoring infrastructures has increased the
   demand for data-driven methods in modern power systems. Artificial
   neural networks (ANNs) have become widely adopted for load forecasting,
   fault diagnosis, state estimation, stability assessment, and energy
   management. Despite substantial publication growth, large-scale
   operational deployment of ANN-based solutions remains limited. This
   study presents a bibliometric and engineering assessment of ANN
   applications in power systems between 2020 and 2024, based on 1511
   SCI-Expanded journal articles retrieved from the Web of Science. Beyond
   conventional science mapping, the study integrates an
   engineering-oriented deployment-readiness evaluation that systematically
   links ANN architectures with core operational problem classes. The
   results reveal a significant imbalance between reported algorithmic
   performance and operational validation rigor. Forecasting and energy
   management applications demonstrate relatively higher readiness due to
   real-world dataset usage, whereas fault diagnosis and state estimation
   remain predominantly simulation-driven and lack explainability and
   robustness validation. A deployment-readiness matrix is applied to
   quantitatively evaluate dataset realism, interpretability integration,
   and reliability considerations across domains. The findings indicate
   that the primary barriers to ANN integration in power systems stem from
   insufficient validation protocols and resilience-oriented design rather
   than algorithmic limitations, highlighting key engineering priorities
   for reliable real-world implementation.},
DOI = {10.3390/en19071610},
EarlyAccessDate = {MAR 2026},
Article-Number = {1610},
EISSN = {1996-1073},
ResearcherID-Numbers = {Karatepe Mumcu, Yelda/V-7234-2017},
Unique-ID = {WOS:001738620400001},
}

@article{ WOS:001676369600001,
Author = {Zhang, Zhen and Shang, Yunlong and Wang, Yue and Li, Xiangjun},
Title = {Fine-Tuning a 3B-Parameter Large Language Model for Multistate
   Coestimation of Lithium-Ion Batteries Under Random Charging Behaviors},
Journal = {IEEE TRANSACTIONS ON INDUSTRIAL INFORMATICS},
Year = {2026},
Volume = {22},
Number = {5},
Pages = {3985-3996},
Month = {MAY},
Abstract = {Advanced battery management systems necessitate accurate multistate
   coestimation to ensure safe operation under random charging behaviors.
   With the revolutionary advancements in data-driven technologies, this
   pressing issue is expected to be resolved; however, it persists due to
   the gap between smaller models, which only provide isolated estimates,
   and the complex interdependence among battery states. Here, this work
   innovatively explores coestimation empowered by large language models
   (LLMs), achieving excellent accuracy with the same data scale. Over 127
   500 cyclic samples from 419 cells across diverse datasets underpin this
   work. First, to alleviate the challenges posed by random charging
   behaviors in engineering practice, degradation feature extraction for
   state of health estimation is implemented using sliding windows.
   Subsequently, a 3B-parameter LLM is fine-tuned to coestimate state of
   health and state of charge, while a lightweight model is fused to
   generate remaining useful life. The validation results demonstrate that
   the proposed multistate coestimation method performs reliably under
   random charging behaviors, indicating robust estimation performance.
   This work is broadly applicable and scalable, opening unprecedented
   interdisciplinary opportunities for LLMs in battery state estimation and
   intelligent management investigations.},
DOI = {10.1109/TII.2026.3654078},
EarlyAccessDate = {JAN 2026},
ISSN = {1551-3203},
EISSN = {1941-0050},
ResearcherID-Numbers = {Li, Xiangjun/GSI-6786-2022
   Zhang, Zhen/GNP-6256-2022
   Shang, Yunlong/W-2317-2019},
ORCID-Numbers = {Zhang, Zhen/0000-0002-8227-2477
   },
Unique-ID = {WOS:001676369600001},
}

@article{ WOS:001782939700001,
Author = {Lee, Tae H. and Chan, Joseph Chang Lun and Tan, Chee Pin},
Title = {Dynamic event-triggered robust state and fault estimation in descriptor
   systems using two observers in cascade},
Journal = {APPLIED MATHEMATICS AND COMPUTATION},
Year = {2026},
Volume = {530},
Month = {DEC 1},
Abstract = {The problem of observer design using a dynamic event-triggered signals
   is studied for estimating the states and faults simultaneously of
   descriptor systems with disturbances. The system is first transformed
   into a structure that is convenient to analyse. A DETM is implemented to
   reduce the number of transmissions from the system to the observers. The
   first observer is designed to produce an initial estimate of the states.
   Signals from this observer are then fed into a sliding mode observer,
   which estimates the fault as well as the estimation error of the first
   observer. The estimated errors are used to improve the state estimates
   from the first observer. Linear matrix inequalities are used to design
   both observers such that the L2 gain from the disturbances to the state
   and fault estimation errors are minimised. Finally, a simulation example
   is utilised to showcase the performance of the proposed scheme.},
DOI = {10.1016/j.amc.2026.130159},
EarlyAccessDate = {MAY 2026},
Article-Number = {130159},
ISSN = {0096-3003},
EISSN = {1873-5649},
ResearcherID-Numbers = {Tan, Chee/E-5851-2012
   Chan, Joseph/AAB-6670-2019
   Lee, TaeHee/I-3043-2019},
