   Quevedo, Daniel E/0000-0002-4804-5481
   Nagahara, Masaaki/0000-0002-8992-2495},
Unique-ID = {WOS:000379685200001},
}

@article{ WOS:000672103600006,
Author = {Dutta, Soham and Olla, Sachin and Sadhu, Pradip Kumar},
Title = {A secured, reliable and accurate unplanned island detection method in a
   renewable energy based microgrid},
Journal = {ENGINEERING SCIENCE AND TECHNOLOGY-AN INTERNATIONAL JOURNAL-JESTECH},
Year = {2021},
Volume = {24},
Number = {5},
Pages = {1102-1115},
Month = {OCT},
Abstract = {The paper proposes an unplanned island detection method in a microgrid
   with micro phasor measurement unit (lPMU). The lPMU extracts certain
   features, by using multi domain nature of discrete fractional Fourier
   transform, from measured voltage data and feeds it to a random forest
   classifier model to make decision of island or fault occurrence. The
   method was tested on an IEEE 34 node distribution network. The results
   show that the method is robust, reliable, cost effective and increases
   situational awareness. The proposed method has 99.8\% accuracy, 99.89\%
   security, 98.11\% reliability, zero non detection zone and detection
   time of 49 ms. (C) 2021 Karabuk University. Publishing services by
   Elsevier B.V.},
DOI = {10.1016/j.jestch.2021.01.015},
EarlyAccessDate = {JUL 2021},
