@article{ WOS:001167527900001,
Author = {Piao, Xianglin and Lin, Chong and Chen, Bing},
Title = {Estimation for T-S Fuzzy CPSs With State Delay via Reduced-Order
   Observer},
Journal = {IEEE TRANSACTIONS ON CIRCUITS AND SYSTEMS II-EXPRESS BRIEFS},
Year = {2024},
Volume = {71},
Number = {2},
Pages = {772-776},
Month = {FEB},
Abstract = {This brief investigates the attack estimation and state reconstruction
   problem for T-S fuzzy cyber-physical systems with state delay. By
   augmenting the original state and sensor attacks into a new form, a
   reduced-order observer is designed to realize the reconstruction of this
   new state. By adopting the double integral term into the
   Lyapunov-Krasovskii functional and the delay-dependent results are
   obtained for the observer design. The method in this brief can
   accurately estimate the state and sensor attacks simultaneously without
   additional algorithms. Compared with the previous method, the time delay
   information is fully utilized and the conservation is greatly reduced.
   Finally, the correctness of the results is verified by simulation.},
DOI = {10.1109/TCSII.2023.3311786},
