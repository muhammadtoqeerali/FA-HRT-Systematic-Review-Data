@article{ WOS:000708316800003,
Author = {Feng, Yi-Fu and Wang, Jing},
Title = {NOVEL STABILITY CRITERIA FOR NONLINEAR STOCHASTIC HOPFIELD NEURAL
   NETWORKS WITH TIME-VARYING DELAYS},
Journal = {PACIFIC JOURNAL OF OPTIMIZATION},
Year = {2020},
Volume = {16},
Number = {2},
Pages = {213-224},
Abstract = {This paper investigates the stability analysis of nonlinear stochastic
   Hopfield neural networks (NSHNNs) with time-varying delays which are
   described by a Takagi-Sugeno (T-S) fuzzy model. By using an improved
   homogeneous matrix polynomials technique, novel convergent stability
   criteria are proposed. More importantly, as the selected design
   parameter becomes larger, less conservative stability criteria will be
   obtained since more algebraic property of the fuzzy weighting functions
   in the unit simplex can be utilized to deal with stability analysis.
   Finally, an illustrative example is provided to show the efficiency of
   the proposed approach.},
ISSN = {1348-9151},
Unique-ID = {WOS:000708316800003},
}

@article{ WOS:000465056800003,
Author = {Guo, Shenghui and Jiang, Bin and Zhu, Fanglai and Wang, Zhenhua},
Title = {Luenberger-like interval observer design for discrete-time descriptor
   linear system},
Journal = {SYSTEMS \& CONTROL LETTERS},
Year = {2019},
Volume = {126},
Pages = {21-27},
Month = {APR},
Abstract = {In this paper, the problem of Luenberger-like interval observer design
   for discrete-time descriptor linear system is investigated. In the first
   place, two ways in which the original descriptor system is transformed
   into general systems are given and the detectability of the equivalent
   general systems is discussed in detail. A new equivalent general system
   construction is developed and we prove that the detectability can be
   kept under this new equivalent transformation. After this, based on the
   new equivalent general system, a Luenberger-like interval observer is
   proposed. Finally, two simulation examples are given to demonstrate the
   correctness and the effectiveness of the proposed interval observer. (C)
   2019 Elsevier B.V. All rights reserved.},
DOI = {10.1016/j.sysconle.2019.02.005},
