@article{ WOS:000835158100010,
Author = {Huang, Jun and Che, Haochi and Trinh, Hieu and Zhao, Xudong and Zhang,
   Yueyuan},
Title = {Functional interval estimation method for discrete-time switched systems
   under asynchronous switching},
Journal = {JOURNAL OF THE FRANKLIN INSTITUTE},
Year = {2022},
Volume = {359},
Number = {11},
Pages = {5712-5732},
Month = {JUL},
Abstract = {This paper considers the issue of functional interval estimation in
   asynchronously discrete-time switched systems. Based on the H infinity
   formalism, a functional observer is first proposed and a weighted
   attenuation performance is achieved. Then, reachability analysis is used
   to estimate its boundaries. Moreover, by comparing with the
   zonotope-based method, it is found that the proposed method can
   effectively reduce the conservatism caused by the reduction-order
   operation in zonotope-based method. Both methods are applied to a
   circuit system for the comparison purpose and to highlight the
   effectiveness of our results. (c) 2022 The Franklin Institute. Published
   by Elsevier Ltd. All rights reserved.},
