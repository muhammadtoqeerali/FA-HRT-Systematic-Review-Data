   Manias, Dimitris M/0000-0002-4788-9877
   Svetinovic, Davor/0000-0002-3020-9556
   El-Saadany, Ehab Fahmy/0000-0003-0172-0686
   },
Unique-ID = {WOS:001349744900001},
}

@inproceedings{ WOS:001027160301150,
Author = {Maravilla-Castro, Merlin Octavio and Davila, Jorge},
