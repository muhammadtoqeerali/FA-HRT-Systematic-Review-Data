	doi = {10.1109/ICECA66444.2025.11382751},
	url = {https://www.scopus.com/pages/publications/105034892726?origin=resultslist},
	abstract = {Prolonged sitting disrupts venous blood circulation in the lower limbs, leading to chronic venous insufficiency (CVI), varicose veins, and deep vein thrombosis. Existing solutions such as compression stockings, pneumatic pumps, and bulky rehabilitation robots provide only partial relief, lacking portability and adaptability for daily use. To address this gap, we present VENOUS+, a compact robotic healthcare device designed to passively train the ankle and stimulate the calf muscle pump. Unlike traditional systems, VENOUS+ integrates an adaptive foot-mapping mechanism that adjusts ankle motion according to user posture, ensuring comfort and safety. Additional features include accelerometer- gyroscope-based fall detection, emergency stop control, and a thermal management system for extended operation. Beyond therapy, the device enables AI/ML-assisted health monitoring with real-time data logging. Experimental results show that VENOUS+ improves venous blood flow velocity and ankle range of motion by more than 70% compared with sedentary conditions, achieving nearly three-fourths of active exercise effectiveness. These outcomes highlight VENOUS+ as a practical bridge between costly rehabilitation machines and simple wellness tools, promoting sustainable venous care in sedentary lifestyles. © 2025 IEEE.},
	author_keywords = {adaptive foot mapping; human-robot interaction; passive ankle exercise; Robotic health; smart health monitoring; venous insufficiency},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
