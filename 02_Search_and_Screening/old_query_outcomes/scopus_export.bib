@ARTICLE{Bayón2022,
	author = {Bayón, Cristina and Keemink, Arvid Q. L. and van Mierlo, Michelle and Rampeltshammer, Wolfgang and van der Kooij, Herman and van Asseldonk, Edwin H. F.},
	title = {Cooperative ankle-exoskeleton control can reduce effort to recover balance after unexpected disturbances during walking},
	year = {2022},
	journal = {Journal of NeuroEngineering and Rehabilitation},
	volume = {19},
	number = {1},
