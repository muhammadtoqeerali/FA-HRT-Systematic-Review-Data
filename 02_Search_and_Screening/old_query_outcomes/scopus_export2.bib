@ARTICLE{Hu2025,
	author = {Hu, Ying and Zhang, Zijing and Zhang, Fei and Menon, Varun G.},
	title = {A Collaborative SLAM Method Based on Cardinality Balanced Multi-Bernoulli Filter with Adaptive Information Control},
	year = {2025},
	journal = {Measurement: Journal of the International Measurement Confederation},
	volume = {253},
	pages = {},
	doi = {10.1016/j.measurement.2025.117531},
	url = {https://www.scopus.com/pages/publications/105002220000?origin=resultslist},
	abstract = {In large-scale dynamic GPS-denied environments, traditional collaborative SLAM (CSLAM) methods encounter issues of poor information fusion and complex data association due to the presence of numerous dynamic objects and poor communication conditions, which further lead to low SLAM accuracy. While SLAM methods based on Random Finite Sets (RFS) can address complex data association problems, they suffer from low localization accuracy and poor real-time performance in dynamic GPS-denied environments with low signal-to-noise ratios and high false alarm rates. Therefore, a collaborative SLAM method based on the Cardinality Balanced Multi-Bernoulli filter (CBMber) with adaptive information control is proposed in this paper. Firstly, a method for constructing Virtual Observation Constraints (VOC) is proposed to enhance the stability of multi-robot systems. Secondly, an Adaptive Information Control (AIC) method is introduced to enrich prior information while preventing excessive information redundancy, reducing the impact of accumulated errors, and improving the localization accuracy of multi-robot systems. Subsequently, an Enhanced Framework for Rapid Data Interaction (EF-RDID) is proposed to ensure timely transmission, reception, and processing of data used to construct virtual observation constraints, thereby guaranteeing the real-time performance of CSLAM. Finally, the proposed method is compared with traditional RFS-based multi-robot SLAM methods on a stable mobile robotic platform. Experimental results demonstrate that the proposed method significantly improves the localization accuracy of robots in traditional RFS-based multi-robot SLAM systems. © 2025},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@ARTICLE{Mulubika2025720,
	author = {Mulubika, Chibaye and Schreve, Kristiaan},
	title = {An approach towards mobile robot recovery due to vision sensor failure in vSLAM systems using ROS},
	year = {2025},
	journal = {Robotica},
	volume = {43},
	number = {2},
	pages = {720 - 742},
	doi = {10.1017/S0263574724002145},
	url = {https://www.scopus.com/pages/publications/85214944062?origin=resultslist},
	abstract = {This paper proposes a mobile robot recovery mechanism for low-cost robotic systems due to vision sensor failure in vSLAM systems. The approach takes advantage of ROS architecture and adopts the Shannon Nyquist sampling theory to selectively sample path parameters that will be used for back travel in case of vision sensor failure. As opposed to point clouds normally used to store vSLAM data, this paper proposes to store and use lightweight variables namely distance between sampled points, velocity combinations, i.e., linear and angular velocity, sampled period, and yaw angle values to describe the robot path and reduce the memory space required to store these variables. In this study, low-cost robotic systems typically using cameras aided by proprioceptive sensors such as IMU during vSLAM activities are investigated. A demonstration is made on how the ROS architecture can be used in a scenario where vision sensing is adversely affected, resulting in mapping failure. Additionally, a recommendation is made for adoption of the approach for vSLAM platforms implemented on both ROS1 and ROS2. Furthermore, a proposal is made to add an additional layer to vSLAM systems that will be exclusively used for back travel in case of vision loss during vSLAM activities resulting in mapping failure.  © The Author(s), 2025. Published by Cambridge University Press.},
	type = {Article},
