@ARTICLE{Deilamsalehy201850,
	author = {Deilamsalehy, Hanieh and Havens, Timothy C.},
	title = {Fuzzy adaptive extended Kalman filter for robot 3D pose estimation},
	year = {2018},
	journal = {International Journal of Intelligent Unmanned Systems},
	volume = {6},
