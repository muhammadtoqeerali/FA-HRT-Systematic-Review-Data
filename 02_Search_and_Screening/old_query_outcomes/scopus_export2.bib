	source = {Scopus},
	note = {Cited by: 8; All Open Access; Gold Open Access}
}

@CONFERENCE{Biresaw2024,
	author = {Biresaw, Tewodros and Stefanescu, Elena Ramona},
	title = {Visual Navigation: Simultaneous Localization and Mapping on Aerial Vehicles},
	year = {2024},
	journal = {AIAA/IEEE Digital Avionics Systems Conference - Proceedings},
	pages = {},
	doi = {10.1109/DASC62030.2024.10749120},
	url = {https://www.scopus.com/pages/publications/85211245072?origin=resultslist},
	abstract = {Navigation plays a critical role in enabling the autonomy of aerial vehicles. Traditionally, aerial systems rely on Global Navigation Satellite Systems (GNSS) and inertial measurement units (IMUs) for navigation. Recent research ad-vancements in Simultaneous Localization and Mapping (SLAM) techniques have encouraged their integration into unmanned aerial systems. By combining these techniques with traditional navigation methods, we enhance safety and accuracy during operations. Cameras offer several advantages, including cost-effectiveness, low-power consumption and minimal physical space requirements, while providing rich navigation information. In this paper, we are introducing and testing some of the most common Visual SLAM and provide an insight on how these algorithms perform without any significant modification on aerial datasets. Relevant data, from camera, IMU and GNSS, have been collected using a fixed wing aircraft and drone flying over rural and urban areas at desirable altitudes. The algorithms' output is compared with GNSS measurements, and their performance is analyzed. Additionally, we examine key components of SLAM, such as loop closure, based on our aerial data. © 2024 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Gao202516334,
	author = {Gao, Hejia and Yang, Yang and Liu, Jiangxu and Sun, Changyin},
	title = {Reinforcement Learning-Based Admittance Control for Physical Human–Robot Interaction With Output Constraints},
	year = {2025},
	journal = {IEEE Transactions on Automation Science and Engineering},
	volume = {22},
	pages = {16334 - 16345},
	doi = {10.1109/TASE.2025.3576586},
	url = {https://www.scopus.com/pages/publications/105007289097?origin=resultslist},
	abstract = {Focused on the scientific issues of collision avoidance and compliant operation of physical human-robot interaction (pHRI) systems, this paper proposes a reinforcement learning (RL) strategy based on admittance control to achieve compliant collision avoidance and accurate trajectory tracking of pHRI. Firstly, a differentiable reference trajectory is generated using a soft saturation function with an admittance model. Subsequently, a reinforcement learning strategy based on an actor-critic structure is implemented to address dynamic uncertainty and enhance tracking performance and compliance. Different from existing studies, a reinforcement learning admittance controller containing an integral barrier Lyapunov function (IBLF) is constructed to attain accurate tracking while ensuring that the end-effector achieves the position constraints. Lyapunov stability theory is employed to proof that all states of the closed-loop system remain semiglobally uniformly ultimately bounded (SGUUB). Finally, a suite of tests on Baxter robot experimental platform have been conducted to validate the superiority of the proposed algorithm compared with adaptive impedance control and conventional admittance control. Note to Practitioners—This paper is motivated by solving the safety problem of interaction between collaborative robots and operators, the proposed method is applicable to service industries and industrial sectors such as medical rehabilitation and collaborative assembly. In current human-robot interaction methods, robots typically operate without positional constraints. This absence of restrictions can lead to potential collisions with obstacles or other participants during collaborative tasks between humans and intelligent robots, raising significant safety concerns. This paper presents a novel control method for human-robot interaction. Firstly, admittance control is employed as a foundational approach to enhance the flexibility of human-robot interactions. Subsequently, a RL strategy is implemented to model the uncertainties in the robotic system and to improve tracking performance during interactions. Lastly, a differentiable soft saturation function is utilized for trajectory shaping, and the output of the physical human-robot interaction (pHRI) system is constrained through the integral barrier Lyapunov function (IBLF) to prevent collisions by regulating the robot’s position. Preliminary experiments on the human-robot interaction platform demonstrate that the proposed method is viable, and the controller has application value in many fields. The proposed controller can be applied in industrial robot assembly tasks to ensure that the industrial robot operates within the designated task area. In certain industrial applications, end-effectors of robots are equipped with hazardous or delicate tools. When the end-effector surpasses the defined task area, it may pose a potential risk of injury to both the human operator and the robotic system. Controller can also be utilized in rehabilitation robots to prevent harm to patients by restricting their movements. In some rehabilitation tasks, the controller parameters could be adjusted in accordance with the patient’s feedback to adapt the autonomy of the rehabilitation task. In future research, we will design control for more complex human-robot interactions, such as human-robot collaborative handling and exoskeleton robots. © 2004-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 22}
}

@ARTICLE{Fishberg202410612,
	author = {Fishberg, Andrew and Quiter, Brian J. and How, Jonathan P.},
	title = {MURP: Multi-Agent Ultra-Wideband Relative Pose Estimation With Constrained Communications in 3D Environments},
	year = {2024},
	journal = {IEEE Robotics and Automation Letters},
	volume = {9},
	number = {11},
	pages = {10612 - 10619},
	doi = {10.1109/LRA.2024.3451393},
	url = {https://www.scopus.com/pages/publications/85202758395?origin=resultslist},
	abstract = {Inter-agent relative localization is critical for many multi-robot systems operating in the absence of external positioning infrastructure or prior environmental knowledge. We propose a novel inter-agent relative 3D pose estimation system where each participating agent is equipped with several ultra-wideband (UWB) ranging tags. Prior work typically supplements noisy UWB range measurements with additional continuously transmitted data (e.g., odometry) leading to potential scaling issues with increased team size and/or decreased communication network capability. By equipping each agent with multiple UWB antennas, our approach addresses these concerns by using only locally collected UWB range measurements, a priori state constraints, and event-based detections of when said constraints are violated. The addition of our learned mean ranging bias correction improves our approach by an additional 19% positional error, and gives us an overall experimental mean absolute position and heading errors of 0.24 m and 9.5° respectively. When compared to other state-of-the-art approaches, our work demonstrates improved performance over similar systems, while remaining competitive with methods that have significantly higher communication costs.  © 2024 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 13; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

@CONFERENCE{Deng2025417,
	author = {Deng, Chao and Ren, Yuan and Xu, Xiang and Liu, Gao and Ma, Tao and Fan, Ziyuan},
	title = {EDMD-based multi-sensor data fusion for longitudinal girder displacement of suspension bridges},
	year = {2025},
	journal = {IABSE Congress Ghent 2025: The Essence of Structural Engineering for Society, Proceedings},
	pages = {417 - 424},
	doi = {10.2749/ghent.2025.0417},
	url = {https://www.scopus.com/pages/publications/105021081496?origin=resultslist},
	abstract = {Bridge girder longitudinal displacement monitoring is crucial for assessing structural health and detecting anomalies in bridge constraint devices. However, inconsistencies in heterogeneous sensor data, including noises, varying resolutions and data loss, pose challenges for data analysis and data fusion. This study proposes an extended dynamic mode decomposition (EDMD)-based multi-sensor fusion method, leveraging the Koopman operator to model nonlinear sensor relationships in a higher-dimensional space. By using laser displacement sensor data to predict push rod sensor measurements, the approach enhances long-term monitoring accuracy. Using displacement data from two sensors on a suspension bridge as an example, the method effectively captures displacement details and enhances prediction reliability. The findings highlight the effectiveness and potential of EDMD method for bridge structural health assessment. © 2025 IABSE Congress Ghent 2025: The Essence of Structural Engineering for Society, Proceedings. All rights reserved.},
