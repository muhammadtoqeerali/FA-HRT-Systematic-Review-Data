@ARTICLE{Luo2026,
	author = {Luo, Yujia and Hu, Qingsong and Cheng, Yuanxun and Lou, Zhibo and Li, Shiyin and Ye, Jun and Zhang, Yuansheng},
	title = {Vision-Enhanced UWB Localization with Link-Visibility Priors in Underground Mines},
	year = {2026},
	journal = {IEEE Transactions on Vehicular Technology},
	pages = {},
	doi = {10.1109/TVT.2026.3723730},
	url = {https://www.scopus.com/pages/publications/105049651695?origin=resultslist},
	abstract = {Accurate localization of autonomous vehicles (AVs) in underground mines is a critical prerequisite for safe operations. While ultra-wideband (UWB) technology is widely adopted, its ranging reliability is highly vulnerable to non-line-of-sight (NLOS) propagation, multipath biases, and constrained anchor geometry in narrow tunnels. To address these challenges, we propose a visibility-aware UWB-vision fusion framework. Unlike traditional visual odometry, onboard stereo vision is uniquely employed not for direct pose estimation, but for inferring the reliability of individual UWB links. Specifically, UWB measurements define depth-feasible regions that guide region-of-interest (ROI) enhancement and anchor observation under low illumination. The resulting detection confidence and depth consistency are then converted into link-visibility priors. These priors are embedded into a robust UWB back end-featuring a mixed Gaussian-half-Laplace residual model and a soft-weighted Levenberg-Marquardt solver-to adaptively suppress unreliable NLOS measurements. Field experiments in a 150-m underground mine tunnel show that the proposed method achieves a Root Mean Square Error (RMSE) of 0.24 m and a Mean Absolute Error (MAE) of 0.18 m. Compared to a recent cross-modal UWB-VO fusion baseline, the overall RMSE is significantly reduced by 53.8%, with reductions reaching 56.8% and 57.0% in two severely NLOS-degraded segments. These results demonstrate that vision-derived link-visibility priors provide a highly effective mechanism for robust UWB localization in visually degraded underground environments. © 1967-2012 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Khemiri2026726,
	author = {Khemiri, Karim and Ferhi, Mokhtar and Hidouri, Noureddine and Ennetta, Ridha and Djebali, Ridha},
	title = {Robust State and Fault Estimation in Mobile Robots under Dynamic Noise Environments using Hybrid LSTM-EKF with Adaptive Weighting},
	year = {2026},
	journal = {Journal of Applied and Computational Mechanics},
	volume = {12},
	number = {2},
	pages = {726 - 738},
	doi = {10.22055/jacm.2025.48393.5203},
	url = {https://www.scopus.com/pages/publications/105041036362?origin=resultslist},
	abstract = {This paper proposes an adaptive hybrid estimation framework combining a Long Short-Term Memory (LSTM) network and an Extended Kalman Filter (EKF) for simultaneous robot state estimation and actuator fault detection in mobile robots operating under uncertain conditions. The LSTM network learns temporal patterns and nonlinear relationships from sensor data, while the EKF provides model-based filtering with uncertainty quantification. A novel adaptive fusion mechanism dynamically balances these complementary approaches using a weighting factor derived from the estimation uncertainties of both components. The proposed method was extensively evaluated on a differential-drive robot model subject to various noise conditions and fault profiles, including progressive drift faults and abrupt jump faults. Simulation results demonstrate that our hybrid approach significantly outperforms standalone EKF and LSTM estimators, achieving up to 74.6% improvement in fault estimation accuracy and 34.5% reduction in position error under challenging high-noise conditions. The framework maintains consistent performance across diverse fault types, showing particular effectiveness in detecting gradual fault progression while remaining responsive to sudden fault events. These findings confirm that the adaptive LSTM-EKF fusion provides enhanced accuracy, robustness, and generalization capability compared to conventional approaches. © 2025 Shahid Chamran University of Ahvaz, Ahvaz, Iran. This article is an open access article distributed under the terms and conditions of the Creative Commons Attribution-NonCommercial 4.0 International (CC BY-NC 4.0 license) (http://creativecommons.org/licenses/by-nc/4.0/).},
