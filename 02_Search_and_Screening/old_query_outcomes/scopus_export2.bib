@ARTICLE{Moon2026,
	author = {Moon, Sunghyun and Kim, Yeongmin and Lee, Kibeom},
	title = {Hierarchical Multi-Sensor Fusion Algorithm for Precision Localization in Four-Wheel Steering Autonomous Platforms},
	year = {2026},
	journal = {International Journal of Automotive Technology},
	pages = {},
	doi = {10.1007/s12239-025-00392-9},
	url = {https://www.scopus.com/pages/publications/105026724812?origin=resultslist},
	abstract = {Precise localization is essential for accurately recognizing the current driving status of an autonomous vehicle and ensuring the safety of autonomous driving systems. Traditionally, global positioning system (GPS) based localization technologies have been widely used; however, in environments where GPS accuracy is compromised by external factors, fusion with other sensors such as inertial measurement unit (IMU) and odometry has been performed. Nevertheless, as mobility platforms evolve, vehicle behavior becomes increasingly complex, necessitating high-performance position estimation algorithms that account for both sensor and driving characteristics. However, the unique dynamics of four-wheel steering (4WS) vehicles, such as lateral movement without significant yaw-rate changes, pose challenges for conventional fusion algorithms in distinguishing intentional maneuvers from vehicle slip. To address this specific problem, this study proposes a hierarchical position estimation algorithm that decouples slip-aware velocity estimation from precise position tracking to resolve this ambiguity. The low-level module employs odometry and IMU data with filtering techniques to estimate velocity while accounting for factors such as vehicle and tire slippage. The high-level module then performs precise position estimation using the velocity estimated by the low-level module and GPS position data. The algorithm is validated using a platform equipped with a four-wheel steering system capable of both in-phase and out-of-phase steering, depending on the driving mode. The results reveal that the proposed hierarchical structure, with modules tailored to specific sensor characteristics and driving scenarios, offers improved robustness and better position estimation performance across a variety of conditions. © The Author(s), under exclusive licence to The Korean Society of Automotive Engineers 2026.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Song2026,
	author = {Song, Dongzhao and Chen, Mingsong and Zhang, Chizhou and Fu, Haotian and Lin, Yongcheng and Li, Zehao and Ma, Aoqiang and Liu, Jiajie},
	title = {RVPF-YOLO: A robust visual person-following framework for mobile robots based on enhanced YOLO model},
	year = {2026},
	journal = {Displays},
	volume = {94},
	pages = {},
	doi = {10.1016/j.displa.2026.103534},
	url = {https://www.scopus.com/pages/publications/105038739456?origin=resultslist},
	abstract = {The following technology of mobile robots holds a significant application value in fields such as smart homes, logistics warehousing, and medical assistance, effectively enhancing work efficiency. Vision-based following methods are suitable for these scenarios. However, they face the challenge of achieving robust following in complex environments. To address this challenge, this paper proposes a robust visual person-following framework for mobile robots based on enhanced YOLO model. First, a novel person object detector is proposed to increase the efficiency of pedestrian target detection. It leverages the lightweight design of MNv4 and the attention mechanism of CBAM. This helps reduce the missed detection rate and improve detection effectiveness. Then, an improved DWA path planner is proposed. It incorporates a path-following sub-function and uses dynamic parameter adjustment. These enhancements improve the following quality and enable dynamic obstacle avoidance. Based on this, the proposed feedback‑based following control model founded on bounding‑box‑centroid theory is fused with the path planer to meet the robot’s motion control, following and obstacle avoidance requirements. The proposed method is analyzed and validated in both simulation and real-world scenarios, demonstrating superior following performance (16.67% in person-following trajectory length, 15.79% in person-following time) than the state-of-the-art method in an indoor environment. It also demonstrates that our method enhances the efficiency and robustness of person-following tasks, which is of significant importance for its future application in elderly care and medical assistance. © 2026 Elsevier B.V. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Wu2026,
	author = {Wu, Kang and He, Zhicheng and Chen, Tao and Fu, Guang and Long, Chunlin and Li, Eric},
	title = {Robust-VIO: A robust visual-inertial odometry for complex scenarios based on weighted deep learning features},
	year = {2026},
	journal = {Proceedings of the Institution of Mechanical Engineers, Part D: Journal of Automobile Engineering},
	pages = {},
	doi = {10.1177/09544070261447389},
	url = {https://www.scopus.com/pages/publications/105038250616?origin=resultslist},
	abstract = {Autonomous vehicles require precise localization across all environments. Complex lighting conditions and dynamic environments pose significant challenges to the accuracy and robustness of visual-inertial odometry systems. In response to these challenges, this paper proposed a robust visual-inertial odometry system named Robust-VIO, which utilizes weighted deep learning features. This novel algorithm combines a learning-based front-end with a tightly-coupled optimization back-end, achieving robust, accurate, and real-time localization in challenging scenarios. Initially, the SuperPoint deep learning network extracts reliable features under various lighting conditions. These features are then efficiently tracked by integrating them with sparse optical flow. To address highly dynamic environments, scene flow detection with IMU pre-integration is used to identify and weigh dynamic features. Subsequently, a tightly-coupled optimization approach is employed to jointly optimize the weights of features and the pose, effectively minimizing the influence of dynamic features and providing precise pose estimates. The performance of the proposed algorithm has been assessed using two publicly available benchmark datasets. The experimental results show that Robust-VIO surpasses other leading visual-inertial odometry systems in accuracy and robustness in complex scenarios, while also fulfilling real-time computational demands, confirming its practical applicability. © IMechE 2026},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Koshekov2026,
	author = {Koshekov, Kayrat and Mambetalin, Doszhan and Kuanov, Yerkanat and Koshekov, Abay},
	title = {Probabilistic Risk Assessment Model for the Navigation of Autonomous Mobile Robotic Systems Around an Aircraft},
	year = {2026},
	journal = {Eng},
	volume = {7},
	number = {6},
	pages = {},
	doi = {10.3390/eng7060284},
	url = {https://www.scopus.com/pages/publications/105042900257?origin=resultslist},
	abstract = {The introduction of autonomous mobile robotic systems into ground handling operations at airports has been limited by aviation safety requirements and the high costs associated with a robot colliding with an aircraft. To ensure safety, traditional robotic navigation methods use static buffer zones, which limit the functionality of robotic systems working near the aircraft fuselage. A probabilistic risk assessment model was developed in this study to simulate close-in operation of heterogeneous mobile robotic systems around an aircraft. The proposed model employs a hybrid framework that integrates an extended Kalman filter, Monte Carlo simulations, and a Bayesian network to consider the kinematic uncertainty of a robot, random environmental conditions, and sensor data for real-time evaluation of collision probabilities. The modeling of near-aircraft inspection scenarios conducted in MATLAB demonstrated the feasibility of the proposed approach: the system successfully completed 49 out of 50 simulated missions while testing landing gear inspection scenarios. In addition, the modeling reduced the minimum distance to the inspection object to 0.48 m, compared with a baseline safe distance of 2 m. These results are interpreted as a simulation-based verification of the feasibility of the proposed approach rather than as an operational validation. Experiments, including hardware modeling, data from real sensors, and controlled tests on the airport apron, are required before implementing the approach in real-world conditions. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@ARTICLE{Imran20261,
	author = {Imran, Ali and Varadharajan, Vivek Shankar and Gomes Braga, Rafael and Beltrame, Giovanni and St-Onge, David},
	title = {Swarm robotics localization: comparing methods from infrared to foundation models},
	year = {2026},
	journal = {Swarm Intelligence},
	volume = {20},
	number = {1},
	pages = {1 - 23},
	doi = {10.1007/s11721-025-00256-z},
	url = {https://www.scopus.com/pages/publications/105029037558?origin=resultslist},
	abstract = {Efficient collaboration within a robot swarm relies on precise relative localization among swarm members. However, in real-world scenarios such as GNSS-denied indoor environments, achieving accurate localization becomes challenging due to the absence of a global reference frame. This study evaluates the relative localization accuracy and operational feasibility of four systems: infrared-based (IR), visual-inertial odometry (VIO), ultra-wideband (UWB), and a decentralized spatial foundation model. We conduct low-fidelity simulations using simplified sensor models with large number of robots and high-fidelity simulations with realistic sensor observations to assess each system’s capability in supporting collective swarm behaviors. The systems are further validated through real-world experiments involving two swarms: one composed of five aerial robots and the other of five ground robots, performing three distinct collaborative behaviors. The results provide a comparative analysis of the systems, highlighting their estimation accuracy, communication overheads, and their impact on behavior performance. © The Author(s), under exclusive licence to Springer Science+Business Media, LLC, part of Springer Nature 2025.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Kumar202625332,
	author = {Kumar, Kethavath Raj and Sahoo, Shubhashisa and Ravi, V.C. and Jamal, Arshad},
	title = {Fault-Tolerant Multisensor Fusion for Autonomous Ground Vehicle Localization Under GNSS and Vision Denial},
	year = {2026},
	journal = {IEEE Sensors Journal},
	volume = {26},
	number = {16},
	pages = {25332 - 25341},
	doi = {10.1109/JSEN.2026.3711917},
	url = {https://www.scopus.com/pages/publications/105045275261?origin=resultslist},
	abstract = {Autonomous ground vehicle localization degrades during global navigation satellite system (GNSS) outages, visual-odometry (VO) failures, and gyroscope drift during prolonged stops. Existing frameworks handle these with discrete mode switching or filter reinitialization, causing state discontinuities and delayed recovery. This article proposes a fault-tolerant extended Kalman filter (EKF)-based fusion framework that combines motor revolutions per minute (RPM), stereo VO, inertial measurements, and dual-antenna GNSS within a unified adaptive-covariance architecture, without mode switching or reinitialization. An adaptive measurement-covariance model continuously modulates sensor confidence from motion state, visual-tracking quality, VO-RPM, and inertial measurement unit (IMU)-RPM consistency, and recovery state; a covariance-gated cross-check preserves forward-speed observability on encoder-free platforms, and sentinel inflation enables seamless recovery from GNSS and VO outages. A zero-velocity update (ZUPT) and constant-heading constraint, triggered by RPM-based stationary detection, suppress stationary drift. On in-house Tomcar datasets and KITTI sequence 07, the framework attains a 2-D RMSE of 0.42 m over the GNSS denial window (relative translational error below 8% of distance traveled) and 1.31 m under simultaneous GNSS and VO denial, and bounds heading drift below 0.05° and position drift below 0.01 m over a 56.4-min stationary multipath test, demonstrating continuous fault-tolerant localization without reinitialization.  © 2001-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Buonomo2026,
	author = {Buonomo, Fabio Valerio and Andolfo, Simone and Genova, Antonio},
	title = {Principled Uncertainty Propagation for Stereo Visual Odometry},
	year = {2026},
	journal = {Journal of Intelligent and Robotic Systems: Theory and Applications},
	volume = {112},
	number = {2},
	pages = {},
	doi = {10.1007/s10846-026-02358-0},
	url = {https://www.scopus.com/pages/publications/105039447699?origin=resultslist},
	abstract = {Stereo Visual odometry (VO) is a well-established technique for estimating the egomotion of a stereo camera by tracking salient features across consecutive stereo pairs. VO is often combined with complementary sensor data to improve trajectory estimation, yet most sensor-fusion approaches rely on heuristics or empirical parameter tuning to jointly process heterogeneous measurements. Motivated by the need for a statistically rigorous treatment of uncertainty in stereo VO, this work presents a 3D–3D stereo VO framework on the Special Euclidean group SE(3) formulated under the Maximum Likelihood principle. The proposed method explicitly models the physical characteristics of the optical sensor and the image formation process to enable a principled propagation of measurement uncertainty from pixel scale to motion parameters. The objective is to quantitatively assess the pose accuracy achievable from stereo VO only, independent of external sensors or fusion schemes. The pipeline includes feature extraction and tracking, robust motion hypothesis generation via Sample Consensus, and on-manifold six-degree-of-freedom pose refinement. A physically grounded subpixel keypoint refinement stage yields non-isotropic, per-feature pixel covariances tied informed by local image gradients, which are analytically propagated through stereo triangulation to the SE(3) pose updates. The resulting covariances associated with inter-frame pose increments and landmark measurements are expressed as Gaussian factors directly usable in graph-based back-ends, supporting bundle adjustment and pose-graph optimization. Experiments on the KITTI odometry benchmark and on the non-urban, Mars-analog DLR MADMAX dataset demonstrate that the proposed framework produces pose estimates whose empirical errors remain consistent with the predicted uncertainty over long sequences. Although the current system estimates inter-frame motion only, and thus accumulates drift over time, the observed error growth remains statistically aligned with the propagated uncertainty. These results establish a principled foundation for the integration of VO within learning-based or multi-sensor navigation frameworks while preserving a physically motivated, sensor-driven treatment of uncertainty. © The Author(s) 2026.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Rawat2026,
	author = {Rawat, Keshav Singh and Sharma, Tarun},
	title = {Machine learning-driven evolution of intelligent unmanned aerial vehicles},
	year = {2026},
	journal = {Computer Science Review},
	volume = {61},
	pages = {},
	doi = {10.1016/j.cosrev.2026.100937},
	url = {https://www.scopus.com/pages/publications/105030921740?origin=resultslist},
	abstract = {Machine Learning (ML) has broadened the operational capability of Unmanned Aerial Vehicles (UAVs) across various fields. But these aerial services still face limitations due to factors like changing environments, onboard computing limits, and secure connections. The current literature lacks a comprehensive analysis of the advancements in the domain and ongoing challenges that need to be addressed. To fill this gap, we conducted a mixed-method review of 9148 associated articles that focus on the usage of ML in UAV systems from the Scopus database. Our study analyzed the country collaboration and document co-citation networks to understand the overall growth trajectory and associated themes. These findings helped in categorizing UAV research into 5 operational areas. These include navigation and control, communication networks, task scheduling and resource management, safe and secure operations, and Drone-As-A-Service (DaaS). The findings also point to the existing barriers that hinder the smooth operations of these systems. The results also identify emerging opportunities like multi-UAV systems, energy-efficient models, contextually aware orchestration, and human-in-the-loop services. These insights will serve as a one-point reference for researchers and industry experts to advance ML-powered UAV services. © 2026 Elsevier Inc.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Feng2026,
	author = {Feng, Yuxuan and Tian, Daiying and Cui, Jinqiang and Fang, Hao},
	title = {Adaptive σ-Consensus With Uncertainty Awareness for Robust Multiagent Trajectory Alignment},
	year = {2026},
	journal = {IEEE Transactions on Instrumentation and Measurement},
	volume = {75},
	pages = {},
	doi = {10.1109/TIM.2026.3709430},
	url = {https://www.scopus.com/pages/publications/105043806778?origin=resultslist},
	abstract = {The trajectory alignment problem in multiagent systems is inherently tied to sensor measurements: given multiple instrument-derived observations, the goal is to estimate reliable relative coordinate transformations and use them to register locally measured trajectories into a common reference frame, yielding a consistent global trajectory. Existing approaches often lack a reliability assessment for the relative coordinate transformations between trajectories and remain vulnerable to scale drift and outlier data associations. To address these limitations, we propose a robust trajectory alignment framework. First, we introduce a joint-uncertainty estimation that fuses and propagates multisource uncertainties to the relative coordinate transformations, and instantiate it under a calibrated monocular camera model to obtain a reliability measure for each interagent constraint. Second, we develop an adaptive σ -consensus algorithm on SIM, which defines a robust nonparametric loss on the residuals by integrating a σ -marginalization mechanism. This mechanism computes residual weights by marginalizing over multiple candidate noise scales and using the empirical residual statistics to calibrate their influence, which improves robustness to scale drift and interrobot outliers. We evaluate the proposed framework using centralized monocular simultaneous localization and mapping (SLAM) as a representative application scenario. Extensive simulations and real-world experiments demonstrate that the proposed method achieves higher accuracy and stronger robustness than state-of-the-art baselines. On synthetic g2o benchmarks with outlier ratios up to 45 %, our method reduces the objective value by 25.2 % compared with a representative robust sampling-based baseline on Grid3D-2. On real-world benchmark sequences, it reduces the root-mean-square absolute pose error (APE) by up to 58.3 % in two-robot configurations and 62.4 % in three-robot configurations compared with the collaborative centralized monocular SLAM baseline while maintaining an alignment runtime of 1.66-10.01 ms.  © 1963-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Lyu2026,
	author = {Lyu, Shilei and Chen, Jiahong and Gao, Peng and Gao, Songmao and Li, Zijie and He, Junxing and Zhang, Guoning and Li, Zhen},
	title = {Adaptive unscented Kalman filter based localization for a tracked operation platform: An intelligent observation noise estimation mechanism},
	year = {2026},
	journal = {Engineering Applications of Artificial Intelligence},
	volume = {182},
	pages = {},
	doi = {10.1016/j.engappai.2026.115719},
	url = {https://www.scopus.com/pages/publications/105046546836?origin=resultslist},
	abstract = {In densely planted orchards, dense canopies frequently cause random Global Navigation Satellite System signal degradation, while unstructured terrains induce mechanical control failures. To address this problem, this paper proposes a nonlinear state-estimation framework which is called adaptive unscented Kalman filter, that performs real-time residual diagnosis and dynamically updates the observation-noise covariance, thereby improving robustness against model mismatch and signal fluctuation and providing high-accuracy localization for tracked agricultural platforms operating in dense canopy occlusion and uneven orchard environments. First, multi-modal sensor data are preprocessed to establish a unified spatio-temporal baseline, including Global Navigation Satellite System validity retention and accelerometer noise suppression. Then, Global Navigation Satellite System and inertial measurement unit observations are fused within an unscented Kalman filter framework, and the observation confidence is adaptively adjusted according to residual statistics. Simulations and field experiments were conducted to compare the proposed method with the extended Kalman filter, adaptive extended Kalman filter, unscented Kalman filter, and traditional Global Navigation Satellite System. In simulation Path B, the proposed method reduced mean absolute error, standard deviation, and root mean square error by 76.9%, 67.3%, and 75.4%, respectively, compared with the extended Kalman filter. In field tests on Path A, it reduced mean absolute error, two-dimensional root mean square, and circular error probable by 30.4%, 29.4%, and 19.3%, respectively, compared with traditional Global Navigation Satellite System positioning. These results demonstrate that the proposed method effectively resolves localization dilemmas in complex agricultural environments, providing reliable technical support for the autonomous navigation of smart agricultural equipment. © 2026 Elsevier Ltd.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Ma20261195,
	author = {Ma, Zhi-Jian and Lu, Jun-Guo and Wei, Ming and Zhang, Qing-Hao},
	title = {A Lightweight Environment Vector Map Framework and Its Fast Lane-Level Navigation Strategy for Autonomous Vehicles},
	year = {2026},
	journal = {IEEE Transactions on Intelligent Transportation Systems},
	volume = {27},
	number = {1},
	pages = {1195 - 1207},
	doi = {10.1109/TITS.2025.3631692},
	url = {https://www.scopus.com/pages/publications/105024712584?origin=resultslist},
	abstract = {High precision maps are essential for autonomous driving, offering prior navigation information and critical decision-making support. However, existing models often lack precise horizontal relationships between road-level and lane-level control points. To narrow this gap, a lightweight lane-level high precision map framework termed environment vector map (EVM), is proposed. EVM features a hierarchical structure where lane-level control points maintain explicit point-to-point correspondence with road-level control points, enabling real-time lane extraction. And the intersections are modeled via traffic matrices, not need to save the intersection lanes in offline. Furthermore, a fast lane-level navigation strategy (road-level path planning in road-level network + lane-level lane extracting + optimal lane select) based on EVM is proposed, which performs real-time extraction of drivable lanes ahead of the ego-vehicle, and selects an optimal lane to local planner. The optimal lane is dynamically adjusted based on the vehicle’s position and total cost. This strategy eliminates global lane-level searches in lane-level network. Experiment results validate the effectiveness of EVM and the proposed lane-level navigation strategy, demonstrating a 22.9% reduction in total planning time and lower lateral deviation compared to conventional lane-level planning methods in lane-level network. © 2000-2011 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Chen2026477,
	author = {Chen, Zhijian and Jin, Shaohua and Bian, Gang and Sui, Xin and Xu, Aigong},
	title = {A Robust, Real-Time, and Drift-Reduced LiDAR–Inertial–UWB Tightly Coupled Fusion},
	year = {2026},
	journal = {IEEE Sensors Journal},
	volume = {26},
	number = {1},
	pages = {477 - 486},
	doi = {10.1109/JSEN.2025.3630840},
	url = {https://www.scopus.com/pages/publications/105021971055?origin=resultslist},
	abstract = {To increase autonomous system positioning accuracy and reliability in global navigation satellite system (GNSS)-denied environments, this study proposes a robust, real-time, and drift-reduced light detection and ranging (LiDAR)–inertial–ultrawideband (UWB) tightly coupled fusion approach, named RLIU, which is based on an onmanifold error state iterated Kalman filter (ESIKF) to achieve locally smooth and globally consistent state estimation. The RLIU is centered on an inertial measurement unit (IMU) and consists of two subsystems, LiDAR–inertial odometry (LIO) and UWB–inertial odometry (UIO), to continuously correct the IMU navigation results. The UIO system can eliminate LIO estimation drift under challenging scenarios and maintain global consistency for map construction. Considering the time offset among multiple UWB ranging values, this study innovatively integrates individual UWB ranging values and IMU measurements in a “time-focused” manner. Simultaneously, robust estimation is performed to eliminate undesirable random error effects such as nonline-of-sight (NLOS) errors in state estimation. We evaluated the proposed RLIU system via a dataset collected by a wheeled robot. The experimental results reveal that the proposed approach effectively increases the availability and robustness of the autonomous system under challenging scenarios and achieves more continuous and accurate pose estimation. © 2001-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@CONFERENCE{Song2026586,
	author = {Song, Yuan and Zhang, Yuzhen and Guo, Lei},
	title = {Multi-Sensor Fusion Localization for Mobile Robots Based on Joint Measurement Update},
	year = {2026},
	journal = {2026 International Annual Conference on Complex Systems and Intelligent Science, CSIS-IAC 2026},
	pages = {586 - 591},
	doi = {10.1109/CSIS-IAC70275.2026.11585010},
	url = {https://www.scopus.com/pages/publications/105044897057?origin=resultslist},
	abstract = {In non-ideal environments, single-sensor degradation is common in mobile robot localization, and conventional multi-sensor fusion may still provide limited accuracy. To address this problem, we propose an EKF-based fusion algorithm incorporating joint measurement fusion and installation-offset compensation. First, we construct a joint measurement-fusion model to fuse LiDAR odometry and optical-flow measurements within a single EKF update, thereby improving the temporal consistency of conventional asynchronous sequential updates. Second, we derive an installation-offset compensation model based on rigid-body kinematics and incorporate it into the measurement Jacobian to mitigate disturbances caused by sensor mounting offsets. In ROS/Gazebo simulation experiments on a differential-drive robot, the proposed method achieves the highest localization accuracy. Under normal conditions, the trajectory RMSE is reduced by 93.4%, 61.9%, and 37.5% compared with optical flow, LiDAR odometry, and Robot Localization, respectively. Under LiDAR interference, the trajectory RMSE is reduced by 80.3% and 25.9% compared with optical flow and LiDAR odometry, respectively. Physical experiments further show cumulative localization-error reductions of 73.5% and 25.6% compared with optical flow and LiDAR odometry, respectively. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Tu2026,
	author = {Tu, Qinglan and Duan, Yuxuan and Zhang, Jiahe and Shen, Kai and Xiao, Xuan},
	title = {Quantitative belief-guided intelligent decision-making for adaptive multi-sensor fusion navigation},
	year = {2026},
	journal = {Satellite Navigation},
	volume = {7},
	number = {1},
	pages = {},
	doi = {10.1186/s43020-026-00206-y},
	url = {https://www.scopus.com/pages/publications/105046421987?origin=resultslist},
	abstract = {Adaptive multi-sensor fusion navigation in complex cross-scenario environments requires adaptive decision-making strategies that can respond to both external environmental changes and internal information degradation. Existing fusion navigation methods typically rely on fixed fusion rules, predefined noise models, or analytically designed parameter mappings, thereby limiting their ability to capture the nonlinear coupling and temporal variation among heterogeneous navigation sources. To address this challenge, this paper proposes a quantitative belief-guided intelligent decision-making method for adaptive multi-sensor fusion navigation. The proposed method constructs a compact quantitative belief state by jointly modeling exogenous availability belief and endogenous credibility belief, which respectively characterize the quality of environmental geometric constraints and the reliability of internal estimation information. Based on this belief representation, a learning-based decision agent is designed to infer adaptive fusion decisions for multi-sensor fusion. By incorporating temporal belief evolution into the decision process, the proposed method enables the navigation system to dynamically adjust the contribution of different navigation sources under varying cross-scenario conditions. Both simulation and real-world experiments demonstrate that the proposed method can effectively characterize changes in environmental constraints and internal information states, learn robust fusion decision policies, and significantly improve navigation accuracy and robustness in challenging cross-scenario environments. © The Author(s) 2026.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Cao2026,
	author = {Cao, Yulong and Zhao, Guhao and Wu, Yarong and Wang, Hao and Gong, Yu},
	title = {Quality-Aware Distributed State Estimation for Multi-UAV Cooperative Localization Under Communication and Navigation Constraints},
	year = {2026},
	journal = {Drones},
	volume = {10},
	number = {6},
	pages = {},
	doi = {10.3390/drones10060439},
	url = {https://www.scopus.com/pages/publications/105042723736?origin=resultslist},
	abstract = {Cooperative localization for multi-Unmanned Aerial Vehicle (UAV) systems in GPS-degraded environments is often compromised by ideal-communication or uniform-quality assumptions. This paper proposes Quality-Aware Distributed State Estimation (QA-DSE), which combines three operational quality factors—freshness (Age of Information), accuracy (covariance trace), and link reliability (packet loss and channel noise)—into a single multiplicative score  (Formula presented.), modulated by a bounded history-consistency factor based on velocity-propagated self-trajectory continuity. A dual-constraint AND-gate on AoI and covariance trace excludes jointly degraded neighbors, while admitted neighbors are fused through a quality-squared information-matrix update under a stated bounded residual cross-correlation assumption, with an adaptive Covariance-Intersection fallback when the assumption is stressed. Under explicit observability, bounded-noise, bounded-quality, joint-connectivity, and bounded residual cross-correlation assumptions, we establish mean-square bounded error, exponential convergence at a rate inherited from the Kalman update operator,  (Formula presented.) per-step complexity, Bounded-Input Bounded-Output (BIBO) stability, soft attenuation of single-axis faults (Theorem 4), and hard exclusion under joint AoI–covariance violation (Theorem 5). Under a Ultra-Wideband (UWB)-style cooperative-observation model, Monte Carlo experiments across five scenarios show 74.08–74.24% position- Root Mean Square Error (RMSE) reductions over Covariance Intersection, with the relative advantage held within 73.04–74.24% as the fleet scales from 3 to 50 UAVs; QA-DSE remains within 8.1% of an idealized no-cooperation single-vehicle Kalman filter, demonstrating graceful degradation rather than improvement above that floor. Per-step Central Processing Unit (CPU) time scales from 0.09 ms (5 UAVs) to 0.31 ms (50 UAVs); embedded validation is left to future work. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@ARTICLE{Luo202610154,
	author = {Luo, Zhipeng and Hu, Mingnan and Wang, Zheming and Chen, Bo},
	title = {UAF-LIVO: Uncertainty-Aware Feature-Based LiDAR-Inertial-Visual Odometry Robust to Cross-Modal Geometric Inconsistency},
	year = {2026},
	journal = {IEEE Robotics and Automation Letters},
	volume = {11},
	number = {9},
	pages = {10154 - 10161},
	doi = {10.1109/LRA.2026.3710002},
	url = {https://www.scopus.com/pages/publications/105044057859?origin=resultslist},
	abstract = {This letter presents UAF-LIVO, a feature-based sequential LiDAR-inertial-visual odometry system robust to cross-modal geometric inconsistency. While sequential fusion mitigates the inherent robustness imbalance between LiDAR and visual measurements, it remains highly susceptible to cross-modal misalignment. These discrepancies typically arise from imperfect sensor calibration and visual feature misalignment in dynamic or degraded environments. To address this, we propose a geometry-consistent visual measurement construction and update strategy. Matched features are categorized as local plane supported, voxel-map supported, or bearing-only. For each, we derive a thorough propagation model to explicitly quantify measurement uncertainty. This theoretical foundation allows UAF-LIVO to adaptively down-weight ill-conditioned observations and reject outliers within an IESKF framework. Experiments on public datasets with diverse sensor configurations and scenarios demonstrate that UAF-LIVO achieves competitive accuracy and consistent robustness against geometric inconsistency compared to state-of-the-art methods. © 2016 IEEE.},
