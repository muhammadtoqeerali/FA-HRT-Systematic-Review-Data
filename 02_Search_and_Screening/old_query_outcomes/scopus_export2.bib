	author = {Edwards, Seamus and Mihaylova, Lyudmila and Aitken, Jonathan M. and Anderson, Sean},
	title = {Toward Robust Visual Odometry Using Prior 2D Map Information and Multiple Hypothesis Particle Filtering},
	year = {2021},
