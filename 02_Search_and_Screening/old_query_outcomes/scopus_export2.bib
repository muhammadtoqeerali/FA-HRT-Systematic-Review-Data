@ARTICLE{Liang2026,
	author = {Liang, Zhiyan and Wang, Luhan and Wang, Hexiang and Zhang, Baohua and Liu, Chengliang},
	title = {Autonomous obstacle avoidance and path planning for mobile robots in orchard environments combining with map construction and positioning methods},
	year = {2026},
