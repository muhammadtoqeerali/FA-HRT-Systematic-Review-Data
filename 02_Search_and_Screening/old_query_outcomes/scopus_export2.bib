@ARTICLE{Lyu202522739,
	author = {Lyu, Haojie and Wu, Wei},
	title = {A Robust Human-Following System for Autonomous Mobile Robot in Unknown Environments},
	year = {2025},
	journal = {IEEE Sensors Journal},
	volume = {25},
