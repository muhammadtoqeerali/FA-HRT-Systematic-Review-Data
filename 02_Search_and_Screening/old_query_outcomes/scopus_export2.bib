@ARTICLE{Wang2026,
	author = {Wang, Chao and Dai, Wentao and Chen, Jun and Xu, Xiaomei and Ding, Tao},
	title = {Real-time micrometer-level dynamic pose measurement and uncertainty propagation chain modeling of robot end-effectors based on laser-event hybrid sensing framework},
	year = {2026},
	journal = {Measurement: Journal of the International Measurement Confederation},
	volume = {290},
	pages = {},
	doi = {10.1016/j.measurement.2026.122775},
	url = {https://www.scopus.com/pages/publications/105046828968?origin=resultslist},
	abstract = {Simultaneously achieving micrometer-level accuracy and kilohertz-level responsiveness in dynamic pose measurement of robot end-effectors remains a fundamental challenge in precision robotic manufacturing. To address this, we propose a laser–event hybrid sensing framework that tightly integrates periodic geometric constraints from laser triangulation sensors with asynchronous microsecond-level motion cues from event cameras. An event-driven asynchronous adaptive Kalman filter is developed to fuse heterogeneous measurements at the measurement-model level, accommodating divergent sampling rates, motion-dependent event density, and non-ideal sensor behaviors, thereby enabling real-time state updates exceeding 12 kHz with an end-to-end latency of 105 µs. Furthermore, a complete uncertainty propagation chain is established to quantify sensor-level errors, synchronization drift, model linearization effects, and covariance evolution, supporting ISO GUM–compliant uncertainty reporting during dynamic operation. Experimental validation on a KUKA iiwa platform demonstrates that the prototype achieves 5 µm-level static position repeatability and maintains RMS errors below 10 µm under low-to-moderate dynamic conditions (≤200 mm/s); at higher speeds (750–1000 mm/s), adaptive event sampling and motion-compensated laser corrections reduce RMS errors from 26.4 µm to 19.2 µm. Comparative experiments against laser-only, laser–IMU, laser–vision, and event-only baselines confirm a superior accuracy–speed–latency balance and enhanced robustness under partial sensor degradation, while application tests in micro-assembly, laser processing, and vibration monitoring illustrate the practical potential of the framework for high-speed precision robotic measurement. © 2026 Elsevier Ltd},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Suzuki20261498,
	author = {Suzuki, Takumi and Funabora, Yuki and Doki, Shinji and Doki, Kae},
	title = {Robust Localization using Map Selection from Multiple Maps Based on the Relative Pose Difference of Map and Interoceptive Sensor},
	year = {2026},
	journal = {2026 IEEE/SICE International Symposium on System Integration, SII 2026},
	pages = {1498 - 1503},
	doi = {10.1109/SII64115.2026.11404656},
	url = {https://www.scopus.com/pages/publications/105035767438?origin=resultslist},
	abstract = {Autonomous mobile robots are expected to demonstrate a high degree of adaptability, enabling effective operation across diverse environments. Robust localization is a key requirement for achieving such autonomous mobility. Typically, localization methods using sensors such as cameras and LiDAR construct a map in advance from features of the driving environment. The robot then estimates its pose by matching the currently observed features to the pre-prepared map. However, environmental changes create discrepancies between the current environment and the pre-prepared map, leading to localization failure. This paper presents a map selection method for robust localization, which selects a map that reflects the current environment from multiple pre-prepared maps constructed under different environmental conditions. Although existing methods are limited to a single sensor, the proposed method can be applied to different types of sensors in a unified manner by handling sensor information at the pose information layer. To achieve this, the method utilizes the relative pose difference between the interoceptive sensor and the map, which is less susceptible to environmental changes, thereby enabling appropriate map selection under varying environmental conditions. The experiment was conducted using a robot equipped with a stereo camera in an environment with four conditions. The results showed maximum localization errors of 0.10-0.24 m and mean errors of 0.03-0.04 m, demonstrating robust localization through the selection of an appropriate map that reflects the current conditions.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

