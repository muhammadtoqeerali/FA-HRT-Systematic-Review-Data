@ARTICLE{Sun2026,
	author = {Sun, Jin and Xutian, Yile and Shen, Xue and Tong, JinWu and Zhang, Youqiang and Zhao, Haitao},
	title = {D2-Lite SLAM: Distilled, Depth-Aware, and Lightweight SLAM System for Real-Time Dynamic Environment},
