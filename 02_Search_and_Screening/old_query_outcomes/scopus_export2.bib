	pages = {},
	doi = {10.1016/j.engappai.2026.115013},
	url = {https://www.scopus.com/pages/publications/105037429592?origin=resultslist},
	abstract = {The state of charge (SOC) and available capacity estimation of power lithium-ion batteries (LIB) are important for battery management systems. In this paper, a novel physical extraction multi-step neural network (PEMSNN) algorithm is proposed for state estimation. First, to solve the problems of insufficient input feature dimension and complex nonlinear coupling relationship of neural network, a model-driven physical feature extraction method is proposed, which effectively extends the input feature dimension. The extracted features are input into the long short-term memory to construct a fusion neural network. Secondly, the complex electrochemical processes within the LIB are comprehensively analyzed. Subsequently, in combination with the external discharge characteristic curve, a multi-segment prediction method is proposed. This method resolves the issue of zone attention allocation and enhances the prediction accuracy of the SOC. Finally, by leveraging the slow time-varying characteristics of capacity and the high-precision SOC results, a PEMSNN algorithm is proposed for the prediction of available capacity. Consequently, this resolves the problem of capacity calibration in the estimation of the SOC. The estimation accuracy and robustness are verified under dynamic operating conditions at 15 °C (°C), 25 °C, and 35 °C. The SOC estimation accuracy has improved by at least 38.42%. The error of the available capacity is within the range of 74 mA-hours. The proposed PEMSNN algorithm offers a potentially viable strategy for applying artificial intelligence to state estimation in new energy electric vehicles. © 2026 Elsevier Ltd.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Green Open Access}
}

@ARTICLE{Lee2026922,
	author = {Lee, Eungchang Mason and Marsim, Kevin Christiansen and Myung, Hyun},
	title = {LODESTAR: Degeneracy-Aware LiDAR-Inertial Odometry With Adaptive Schmidt-Kalman Filter and Data Exploitation},
	year = {2026},
	journal = {IEEE Robotics and Automation Letters},
	volume = {11},
	number = {1},
	pages = {922 - 929},
	doi = {10.1109/LRA.2025.3634906},
	url = {https://www.scopus.com/pages/publications/105022448610?origin=resultslist},
	abstract = {LiDAR-inertial odometry (LIO) has been widely used in robotics due to its high accuracy. However, its performance degrades in degenerate environments, such as long corridors and high-altitude flights, where LiDAR measurements are imbalanced or sparse, leading to ill-posed state estimation. In this letter, we present LODESTAR, a novel LIO method that addresses these degeneracies through two key modules: degeneracy-aware adaptive Schmidt-Kalman filter (DA-ASKF) and degeneracy-aware data exploitation (DA-DE). DA-ASKF employs a sliding window to utilize past states and measurements as additional constraints. Specifically, it introduces degeneracy-aware sliding modes that adaptively classify states as active or fixed based on their degeneracy level. Using Schmidt-Kalman update, it partially optimizes active states while preserving fixed states. These fixed states influence the update of active states via their covariances, serving as reference anchors–akin to a lodestar. Additionally, DA-DE prunes less-informative measurements from active states and selectively exploits measurements from fixed states, based on their localizability contribution and the condition number of the Jacobian matrix. Consequently, DA-ASKF enables degeneracy-aware constrained optimization and mitigates measurement sparsity, while DA-DE addresses measurement imbalance. Experimental results show that LODESTAR outperforms existing LiDAR-based odometry methods and degeneracy-aware modules in terms of accuracy and robustness under various degenerate conditions. © 2016 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6}
}

@ARTICLE{Wang2026,
	author = {Wang, Qilong and Wang, Ning and Du, Xin and Gao, Xiang and Tang, Aofei},
	title = {Real-time lidar-visual feature co-optimization for complex indoor environments: an adaptive fusion framework with illumination-robust enhancement},
	year = {2026},
	journal = {Journal of King Saud University - Computer and Information Sciences},
	volume = {38},
