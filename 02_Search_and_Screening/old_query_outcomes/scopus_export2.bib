	note = {Cited by: 0}
}

@ARTICLE{Shili2025,
	author = {Shili, Mohamed and Chaoui, Hicham and Nouri, Khaled},
	title = {Energy-Aware Sensor Fusion Architecture for Autonomous Channel Robot Navigation in Constrained Environments},
	year = {2025},
