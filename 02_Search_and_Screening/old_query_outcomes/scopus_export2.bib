@ARTICLE{Zhang2025248,
	author = {Zhang, Yahui and Li, Aimin and Li, Haopeng and Chen, Fei and Shen, Ruiying},
	title = {Robust positioning in extreme environments: a tightly coupled GNSS-vision-inertial-wheel odometer framework},
