	year = {2023},
	journal = {Lecture Notes in Networks and Systems},
	volume = {642 LNNS},
	pages = {99 - 106},
	doi = {10.1007/978-3-031-26889-2_10},
	url = {https://www.scopus.com/pages/publications/85151053916?origin=resultslist},
	abstract = {Because unmanned aerial vehicles (UAVs) have relatively free movement compared to unmanned ground vehicles (UGVs), they can be adopted for various tasks. However, low payload and short flight time are the major limitations in operating UAVs. Consequently, lightening UAVs and multi-UAV systems are being researched. With the aim of utilizing the multi-UAV system efficiently, the relative position of each UAV is needed. In this study, we propose a low-cost relative position estimation method for the lightened multi-UAV system that uses only the range data between the UAVs on the cyber-physical system. In addition, our method uses the filtered ultra-wideband (UWB) data with reduced outliers by utilizing the sliding window and a low pass filter on the UWB raw data. © 2023, The Author(s), under exclusive license to Springer Nature Switzerland AG.},
