@ARTICLE{Cai2023,
	author = {Cai, Yunpiao and Qian, Weixing and Dong, Jiayi and Zhao, Jiaqi and Wang, Kerui and Shen, Tianxiao},
	title = {A LiDAR–Inertial SLAM Method Based on Virtual Inertial Navigation System},
	year = {2023},
