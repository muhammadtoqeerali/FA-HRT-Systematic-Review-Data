@ARTICLE{Mahmoud2026112,
	author = {Mahmoud, Lina M. and Saleh, Muna H. and Abbas, Nizar H.},
	title = {Resilient Hybrid AI Navigation for Mobile Robots in Hazardous Cyber-Physical Environments: A Review; [أنظمة الملاحة الهجينة المعتمدة على الذكاء الاصطناعي المرِن للروبوتات المتنقلة في البيئات السيب ا رنية الفيزيائية عالية الخطورة: م ا رجعة علمية]},
