	title = {Cross-Modal Reinforcement Learning for Navigation with Degraded Depth Measurements},
	year = {2026},
	journal = {European Control Conference (Piscataway, N.J. Online), ECC},
	number = {2026},
	pages = {3000 - 3007},
	url = {https://www.scopus.com/pages/publications/105047336452?origin=resultslist},
	abstract = {This paper presents a cross-modal learning framework that exploits complementary information from depth and grayscale images for robust navigation. We introduce a Cross-Modal Wasserstein Autoencoder that learns shared latent representations by enforcing cross-modal consistency, enabling the system to infer depth-relevant features from grayscale observations when depth measurements are corrupted. The learned representations are integrated with a Reinforcement Learning-based policy for collision-free navigation in unstructured environments when depth sensors experience degradation due to adverse conditions such as poor lighting or reflective surfaces. Simulation and real-world experiments demonstrate that our approach maintains robust performance under significant depth degradation and successfully transfers to real environments. © 2026 EUCA.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Li2026,
	author = {Li, Xiang and Suo, Zhe and Pan, Feifan and Wang, Jixin and Xie, Fei},
	title = {Stability-constrained operation planning for multi-support construction equipment under load and configuration variations},
	year = {2026},
	journal = {Computer-Aided Civil and Infrastructure Engineering},
	volume = {50},
	pages = {},
	doi = {10.1016/j.cacaie.2026.100209},
	url = {https://www.scopus.com/pages/publications/105049047238?origin=resultslist},
	abstract = {For multi-support construction equipment operating in complex environments, load and configuration variations can induce significant whole-equipment CoM fluctuations that directly affect operational stability. Existing stability analysis methods are generally unable to simultaneously accommodate multiple constraints or explicitly account for CoM fluctuations, limiting their applicability to operation planning. To address these limitations, this paper proposes a multi-constraint three-dimensional quasi-static stability analysis and operation planning framework for multi-support construction equipment. The CoM fluctuation region induced by load and configuration variations is first characterized and regularized using a minimum enclosing sphere. A three-dimensional quasi-static stability boundary is then constructed by jointly considering force and moment equilibrium, kinematic constraints, actuation constraints, support conditions, and ground conditions. Together, these formulations transform equipment stability analysis into a feasibility problem of the CoM position and enable stability to be directly incorporated into operation planning. The proposed operation planning framework is applied to support-layout evaluation for static-support equipment, and to support-point feasibility evaluation, mobile-body target position and trajectory planning for the walking transition of mobile-support equipment. Simulations and prototype experiments on flat, uneven, and sloped terrain show that a quasi-static stability boundary and a trajectory between two target positions can be generated in approximately 2 s and 3.5 s, respectively, while achieving zero boundary violations under the adopted discrete verification. These results demonstrate the effectiveness of the proposed framework, which has the potential to further enhance the practicality, robustness, and autonomy of multi-support construction equipment operating in complex environments. © 2026 The Author(s).},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Liu202620050,
	author = {Liu, Ning and Zhu, Lixuan and Hu, Kejun and Fan, Junfang},
	title = {Sensor Fusion With Neural Virtual Measurements for Aerial GNSS/INS Integration},
	year = {2026},
	journal = {IEEE Sensors Journal},
	volume = {26},
	number = {13},
	pages = {20050 - 20065},
	doi = {10.1109/JSEN.2026.3694376},
	url = {https://www.scopus.com/pages/publications/105040268596?origin=resultslist},
	abstract = {High-spinning aerial platforms operating under high-speed rotation and strong electromagnetic interference experience severe global navigation satellite system (GNSS) signal degradation, causing periodic outages and measurement gaps. Such conditions force the navigation system into pure inertial mode, resulting in rapidly accumulating position errors. To address sensor measurement gaps, this article develops a physics-informed mapping between inertial measurement unit (IMU) observations and flight-phase states derived from 7-DOF dynamics equations. A Transformer-CNN-based virtual sensor is developed for real-time flight-phase identification and synthetic position-increment measurements, dynamically adapting the Kalman filter's measurement covariance matrix and measurement model. This dual-constraint sensor fusion framework improves GNSS/inertial navigation system (INS) integration robustness during signal degradation. Hardware-in-the-loop (HIL) sensor simulations demonstrate that under sporadic electromagnetic interference (short-term GNSS outages), position and velocity RMSEs decrease by 63% and 16%, respectively; under sustained interference in electromagnetically contested environments (prolonged outages), reductions reach 42% and 11%. The approach mitigates pure inertial navigation error accumulation, substantially enhancing multisensor fusion accuracy in GNSS-challenged extreme environments. Comparative validation across multiple neural network architectures confirms the Transformer-CNN's superiority in adaptive flight-phase recognition. This work provides a deployable virtual sensor-enhanced framework for multisensor fusion systems operating under severe electromagnetic interference, offering both theoretical rigor and engineering viability for practical implementation.  © 2026 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Li202611401,
	author = {Li, Bofeng and He, Linkun and Chen, Guang'e},
	title = {Precise LiDAR-Only Odometry With Error Rectification in Structured Environments},
	year = {2026},
	journal = {IEEE Journal of Selected Topics in Applied Earth Observations and Remote Sensing},
	volume = {19},
	pages = {11401 - 11410},
	doi = {10.1109/JSTARS.2026.3677220},
	url = {https://www.scopus.com/pages/publications/105034438007?origin=resultslist},
	abstract = {Accurate self-localization is a prerequisite for advanced autonomous systems. LiDAR odometry provides a relative solution to this problem yet inevitably drifts over time. So far, many efforts have been made to reduce the drift, such as introducing semantic information. However, existing methods neglect fully exploiting the measurement uncertainties when formulating the LiDAR odometry, which also improves the accuracy as demonstrated in this article. The proposed LiDAR odometry method uses planes as landmarks for point cloud registration. With plane-to-plane correspondences, we estimate the relative pose as well as the error terms of plane parameters. To this end, we establish the correlations between planes via an empirical covariance function. The error rectification for plane parameters enables us to maintain a high quality plane map and thus suppress the drift. We further refine the pose using point-to-plane correspondences and acquire a low-drift LiDAR odometry (and mapping) system. The validation of our method is conducted on different datasets that involve challenging urban and indoor scenes. Experimental results suggest that our method is competitive among state-of-the-art methods, achieving accurate pose estimation on the fly. © 2026 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Liu20266906,
	author = {Liu, Man and Zhou, Wei and Xu, Zeshui},
	title = {The Self-Attention IHF-LSTM Network to Model Interactive Hesitant Fuzzy Information and Its Application in UAV Autonomous Navigation},
	year = {2026},
	journal = {IEEE Transactions on Intelligent Transportation Systems},
	volume = {27},
	number = {6},
	pages = {6906 - 6918},
	doi = {10.1109/TITS.2026.3677001},
	url = {https://www.scopus.com/pages/publications/105036336648?origin=resultslist},
	abstract = {Recently, the uncrewed aerial vehicle (UAV) autonomous navigation has been widely used in logistics transportation and environmental monitoring. However, the interaction of subjective evaluation information has been the critical challenge for UAVs and its operations. Also, the correlation among different attributes of the evaluation information is unclear, and the interaction between early and late attributes is often overlooked. Then, how to describe this interactive evaluation information and realize classification decisions has become a key issue. To do it, this paper introduces the hesitant fuzzy set (HFS) and develop the temporal and interactive HFS. Further, we propose a self-attention interactive hesitant fuzzy-long short-term memory network to processes and recognizes the defined information. Then, a multi-probability classification algorithm is given to show the calculation process. At last, its feasibility and applicability are verified by an example of UAV autonomous navigation, which provides a new direction for the development of related UAV technologies.  © 2026 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wang2026,
	author = {Wang, Changqiang and Xu, Zhihao and Chen, Liang and Gao, Song and Sui, Xin and Li, Biao},
	title = {Dual-Layer Adaptive Robust Tightly Coupled VIO-UWB Localization with Anchor-Error Priors and Residual-Scale Alignment},
	year = {2026},
	journal = {IEEE Transactions on Instrumentation and Measurement},
	volume = {75},
	pages = {},
	doi = {10.1109/TIM.2026.3716490},
	url = {https://www.scopus.com/pages/publications/105045993660?origin=resultslist},
	abstract = {The tight coupling of visual-inertial odometry (VIO) and ultra-wideband (UWB) ranging is an effective solution for high-precision localization in global navigation satellite system (GNSS)-denied environments. However, anchor-dependent biases and noise heterogeneity, residual scale imbalance, and nonline-of-sight (NLOS) outliers can degrade localization accuracy and robustness. This article proposes DAR-UVIO, a dual-layer adaptive robust UWB-aided VIO framework. First, anchorwise statistical priors are introduced to compensate for constant biases and normalize heterogeneous ranging noise. Second, a scale-alignment factor derived from camera intrinsics balances the numerical influence of UWB residuals, and the final anchor-normalized UWB residual is formulated as a dimensionless standardized variable, improving the numerical conditioning of joint optimization. Finally, a dual-layer robust strategy combines IGG3-based iterative reweighting for measurement-level outlier suppression with Helmert variance component estimation (HVCE) for online adaptation of sensor-group weights. Experiments on the public NTU-VIRAL dataset show that the proposed method achieves improved localization accuracy and robustness compared with representative VIO and VIO-UWB baselines while maintaining good real-time performance.  © 1963-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Zhang2026,
	author = {Zhang, Zijun and Xu, Xing and Jiang, Xinwei and Jiang, Jiachen and Wang, Yan},
	title = {IMU-based estimation and control strategy design of electronically controlled QZS air suspension system},
	year = {2026},
	journal = {Vehicle System Dynamics},
	pages = {},
	doi = {10.1080/00423114.2026.2683874},
	url = {https://www.scopus.com/pages/publications/105041290820?origin=resultslist},
	abstract = {This paper presents a novel estimation and control framework for Quasi-Zero-Stiffness (QZS) air suspension systems based on Inertial Measurement Unit (IMU) data. A combined algorithm integrating Grey Wolf Optimisation (GWO) and Unscented Kalman Filtering (UKF) is proposed to address the challenges of noise and uncertainty inherent in IMU signals. First, the mathematical model of the QZS air suspension system is formulated, and an (Formula presented.) controller coupled with an IMU simulation model is developed. IMU measurements are incorporated into the state vector directly, while the remaining state variables are estimated through the GWO-UKF algorithm. To further improve estimation adaptability and accuracy, GWO is employed to optimise the UKF parameters. Simulation results demonstrate that the proposed method achieves high accuracy in estimating the unsprung mass velocity and dynamic displacement. Finally, Hardware-in-the-Loop (HiL) experiments confirm that the proposed controller significantly enhances vehicle ride comfort and operational stability. © 2026 Informa UK Limited, trading as Taylor & Francis Group.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Sun2026,
	author = {Sun, Guiyin and Yang, Wen and Liang, Hongjing and Zhu, Zhechen},
	title = {Adaptive tracking control for stochastic nonlinear multiagent systems via an improved synchronous self-triggered mechanism},
	year = {2026},
	journal = {International Journal of Systems Science},
	pages = {},
	doi = {10.1080/00207721.2026.2636999},
	url = {https://www.scopus.com/pages/publications/105031794533?origin=resultslist},
	abstract = {With the increased need for information exchanges, the communication part of stochastic nonlinear multiagent systems (MASs) suffers from the influence of limited communication resources, which brings challenges to the efficiency of the information exchange between agents. This paper investigates the synchronous self-triggered adaptive tracking control problem for stochastic nonlinear MASs. To begin with, a novel synchronous self-triggered mechanism is constructed based on nonlinear impulsive dynamics, which ensures simultaneous updates of agent states and adaptive laws without continuous monitoring. Besides, this mechanism ensures the consistency of triggering instants for the same-order states of multiple agents, thereby effectively avoiding the communication congestion problem caused by asynchronous triggering. Next, a new class of adaptive triggering update law is designed, which expands the feasible parameter domain and enhances system flexibility. In addition, a first-order filter is introduced into the controller design to address the discontinuity of virtual control signal caused by the triggering mechanism. Based on the Lyapunov stability theory, it is shown that the designed controller can ensure that all signals in the closed-loop system stay bounded in probability. Finally, a simulation example is conducted to further demonstrate the validity of the presented control method. © 2026 Informa UK Limited, trading as Taylor & Francis Group.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Park20261305,
	author = {Park, Jinbum and Lee, Dongje and Kang, Yejin and Kim, Hanguen and Jang, Hyesu},
	title = {M2rDM: A Map-Conditioned Diffusion Model for Maritime X-Band Radar Synthesis and Dynamic Object Suppression},
	year = {2026},
