@ARTICLE{He2026,
	author = {He, Jianghai and Wang, Zegen and Ran, Yaowen and Liu, Xia and Pu, Xinming and Wang, Zehua},
	title = {GMFNet: A gated multi-stage fusion network for efficient sewer defect detection based on inherent pipe joint feature},
	year = {2026},
	journal = {Applied Soft Computing},
	volume = {201},
	pages = {},
	doi = {10.1016/j.asoc.2026.115492},
	url = {https://www.scopus.com/pages/publications/105040027861?origin=resultslist},
	abstract = {Sewer defect detection is a very important technique to guarantee sewer pipe quality and prolong its service life. Surveillance videos captured by closed-circuit television (CCTV) often offer massive image data, which allows the development of convolutional neural network (CNN)-based methods. However, conventional approaches often overlook the intrinsic features inherent in the data and struggle to obtain effective detect performance. In this paper, we exploit the fact that pipe joints are intrinsic feature and propose a gated multi-stage fusion network (GMFNet) for sewer defect detection. After feature extraction of defect and pipe joint by a modified CNN, we design a simple and efficient feature fusion module with a gating mechanism named gated channel fusion module (GCFM). GCFM focuses on the general information of low-level features and the semantic information of high-level features, enabling adaptive delivery of distinct features. The GCFM is also able to purify interference and enrich semantics in the fusion process. To enable information communication between the two features, we propose an aggregated channel shuffle (ACS). After that, we develop a gated decoupled channel attention (GDCA) to unveil the behavior of the pipe joint mask. Experiment results demonstrate that the proposed model achieved a precision (P) of 0.678, a recall (R) of 0.356, and a mean average precision (mAP) of 0.503 on benchmark dataset, some of which are far superior to the baseline (P: 0.627, R: 0.357, mAP: 0.433) and other existing models. These results demonstrated the significant positive influence of pipe joint features on sewer defect detection. © 2026 Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wang2026,
	author = {Wang, Ziyang and Tong, Wenfu and Zhou, Haibo and Li, Mingjun and Wang, Xiaozhuo and Cheng, Biyao},
