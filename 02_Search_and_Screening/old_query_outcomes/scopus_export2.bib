@ARTICLE{Xu2023214,
	author = {Xu, Xiaobin and Qu, Qinyang and Zhang, Haojie and Wang, Jiali and Wu, Jialin and Ran, Yingying and Tan, Zhiying},
	title = {Polarized laser target detection system for smoky environment based on full-waveform decomposition and multiscale convolutional neural networks with attention},
