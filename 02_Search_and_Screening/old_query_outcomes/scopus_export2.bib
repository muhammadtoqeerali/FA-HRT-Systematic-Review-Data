@ARTICLE{Song202211523,
	author = {Song, Seungwon and Lim, Hyungtae and Lee, Alex Junho and Myung, Hyun},
	title = {DynaVINS: A Visual-Inertial SLAM for Dynamic Environments},
	year = {2022},
	journal = {IEEE Robotics and Automation Letters},
	volume = {7},
