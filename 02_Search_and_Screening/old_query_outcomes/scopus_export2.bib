	note = {Cited by: 22}
}

@ARTICLE{Billah20231316,
	author = {Billah, Md Arif and Faruque, Imraan A.},
	title = {Robustness in bio-inspired visually guided multi-agent flight and the gain modulation hypothesis},
	year = {2023},
	journal = {International Journal of Robust and Nonlinear Control},
	volume = {33},
