	note = {Cited by: 4}
}

@ARTICLE{Li2023,
	author = {Li, Zehua and Shang, Junna and Shi, Huli},
	title = {Factor Graph with Local Constraints: A Magnetic Field/Pedestrian Dead Reckoning Integrated Navigation Method Based on a Constrained Factor Graph},
	year = {2023},
	journal = {Electronics (Switzerland)},
	volume = {12},
	number = {18},
	pages = {},
	doi = {10.3390/electronics12183832},
	url = {https://www.scopus.com/pages/publications/85172936739?origin=resultslist},
	abstract = {The method of multi-sensor integrated navigation improves navigation accuracy by fusing various sensor data. However, when a sensor is disturbed or malfunctions, incorrect measurement information will seriously affect the estimation of the trajectory, which will lead to a decrease in accuracy. Existing factor graph models based on weights can neither fully resist the influence of disturbances nor guarantee the local rationality of estimated trajectories. In this paper, a factor graph with local constraints model that fuses the magnetic field and pedestrian dead reckoning data is proposed to navigate complex curved trajectories. First, adding local constraints to the pedestrian dead reckoning measurement converts the navigation solution problem into a hard-constrained nonlinear least squares problem. Then, a mapping model is constructed to reconstruct the variable space and the Adam gradient algorithm is used to realize a fast calculation. The navigation accuracy of this algorithm is better than that of the state-of-the-art method in real-world experiments, with an average accuracy of 0.83 m. © 2023 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6; All Open Access; Gold Open Access}
}

@CONFERENCE{Song2023,
	author = {Song, Weimin and Wen, Chuanbo},
	title = {Multi-sensor system fusion estimation based on improved Kalman filtering},
	year = {2023},
	journal = {Proceedings of SPIE - The International Society for Optical Engineering},
	volume = {12922},
	pages = {},
	doi = {10.1117/12.3009149},
	url = {https://www.scopus.com/pages/publications/85176266420?origin=resultslist},
	abstract = {For the sampling points of sensors at different moments, a sequential asynchronous algorithm to improve multi-sensor fusion is proposed after using the idea of sequential discretization to achieve fusion estimation of position states. It is assumed that the system uses N sensors with different sampling rates for the observed position states. Among them, a multi-rate Kalman filter is designed to estimate the target position at multiple scales with multiple sampling rates. The equation of state between the different sampling points during each sampling moment of the fusion cycle can be obtained as well as the measurement equation at this point in the cycle. Using an optimized linear Kalman filtering algorithm, a sequential fusion process of signals observed by asynchronous sampling is investigated in one cycle to achieve a good estimation of the target position. The effectiveness of the improved algorithm is verified by a numerical example simulation, and the advantages of the algorithm in terms of less computation, good real-time performance and high estimation of fusion accuracy are evident. © 2023 SPIE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Liu2024526,
	author = {Liu, Aoqi and Lai, Guanyu and Xiao, Hanzhen and Liu, Zhi and Zhang, Yun and Chen, C.L. Philip},
	title = {Resilient adaptive trajectory tracking control for uncalibrated visual servoing systems with unknown actuator failures},
	year = {2024},
	journal = {Journal of the Franklin Institute},
	volume = {361},
	number = {1},
	pages = {526 - 542},
	doi = {10.1016/j.jfranklin.2023.12.011},
	url = {https://www.scopus.com/pages/publications/85181149100?origin=resultslist},
	abstract = {A resilient adaptive tracking control scheme for uncalibrated visual servoing system with unknown actuator failures is proposed, where the camera parameters, the robotic physical parameters, and the position information of end-effector cannot be measured accurately. For our scheme, the nonlinear composite Jacobian matrix involving unknown parameters is estimated by an adaptive algorithm based on the depth-independent interaction matrix frame so that the image feature with time-varying depth can be tackled effectively. With the use of projection technique in the adaptive algorithm, the possible singularity of the estimated composite Jacobian matrix can be well circumvented without any stringent assumption, which is critical for establishing the closed-loop stability. Moreover, a novel adaptive resilient control scheme based on dynamic decoupling is developed to separate the design of visual servoing controller and fault compensation, improving the visual servoing system resilience against unknown actuator failures in uncalibrated environment. Through a rigorous Lyapunov argument, the asymptotic convergence of image tracking error to zero is established successfully regardless of the occurrence of unknown actuator failures. The effectiveness of the proposed visual tracking control scheme is confirmed by simulation results. © 2023 The Franklin Institute},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7}
}

@ARTICLE{Meng2023,
	author = {Meng, Jie and Xiao, Hanbiao and Jiang, Liyu and Hu, Zhaozheng and Jiang, Liquan and Jiang, Ning},
	title = {Adaptive Model Predictive Control for Mobile Robots with Localization Fluctuation Estimation},
	year = {2023},
	journal = {Sensors},
	volume = {23},
	number = {5},
	pages = {},
	doi = {10.3390/s23052501},
	url = {https://www.scopus.com/pages/publications/85149741714?origin=resultslist},
	abstract = {Mobile robots are widely employed in various fields to perform autonomous tasks. In dynamic scenarios, localization fluctuations are unavoidable and obvious. However, common controllers do not consider the impact of localization fluctuations, resulting in violent jittering or poor trajectory tracking of the mobile robot. For this reason, this paper proposes an adaptive model predictive control (MPC) with an accurate localization fluctuation assessment for mobile robots, which balances the contradiction between precision and calculation efficiency of mobile robot control. The distinctive features of the proposed MPC are three-fold: (1) Integrating variance and entropy—a localization fluctuation estimation relying on fuzzy logic rules is proposed to enhance the accuracy of the fluctuation assessment. (2) By using the Taylor expansion-based linearization method—a modified kinematics model that considers that the external disturbance of localization fluctuation is established to satisfy the iterative solution of the MPC method and reduce the computational burden. (3) An improved MPC with an adaptive adjustment of predictive step size according to localization fluctuation is proposed, which alleviates the disadvantage of a large amount of the MPC calculation and improves the stability of the control system in dynamic scenes. Finally, verification experiments of the real-life mobile robot are offered to verify the effectiveness of the presented MPC method. Additionally, compared with PID, the tracking distance and angle error of the proposed method decrease by 74.3% and 95.3%, respectively. © 2023 by the authors.},
	pmid = {36904708},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 16; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Inostroza2023,
	author = {Inostroza, Felipe and Parra-Tsunekawa, Isao and Ruiz-del-Solar, Javier},
	title = {Robust Localization for Underground Mining Vehicles: An Application in a Room and Pillar Mine},
	year = {2023},
	journal = {Sensors},
	volume = {23},
	number = {19},
	pages = {},
	doi = {10.3390/s23198059},
	url = {https://www.scopus.com/pages/publications/85174035569?origin=resultslist},
	abstract = {Most autonomous navigation systems used in underground mining vehicles such as load–haul–dump (LHD) vehicles and trucks use 2D light detection and ranging (LIDAR) sensors and 2D representations/maps of the environment. In this article, we propose the use of 3D LIDARs and existing 3D simultaneous localization and mapping (SLAM) jointly with 2D mapping methods to produce or update 2D grid maps of underground tunnels that may have significant elevation changes. Existing mapping methods that only use 2D LIDARs are shown to fail to produce accurate 2D grid maps of the environment. These maps can be used for robust localization and navigation in different mine types (e.g., sublevel stoping, block/panel caving, room and pillar), using only 2D LIDAR sensors. The proposed methodology was tested in the Werra Potash Mine located at Philippsthal, Germany, under real operational conditions. The obtained results show that the enhanced 2D map-building method produces a superior mapping performance compared with a 2D map generated without the use of the 3D LIDAR-based mapping solution. The 2D map generated enables robust 2D localization, which was tested during the operation of an autonomous LHD, performing autonomous navigation and autonomous loading over extended periods of time. © 2023 by the authors.},
	pmid = {37836889},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
