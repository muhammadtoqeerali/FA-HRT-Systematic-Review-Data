	pages = {},
	doi = {10.1016/j.mechmachtheory.2026.106574},
	url = {https://www.scopus.com/pages/publications/105047651940?origin=resultslist},
	abstract = {The accurate recognition and realization of amputees' intentions is the primary goal of intelligent prostheses, yet the complexity of human joint biomechanics complicates motion intent recognition. Furthermore, existing prosthetic actuators differ markedly from biological actuation, requiring sophisticated decoding models to interpret neuromuscular outputs. This study establishes an anatomy-guided function-to-topology mapping that determines the actuation paths, constraint layout, load-bearing skeleton, and compliant transmission of a three-degree-of-freedom wrist. The mapping configures shared antagonistic cables for muscle actuation, a universal-joint skeleton for structural support and kinematic constraint, and elastic bands for ligament-like passive restraint, thereby generating flexion/extension and radial/ulnar deviation with end-range limitation and restoring torque. A variable-stiffness mechanism reconfigures its pulley-link-torsion-spring geometry to produce nonlinear, state-dependent compliance; inertial feedback compensates for the resulting motion errors; a self-locking mechanism secures the pronation/supination axis. Together, these features enhance flexibility and stability. Beyond verifying basic mechanical performance, tracking of non-periodic, dual-axis trajectories drawn from activities of daily living validates the coordinated motion arising from the anatomy-guided topology. Offline simulation further indicates the feasibility of driving the mechanism directly from measured electromyographic signals. © 2026 Elsevier Ltd},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

