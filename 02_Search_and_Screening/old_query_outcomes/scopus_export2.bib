	doi = {10.1109/CYBER63482.2024.10749345},
	url = {https://www.scopus.com/pages/publications/85212050816?origin=resultslist},
	abstract = {In environments with similar geometric structures or sparse features, it is extremely challenging for mobile robots to perform LiDAR simultaneous localization and mapping. This paper presents a new vision-inertial-aided degenerate-robust LiDAR SLAM (DR-SLAM) based on dual confidence ellipsoid oblateness. First, to solve the problem of scale inconsistency between rotation and translation subspaces in traditional degradation judgment algorithms, this paper proposes a novel degradation judgment algorithm based on dual confidence ellipsoid oblateness, which is insensitive to environmental changes. Then, we develop a vision-inertial-aided degenerate-robust LiDAR SLAM system. The visual-inertial odometry provides a priori pose, and the LiDAR point cloud is used to update the pose in well-constrained directions. Finally, experimental results in both self-built simulation environments and real-world scenarios demonstrate that DR-SLAM outperforms state-of-the-art methods in terms of accuracy and robustness. © 2024 IEEE.},
