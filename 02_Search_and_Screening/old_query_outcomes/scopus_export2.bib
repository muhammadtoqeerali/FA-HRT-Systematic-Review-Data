	doi = {10.5755/j02.mech.34093},
	url = {https://www.scopus.com/pages/publications/85192436993?origin=resultslist},
	abstract = {In the attitude calculation process of quadrotor, the traditional pre-filtering method has degraded the attitude solving accuracy due to incomplete denoising of accelerometer and gyroscope measurements. Therefore, a complementary filtered attitude solution method based on double filter preprocessing is proposed to address this problem. First, the signal decomposition, hard threshold denoising, and signal reconstruction of the accelerometer and gyroscope acquired data are performed using the Haar real-time wavelet filtering algorithm. The reconstructed signal is then filtered by the infinite impulse response (IIR) low-pass filtering algorithm to remove the residual high-frequency noise and complete the dual filtering preprocessing. Next, the gyroscope data is corrected with accelerometer data according to the complementary filtering algorithm. Finally, the corrected data are used to solve the quaternion and thus the attitude angle by combining the Longacurta method. The results show that the dual filtering preprocessing method can further reduce the noise in the measurements of accelerometer and gyroscope. The attitude angle results calculated by the proposed method in the static and dynamic hovering states of the four-rotor aircraft have a small degree of dispersion, which can effectively improve the accuracy of attitude calculation. © 2024 Kauno Technologijos Universitetas. All rights reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5; All Open Access; Gold Open Access}
}

@ARTICLE{Liu2023259,
	author = {Liu, Cong and Liu, Hui and Han, Lijin and Xiang, Changle},
	title = {New Integrated Multi-Algorithm Fusion Localization and Trajectory Tracking Framework of Autonomous Vehicles under Extreme Conditions with Non-Gaussian Noises},
	year = {2023},
	journal = {International Journal of Automotive Technology},
	volume = {24},
	number = {1},
	pages = {259 - 272},
	doi = {10.1007/s12239-023-0023-8},
	url = {https://www.scopus.com/pages/publications/85148443735?origin=resultslist},
	abstract = {This paper proposes a novel integrated multi-algorithm fusion localization and trajectory tracking framework for autonomous vehicles under extreme conditions with non-Gaussian noises. Firstly, in order to solve the problem that GPS signals are interfered with non-Gaussian noises or lost, a localization method based on Particle Filter (PF) is designed, which takes full advantage of the reference objects position information and vehicle driving state information, thus realizing the self-localization for high-speed autonomous vehicles. Besides, considering the accumulated errors of the model-driven Inertial Measurement Unit (IMU) in the long-horizon positioning prediction, an online future driving state prediction algorithm based on multi-order variable-step Markov model (MM) is proposed to calculate the future vehicle position in scenarios without reference. The fusion of these two methods can give full play to their respective advantages, thus improving the accuracy and robustness of the whole localization algorithm in scenes with non-Gaussian noises. Then, the location information and the future driving state are applied to the trajectory tracking controller based on adaptive model predictive control (AMPC). Finally, the CarSim-Matlab/Simulink cGAOo-simulations results show the effectiveness of the proposed framework when GPS signal is interfered with non-Gaussian noises, which further improve the positioning accuracy and autonomous tracking stability. © 2023, KSAE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

@ARTICLE{Lin2023,
	author = {Lin, Huei-Yung and Zhan, Jia-Rong},
	title = {GNSS-denied UAV indoor navigation with UWB incorporated visual inertial odometry},
	year = {2023},
	journal = {Measurement: Journal of the International Measurement Confederation},
	volume = {206},
	pages = {},
	doi = {10.1016/j.measurement.2022.112256},
	url = {https://www.scopus.com/pages/publications/85145561846?origin=resultslist},
	abstract = {The localization of unmanned aerial vehicles (UAVs) in GPS-denied areas is an essential issue for indoor navigation. This paper presents a technique to improve the accuracy of visual inertial odometry (VIO) by combining the ultra-wideband (UWB) positioning technology. The proposed architecture is divided into two stages. In the initial stage, the constraint on UWB short-term position change is adopted to improve the pose estimation results of the VIO system. It is also used to mitigate the translation error caused by the vibration and lack of features during the flight. In the second stage, a loose coupling approach based on nonlinear optimization is utilized to fuse the local pose estimator of the VIO system with the global constraints from the UWB positioning. At the beginning of each operation, the alignment between the VIO and UWB frames is estimated to avoid the influence of coordinate transformation due to the VIO cumulative error. It is shown that our optimization-based fusion method is able to achieve a smooth localization trajectory under the global coordinate frame. In the experiments, the performance evaluation carried out in the real-world scenes has demonstrated the effectiveness of the proposed technique. © 2022 Elsevier Ltd},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 96}
}

@ARTICLE{Mi20241,
	author = {Mi, Jing and Wang, Qing and Liu, Pengfei and Han, Xiaotao},
	title = {A Performance Enhancement Method for Redundant IMU Based on Neural Network and Geometric Constraint},
	year = {2024},
	journal = {IEEE Transactions on Instrumentation and Measurement},
	volume = {73},
	pages = {1 - 11},
	doi = {10.1109/TIM.2024.3368485},
	url = {https://www.scopus.com/pages/publications/85186085712?origin=resultslist},
	abstract = {The predicament stems from the fact that low-cost inertial measurement unit (IMU), operating within a context of global satellite navigation system (GNSS) denial, faces difficulties in autonomously providing continuous and high-precision navigational information to unmanned ground vehicles (UGVs). This challenge is primarily attributed to the accumulation of IMU errors over time. In this article, a hybrid approach integrating improved propagation neural network based on random forest regression (RFR-IBPNN) with geometrical information for redundant IMU (RIMU) is proposed to provide a reliable and high-precision navigation solution in GNSS-denied scenarios. Specifically, the dynamic function is designed to adjust the learning rate adaptively, which can avert deficiencies of slow convergence speed and randomness of initial value in the backpropagation neural network (BPNN). Then, random forest regression based on ensemble learning is adopted to optimize single BPNN and improve the reliability and prediction accuracy of the neural network trained with a small number of samples. Furthermore, the geometric model of RIMU system is derived and introduced as dynamic information to further improve the measurement accuracy. The feasibility and effectiveness of the proposed method in this article were proved via experiment. In contrast to the single IMU, multiple-IMUs based on least square method fusion, and single BP neural networks, the proposed method in this article achieved a substantial 40% enhancement in navigation accuracy.  © 1963-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 12}
}

@ARTICLE{Jin20241,
	author = {Jin, Xiaofeng and Ge, Jianfei and Xiao, Jiangjian and Bu, Ningbo and Xu, Gen},
	title = {IPAL: Infinite Planes as Lines for Consistent Mapping in Indoor Multifloor Environments},
	year = {2024},
	journal = {IEEE Transactions on Instrumentation and Measurement},
	volume = {73},
	pages = {1 - 11},
	doi = {10.1109/TIM.2024.3353846},
	url = {https://www.scopus.com/pages/publications/85182927856?origin=resultslist},
	abstract = {Indoor high-precision maps are harder to obtain. Numerous researchers considered the extendibility of indoor plane features to constrain the poses and improve mapping consistency. However, the usage of parametric planar or line features requires complex modeling, and threshold-based matching methods are eager to lead to degradation. Indeed, planes can be more simply represented as line projections, with the projection direction perpendicular to the plane's normal vector. In this article, we proposed a novel mapping optimization framework that incorporates building outline features specifically designed for multistory buildings. The framework consists of three main components: LiDAR bundle adjustment (LBA), global constraints based on building outline features, and factor graph optimization. The method extracts the ground only for horizontal correction, while the core idea is based on the assumption of vertical structure, projecting the point cloud contours of multistory buildings to the top view perspective for independent spatial pose correlation, which is a strong constraint and very effective. Finally, constraints are constructed based on keyframes and intermediate frames are refined by a factor graph. Through extensive experiments conducted on multistory buildings, we demonstrate that our algorithm significantly enhances mapping consistency and local accuracy compared to existing methods.  © 1963-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@CONFERENCE{Jin202355,
	author = {Jin, Lingqiu and Ye, Cang},
	title = {VCU-RVIL: A Multi-Sensor Dataset for Benchmark of Simultaneous Localization and Mapping},
	year = {2023},
	journal = {ISKE 2023 - 18th International Conference on Intelligent Systems and Knowledge Engineering},
	pages = {55 - 61},
	doi = {10.1109/ISKE60036.2023.10481407},
	url = {https://www.scopus.com/pages/publications/85191025463?origin=resultslist},
	abstract = {This paper presents VCU-RVIL-a multi-sensor dataset-for the benchmark of Simultaneous Localization and Mapping (SLAM) algorithms. The dataset contains diverse data sequences captured in various indoor and outdoor environments from a sensor suite and a GNSS-RTK receiver installed on a ground robot (Husky Jackal). The sensor suite consists of a solid-state LiDAR camera, a fisheye stereo camera, a 3D scanning LiDAR, and two IMUs that are popular robotic sensors. It produces synchronized visual, depth, and inertial data. The GNSS-RTK receiver provides ground truth robot positions with centimeter accuracy. The data from the sensor suite and the GNSS-RTK are paired to form the data sequences of the dataset. VCU-RVIL comprises 27 data sequences (size: 2TB) acquired from various indoor/outdoor environments by driving the ground robot in these environments. The dataset overcomes the drawback of existing SLAM datasets - limited sensor modalities and/or limited operating environments. It can be used by researchers/ developers to support their efforts in developing SLAM methods (e.g., test, evaluate, fine-tune the methods, and compare them with existing SLAM methods), or assist them in deciding the best sensor modality for their SLAM systems. We are currently working to make it publicly available.  © 2023 IEEE.},
