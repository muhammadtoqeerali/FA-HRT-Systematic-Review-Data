@ARTICLE{Zheng202626386,
	author = {Zheng, Jiajun and Li, Yancheng and Zhao, Jinjing and Chen, Yunfan and Xu, Jingjing and Xu, Shengyong},
	title = {Residual Reweighting With Scan Normalization for LiDAR-Inertial Odometry in Degenerate Environments},
	year = {2026},
	journal = {IEEE Sensors Journal},
	volume = {26},
	number = {17},
	pages = {26386 - 26400},
	doi = {10.1109/JSEN.2026.3714871},
	url = {https://www.scopus.com/pages/publications/105045790815?origin=resultslist},
	abstract = {In geometrically degenerate or sparse environments with spatially varying LiDAR measurement quality, existing LiDAR-inertial odometry (LIO) systems generally assume homoscedastic residuals or rely on coarse sensor-level covariance models. Such assumptions cannot adequately reflect pointwise and directionwise differences in observability, allowing low-quality constraints to skew the filtering update. This article proposes a lightweight observation-side plug-in module termed degeneracy-guided update (DGU), which can be integrated into existing LIO frameworks. DGU introduces residual reweighting based on pointwise quality scores, together with scan-level motion modulation, nonexpansive scan normalization, and degeneracy-aware control, to regularize linearized LiDAR measurement updates in a bounded manner. Experiments on public benchmarks (NTU VIRAL, SubT-MRS, and M2DGR) and self-collected robotic sequences show that DGU mitigates degeneracy-induced drift and improves odometry accuracy in degenerate scenarios, including repetitive facades, long corridors, and underground caves. In well-conditioned scenes, it remains conservative and preserves the baseline odometry and mapping performance of the host systems. © 2026 IEEE. All rights reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

