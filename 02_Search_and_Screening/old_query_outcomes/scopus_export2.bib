	title = {Efficient visual sensor fusion for autonomous agents},
	year = {2023},
	journal = {2023 International Conference on Control, Automation and Diagnosis, ICCAD 2023},
	pages = {},
	doi = {10.1109/ICCAD57653.2023.10152399},
