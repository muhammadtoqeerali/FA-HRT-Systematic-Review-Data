}

@ARTICLE{Cheng2025,
	author = {Cheng, Long and Fu, Zhentao},
	title = {An adaptive Kalman filter loosely coupled indoor fusion positioning system based on inertial navigation system and ultra-wide band},
	year = {2025},
	journal = {Measurement: Journal of the International Measurement Confederation},
