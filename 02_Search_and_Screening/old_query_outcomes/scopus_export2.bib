@CONFERENCE{Li20254578,
	author = {Li, Hang and Huang, Lun and Sun, Shaoxin and Song, Pengfei and Qin, Zongchen},
	title = {An Indoor-Outdoor Continuous Localization Method Based on Multi-Sensor Fusion},
	year = {2025},
	journal = {Chinese Control Conference, CCC},
	pages = {4578 - 4583},
	doi = {10.23919/CCC64809.2025.11178666},
	url = {https://www.scopus.com/pages/publications/105020299051?origin=resultslist},
	abstract = {As the basis of mapping and navigation of mobile robots, localization technology plays a vital role in the field of robotics. In this paper, a fault-tolerant indoor-outdoor multi-sensor adaptive fusion localization method is presented. This method aims to solve the problem of a single sensor losing signal when a mobile robot is located in indoor-outdoor environments. Firstly, ground point cloud segmentation is applied to the NDT (Normal Distributions Transform) algorithm, which improves the registration speed by nearly 36% compared to the original method. Then, based on the improved point cloud registration localization method, a multi-sensor adaptive switching fusion algorithm is carried out by combining ESKF (Error State Kalman Filter) and the motion constraints of the robot kinematics model. This algorithm effectively isolates the failed sensors and improves the accuracy and robustness of continuous localization in indoor-outdoor environments. Finally, in order to verify the effectiveness of the proposed method, a long-term localization test is conducted in indoor-outdoor continuous environments. The experimental results show that the proposed method can effectively improve the speed of LiDAR (Light Detection and Ranging) point cloud registration, and ensure localization accuracy and robustness when a single sensor fails. © 2025 Technical Committee on Control Theory, Chinese Association of Automation.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Klüpfel20254459,
	author = {Klüpfel, Leonard and Burkhard, Lukas and Reichert, Anne Elisabeth and Durner, Maximilian and Triebel, Rudolph},
	title = {Seeing Through Uncertainty: Robot Pose Estimation Based on Imperfect Prior Kinematic Knowledge},
	year = {2025},
	journal = {IEEE Transactions on Robotics},
	volume = {41},
	pages = {4459 - 4478},
	doi = {10.1109/TRO.2025.3577030},
	url = {https://www.scopus.com/pages/publications/105007600508?origin=resultslist},
	abstract = {We present prior knowledge robot keypoint detection (PK-ROKED), a learning-based pipeline for probabilistic robot pose estimation relative to a camera, addressing inaccuracies in forward kinematics, particularly in systems with elastic and lightweight modules. Our approach integrates a probabilistic 2-D keypoint detection mechanism that leverages prior knowledge derived from the robot’s imprecise kinematics. We further improve the detection accuracy and geometric understanding by incorporating segmentation of the robot arm. The method computes reliable uncertainty estimates, enabling a robust 2D–6D fusion for precise robot arm pose estimation from a single detected keypoint. PK-ROKED requires only synthetic training data, effectively exploits imperfect kinematics as valuable prior knowledge, and introduces a novel fusion framework for enhanced robot pose estimation. We validate our method on the Panda-Orb dataset, demonstrating competitive performance against state-of-the-art approaches. In addition, we evaluate on two other robotic systems in real-world scenarios and show its practicality by using the predictions to initialize a tracking algorithm. Code and pretrained models are available. © 2004-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Fu2025,
	author = {Fu, Minglei and Li, Shengzhou and Jin, Yuqiang and Zhang, Wen-An and Sychou, Uladzislau and Skobtsov, Vadim and Sobolevskii, Vladislav and Sokolov, Boris},
	title = {Fusion or not: Learning visual relocalization with matrix Fisher distribution},
	year = {2025},
	journal = {Neurocomputing},
	volume = {618},
	pages = {},
	doi = {10.1016/j.neucom.2024.129033},
	url = {https://www.scopus.com/pages/publications/85210898238?origin=resultslist},
	abstract = {Visual relocalization is crucial for applications such as simultaneous localization and mapping (SLAM) and augmented reality. State-of-the-art methods based on multiple view geometry struggles with robust localization in challenging environments due to visual perturbations. Recently, deep learning-based absolute pose regression (APR) has gained significant attention owing to its robust feature extraction capabilities, yet it consistently falls short of matching the localization accuracy achieved by structure-based localization methods. In the paper, a novel visual localization framework is developed, which fuses geometric structure methods with neural network inference via the matrix Fisher distribution on the special orthogonal group SO(3). To be specific, a deep neural network is trained to generate the exponential probability density model on SO(3), i.e., the matrix Fisher distribution, which does not require the implementation of complex functions to constrain the rotational variables and can simultaneously model the uncertainty of the rotation estimates. A Bayesian fusion method is then introduced to fuse the orientation predictions recovered from the Fisher parameters with the rotation estimates computed by a structure-based approach. Moreover, the fusion results are concatenated with the feature encoding of the image to compensate for the correlation with the rotational variables, and the position prediction is output through a fully connected layer. The performance of the developed localization framework is evaluated via public indoor and outdoor datasets, demonstrating that the approach significantly improves localization accuracy while remaining robust in challenging environments. © 2024 Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

@ARTICLE{Schichler2025,
	author = {Schichler, Lukas and Festl, Karin and Solmaz, Selim},
	title = {Robust Multi-Sensor Fusion for Localization in Hazardous Environments Using Thermal, LiDAR, and GNSS Data},
	year = {2025},
	journal = {Sensors},
	volume = {25},
	number = {7},
	pages = {},
	doi = {10.3390/s25072032},
	url = {https://www.scopus.com/pages/publications/105002239749?origin=resultslist},
	abstract = {Navigation for autonomous robots in hazardous environments demands robust localization solutions. In challenging environments such as tunnels and urban disaster areas, autonomous robots and vehicles are particularly important for search and rescue operations. However, especially in these environments, sensor failures and errors make the localization task particularly difficult. We propose a robust sensor fusion algorithm that integrates data from a thermal camera, a LiDAR sensor, and a GNSS to provide reliable localization, even in environments where individual sensor data may be compromised. The thermal camera and LiDAR sensor employ distinct SLAM and odometry techniques to estimate movement and positioning, while an extended Kalman filter (EKF) fuses all three sensor inputs, accommodating varying sampling rates and potential sensor outages. To evaluate the algorithm, we conduct a field test in an urban environment using a vehicle equipped with the appropriate sensor suite while simulating an outage one at a time, to demonstrate the approach’s effectiveness under real-world conditions. © 2025 by the authors.},
