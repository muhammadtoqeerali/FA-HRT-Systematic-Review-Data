@ARTICLE{Ding2026,
	author = {Ding, Lei and Hu, Zhiying and Yue, Jin and Li, Dong},
	title = {Low-illumination robust 4D scene reconstruction via event-guided temporal Gaussian hierarchy and Retinex-neural radiance fields for tunnel autonomous navigation},
	year = {2026},
	journal = {Engineering Research Express},
	volume = {8},
	number = {13},
	pages = {},
	doi = {10.1088/2631-8695/ae7e42},
	url = {https://www.scopus.com/pages/publications/105043524140?origin=resultslist},
	abstract = {For autonomous tunnel navigation without GPS, the ill-conditioned photometric decoupling under extreme low light and spatiotemporal feature drift caused by high-speed travel make traditional visual 4D scene reconstruction prone to failure. This paper proposes an event-guided temporal Gaussian hierarchy and Retinex neural radiance field (ETR-GS) architecture for robust low-illumination perception. The architecture follows a three-step logic: spatiotemporal alignment, photometric decoupling, and hierarchical scheduling. First, continuous-time B-splines achieve microsecond-level cross-modal anchoring between asynchronous event streams and discrete red green blue frames. Second, event gradient regularization drives Retinex physical priors, explicitly decomposing the Gaussian rendering equation into base albedo and dynamic illumination, thus resolving geometric collapse under unsupervised conditions. Third, an event-energy hard-triggered local deformation multi layer perceptron, combined with a view-frustum-aware octree, constructs a spatial hierarchy to avoid memory explosion in long sequences. Comparative experiments demonstrate: (1) under the ‘black hole effect’ (10 000 Lux → 5 Lux), the model achieves PSNR of 29.71 dB and LPIPS of 0.146. (2) At 120 km h<sup>−1</sup> nonlinear motion, the absolute trajectory error peak is constrained within 15 cm. (3) Over two-kilometer continuous inference, peak VRAM stays at 5–10 GB with 31.2 ms per frame. (4) Under extreme overlapping interference (120 km h<sup>−1</sup>, 5 Lux), the occupancy grid reduces the collision rate to 4.5%. This architecture provides high-fidelity, low-latency 3D perception for high-order autonomous driving in GPS-denied environments. © 2026 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved. This article is available under the terms of the https://publishingsupport.iopscience.iop.org/iop-standard/v1.},
