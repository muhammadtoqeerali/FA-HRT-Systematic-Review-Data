@ARTICLE{Song2025,
	author = {Song, Zhixing and Zhang, Xuebo and Wang, Runhua and Zhang, Shiyong and Wu, Songyang and Wang, Youwei and Yuan, Jing},
	title = {FI-SLAM: Feature Information-Based Robust and Efficient LiDAR SLAM},
	year = {2025},
	journal = {IEEE Transactions on Instrumentation and Measurement},
