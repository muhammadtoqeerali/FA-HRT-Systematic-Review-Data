}

@ARTICLE{Zhao2025,
	author = {Zhao, Zhibo and Zhang, Hongjuan and Li, Bijun and Guo, Ziyi and Liu, Minzhe and Qian, Chuang},
	title = {Optimizing the long-range consistent extraction of vehicle trajectory using low-channel roadside LiDAR data},
	year = {2025},
	journal = {International Journal of Digital Earth},
	volume = {18},
	number = {2},
	pages = {},
	doi = {10.1080/17538947.2025.2552883},
	url = {https://www.scopus.com/pages/publications/105015334457?origin=resultslist},
	abstract = {Vehicle trajectories are essential for analyzing the traffic flow, safety, and efficiency. With the advance of intelligent roadside infrastructures, LiDAR significantly helps extract vehicle trajectories. However, point sparsity and occlusion impede trajectory extraction in complex traffic environments using low-channel LiDAR, particularly in long-range scenarios. To address these issues, we proposed a novel framework for the long-range, consistent vehicle trajectory extraction using low-channel roadside LiDAR data. First, we introduced a joint clustering and classification method that preserved sparse points and avoided over-segmentation caused by point sparsity and occlusion. An improved Hungarian algorithm was used to associate the detected vehicles in adjacent frames considering the vehicle geometry, motion, and undetected points to solve occlusion-induced association errors. Finally, an adaptive current statistical model (ACSM) for trajectory tracking with an adaptive decaying factor predicted the missing vehicle positions in full occlusion to ensure consistent trajectories. For floating vehicles (e.g. taxis) and automated vehicles, their trajectories were optimized using a pre-established occupancy voxel map (OVM) to improve accuracy. The framework was tested at four stations, with reference data from a high-precision positioning system. Results show that our method achieved a maximum detection range of 117 m, over 97% accuracy, and 0.3-m precision, outperforming state-of-the-art methods. © 2025 The Author(s). Published by Informa UK Limited, trading as Taylor & Francis Group.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

