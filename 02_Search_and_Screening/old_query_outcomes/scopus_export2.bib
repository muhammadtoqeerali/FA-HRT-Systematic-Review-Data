@ARTICLE{Chen20264783,
	author = {Chen, Tianyi and Rushworth, Adam and Jia, Fuhua},
	title = {A Review on Search and Rescue Robots in Complex Scenarios: Key Technologies of Simultaneous Localisation and Mapping},
