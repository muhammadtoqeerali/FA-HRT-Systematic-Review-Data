	author = {Luo, Jianwen and Zhao, Ye and Ruan, Lecheng and Mao, Shixin and Fu, Chenglong},
	title = {Estimation of CoM and CoP Trajectories during Human Walking Based on a Wearable Visual Odometry Device},
