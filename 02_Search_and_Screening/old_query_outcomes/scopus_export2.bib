@ARTICLE{Zhou2027,
	author = {Zhou, Beibei and Zhang, Zhiyuan and Song, Zhenbo and Guo, Jianhui and Zhang, Tongpo and Song, Shaojing and Wu, Qinge and Kong, Hui},
	title = {Generalizing unsupervised LiDAR motion estimation via patch-aware feature reweighting under snowy conditions},
	year = {2027},
	journal = {Pattern Recognition},
