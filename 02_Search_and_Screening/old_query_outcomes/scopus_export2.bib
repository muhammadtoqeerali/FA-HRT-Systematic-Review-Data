@ARTICLE{Liu202410727,
	author = {Liu, Xueyin and Dong, Dawei and Luo, Jianqiao and Li, Bailin},
	title = {Calibrated Aleatoric Uncertainty-Based Adaptive Label Distribution Learning for Pose Estimation of Sichuan Peppers},
