	title = {ADCV: Unsupervised depth completion employing adaptive depth-based cost volume},
	year = {2024},
	journal = {Digital Signal Processing: A Review Journal},
	volume = {155},
	pages = {},
	doi = {10.1016/j.dsp.2024.104750},
	url = {https://www.scopus.com/pages/publications/85203129535?origin=resultslist},
	abstract = {Unsupervised depth completion aims to restore dense depth maps from sparse inputs without relying on ground-truth annotations. However, some current models lack flexibility for capturing multi-scale features and also underutilize inter-view information. To tackle these problems, we propose a model that combines a Deformable Pyramid Vision Transformer (DPVT) with an Adaptive Depth-partitioned Cost Volume (ADCV). Our algorithm employs a conventional branch and a DPVT branch to extract depth and RGB multi-scale features, respectively. The DPVT module enhances self-attention by adaptively adjusting sampling positions for RGB multi-scale features. The Feature Enhancement and Fusion (FEF) module integrates depth and RGB features. Most importantly, the ADCV module utilizes relevant information between views to obtain matching errors for each adaptive depth plane, and then sends the cost volume to the decoder for depth optimization. Quantitative and qualitative assessments on the KITTI and VOID datasets reveal the outstanding performance of our method in depth completion tasks. © 2024 Elsevier Inc.},
