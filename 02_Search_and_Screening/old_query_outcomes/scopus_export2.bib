@CONFERENCE{Breitfuss202412271,
	author = {Breitfuss, Matthias and Geimer, Marcus and Gruber, Christoph},
	title = {Long-Term Map-Maintenance in Changing Environments using Ray-Bundle-Impact-Factor Estimation},
	year = {2024},
