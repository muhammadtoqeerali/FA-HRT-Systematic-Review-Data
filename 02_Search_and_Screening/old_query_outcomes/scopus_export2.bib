@ARTICLE{Kerdjidj202473980,
	author = {Kerdjidj, Oussama and Himeur, Yassine and Sohail, Shahab Saquib and Amira, Abbes and Fadli, Fodil and Atalla, Shadi and Mansoor, W. and Copiaco, Abigail and Gawanmeh, Amjad and Miniaoui, Sami and Dawoud, Diana},
