@ARTICLE{Zhou2026,
	author = {Zhou, Xu and Liao, Qinglin and Yuan, Ranhui and Shi, Gefei and Yang, Xuerong},
	title = {Conflict-aware evidence fusion for robust decentralized cooperative localization},
	year = {2026},
