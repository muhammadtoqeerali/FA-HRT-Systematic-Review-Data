}

@ARTICLE{Sun2022143,
	author = {Sun, Lei},
	title = {RANSIC: Fast and Highly Robust Estimation for Rotation Search and Point Cloud Registration Using Invariant Compatibility},
	year = {2022},
	journal = {IEEE Robotics and Automation Letters},
