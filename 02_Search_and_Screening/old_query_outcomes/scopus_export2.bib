@ARTICLE{Yao2026,
	author = {Yao, Hekai and Zhang, Xuetao and Sun, Gang and Liu, Yisha and Zhuang, Yan},
	title = {GIF-LIO: Geometry-Intensity Fused LiDAR-Inertial Odometry with Degeneracy-Constrained State Estimation},
	year = {2026},
