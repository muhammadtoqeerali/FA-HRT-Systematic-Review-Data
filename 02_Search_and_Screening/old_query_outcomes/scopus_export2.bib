@ARTICLE{Lee202612034,
	author = {Lee, Jaeho and Park, Junwoo and Jeong, Byeong-Min and Jang, Dae-Sung and Choi, Han-Lim},
	title = {In-Depth Cluster Conflict-Based Search for Multi-Agent Path Finding},
	year = {2026},
