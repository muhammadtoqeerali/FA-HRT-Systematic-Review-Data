@ARTICLE{Yang2025,
	author = {Yang, Li and Jun, Zhu and Yanpin, Wang and Yun, Lin and Wenjie, Shen and Wen, Jiang and Zechao, Bai and Lei, Du and Jinping, Sun},
	title = {Compensation for Positional Errors in MMW Radar SLAM Caused by Observation Deviations and Coordinate System Transformation},
	year = {2025},
	journal = {IEEE Transactions on Instrumentation and Measurement},
	volume = {74},
	pages = {},
	doi = {10.1109/TIM.2025.3553241},
	url = {https://www.scopus.com/pages/publications/105003751343?origin=resultslist},
	abstract = {Nowadays, since millimeter-wave (MMW) radar can stably perform simultaneous localization and mapping (SLAM) in bad weather, it plays an important role in application scenarios such as autonomous driving and disaster rescue. Existing research considered the observation of MMW radars is conformed to 0-mean Gaussian distribution, so the localization based on MMW radar is conformed to the distribution, too. However, the change of observation’s distribution because of coordinate transform was ignored. Hence, the conclusion is drawn out that the estimated position will cumulate error with fixed direction when the robot is located by MMW radar after the analysis of this article. This article utilizes the correlative scan matching (CSM) method in radar SLAM to analyze the error form with different coordinate transforms. The error of one landmark, the effect of localization due to a set of landmarks, and the trend of accumulation of errors are analytic, respectively. A simulation method based on Monte Carlo sampling is used to prove the conclusion in theory. In order to solve this problem, a CSM-based cumulative error expectation compensation (CEEC-CSM) method is proposed. Four scene experiments were used to prove that the position error of the CEEC-CSM method is reduced by 49%. © 1963-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wang202594,
	author = {Wang, Yu and He, Zhitao and Chen, Yongyi and Zhang, Dan and Zhang, Hui and Jasinski, Marek},
	title = {Detail-Enhanced Attention Metric Convolutional Network for Anomaly Detection in Mobile Robotic Systems},
	year = {2025},
	journal = {Proceedings of the Annual International Conference on Control, Automation and Robotics, ICCAR},
	number = {2025},
	pages = {94 - 98},
	doi = {10.1109/ICCAR64901.2025.11072997},
	url = {https://www.scopus.com/pages/publications/105013080098?origin=resultslist},
	abstract = {The reliability and safety of robots in various fields have emerged as critical research focal points. Anomaly detection is pivotal for sustaining the normal operation of mobile robots, enabling the timely identification and resolution of anomaly scenarios such as path deviations and sensor failures. Traditional methods often encounter limitations when confronted with largescale data and complex scenarios. This paper introduces a novel deep learning algorithm, i.e., Detail-Enhanced Attention Metric Convolutional Network (DMCN), designed for anomaly detection in mobile robotic systems. A dual-channel embedding module with shared weights is integrated into the DMCN, which automatically extracts and selects salient features from sensor data. The representation of time-series features is optimized, and the Squeeze-Enhanced Axial (SEA) attention mechanism is incorporated to efficiently capture global information and allocate adaptive attention to critical feature channels. The DMCN's effectiveness is validated through experiments using real sensor data of mobile robots, demonstrating its superiority over other methods in terms of detection accuracy. © 2025 IEEE.},
