@CONFERENCE{Mermigkas2025221,
	author = {Mermigkas, Panagiotis and Moustris, George P. and Tzafestas, Costas S. and Maragos, Petros},
	title = {Constructing Visibility Maps of Optimal Positions for Robotic Inspection in Ultra-High Voltage Centers},
	year = {2025},
	journal = {2025 33rd Mediterranean Conference on Control and Automation, MED 2025},
	pages = {221 - 226},
	doi = {10.1109/MED64031.2025.11073348},
	url = {https://www.scopus.com/pages/publications/105012184672?origin=resultslist},
	abstract = {Visibility maps are crucial for autonomous robotic applications such as exploration, path planning, obstacle avoidance, and multi-robot coordination. In the context of electrical transmission infrastructure, automated robotic inspection enhances proactive maintenance, enabling early detection of wear, damage, or faults, thereby improving safety, extending component lifespan, and optimizing maintenance schedules.In this work, we propose an algorithm to compute optimal visibility locations, enabling a mobile robot to acquire RGB and thermal images for fault detection. Using LiDAR scans, we construct a global 3D map composed of ground structures (represented as a Grid Map) and overground structures (modeled with an OctoMap for efficient ray-casting). We apply clustering techniques to identify 3D bounding boxes for electrical components and define suitable source and target points for visibility assessment. By employing a weighted visibility scoring approach, we determine the ground positions that offer the best visibility of each component while ensuring minimal occlusions and adherence to viewing constraints.The proposed method enables a robot to autonomously navigate to these optimal viewpoints, improving inspection efficiency. By integrating visibility regions across multiple components, the inspection process is further optimized, reducing overall inspection time. Our algorithm has been successfully deployed and tested at an Ultra-High Voltage Center (UHVC) in Greece, demonstrating its effectiveness in real-world conditions.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@ARTICLE{Xu2025,
	author = {Xu, Zhiling and Zhong, Xunyu and Wang, Ningning and Hu, Huosheng and Liu, Qiang},
	title = {VG-Fusion: A Novel Visual Geo-Localization Fused with IMU and LiDAR-Inertial Odometry for UAVs in GNSS-Denied Environments},
	year = {2025},
	journal = {Unmanned Systems},
	pages = {},
	doi = {10.1142/S2301385026500561},
	url = {https://www.scopus.com/pages/publications/105010587789?origin=resultslist},
	abstract = {In recent years, unmanned aerial vehicles (UAVs) have experienced rapid advancements. Currently, the long-range autonomous flight capability of UAVs is heavily dependent on GNSS localization. However, achieving robust and rapid localization in GNSS-denied conditions remains a significant challenge in UAV localization and navigation. Existing research methods face several issues, including high time consumption, substantial computing resource requirements and low localization accuracy in field scenes. In this paper, we present a novel visual geo-localization (VG) method for UAV localization in GNSS-denied field environments utilizing remote sensing-UAV image registration to achieve absolute localization. We propose an improved approach for constructing a remote sensing image database and an enhanced method for image registration. Our method relies solely on the remote sensing image database and the images captured by the UAV’s onboard camera. Furthermore, we use LiDAR-inertial odometry (LIO) to compensate the displacement of VG during its operation, and then we obtain the precise and continuous localization by fuse the compensated VG, LIO and IMU using factor graph optimization (FGO) in order to improve the robustness and continuous of the localization system. This fusion method is referred to as VG-fusion. Finally, we conducted VPR benchmarking on public datasets and practical application tests on our own datasets. Across two different field scenes, our method achieves localization accuracy with an average error of less than 10 m, demonstrating its robustness and accuracy. The test results demonstrate that our approach provides continuous, stable and robust localization on a small UAV platform with limited computing power in GNSS-denied conditions. © 2026 World Scientific Publishing Company.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

