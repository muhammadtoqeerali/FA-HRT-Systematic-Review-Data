	doi = {10.1109/TIM.2025.3650287},
	url = {https://www.scopus.com/pages/publications/105027203537?origin=resultslist},
	abstract = {Anomaly-tolerant localization remains a critical challenge for autonomous vehicles, where reliable state estimation must be maintained despite global navigation satellite system (GNSS) degradation. This article presents a robust GNSS/inertial measurement unit (IMU) fusion framework that integrates an error-state Kalman filter (ESKF) with a residual-based detection–identification–adaptation (DIA) mechanism. Operating directly on GNSS observation dimensions, the framework selectively rejects or corrects inconsistent measurements using residual statistics and temporal consistency. The ESKF ensures stable propagation of position, velocity, attitude, and sensor bias, while the DIA module performs real-time residual evaluation, adaptive thresholding, and subset-based fusion to mitigate degraded GNSS inputs. The proposed method was evaluated through high-fidelity simulations and real-world road tests. Under typical GNSS signal degradation scenarios, including multipath propagation, partial obstruction, and sudden jumps, ESKF-DIA consistently delivers the highest trajectory accuracy and anomaly tolerance. Compared to the baseline ESKF method, the proposed method reduces the root mean square error by 20%–35%, maintaining stable performance compared to other novel methods, even with performance degradation. These results demonstrate that the framework provides a robust and practical solution for autonomous localization in complex environments with limited GNSS signals. © 1963-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Gao2026,
