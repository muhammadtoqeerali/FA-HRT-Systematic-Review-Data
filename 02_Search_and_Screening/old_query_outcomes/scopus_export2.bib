@ARTICLE{Gao2025,
	author = {Gao, Wen and Yu, Zhiwen and Wang, Tianfu and Wang, Liang and Cui, Helei and Guo, Bin and Xiong, Hui},
	title = {GNN-based deep reinforcement learning for computation task scheduling in autonomous multi-robot systems},
