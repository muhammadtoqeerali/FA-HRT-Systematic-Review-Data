@ARTICLE{Mao2025,
	author = {Mao, Jianliang and Song, Wenxin and Liang, Hongpeng and Xia, Fei and Zhang, Chuanlin},
	title = {Graph-Optimized Encoder–IMU Fusion for Robust Pipeline Robot Localization in Confined Spaces},
	year = {2025},
