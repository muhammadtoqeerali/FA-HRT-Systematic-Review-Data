	author = {Belkin, Ilya V. and Abramenko, Alexander A. and Bezuglyi, Vitaly D. and Yudin, Dmitry A.},
	title = {Localization of mobile robot in prior 3D LiDAR maps using stereo image sequence},
	year = {2024},
