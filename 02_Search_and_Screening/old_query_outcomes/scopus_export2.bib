@ARTICLE{Kim202665991,
	author = {Kim, Yongseok and Kee, Seok-Cheol},
	title = {Real-Time Localization for Autonomous Vehicles via Fusion of Low-Rate LiDAR Poses and GNSS/IMU Data},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {65991 - 66003},
	doi = {10.1109/ACCESS.2026.3688311},
	url = {https://www.scopus.com/pages/publications/105037824019?origin=resultslist},
	abstract = {Robust real-time localization is a prerequisite for safe autonomous driving. While LiDAR-based methods provide precise local pose estimation, their performance often degrades in environments lacking distinct features like tunnels or open highways or when the pre-built map is outdated due to environmental changes. In contrast, GNSS ensures global consistency but suffers from signal instability in urban canyons. To address these limitations, this paper proposes a robust localization framework based on parallel dual Error-State Kalman Filters (ESKFs). The system maintains two independent estimators: LiDAR-IMU and GNSS-IMU fusion. A key contribution is the dynamic covariance scaling mechanism that translates NDT matching quality into probabilistic uncertainty, allowing the system to assess LiDAR reliability in real-time. By comparing the posterior covariance of the two filters, the framework dynamically selects the more trustworthy estimate and maintains localization continuity under practically common complementary GNSS/LiDAR degradation. Extensive evaluations were conducted on both high-speed custom datasets (up to 110 km/h) and the KITTI residential benchmark. On degraded KITTI maps, the proposed method achieved RMSEs of 0.6727 m and 0.5497 m on Sequences 0027 and 0034, respectively, while preserving a 200 Hz output stream through IMU-rate state propagation.  © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Xie2026,
	author = {Xie, Xiaoen and Zhou, Zhenhua and Zheng, Wuqi and Li, Zeji and Chen, Huahua},
	title = {Robust indoor positioning in impulsive noise environments},
	year = {2026},
	journal = {Digital Signal Processing: A Review Journal},
	volume = {184},
	pages = {},
	doi = {10.1016/j.dsp.2026.106465},
	url = {https://www.scopus.com/pages/publications/105048463665?origin=resultslist},
	abstract = {This paper focuses on the time-of-arrival measurement model, and investigates the problem of robust indoor positioning in impulsive noise environments. To enhance the resistance of the conventional positioning methods to the impulsive noise, the optimum external weighting matrix is derived, and a new robust approach, which is based on the weighted ℓ<sub> p </sub>-norm (WLP) minimization, is devised. To overcome the difficulty in solving the resultant nonconvex optimization problem, the majorization-minimization technique is utilized to relax it as several successive convex counterparts, which are tackled in an iterative way. Furthermore, to improve the positioning accuracy without increasing the number of base stations, a multi-snapshot framework of indoor positioning is proposed, which fuses the multiple time-of-arrival measurements to suppress impulsive noise in a statistically efficient way. The convergence, asymptotic mean square error, and computational complexity of the WLP-based approach are analyzed theoretically. Simulation results demonstrate the robustness of the proposed indoor positioning approach under the Gaussian mixture model noise by comparing with other methods. © 2026 Elsevier Inc.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Zhu20261,
	author = {Zhu, Mengmeng and Guo, Shuai and Zhang, Pengyu and Duan, Hao},
	title = {Robust localization method for mobile robot using feature map in structured environment},
	year = {2026},
	journal = {Industrial Robot},
	pages = {1 - 11},
	doi = {10.1108/IR-11-2025-0430},
	url = {https://www.scopus.com/pages/publications/105048122912?origin=resultslist},
	abstract = {Purpose – Mobile robot localization in structured environments, such as warehouses, is frequently hindered by ghosting inherent in maps generated via 2D Laser Range Finder (LRF)-based SLAM. To address this issue, this study aims to introduce an enhanced localization framework specifically engineered to mitigate these ghosting effects. By effectively filtering out map noise, the proposed method significantly improves positioning robustness and precision, overcoming the limitations often encountered by traditional systems in such scenarios. Design/methodology/approach – The proposed method introduces a novel system to construct optimized feature maps from raw SLAM output, effectively filtering ghosting noise while significantly reducing data volume. Subsequently, the Iterative Closest Point (ICP) algorithm is used to register real-time laser scans against this feature map for precise pose estimation. The framework’s efficacy is validated through comprehensive comparative evaluations in both simulated environments and real-world physical scenarios against conventional baselines. Findings – Experimental results demonstrate that the proposed method significantly outperforms conventional approaches. In real-world tests, the root-mean-square error (RMSE) for translation and rotation was reduced by 0.034 m and 0.6, respectively. Furthermore, the system showed improved efficiency, with computational time decreased by nearly 8.2%. These findings confirm that the feature map-based approach effectively mitigates ghosting, enhancing both localization accuracy and operational efficiency. Originality/value – This study addresses the persistent issue of map degradation in 2D SLAM without relying on complex multi-sensor fusion. By innovatively optimizing map representation through a specialized feature map generation mechanism, the method simultaneously compresses data and eliminates perceptual aliasing. This offers a robust, cost-effective solution for industrial automation in complex, structured environments. © 2026 Emerald Publishing Limited},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Giuffra2026,
	author = {Giuffra, A. and Minaya, J. and Tarrillo, J.},
	title = {Soft Error Mitigation in a Real-Time Control System Through Hardware Protection on an SRAM-Based FPGA},
	year = {2026},
	journal = {Latin American Test Workshop, LATW},
	number = {2026},
	pages = {},
	doi = {10.1109/LATS70329.2026.11480358},
	url = {https://www.scopus.com/pages/publications/105038338338?origin=resultslist},
	abstract = {Robotics and automation systems requires a design to handle transient faults that can lead to financial loss, physical damage, or equipment failure. Non-ionizing radiation is a common source of such faults in transistor-based devices. SRAMbased FPGAs provide flexibility for embedded designs using soft processors. This work presents a real-time temperature control system implemented on a MicroBlaze soft-core processor within a Xilinx Artix-7 XC7A100T FPGA, deployed on the Nexys A7100T board. Robustness against Single Event Upsets (SEUs) is evaluated through fault injection on three PI controller implementations: software-based, hardware IP core, and a triplicated TMR design. FreeRTOS manages scheduling, data acquisition, and control signal generation. MATLAB simulations serve as a baseline to validate and compare performance and reliability across the three approaches.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Li20261539,
	author = {Li, Rundong and Liu, Zheng and Wei, Hairuo and Cai, Yixi and Li, Haotian and Zhang, Fu},
	title = {Efficient and distributed large-scale point cloud bundle adjustment via majorization-minimization},
	year = {2026},
	journal = {International Journal of Robotics Research},
	volume = {45},
	number = {10},
	pages = {1539 - 1566},
	doi = {10.1177/02783649251398874},
	url = {https://www.scopus.com/pages/publications/105026708010?origin=resultslist},
	abstract = {Point cloud bundle adjustment is critical in large-scale point cloud mapping. However, point cloud bundle adjustment is both computationally and memory intensive, growing dramatically as the number of scan poses increases. This paper presents BALM3.0, an efficient and distributed large-scale point cloud bundle adjustment method. The proposed method employs the majorization-minimization algorithm to decouple the scan poses in the bundle adjustment process, thus performing the point cloud bundle adjustment on large-scale data with improved computational efficiency. The key difficulty of applying majorization-minimization on bundle adjustment is to identify the proper upper surrogate cost function. In this paper, the proposed upper surrogate cost function is based on the point-to-plane distance. The primary advantages of decoupling the scan poses via a majorization-minimization algorithm stem from two key aspects. First, the decoupling of scan poses reduces the optimization time complexity from cubic to linear, significantly enhancing the computational efficiency of the bundle adjustment process in large-scale environments. Second, it lays the theoretical foundation for distributed bundle adjustment. By distributing both data and computation across multiple devices, this approach helps overcome the limitations posed by large memory and computational requirements, which may be difficult for a single device to handle. The proposed method is extensively evaluated in both simulated and real-world environments. The results demonstrate that the proposed method achieves the same optimal residual with comparable accuracy while offering up to 704 times faster optimization speed and reducing memory usage to 1/8. Furthermore, this paper also presented and implemented a distributed bundle adjustment framework and successfully optimized large-scale data (21,436 poses with 70 GB point clouds) with four consumer-level laptops. © The Author(s) 2026},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@ARTICLE{Hu2026,
	author = {Hu, Qinghan and Zhu, Haijiang and Sun, Na and Chen, Lei and Fan, Zhengqiang and Li, Zhiqing},
	title = {A multi-mode structured light 3D imaging system with multi-source information fusion for underwater pipeline detection},
	year = {2026},
	journal = {Knowledge-Based Systems},
	volume = {343},
	pages = {},
	doi = {10.1016/j.knosys.2026.115985},
	url = {https://www.scopus.com/pages/publications/105035786822?origin=resultslist},
	abstract = {Underwater pipelines are highly susceptible to corrosion, which not only shorten their service life but also pose significant safety risks. Compared with manual inspection, intelligent real-time imaging systems for underwater pipeline detection have emerged as a more reliable and practical solution. Among various underwater imaging techniques, structured light 3D imaging can restore the sufficient spatial detail for precise defect characterization. Therefore, this paper develops a multi-mode underwater structured light 3D imaging system for pipeline detection (UW-SLD system) based on multi-source information fusion. First, a rapid distortion correction (FDC) method is employed for efficient underwater image rectification. To overcome the challenges of extrinsic calibration among underwater sensors, a factor graph-based parameter optimization (GPO) method is proposed to estimate the transformation matrix between the monocular structured light and acoustic sensors. Furthermore, a multi-mode 3D imaging strategy is introduced to adapt to the geometric variability of underwater pipelines. Given the presence of numerous disturbances in underwater environments, a multi-source information fusion strategy and an adaptive extended Kalman filter (AEKF) are designed to ensure stable pose estimation and high-accuracy measurements. In particular, an edge detection-based ICP (ED-ICP) algorithm is proposed. This algorithm integrates pipeline edge detection network with enhanced point cloud registration to achieve robust and high-fidelity reconstruction of defect structures even under variable motion conditions. Extensive experiments are conducted under different operation modes, depths, velocities, and turbidities. In addition, comprehensive ablation studies and system comparisons are carried out to validate the contribution of each component and the overall system. The experimental results demonstrate that the developed system achieves superior accuracy, adaptability and robustness, providing a solid foundation for autonomous underwater pipeline detection. © 2026 Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Li202626043,
	author = {Li, Xiaoyang and Wang, Jiang and Li, Zhi and Rakhshan, Seyed Ali and Chen, Ziyu and Wang, Zhong-Qiu and Kong, He},
	title = {Enhanced Extrinsic Calibration of Acoustic Cameras via Closed-Form Initialization and Batch Optimization},
	year = {2026},
	journal = {IEEE Sensors Journal},
	volume = {26},
	number = {17},
	pages = {26043 - 26055},
	doi = {10.1109/JSEN.2026.3703784},
	url = {https://www.scopus.com/pages/publications/105043384710?origin=resultslist},
	abstract = {Acoustic cameras, which integrate microphones and optical sensing units, have been widely adopted in various applications. However, accurately calibrating the system parameters, specifically the relative geometric information between the microphone array and the camera, remains a challenge. Knowing the positions of the microphones in the camera frame is the key to integrating the visual and auditory measurements of an acoustic camera. In this article, we formulate the identification problem of the microphone positions in the camera frame as a nonlinear least squares (NLS) problem and derive a closed-form solution. The former solution is further used as a reliable initial estimate in the Gauss-Newton method to enhance calibration accuracy. The proposed framework eliminates the need for prior geometric information of the system, as required in existing works, and provides a more practical identification pipeline. Numerical simulations and real-world experiments demonstrate the effectiveness and advantages of our approach, showing significant improvements in both calibration accuracy and robustness over existing methods. The code and dataset are publicly available at https://github.com/AISLAB-sustech/AcousticCameraCalib.  © 2001-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Lin2026,
	author = {Lin, Fan and Li, Guangrui and Xue, Xiaohang and Chen, Kaikang and Wei, Liguo and Wang, Ruixue},
	title = {A multi-sensor stabilized phenotyping platform for accurate wheat canopy sensing in unstructured field environments},
	year = {2026},
	journal = {Smart Agricultural Technology},
	volume = {14},
	pages = {},
	doi = {10.1016/j.atech.2026.102168},
	url = {https://www.scopus.com/pages/publications/105039787061?origin=resultslist},
	abstract = {To address the challenges of insufficient sensor stability and poor consistency among multi-source data during crop phenotyping in unstructured field environments, this study develops a hardware-software co-optimization framework for wheat canopy sensing based on a four-wheel-drive, high-clearance phenotyping platform. A multi-sensor stabilization device integrated with an ESO-LQR control strategy suppresses pitch disturbances during motion. A ROS-based hierarchical framework coordinates LiDAR, cameras, and inertial sensors, while spatial calibration and timestamp-based software synchronization ensure spatiotemporal consistency. A tightly coupled LiDAR-IMU SLAM algorithm enables centimeter-level 3D reconstruction of farmland. To mitigate terrain effects, a two-stage ground point extraction method integrating verticality and spatial distribution features improves canopy height estimation. Field experiments demonstrate stable platform operation at 1.5 m s⁻¹ while maintain high efficiency and data quality, with a coverage efficiency of 95.2%, retained-point ratio of 85.3%, and an MTF of 0.35 for image clarity. Phenotypic evaluation shows strong agreement between predicted wheat plant height and manual measurements, with R² values of 0.898 and 0.729 and RMSE values of 1.30 cm and 1.64 cm at the jointing and grain-filling stages, respectively. Moreover, at the jointing stage, both the 2D green area index (GAI) and the 3D point-cloud-based canopy coverage exhibit strong consistency with ImageJ-derived results (R² = 0.873 and 0.910). These findings demonstrate that the proposed approach enables stable and efficient acquisition of crop phenotypic information in complex field environments, providing a solid technical foundation for digital field monitoring, data-driven crop management, and intelligent agricultural systems. © 2026 The Authors. Published by Elsevier B.V. This is an open access article under the CC BY-NC-ND license. http://creativecommons.org/licenses/by-nc-nd/4.0/},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@ARTICLE{Zhu2026,
	author = {Zhu, Jinsong and Gao, Jingwei},
	title = {Autonomous UAV-based inspection system for intelligent quantification and localization of concrete surface defects},
	year = {2026},
	journal = {Automation in Construction},
	volume = {191},
	pages = {},
	doi = {10.1016/j.autcon.2026.107205},
	url = {https://www.scopus.com/pages/publications/105047092310?origin=resultslist},
	abstract = {Automated inspection of concrete-bridge undersides, underground spaces, and similar infrastructure is hindered by Global Positioning System (GPS)-denied environments and highly occluded confined spaces, limiting accessibility. Existing automated inspection methods often rely on communication with a ground station and offline post-processing, preventing on-site defect result generation. This paper proposes an onboard online method for quantitative defect assessment and localization in GPS-denied environments. An automated inspection platform with onboard localization, mapping, and obstacle avoidance enables stable operation in confined spaces. A lightweight multi-scale instance segmentation network supports real-time defect detection, while depth sensing enables non-contact estimation of the defect area. To reduce blind areas, a pose-adaptive coordinate transformation method for three-dimensional (3D) defect localization is proposed, mapping image-level defects into world coordinates. Experimental results show area estimation errors below 5.58% at 1.5 m and 3D localization errors under 9 cm within 1–2 m, providing spatial data for infrastructure maintenance applications. © 2026 Published by Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Xie2026520,
	author = {Xie, Zikang and Fei, Kexin and Sun, Zhenping and Fu, Hao and Li, Xiaohui and Li, Jian},
	title = {OTRNet: Pixel-Level Terrain Roughness Estimation for Off-Road Environments},
	year = {2026},
	journal = {Lecture Notes in Electrical Engineering},
	volume = {1580 LNEE},
	pages = {520 - 530},
	doi = {10.1007/978-981-95-7660-9_48},
	url = {https://www.scopus.com/pages/publications/105042938669?origin=resultslist},
	abstract = {Regional Traversability assessment constitutes a foundational task in autonomous driving, with terrain roughness serving as a critical factor influencing road perception. Off-road environments present unique safety challenges for vehicles due to undulating topography and heterogeneous distributions of surface materials and geometries, which contribute to pronounced spatial complexity and physical diversity. In this paper, we present the first large-scale multi-modal Off-road Terrain Roughness dataset NUDT-OTR. Accordingly, we propose a terrain roughness ground-truth generation framework leveraging LiDAR point cloud elevation differentials, where a dynamic-patch module is introduced in ground segmentation dealing with highly undulating terrains. Based on this, we further present a visual-based model OTRNet, which achieved robust estimation of terrain roughness in the BEV perspective through the designed Occlusion-Aware Module. Experimental results demonstrate significant estimation reliability of our approach across the proposed benchmark dataset. © Beijing HIWING Scientific and Technological Information Institute 2026.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Tang20267013,
	author = {Tang, Yujie and Wang, Meiling and Zuo, Sibo and Yang, Chengxi and Jiang, Jinhao and Chen, Xieyuanli and Yue, Yufeng},
	title = {Coupling Structural Descriptors with a Novel Semantic Graph Matching Approach for LiDAR Loop Detection},
	year = {2026},
	journal = {IEEE Transactions on Automation Science and Engineering},
	volume = {23},
	pages = {7013 - 7024},
	doi = {10.1109/TASE.2026.3676786},
	url = {https://www.scopus.com/pages/publications/105034202167?origin=resultslist},
	abstract = {Outdoor loop closure detection is essential for correcting odometry drift and constructing a globally consistent map. Semantic-graph-based approaches effectively model object-level topology and achieve strong loop closure performance; however, their effectiveness degrades in background-dominated scenes with few distinctive objects, and establishing accurate injective node correspondences remains challenging. In contrast, structural descriptor methods, though offering stronger environmental generality through spatial-distribution modeling, remain susceptible to LiDAR noise and the discriminative power of point-level features. These limitations motivate the need for a more robust method that combines adaptability with enhanced descriptive power. We propose a novel loop-closure detection framework, SAGE, that integrates highly adaptable point-cloud shape-distribution features and generally reliable semantic graph topology, adaptively combining their similarity measures to improve detection performance. Specifically, we design a semantic graph matching module with dual constraints, local graph feature consistency and global spatial consistency, to achieve more accurate injective node correspondences. In addition, we extract point-cloud shape-distribution features and introduce a fusion mechanism that integrates them with the semantic graph module, assessing reliability and adaptively weighting their contributions. Extensive loop closure detection and pose estimation experiments on various datasets demonstrate that SAGE achieves superior performance over strong baselines. We provide the code at https://github.com/SAGE-11/SAGE Note to Practitioners - This paper focuses on improving the accuracy and robustness of LiDAR loop closure detection in outdoor road environments, which is a critical component for long-term robot navigation, and mapping. Mainstream semantic-graph-based methods typically require a number of nodes in the semantic graph and accurate estimates of object centers; otherwise, the correct loop closure can be difficult to identify, significantly limiting the environments applicable. To address this limitation, we propose SAGE, a framework that integrates semantic graph matching with more widely applicable structural descriptors through an effective fusion strategy. This design enhances loop closure detection in both accuracy and robustness. Future work may extend our method beyond road environments to a wider range of scenarios, including forests, valleys, and other natural environments.  © 2004-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Ji202610526,
	author = {Ji, Xinchun and He, Zheng and Gu, Shuhang and Wei, Dongyan and Zhou, Deyun},
	title = {Online Targetless Camera-Lidar Extrinsic Calibration Using Object-Oriented Semantic Feature},
	year = {2026},
	journal = {IEEE Sensors Journal},
	volume = {26},
	number = {7},
	pages = {10526 - 10540},
	doi = {10.1109/JSEN.2026.3663294},
	url = {https://www.scopus.com/pages/publications/105030722031?origin=resultslist},
	abstract = {Accurate extrinsic parameters are critical for fusing heterogeneous data from camera and light detection and ranging (Lidar). To solve the problems of incomplete feature extraction, poor scene adaptability, and unstable parameter convergence in conventional automatic calibration methods, this article proposed an online extrinsic calibration method using object-oriented semantic features, which consisted of a coarse-calibration based on trajectory-consistency and a fine-calibration based on feature-consistency. With the initial parameters from the coarse-calibration, the fine-calibration pictorialized a sparse point cloud to obtain its depth, intensity, and class attributes simultaneously. Then, the segment anything model (SAM) network was used to process both the visual image and the point cloud pseudoimage to extract consistent object-oriented features. To enhance the stability and adaptability of extrinsic calibration to various scenes, an observability-based intersection-over-union (IoU) was proposed to perform the camera-Lidar feature matching. In addition, we designed an adaptability function to evaluate the quality of scene features, thereby ensuring the effectiveness of extrinsic calibration. Results of testing on the KITTI dataset and real-world dataset demonstrate that the proposed method can effectively obtain accurate extrinsic parameters in multiple scenes. By comparing with the ground truth, errors of the rotation and translation are less than (0.15°, 0.05 m), and the variances are less than (2.0 × 10-3 deg2, 3.0 × 10-4 m2), which indicates good potential for engineering applications. © 2026 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Bhargava2026408,
	author = {Bhargava, Ankur and Suhaib, Mohammad and Singholi, Ajay K. S.},
	title = {A hybrid optimization algorithm combining A∗ and the dynamic window approach for automated guided vehicle control in static and dynamic environments},
	year = {2026},
	journal = {Robotica},
	volume = {44},
	number = {2},
	pages = {408 - 470},
	doi = {10.1017/S0263574725102944},
	url = {https://www.scopus.com/pages/publications/105025416273?origin=resultslist},
	abstract = {This study presents the control of an omnidirectional automated guided vehicle (AGV) with mecanum wheels using a hybrid optimization algorithm that combines a modified A∗ algorithm and the dynamic window approach (ADWA-HO). The method ensures efficient and precise navigation in both static and dynamic environments. The modified A∗ algorithm generates global paths, removes redundant nodes, and refines trajectories to improve efficiency and smoothness. At the same time, the dynamic window approach (DWA) enables real-time local path planning and obstacle avoidance. By evaluating the AGV's motion commands in real time, ADWA-HO selects optimal velocity commands within a dynamically updated window, thereby reducing route conflicts and ensuring stable movement. Compared with benchmark methods including dynamic A∗ (D∗), artificial potential field (APF), DWA, probabilistic roadmap (PRM) & rapidly exploring random tree (RRT) fusion, and PRM & DWA fusion, the proposed ADWA-HO achieves improvements in average path length of 28.10%, 22.95%, 21.16%, 17.35%, and 10.71% and in average motion time of 23.48%, 17.85%, 15.47%, 11.86%, and 7.53% on both Map 1 and Map 2, respectively. The difference between simulation and real-world experiments is limited to 5.35% in path length and 4.38% in motion time, confirming the method's practical reliability. Furthermore, the algorithm achieves lower standard deviation in both metrics, indicating higher consistency of performance. This work also introduces a novel map-building strategy based on geometric and semantic data modules, which enhances the adaptability of real-world AGV deployment.  © The Author(s), 2025. Published by Cambridge University Press.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6}
}

@CONFERENCE{Jun20261165,
	author = {Jun, Liu and Xiangren, Lv and Qian, Zhao},
	title = {Enhancing the Robustness and Accuracy of 3D LiDAR Mapping and Localization Using Adaptive Semantics},
	year = {2026},
	journal = {38th Chinese Control and Decision Conference, CCDC 2026},
	pages = {1165 - 1171},
	doi = {10.1109/CCDC69976.2026.11560554},
	url = {https://www.scopus.com/pages/publications/105043934938?origin=resultslist},
	abstract = {3D LiDAR SLAM is crucial for accurate mapping and localization in large-scale applications, such as autonomous vehicles in parks and mobile robots in factories. Recent advancements in 3D point cloud semantic segmentation enable the extraction of stable and real-time LiDAR semantic information. The utilization of this stable semantic information enhances the richness of LiDAR mapping and localization, leading to improved accuracy and stability. This paper presents a LiDAR semantic mapping and localization system consisting of two main components. The first component is the semantic-assisted LiDAR mapping module, which employs semantic LOAM in conjunction with an adaptive semantic weighting method to construct a globally consistent semantic Normal Distribution Transform (NDT) map. The second component is the localization module that utilizes the globally consistent map generated in the first part. Within the localization module, we introduce a realtime, high-precision semantic NDT localization method. To evaluate the performance of our system, we conducted experiments using the KITTI dataset. We also compared our approach with existing LiDAR mapping and localization methods. The results demonstrate that our system achieves superior mapping accuracy and localization stability. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Ebrahimi202616538,
	author = {Ebrahimi, Farzaneh and Setoodeh, Peyman and Ahmed, Ryan and Habibi, Saeid},
	title = {Smooth Variable-Structure Filters With Application to Battery State Estimation: A Review},
	year = {2026},
	journal = {IEEE Sensors Journal},
	volume = {26},
	number = {11},
	pages = {16538 - 16561},
	doi = {10.1109/JSEN.2026.3685361},
	url = {https://www.scopus.com/pages/publications/105037041907?origin=resultslist},
	abstract = {The smooth variable-structure filter (SVSF) provides a complementary approach to Bayesian filters, exemplified by the Kalman filter (KF) and its variants. The SVSF is based on the sliding mode concept to achieve comparatively better robustness against modeling uncertainties and environmental disturbances. Bayesian filters are derived to provide approximations for the optimal filtering solution. From an algorithmic point of view, both families of filters can be formulated in a predictor-corrector form, but they present different tradeoffs between robustness and optimality in estimation. This article presents a comprehensive review of the state-of-the-art SVSF variants as well as the methods for combining SVSF and Bayesian filters. A key contribution of this work is the systematic comparison of 15 SVSF variants with several nonlinear KFs [extended KF (EKF), unscented KF (UKF), and central difference KF (CDKF)] in the context of battery state-of-charge (SOC) estimation. Simulation results using real-world battery data demonstrate that several SVSF variants offer superior estimation accuracy and robustness compared to traditional filters. This work also highlights performance under various initial conditions and evaluates the impact of the accuracy of SOC estimation on the estimation of terminal voltage. Since the governing dynamics of lithiumion (Li-ion) batteries change with aging and varying environmental conditions, the robustness of SVSF-based algorithms makes them promising candidates for reliable SOC estimation in battery management systems (BMSs).  © 2001-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Xu2026,
	author = {Xu, Jiaming and Ye, Tianyong and Shi, Shikuan and He, Man and Zheng, Chunran and Huang, Tingwen and Cui, Yukang},
	title = {FAST-RTFM: Fast RGB–Thermal Fusion for Point Cloud Mapping in Low-Light Environments},
	year = {2026},
	journal = {IEEE/ASME Transactions on Mechatronics},
	pages = {},
	doi = {10.1109/TMECH.2026.3681437},
	url = {https://www.scopus.com/pages/publications/105036881743?origin=resultslist},
	abstract = {Thermal cameras, capable of operating independently of ambient light while acquiring extra-spectral radiation data, present distinct advantages over conventional RGB cameras that require adequate illumination in low-light environments. However, traditional visual simultaneous localization and mapping methods struggle with thermal imagery due to limitations, such as lower image resolution, constrained dynamic range, and imaging interruptions during nonuniformity correction. Although existing deep learning-based approaches have partially improved the performance of thermal imaging in localization and mapping tasks, their generalization capability across diverse environments remains weaker than traditional geometric methods. Integrating thermal information as complementary data with other sensors, such as LiDAR and RGB cameras, has proven to be an effective approach to address this issue. This article introduces a pointwise RGB–thermal pixel fusion strategy for efficient real-time point cloud coloring based on LiDAR–inertial–visual odometry frameworks. By effectively combining the complementary strengths of thermal cameras (illumination robustness), RGB sensors (textural details), and LiDAR's high-precision geometric structures, we successfully implement an efficient mapping system for target detection and nighttime reconnaissance. The system achieves both high real-time performance and accuracy, demonstrating broad application potential in security operations and emergency response scenarios. © 1996-2012 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Felix2026570,
	author = {Felix, Doumegna Mawuto Koudjo and Yu, Xianjia and Zhang, Jiaqiang and Ha, Sier and Zou, Zhuo and Westerlund, Tomi},
	title = {Understanding Lidar Variability: A Dataset and Comparative Study Featuring Dome-Shaped, Solid-State, and Spinning Lidars},
	year = {2026},
	journal = {IEEE Robotics and Automation Letters},
