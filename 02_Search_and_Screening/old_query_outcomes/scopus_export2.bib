	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 27}
}

@CONFERENCE{Ortiz-Fernandez202267,
	author = {Ortiz-Fernandez, Luis E. and Silva, Bruno M. F. and Goncalves, Luiz M. G.},
	title = {Error Accuracy Estimation of 3D Reconstruction and 3D Camera Pose from RGB-D Data},
	year = {2022},
