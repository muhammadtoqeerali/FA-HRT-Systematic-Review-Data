@ARTICLE{Sabzevari2016638,
	author = {Sabzevari, Reza and Scaramuzza, Davide},
	title = {Multi-body Motion Estimation from Monocular Vehicle-Mounted Cameras},
	year = {2016},
	journal = {IEEE Transactions on Robotics},
	volume = {32},
