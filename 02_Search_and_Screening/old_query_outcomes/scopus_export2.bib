	author = {Lee, Junwoon and Ando, Taisei and Shinozaki, Mitsuru and Kitajima, Toshihiro and An, Qi and Yamashita, Atsushi},
	title = {TC-LTIO: Tightly-coupled LiDAR Thermal Inertial Odometry for LiDAR and Visual Odometry Degraded Environments},
	year = {2024},
	journal = {International Conference on Control, Automation and Systems},
	pages = {655 - 660},
	doi = {10.23919/ICCAS63016.2024.10773102},
	url = {https://www.scopus.com/pages/publications/85214388347?origin=resultslist},
	abstract = {We propose tightly-coupled LiDAR thermal inertial odometry for LiDAR and visual odometry degraded environments to deal with LiDAR and RGB-based visual odometry degenerate environments. Our approach exhibits high robustness and accuracy by tightly-coupled sensor fusion between LiDAR edge/planar features and thermal camera point features. Furthermore, to mitigate challenges inherent in thermal vision such as low contrast, we employ a learning-based optical flow trained on both synthetic thermal images generated from RGB images and real-world thermal images. Experimental results demonstrate that our method effectively handles not only the degradation of LiDAR and visual odometry but also challenges inherent in thermal vision. © 2024 ICROS.},
