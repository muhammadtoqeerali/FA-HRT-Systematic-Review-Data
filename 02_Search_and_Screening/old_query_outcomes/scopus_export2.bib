@ARTICLE{Lee2025108,
	author = {Lee, Seong Hun and Civera, Javier},
	title = {What’s Wrong with the Absolute Trajectory Error?},
	year = {2025},
	journal = {Lecture Notes in Computer Science},
	volume = {15623 LNCS},
	pages = {108 - 123},
	doi = {10.1007/978-3-031-91569-7_8},
	url = {https://www.scopus.com/pages/publications/105006877177?origin=resultslist},
	abstract = {One of the limitations of the commonly used Absolute Trajectory Error (ATE) is that it is highly sensitive to outliers. As a result, in the presence of just a few outliers, it often fails to reflect the varying accuracy as the inlier trajectory error or the number of outliers varies. In this work, we propose an alternative error metric for evaluating the accuracy of the reconstructed camera trajectory. Our metric, named Discernible Trajectory Error (DTE), is computed in five steps: (1) Shift the ground-truth and estimated trajectories such that both of their geometric medians are located at the origin. (2) Rotate the estimated trajectory such that it minimizes the sum of geodesic distances between the corresponding camera orientations. (3) Scale the estimated trajectory such that the median distance of the cameras to their geometric median is the same as that of the ground truth. (4) Compute, winsorize and normalize the distances between the corresponding cameras. (5) Obtain the DTE by taking the average of the mean and the root-mean-square (RMS) of the resulting distances. This metric is an attractive alternative to the ATE, in that it is capable of discerning the varying trajectory accuracy as the inlier trajectory error or the number of outliers varies. Furthermore, we propose a simple yet effective method for calibrating the camera-to-marker rotation, which is needed for the computation of the DTE. Our method is verified through extensive simulations. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2025.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

