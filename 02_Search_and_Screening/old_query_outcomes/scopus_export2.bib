@ARTICLE{Landolfi20231459,
	author = {Landolfi, Enrico and Salvi, Alessandro and Troiano, Alfredo and Natale, Ciro},
	title = {Hardware-in-the-loop validation of an adaptive model predictive control on a connected and automated vehicle},
	year = {2023},
	journal = {International Journal of Adaptive Control and Signal Processing},
