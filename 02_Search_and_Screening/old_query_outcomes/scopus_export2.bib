@CONFERENCE{Zhao20212214,
	author = {Zhao, Yifan and Hui, Le and Xie, Jin},
	title = {SSPU-Net: Self-Supervised Point Cloud Upsampling via Differentiable Rendering},
	year = {2021},
	journal = {MM 2021 - Proceedings of the 29th ACM International Conference on Multimedia},
	pages = {2214 - 2223},
	doi = {10.1145/3474085.3475381},
	url = {https://www.scopus.com/pages/publications/85119379940?origin=resultslist},
	abstract = {Point clouds obtained from 3D sensors are usually sparse. Existing methods mainly focus on upsampling sparse point clouds in a supervised manner by using dense ground truth point clouds. In this paper, we propose a self-supervised point cloud upsampling network (SSPU-Net) to generate dense point clouds without using ground truth. To achieve this, we exploit the consistency between the input sparse point cloud and generated dense point cloud for the shapes and rendered images. Specifically, we first propose a neighbor expansion unit (NEU) to upsample the sparse point clouds, where the local geometric structures of the sparse point clouds are exploited to learn weights for point interpolation. Then, we develop a differentiable point cloud rendering unit (DRU) as an end-to-end module in our network to render the point cloud into multi-view images. Finally, we formulate a shape-consistent loss and an image-consistent loss to train the network so that the shapes of the sparse and dense point clouds are as consistent as possible. Extensive results on the CAD and scanned datasets demonstrate that our method can achieve impressive results in a self-supervised manner. © 2021 ACM.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
