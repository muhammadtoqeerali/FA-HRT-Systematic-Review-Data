}

@CONFERENCE{Tan20257235,
	author = {Tan, Guilin and Zhu, Hao and Yang, Wen and Chen, Chao},
	title = {Application of Cholesky-KalmanNet to Integrated Navigation with Pseudo Measurement Constraints},
	year = {2025},
	journal = {Proceedings - 2025 China Automation Congress, CAC 2025},
	pages = {7235 - 7240},
	doi = {10.1109/CAC67268.2025.11486723},
	url = {https://www.scopus.com/pages/publications/105041020011?origin=resultslist},
	abstract = {Integrated navigation systems, which fuse data from an Inertial Measurement Unit (IMU) and a Global Positioning System (GPS), are fundamental to achieving robust localization for autonomous vehicles. The IMU provides continuous, high-frequency motion data but suffers from rapid drift accumulation, while the GPS offers low-frequency, drift-free absolute position but is prone to signal outages. Traditional fusion methods, typically based on the Extended Kalman Filter (EKF), can struggle to optimally model the complex, time-varying noise characteristics and may exhibit instability. To address these challenges, this work explores an enhanced learning-based filtering framework. The approach adapts the Cholesky-KalmanNet architecture by incorporating a nonholonomic pseudo measurement as a high-frequency, physics-informed corrective input. This constraint guides the recurrent neural network to learn a more physically plausible motion model, effectively mitigating drift during GPS outages and improving numerical stability. We conducted extensive experiments on two distinct datasets: the publicly available NCLT dataset and a real-world dataset. The results demonstrate that our approach not only maintains robustness where other models but also achieves superior accuracy. This study validates that augmenting data-driven estimators with kinematic constraints is a powerful strategy for developing more accurate and reliable integrated navigation systems. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Sun202412315,
	author = {Sun, Chao and Leng, Jianghao and Wang, Bo and Liang, Weiqiang and Jia, Bowen and Huang, Zhishuai and Lu, Bing and Li, Jiajun},
	title = {VMC-LIO: Incorporating Vehicle Motion Characteristics in LiDAR Inertial Odometry},
	year = {2024},
	journal = {IEEE Transactions on Vehicular Technology},
	volume = {73},
	number = {9},
	pages = {12315 - 12327},
	doi = {10.1109/TVT.2024.3384955},
	url = {https://www.scopus.com/pages/publications/85189614112?origin=resultslist},
	abstract = {This paper proposes a novel LiDAR inertial odometry (LIO) incorporating vehicle motion characteristics (VMC) tailored for ground vehicles. While most advanced LIO systems are designed for 6 degrees of freedom (DOF) SE(3), which are not ideally suited for ground vehicles, this paper investigates the performance of the vehicle-LiDAR-IMU system by considering the vehicle motion characteristics. The system combines IMU propagation, LiDAR measurements, ground surface measurements and 3 dimension (3D) vehicle kinematic model measurements within an iterated Kalman filter framework. To ensure a robust system bootstrapping, the temporal and spatial parameters of the vehicle-LiDAR-IMU system are calibrated first. Then, in addition to the IMU preintegration and LiDAR measurements, constraints are established between the ground surface and the vehicle pose by calculating the normal of the ground beneath the vehicle in the local point cloud map. Moreover, measurements of the 3D vehicle kinematic model with angular velocity and velocity constraints are adopted. Ground surface is considered in the 3D kinematic model for vehicle angular velocity calculation. The results from simulations and vehicle experiments demonstrate that the proposed method improves accuracy compared with state-of-the-art LiDAR SLAM methods while maintaining a real-time implementation capability for vehicles.  © 2024 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 7}
}

@ARTICLE{Fraifer2025,
	author = {Fraifer, Muftah A and Coleman, Joseph and Maguire, James and Trslić, Petar and Dooly, Gerard and Toal, Daniel},
	title = {Autonomous Forklifts: State of the Art—Exploring Perception, Scanning Technologies and Functional Systems—A Comprehensive Review},
	year = {2025},
	journal = {Electronics (Switzerland)},
	volume = {14},
	number = {1},
	pages = {},
	doi = {10.3390/electronics14010153},
	url = {https://www.scopus.com/pages/publications/85214499014?origin=resultslist},
	abstract = {This paper presents a comprehensive overview of cutting-edge autonomous forklifts, with a strong emphasis on sensors, object detection and system functionality. It aims to explore how this technology is evolving and where it is likely headed in both the near and long-term future, while also highlighting the latest developments in both academic research and industrial applications. Given the critical importance of object detection and recognition in machine vision and autonomous vehicles, this area receives particular attention. The article provides an in-depth summary of both commercial and prototype forklifts, discussing key aspects such as design features, capabilities and benefits, and offers a detailed technical comparison. Specifically, it clarifies that all available data pertains to commercially available forklifts. To obtain a better understanding of the current state-of-the-art and its limitations, the analysis also reviews commercially available autonomous forklifts. Finally, this paper includes a comprehensive bibliography of research findings in this field. © 2025 by the authors.},
