}

@ARTICLE{Khemiri202655,
	author = {Khemiri, K. and Djebali, R.},
	title = {Hybrid extended Kalman filter long short-term memory framework for robust state and fault estimation in mobile robots under unknown disturbances},
	year = {2026},
	journal = {Electrical Engineering and Electromechanics},
	volume = {2026},
	number = {3},
	pages = {55 - 61},
	doi = {10.20998/2074-272X.2026.3.08},
	url = {https://www.scopus.com/pages/publications/105037624441?origin=resultslist},
	abstract = {Introduction. Reliable and accurate state estimation plays a central role in mobile robotics, ensuring effective localization, navigation, and control in uncertain and dynamic environments. Traditional estimation methods such as the extended Kalman filter (EKF) and the unscented Kalman filter (UKF) are widely used for nonlinear systems; however, their performance degrades when facing unknown disturbances or modeling inaccuracies. Problem. In real-world mobile robots, unexpected motor faults and unmeasured disturbances significantly reduce the estimation accuracy and may lead to mission failure. Classical EKF and UKF approaches rely on static models and Gaussian noise assumptions, which make them unsuitable for systems affected by unknown or time-varying uncertainties. The goal of this work is to design and validate a hybrid extended Kalman filter long short-term memory (EKF–LSTM) framework capable of achieving joint state and fault estimation for mobile robots operating under unknown disturbances. Methodology. The proposed approach combines a model-based EKF with an offline-trained LSTM neural network. The EKF performs nonlinear state estimation using physical robot dynamics and noisy Global Positioning System (GPS) measurements, while the LSTM predicts additive motor faults based on temporal data. The LSTM outputs are incorporated into the EKF as pseudo-measurements with adaptive covariance tuning, ensuring stability and robustness. Results. Simulation results demonstrate that the hybrid EKF–LSTM reduces trajectory root mean square error (RMSE) by 4.6 % and fault RMSE by 68 % compared to a standalone EKF, and by more than 50 % compared to the UKF. The framework effectively tracks abrupt fault variations and remains resilient to unknown inputs and sensor noise. Scientific novelty. Unlike existing hybrid filters, the proposed method introduces adaptive covariance fusion between EKF and LSTM estimators, enabling reliable operation under directional dynamics and unmodeled disturbances. Practical value. The proposed hybrid EKF–LSTM framework enhances fault-tolerant localization for autonomous robots, providing a scalable solution for real-time applications such as search-and-rescue operations, industrial automation, and autonomous navigation in noisy or GPS-denied environments. References 33, tables 2, figures 5. © 2026, National Technical University "Kharkiv Polytechnic Institute". All rights reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Dash2026,
	author = {Dash, Sanujit and Ramkumar, Barathram and Vundavilli, Pandu R.},
	title = {Light-weight AI Enhanced Adaptive Sensor Fusion for Robot based 3D Mapping Applications},
	year = {2026},
	journal = {IEEE Sensors Journal},
	pages = {},
	doi = {10.1109/JSEN.2026.3715206},
	url = {https://www.scopus.com/pages/publications/105046074826?origin=resultslist},
	abstract = {Three dimensional (3D) mapping is a technique used by autonomous robots to understand the environment. Simultaneous Localization and Mapping (SLAM) algorithms are used widely to map an unknown environment based on sensory data. Light Detection and Ranging (LiDAR) offers reliable geometry range data while Red-Green-Blue with Depth (RGB-D) camera offers detailed information about the scene such as depth and appearance data. Limited memory, computation resources, sensor degradation and environmental interference are some of the challenges that affect the implementation on robotic platforms. The proposed method solves these limitations through a novel three-tier architecture: (1) a Bayesian Adaptive Weighting (BAW) module that provides probabilistic sensor reliability estimation with Adaptive Parameter Tuning (APT); (2) an Adaptive Resource-Aware Intelligence (ARAI) layer that enhances BAW output via anomaly detection and online learning; and (3) a Hybrid Probabilistic-Deterministic SLAM system combining particle filter localization with trust-adjusted occupancy grid mapping. The fusion module constantly compares and adjusts the quality of sensor inputs, allowing for robust perception, while the hybrid SLAM system solves the localization uncertainty and enhances mapping. The designed system is tested on both a desktop PC with GPU acceleration and a Raspberry Pi embedded platform and compared with state-of-the-art baseline methods. The proposed method is also evaluated on the Technical University of Munich (TUM) RGB-D dataset to validate the proposed SLAM system. On desktop PC with GPU, the system achieves 35.12 frames per second (FPS) with 70 megabytes (MB) memory usage. On Raspberry Pi, the system completes full SLAM cycles at 0.04 FPS with 476 MB memory, showing that the architecture can run on a CPU-only embedded board. On TUM RGB-D dataset, the proposed method achieves 0.946 meters (m) Absolute Trajectory Error Root Mean Square Error (ATE RMSE) with Relative Pose Error translation of 0.343 m, demonstrating superior localization accuracy. © 2001-2012 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Galea2026,
	author = {Galea, Andreea-Catalina and Radac, Mircea-Bogdan},
	title = {Performance Characterization of a Commercial UWB Localization Relative to Low-Cost Vision-Based Tracking},
	year = {2026},
	journal = {Machines},
	volume = {14},
	number = {1},
	pages = {},
	doi = {10.3390/machines14010062},
	url = {https://www.scopus.com/pages/publications/105028708059?origin=resultslist},
	abstract = {An ultra-wideband (UWB) Anchor–Tag commercial sensor system used for positioning is characterized herein, against an image-processing based positioning system used as a ground truth. The UWB consists of a single anchor that measures the angle of arrival (AoA) and distance to the moving tag. The driftless camera-based positioning system requires a series of complex operations, among camera calibration, image processing and network transmission delay estimation, and time alignment with the analyzed UWB measurement system. For the UWB system, the accuracy, precision, resolution, covered area, and error-vs-distance dependence are measured on several collected trajectories, both stationary and in motion. Several filtering solutions are proposed to improve these metrics that are affected by some faulty measurements, to subsequently validate the overall performance. The condition monitoring is verified both in offline and in online processing modes, using these filtering solutions. Our approach is black-box and does not use additional information except for raw position data. The importance and feasibility of UWB systems for indoor or outdoor localization is demonstrated, as well as some caveats and possible mitigation strategies. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Tabatabaei2026,
	author = {Tabatabaei, Ramtin and Kostakos, Vassilis and Johal, Wafa},
	title = {Oops, i Did It Again (But i Know It): Robot Failure Consistency and Awareness in Human-Robot Collaboration},
	year = {2026},
	journal = {Conference on Human Factors in Computing Systems - Proceedings },
	pages = {},
	doi = {10.1145/3772318.3790336},
	url = {https://www.scopus.com/pages/publications/105038788496?origin=resultslist},
	abstract = {In human-robot collaboration, repeated failures are inevitable and can undermine trust and perceptions of robot intelligence. While some failures severely disrupt tasks and others are relatively benign, their cumulative impact on trust is not clearly understood. We investigated whether users perceive repeated failures of the same type differently from varied failures, and how robot awareness of its own failures affects these perceptions. In a collaborative physical task with 54 participants, we manipulated failure sequence (homogeneous vs. heterogeneous) and awareness (none, partial, full). Results show that trust and perceived intelligence were influenced by both current and prior failures, with homogeneous sequences leading to smaller reductions in these evaluations compared to heterogeneous ones. Robots displaying awareness, whether partial or full, were consistently rated higher than unaware robots, particularly for grasping and planning failures. Our findings provide a deeper understanding of how failure type, sequence, and robot awareness shape users' perceptions of collaborative robots. © 2026 Copyright held by the owner/author(s).},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Yan2026,
	author = {Yan, Hongjian and Yuan, Jun and Wu, Yajia and Zhang, Junran},
	title = {A few-parameter graph convolution network for gyroscope error compensation of low-cost IMUs in attitude estimation},
	year = {2026},
	journal = {Measurement Science and Technology},
	volume = {37},
	number = {30},
	pages = {},
	doi = {10.1088/1361-6501/ae81d4},
	url = {https://www.scopus.com/pages/publications/105046011522?origin=resultslist},
	abstract = {Low-cost inertial measurement units (IMUs) inherently suffer from complex error sources and high random-walk noise, making pure IMU dead reckoning highly sensitive to gyroscope drift and introducing high measurement uncertainty. Most existing deep learning-based error compensation approaches are limited by weak long-range temporal modeling and/or high computational demands. To address these issues, this paper proposes a graph-based learning module for gyroscope error correction under an IMU-only open-loop attitude integration protocol on continuous benchmark sequences. In the proposed framework, each IMU frame is modeled as a node in a sparse directed temporal graph that captures inter-frame dependencies over a short history window. A compact graph convolutional network (GCN) is integrated with a gyroscope error model to estimate frame-wise correction terms, which are then used in a kinematic motion model for open-loop attitude propagation. Using only 20 frames of historical data, the proposed GCN estimates correction terms with 563 parameters and 4.11 M FLOPs, significantly reducing the uncertainty in the compensated measurements. On EuRoC-MAV and KITTI under the stated IMU-only open-loop protocol, the proposed method achieves an average AOE of 0.71 and an average relative rotational error of 2.6, respectively. We report the end-to-end runtime measured by our evaluation script on a desktop GPU (about 0.7 s per sequence on an NVIDIA GeForce GTX 1080 Ti); because sequences differ in length and hardware/framework effects are significant, these timings are provided only as coarse references alongside FLOPs/parameter counts. Since EuRoC-MAV and KITTI do not contain real power-cycle events, robustness to non-stationary turn-on bias is examined through controlled synthetic stress tests on representative sequences (bias-jump and restart-proxy protocols); full system-level evaluation with explicit restart detection/handling is left for future work. © 2026 IOP Publishing Ltd. All rights, including for text and data mining, AI training, and similar technologies, are reserved. This article is available under the terms of the IOP-Standard License.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Du20263818,
	author = {Du, Yuxin and Zhang, Jianhua and Liang, Liang and Song, Bin},
	title = {Review of Essential Generic Technologies for Visual Perception in Underground Coal Mine Robots},
	year = {2026},
	journal = {Journal of Field Robotics},
	volume = {43},
	number = {6},
	pages = {3818 - 3844},
	doi = {10.1002/rob.70218},
	url = {https://www.scopus.com/pages/publications/105036050215?origin=resultslist},
	abstract = {Visual perception technology serves as the core support for establishing the “perception-decision-control” closed-loop system of underground coal mine robots (UCMRs). Research on its key generic technologies is crucial to promoting the large-scale deployment of UCMRs in underground mines. This paper initially reviews the development status of UCMRs and elaborates on the functional roles and application scenarios of five core categories: tunneling, coal mining, auxiliary operations, inspection, and rescue robots, thereby clarifying the fundamental requirements of visual perception across diverse underground scenes. Subsequently, it concentrates on the generic technological system essential for UCMR visual perception, presenting an in-depth analysis of the principles, research advancements, and application challenges related to four technical modules: environmental adaptability under extreme conditions, target detection and recognition in complex scenarios, 3D spatial perception and positioning, and lightweight algorithms suitable for edge computing. Finally, aligned with practical industry needs, the paper projects future development trends and practical challenges, proposing four strategic pathways for breakthroughs, namely human-machine-environment integrated active perception, automated iteration of datasets and models, cluster perception and interaction, and cross-technology integration, and highlighting four core challenges, including environmental adaptability, hardware reliability, communication collaboration, and industry access compatibility. It aims to provide a valuable theoretical reference and technical support for the technological development, achievement transformation, and advancement of mine intellectualization. © 2026 Wiley Periodicals LLC.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Hybrid Gold Open Access}
}

@ARTICLE{Wan2026,
	author = {Wan, Tianjian and Al Shamaileh, Khair and Alkhatib, Mustafa},
	title = {A Machine Learning-Powered Solution for Safe Autonomous Robotic Ground Navigation in Cyber-Contested Environments},
	year = {2026},
	journal = {Applied Sciences (Switzerland)},
	volume = {16},
	number = {15},
	pages = {},
	doi = {10.3390/app16157666},
	url = {https://www.scopus.com/pages/publications/105046989728?origin=resultslist},
	abstract = {Featured Applications: Detection and classification of cyberattacks targeting autonomous ground vehicles, particularly those with fixed-route navigation, find applications in public transportations. In this article, machine learning (ML) is proposed as a solution to detect and classify false message injection attacks in autonomous ground navigation. First, multiple trajectories are designed and simulated to collect authentic feature samples offered by the odometry and inertial measurement unit (IMU) of an autonomous ground vehicle (UGV). Then, a dataset comprising these samples and other injected samples that simulate two cyberattacks, namely path modification (PM) and velocity drift (VD), is created to train, validate, and benchmark various ML classification models. These include decision tree (DT), k-nearest neighbors (KNN), multi-layer perceptron (MLP), random forest (RF), and support vector machine (SVM). The optimum classification model is experimentally evaluated using a UGV platform, and results suggest that the proposed solution allows the detection of authentic and attacked messages with more than 98% average accuracy and sub-millisecond prediction time. Thus, this solution is ideal for real-time classification, especially in fixed-route applications, e.g., public transportation. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
