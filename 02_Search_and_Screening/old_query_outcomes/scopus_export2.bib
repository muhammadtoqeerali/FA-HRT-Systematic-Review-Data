@ARTICLE{Chotikunnan20251069,
	author = {Chotikunnan, Phichitphon and Khotakham, Wanida and Chotikunnan, Rawiphon and Roongprasert, Kittipan and Pititheeraphab, Yutthana and Puttasakul, Tasawan and Wongkamhang, Anantasak and Thongpance, Nuntachai},
