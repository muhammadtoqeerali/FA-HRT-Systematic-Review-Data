	abstract = {Mobile robot navigation and localization utilizing multisensor fusion have attracted significant attention due to the advantages of high positioning accuracy, extensive perception range, and strong system robustness. To meet the application requirements of seamless indoor and outdoor transitions and improve the accuracy of asynchronous sensor data fusion, a neural network weighted factor graph (NN-WFG) positioning method using inertial measurement unit (IMU), real-time kinematic (RTK), and LiDAR is proposed by combining factor graph theory and a neural network model. Corresponding sensor factor node models are established according to the advantageous characteristics of different sensors, and a new multisensor fusion factor graph positioning model is constructed by integrating variable nodes and factor nodes. In addition, a neural network factor-weighted function is designed to optimize the trust allocation of different sensors during scenario transitions, thereby enhancing positioning accuracy and system robustness. Furthermore, an incremental smoothing optimization algorithm applying Givens transformation and QR matrix decomposition is developed to reduce computational complexity and improve real-time positioning performance. The simulation and experimental results demonstrate that compared with the inertial navigation system (INS), extended Kalman filter (EKF), conventional particle swarm optimization (PSO), LiDAR-inertial odometry via smoothing and mapping (LIO-SAM), and deep learning-assisted error-state EKF (DL-ES-EKF) methods, the proposed scheme can not only reduce the mean location error by approximately 40% under indoor and outdoor scenarios, but also significantly improve the computational efficiency and system robustness.  © 2014 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

