@ARTICLE{Luchetti2026129,
	author = {Luchetti, Alessandro and Tavernini, Mattia and De Cecco, Mariolino},
	title = {3D Vision-Based Digital Twin of a Mobile Robot for Objects Management in Intralogistics Scenarios},
	year = {2026},
	journal = {Lecture Notes in Computer Science},
	volume = {15740 LNCS},
	pages = {129 - 144},
	doi = {10.1007/978-3-031-97772-5_9},
	url = {https://www.scopus.com/pages/publications/105013621492?origin=resultslist},
	abstract = {Digital Twins (DTs) are revolutionizing industrial automation, particularly in intralogistics, by enabling real-time monitoring, predictive maintenance, and process optimization. This paper presents a 3D vision-based DT framework for an Autonomous Mobile Robot (AMR) designed for object localization and management in warehouse environments. The proposed framework integrates a high-fidelity simulation of 3D Time-of-Flight (ToF) cameras to model systematic effects such as multipath interference, flying pixels, and missing pixels. A virtual warehouse, built within the Unity engine, serves as a testbed for evaluating and optimizing object localization algorithms prior to deployment in real-world scenarios. As a case study, we introduce SmartFinder, a vision-based solution for precise pallet detection and localization in automated material handling. By calibrating the virtual ToF camera with real sensor data, we demonstrate the effectiveness of our simulation in predicting measurement uncertainties and improving algorithm robustness. The experimental results validate the DT’s capability to enhance AMR performance, ensuring accurate object localization with an error margin below ± 5 mm. Our findings highlight the advantages of DT-based simulation in reducing testing costs, minimizing operational risks, and accelerating industrial automation deployment. The proposed approach provides a scalable and efficient solution for AMRs operating in dynamic warehouse environments. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Lu2026,
	author = {Lu, Jiakai and Liu, Jun and Qin, Lan and Li, Min},
	title = {Dome: fast and robust LiDAR place recognition via spherical three-view feature fusion},
	year = {2026},
	journal = {Measurement: Journal of the International Measurement Confederation},
	volume = {263},
	pages = {},
	doi = {10.1016/j.measurement.2025.120174},
	url = {https://www.scopus.com/pages/publications/105025780254?origin=resultslist},
	abstract = {This paper presents Dome, a highly efficient and robust lightweight LiDAR-based place recognition algorithm, which aims to achieve rapid and accurate three-dimensional localization without relying on deep neural networks or GPU acceleration. The proposed method constructs three-view projections within a spherical coordinate system, integrating spatial density, relative depth, and elevation structural information of point clouds to generate a discriminative dense descriptor. To enhance feature stability, Dome introduces a hierarchical feature-guided fusion paradigm based on density-aware convolution and relative-depth weighting, thereby reinforcing geometrically sensitive regions and improving the consistency of multi-view feature representations. During the loop detection stage, Dome utilizes frequency-domain cosine similarity accelerated by FFTW to accomplish efficient matching. The algorithm achieves a per-frame processing frequency of approximately 250 Hz, reducing the single-frame computation time by about 28.86 % compared with Solid, thereby significantly improving the system's real-time performance. In terms of the Recall@1 evaluation metric, Dome surpasses the latest baseline methods Solid and NDTMC by approximately 18.71 % and 13.95 %, respectively, and demonstrates excellent robustness under challenging conditions such as occlusion and rotation. © 2025 Elsevier Ltd},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Hong2026,
	author = {Hong, Injun and Park, Manbok},
	title = {Particle-Filter-Based LiDAR Localization for Indoor Parking Lot},
	year = {2026},
	journal = {Applied Sciences (Switzerland)},
	volume = {16},
	number = {2},
	pages = {},
	doi = {10.3390/app16020908},
	url = {https://www.scopus.com/pages/publications/105028775981?origin=resultslist},
	abstract = {Accurate localization of autonomous vehicles in indoor environments is challenging due to the absence of GPS signals, so various studies have explored the use of environmental sensors to address this limitation. In this paper, we propose an indoor localization algorithm that utilizes a 3D LiDAR sensor and a 2D map, supported by improved motion and sensor modeling tailored for indoor parking lots. These environments contain complex conditions in which static noise from parked vehicles and dynamic noise from moving vehicles coexist, requiring a localization method capable of maintaining robustness under high-noise conditions. In this study, vehicle odometry was obtained using LOAM-style scan-to-scan LiDAR odometry, and a particle filter was implemented based on this information. The proposed algorithm was validated using a test vehicle in two indoor parking lots under three different conditions: when the lot was empty, when parked vehicles were present, and when other moving vehicles were present. Experimental results demonstrated that the algorithm achieved an average localization error of approximately 0.09 m across all scenarios, confirming its effectiveness for indoor parking environments. © 2026 by the authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Jiang2026551,
	author = {Jiang, Yuze and Javanmardi, Ehsan and Tsukada, Manabu and Esaki, Hiroshi},
	title = {Enhancing Autonomous Vehicle Localization Through Cooperative LiDAR and Smart Infrastructure Integration},
	year = {2026},
	journal = {IEEE Open Journal of Intelligent Transportation Systems},
	volume = {7},
	pages = {551 - 564},
	doi = {10.1109/OJITS.2026.3664106},
	url = {https://www.scopus.com/pages/publications/105030090877?origin=resultslist},
	abstract = {Autonomous driving systems rely on precise localization to ensure safety and performance in dynamic environments. However, standalone vehicle localization methods using onboard sensors often fail to deliver sufficient accuracy in adverse environments, such as tunnels or areas with limited distinguishable features. To address these challenges, we propose a novel cooperative localization framework that leverages roadside LiDAR-equipped infrastructure and vehicle-to-infrastructure (V2I) communication. In our approach, roadside LiDARs detect and estimate vehicle positions using a refined L-shape fitting algorithm, complemented by the vehicle’s geometric data shared over the V2I network. This method mitigates errors associated with partial point cloud data and improves localization precision significantly. By integrating this infrastructure-based positioning data with onboard localization modules via sensor fusion, our framework enhances overall accuracy and robustness in real-time autonomous driving scenarios. Experimental results in a digital twin environment demonstrate that our system achieves over 70% improvement in localization accuracy compared to self-localization methods. Our work highlights the potential of smart infrastructure to enhance localization, reduce onboard sensor dependency, and improve autonomous driving reliability under challenging environment for self-localization. © 2020 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4; All Open Access; Gold Open Access}
}

@ARTICLE{Jian202612503,
	author = {Jian, Qiuwei and Ma, Qinglu and Wang, Xinyu and Ullah, Saleem},
	title = {JONA-SLAM: Tightly Coupled SLAM With Joint Observation and Normal-Aware Loop Closure},
	year = {2026},
	journal = {IEEE Sensors Journal},
	volume = {26},
	number = {8},
	pages = {12503 - 12511},
	doi = {10.1109/JSEN.2026.3669355},
	url = {https://www.scopus.com/pages/publications/105032881636?origin=resultslist},
	abstract = {In the field of autonomous navigation, accurate localization and mapping are of paramount importance, especially for autonomous vehicles operating in global navigation satellite system (GNSS)-challenged or denied environments. This article presents joint observation and normal-aware (JONA)-simultaneous localization and mapping (SLAM), a tightly coupled light detection and ranging (LiDAR)-visual-inertial SLAM system designed to enhance state estimation robustness for autonomous driving platforms in complex scenarios such as urban canyons and tunnels. Building upon our previous research on point-line feature extraction, the proposed system strengthens spatial constraints by constructing a LiDAR-visual joint observation factor. This factor enables the tight coupling of LiDAR-derived geometric information with visual texture features at the feature level, effectively addressing the observation degradation common in GNSS-denied areas. Furthermore, a normal-aware hybrid loop closure detection method is proposed, incorporating point cloud normal consistency verification to significantly improve loop identification reliability and suppress false positives in challenging semistructured scenes. Evaluation results on 22 public sequences and a self-collected campus dataset demonstrate that JONA-SLAM achieves superior or competitive performance compared to state-of-the-art methods. Across 23 experimental test cases, the proposed method reduces the trajectory error [root mean square error (RMSE)] by an average of 35.02%. While maintaining real-time performance, the system demonstrates superior environmental adaptability and global consistency, providing a high-precision and robust localization solution for autonomous driving and versatile mobile platforms in degraded environments. © 2001-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Jiao2026,
	author = {Jiao, Hongjian and Dong, Wenxin and Zhou, Tao and Chen, Ruizhi and Chen, Liang},
	title = {5G/GNSS/INS multi-sources integration navigation based on adaptive-FGO for urban environment},
	year = {2026},
	journal = {Information Fusion},
	volume = {127},
	pages = {},
	doi = {10.1016/j.inffus.2025.103876},
	url = {https://www.scopus.com/pages/publications/105022729051?origin=resultslist},
	abstract = {As a strategic component in modern positioning, navigation, and timing (PNT) system, the Global Navigation Satellite System (GNSS) has been extensively applied in daily life. Nevertheless, in complex urban environments, GNSS still struggles to fulfill the demands for high-precision and high-reliability positioning. Consequently, it is essential to implement multi-source signal fusion positioning to ensure the availability, continuity, and reliability of PNT services. The fifth-generation mobile communication technology (5G), as the communication system, has achieved extensive indoor and outdoor coverage globally. Therefore, this paper proposes a tightly-coupled 5G/GNSS/INS integrated navigation framework to address positioning challenges in GNSS-degraded environments, leveraging public 5G downlink signals. First, we conduct 5G downlink ranging using signals from publicly available 5G base stations instead of simulated 5G data. Building on this, a novel implementation of factor graph optimization that integrates public 5G signals with GNSS and inertial measurements is proposed. We build a multi-layer factor graph optimization structure through GNSS measurements and public 5G observations, and then perform data fusion through preintegration with inertial data. Moreover, the factor graph optimization strategy is improved by adaptive noise estimation based on the localization residual detection in continuous time. The experimental results show that this method achieves submeter positioning accuracy and significantly improves the navigation and positioning performance in different scenarios. © 2025 Elsevier B.V.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

@ARTICLE{Yang2026,
	author = {Yang, Zhe and Song, Kunyu and Zheng, Bo and Nan, Zhixiong},
	title = {ADR-LIO: Adaptive Degradation-Resilient LiDAR-Inertial Odometry for Urban Environments},
	year = {2026},
	journal = {IEEE Transactions on Instrumentation and Measurement},
	volume = {75},
	pages = {},
	doi = {10.1109/TIM.2026.3694768},
	url = {https://www.scopus.com/pages/publications/105039638910?origin=resultslist},
	abstract = {LiDAR-inertial odometry (LIO), as a core technology for autonomous navigation, has been widely used for real-time localization and mapping of autonomous vehicles. However, some urban environments (e.g., tunnels and bridges) usually present sparse features, which is commonly termed as a degradation issue, leading to point cloud mapping drift. To address the issue, this article proposes adaptive degradation-resistant LIO (ADR-LIO). First, a degradation detection method based on point cloud spatial distribution is proposed. Precise degradation identification is realized by adapting to the properties of urban scenarios. Then, according to the severity of degradation, we adaptively adjust feature weights and perform initial pose updates using historical frame pose information, thereby mitigating matching errors induced by degradation. Additionally, we contribute a new dataset, the Degenerate Traffic Scenes Dataset (DTSD), which covers 25 km of real-world urban data with diverse degenerate scenes. Experimental evaluations on GEODE and DTSD demonstrate that ADR-LIO outperforms state-of-the-art SLAM methods in terms of accuracy and robustness, while ensuring real-time performance and global mapping consistency. © 1963-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Cheng20266702,
	author = {Cheng, Jiajun and Xue, Zhirui and Chen, Haonan and Huang, Yulong},
	title = {Distributionally Robust Kalman Filter under Likelihood Model Mismatch from an Optimization Perspective - Part II: Extension and Application to Cooperative Localization},
	year = {2026},
	journal = {IEEE Transactions on Aerospace and Electronic Systems},
	volume = {62},
	pages = {6702 - 6726},
	doi = {10.1109/TAES.2026.3669118},
	url = {https://www.scopus.com/pages/publications/105031815634?origin=resultslist},
	abstract = {Cooperative localization enhances positioning performance by exploiting relative measurements and information exchange within a swarm system. Fully distributed cooperative localization, wherein each agent maintains and shares only its local state information, is particularly attractive due to its low communication overhead and strong scalability. However, the lack of correlation information prevents fully distributed cooperative localization from precisely maintaining likelihood model and leads to an inherent likelihood model mismatch problem, which causes inconsistent and inaccurate relative measurement update. To address this issue, the robust filtering method proposed in the companion paper (Part I) is considered to reduce the sensitivity of the state estimation to the likelihood model mismatch and improve the estimation consistency and accuracy. To better balance estimation accuracy and consistency, this robust filtering method is further extended by incorporating the γ-divergence, which enables a tunable tradeoff between the estimation accuracy and consistency through the parameter γ. Based on this extension, a fully distributed cooperative localization framework is developed. A theoretical analysis is conducted to elucidate the impact of the tunable parameter γ on estimation accuracy and consistency. Extensive simulations, dataset evaluations, and real-world experiments validate the effectiveness of the proposed approach and demonstrate its advantages over existing state-of-the-art cooperative localization methods.  © 1965-2011 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Ge2026,
	author = {Ge, Yunchen and Contreras, Marcelo and Bhatt, Neel P. and Hashemi, Ehsan},
	title = {Design of a 3D High-Definition Map Visualizer for Pose Estimation and Autonomous Navigation in Dynamic Environments},
	year = {2026},
	journal = {Sensors},
	volume = {26},
	number = {4},
	pages = {},
	doi = {10.3390/s26041344},
	url = {https://www.scopus.com/pages/publications/105031425255?origin=resultslist},
	abstract = {A high-definition (HD) map development framework providing real-time visualization of multimodal perception data for state estimation, motion planning, and decision-making in autonomous navigation is presented and experimentally validated. The proposed framework integrates synchronized visual and LiDAR data and generates consistent frame transformations to construct accurate and interpretable HD maps suitable for navigation in dynamic environments. In addition, the framework enables flexible customization of essential map elements, including road features and static landmarks, facilitating efficient map generation and visualization. Building upon the developed HD map visualizer, a semantic-aware visual odometry (VO)-based pose estimation module is designed and verified through extensive evaluations and under perceptually degraded conditions. To ensure the reliability of synchronized multimodal data used by downstream perception and pose estimation modules, a sensor health monitoring system is also developed and validated in urban canyon scenarios with intermittent or unavailable global navigation satellite system (GNSS) measurements. Experimental results demonstrate that the proposed HD map visualizer and associated perception modules are transferable for autonomous navigation and can be effectively employed as benchmarking tools for state estimation and motion planning algorithms in autonomous driving. © 2026 by the authors.},
	pmid = {41755283},
	type = {Article},
