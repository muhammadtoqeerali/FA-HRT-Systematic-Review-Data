@ARTICLE{Yoo20252218,
	author = {Yoo, Kwanghyun and Kim, Dae-Kwang and Kim, Jae-Jun and Yang, Seung-Ung and Yoo, Hui-Ryoung and Song, HongSeok and Jeong, Han-You and Nguyen, Hoa-Hung and Song, Jin Woo and Kim, Dong-Kyu},
	title = {Improving Localization Accuracy of Offline Navigation Algorithms for Intelligent Pipeline Inspection Gauges and In-Line Inspection Robotic Systems},
