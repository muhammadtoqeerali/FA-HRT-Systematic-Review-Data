@ARTICLE{Wang2022,
	author = {Wang, Zelin and Gao, Feng and Zhao, Yue and Yin, Yunpeng and Wang, Liangyu},
	title = {A Deep Hierarchical Framework for Robot Global Localization},
	year = {2022},
	journal = {Journal of Intelligent and Robotic Systems: Theory and Applications},
	volume = {106},
