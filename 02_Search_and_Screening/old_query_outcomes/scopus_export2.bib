	year = {2026},
	journal = {2026 International Conference on Intelligent Manufacturing and Automation, IMA 2026},
	pages = {371 - 376},
	doi = {10.1109/IMA68480.2026.11517629},
	url = {https://www.scopus.com/pages/publications/105041605360?origin=resultslist},
	abstract = {This paper presents an intelligent medicine delivery robot system integrating advanced computer vision algorithms for autonomous hospital navigation. We propose a hierarchical ROS2-based framework combining ResNet18 for deep learning-driven line following, YOLOv5 for real-time obstacle detection, and depth-enhanced visual SLAM for robust localization. The system leverages the RDKX3 AI accelerator to achieve 28 FPS ResNet18 inference and 45ms YOLOv5 detection, enabling 87±12ms end-to-end control latency. Deployed on an Ackermann chassis with RGB-D sensors, our approach demonstrates superior performance in hospital corridor environments with 6.8±2.1cm path deviation, zero collision incidents across 20 autonomous trials, and 16.7% improved energy efficiency compared to LiDAR-based systems. Comprehensive benchmarking in laboratory-simulated hospital corridors against traditional CV, YOLOv3, MobileNetV2, and LiDAR-SLAM baselines validates the technical feasibility of our integrated deep learning pipeline as a proof-of-concept for medical logistics automation, pending clinical validation and medical device certification. ©2026 IEEE.},
