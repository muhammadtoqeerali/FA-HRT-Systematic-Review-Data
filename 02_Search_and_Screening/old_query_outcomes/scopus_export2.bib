@ARTICLE{Shen202415100,
	author = {Shen, Zhiheng and Li, Xin and Li, Xingxing},
	title = {Advancing High-Precision Navigation: Leveraging Homogeneous Sensors in Tightly Coupled PPP-RTK/IMU Integration},
	year = {2024},
	journal = {IEEE Transactions on Industrial Electronics},
	volume = {71},
	number = {11},
	pages = {15100 - 15110},
	doi = {10.1109/TIE.2024.3363741},
	url = {https://www.scopus.com/pages/publications/85186082238?origin=resultslist},
	abstract = {As Global Navigation Satellite Systems (GNSS) and inertial measurement units (IMUs) are gradually emerging as ubiquitous, utilizing redundant sensors to achieve accurate and robust large-scale navigation holds great promise. In this article, we propose a tightly coupled precise point positioning-real-Time kinematic (PPP-RTK)/ IMU system with multiple homogeneous sensors to enable high-precision and high-Availability vehicle navigation. In it, a stacked Kalman filter is employed to fuse raw pseudorange and carrier phase measurements from all GNSS terminals, driven by a core IMU designated randomly. In PPP-RTK processing, precise atmospheric and bias corrections from a GNSS server are leveraged to quickly resolve carrier phase ambiguity, thus ensuring centimeter-level positioning. Besides, rotation and translation constraints from redundant IMUs are imposed on the estimation pipeline to further improve the state estimation. Real-world experiments show that the proposed method can achieve an availability of 98.7% (horizontal position error <0.1 m) in a half-open-sky case, which is far better than the state-of-The-Art methods. Also, redundant sensors not only contribute significantly to the integer ambiguity resolution, but are also able to promise continuous state estimation in the case of sensor failure. © 1982-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 17}
}

@ARTICLE{Zhang2023,
	author = {Zhang, Yuhan and Zou, Lei and Song, Baoye and Zhao, Zhongyi and Wang, Yezheng},
	title = {Neural-network-based output feedback control for networked multirate systems: A bit rate allocation scheme},
	year = {2023},
	journal = {Information Sciences},
	volume = {637},
	pages = {},
	doi = {10.1016/j.ins.2023.118952},
	url = {https://www.scopus.com/pages/publications/85152916061?origin=resultslist},
	abstract = {This paper deals with the neural-network (NN)-based output feedback control problem for a class of networked systems with unknown nonlinearities under the effects of bit rate constraints. Considering the physical conditions/requirements in practical applications, the sampling period of sensors is assumed to be different from the state updating period of the system. For the purpose of facilitating digital communications over networks, a group of encoders is utilized to convert the measurement signal into codewords with limited bit lengths. A so-called bit rate constraint is introduced to capture the bandwidth-limited nature of communication network. To handle the unknown nonlinearity of the multirate system, both the NN-based observer and NN-based controller are designed to generate the desired state estimates and control input signals, respectively. Then, a unified framework is established to analyze the boundedness of the estimation error and system state as well as the neural network weights. The effects of the bit rate constraint on the resultant control performance is also analyzed. Subsequently, sufficient conditions are derived to guarantee the existence of the required NN-based output feedback controller. A particle-swarm-optimization-based (PSO-based) algorithm is developed to co-design the desired controller parameter and the bit rate allocation strategy. Finally, an illustrative example is given to verify the effectiveness of the proposed control strategy. © 2023 Elsevier Inc.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 12}
}

@CONFERENCE{Wang20241064,
	author = {Wang, Wuqi and Min, Haigen and Wu, Xia and Zhao, Xiangmo},
	title = {Augmenting Loop Detection Performance in Autonomous Navigation: A Temporal Similarity-Based Approach},
	year = {2024},
	journal = {2024 9th International Conference on Computer and Communication Systems, ICCCS 2024},
	pages = {1064 - 1072},
	doi = {10.1109/ICCCS61882.2024.10603020},
	url = {https://www.scopus.com/pages/publications/85201281209?origin=resultslist},
	abstract = {Loop detection constitutes an indispensable component in robotics and autonomous driving navigation systems. Extant literature has predominantly focused on extracting essential features from sensor data and constructing robust descriptors. Nevertheless, these measurements frequently suffer from errors, attributable to the diversity in traversal behaviors, complex traffic environments, and inconsistencies in sensor performance. This paper explores into the spatial and temporal aspects of loops, examines the temporal similarity and patterns of consecutive loop sequences, and introduces a temporal similarity assessment for measurements within the same sequence. Contrary to previous methodologies, our proposed method amalgamates measurements and temporal similarity for detection simultaneously. This innovative approach not only improves the efficiency of the measurement method but also utilizes temporal similarity to offset measurement inaccuracies, thereby enhancing detection performance in complex and extreme scenarios. To corroborate the efficacy of the proposed methodology, a meticulous evaluation is executed on a dataset comprising a wide spectrum of traffic scenarios. The results corroborate that the proposed method exhibits adaptability across an extensive array of complex and extreme scenarios while upholding efficiency. © 2024 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Chi202326486,
