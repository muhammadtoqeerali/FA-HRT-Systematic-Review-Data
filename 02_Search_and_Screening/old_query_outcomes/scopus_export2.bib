	title = {Event-Triggered Quantized Consensus of Networked MASs Using Integral Sliding Mode Observer},
	year = {2026},
	journal = {IEEE Transactions on Systems, Man, and Cybernetics: Systems},
	volume = {56},
	number = {9},
	pages = {5342 - 5352},
	doi = {10.1109/TSMC.2026.3702006},
	url = {https://www.scopus.com/pages/publications/105043222220?origin=resultslist},
	abstract = {Achieving average consensus in networked multiagent systems (MASs) remains challenging in practical engineering scenarios when unmeasured states, external disturbances, and limited communication bandwidth occur. These issues often degrade system performance and may even lead to instability. To address these challenges, this article provides an observer-based event-triggered quantized integral sliding mode control framework. In particular, an integral sliding manifold (ISM) is constructed using observer states to eliminate steady-state errors under disturbances. Then, an exponential-decay-based event-triggered scheme with observer states is devised to reduce unnecessary transmissions, while a logarithmic quantizer compresses the triggered signals to alleviate digital network burden. These elements are further synthesized into an observer-based controller that ensures average consensus despite unmeasured states, disturbances, and quantization. Sufficient conditions for average consensus are derived via Riccati equations, linear matrix inequalities, and Lyapunov theory. Finally, a numerical simulation demonstrates the effectiveness of the proposed method, showing its potential for practical applications such as cooperative control of autonomous vehicles and distributed power systems.  © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{Zhao2026,
