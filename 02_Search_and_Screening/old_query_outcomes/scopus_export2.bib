@CONFERENCE{Cruz-Acevedo2025,
	author = {Cruz-Acevedo, Mauricio and Cervantes, Ilse and Hernandez-Nochebuena, Marco},
	title = {Longitudinal Speed Estimation in Vehicles Using a Multilayer Perceptron},
	year = {2025},
	journal = {2025 IEEE Latin American Conference on Computational Intelligence, LA-CCI 2025 - Conference Proceedings},
	pages = {},
	doi = {10.1109/LA-CCI66231.2025.11270448},
	url = {https://www.scopus.com/pages/publications/105031386499?origin=resultslist},
	abstract = {Accurate estimation of a vehicle’s longitudinal speed is essential for numerous safety and control functions, especially in environments where traditional sensors (e.g., GNSS or wheel encoders) become unreliable. This study explores a lightweight, data-driven approach using a multilayer perceptron (MLP) neural network trained exclusively on inertial measurements and auxiliary vehicle data. The proposed estimator takes as input six IMU signals—three-axis accelerations and angular velocities—alongside optional powertrain and steering features such as engine RPM and steering wheel angle. The model employs a simple feed-forward architecture with two hidden layers of 220 neurons each, enabling efficient training and real-time inference. Experimental data were collected from a test vehicle equipped with a high-precision GNSS/IMU ground-truth system. The results show that when only IMU data are used, the estimator achieves a root mean square error (RMSE) of 0.269 m/s and an R<sup>2</sup> of 0.57 after 30 training epochs. Excluding individual signals like vertical acceleration or pitch reduces accuracy, highlighting the value of a complete inertial profile. Remarkably, when engine RPM and steering angle are included alongside IMU inputs, the network achieves an RMSE of 0.093 m/s and R<sup>2</sup> of 0.948—comparable to more complex sensor fusion techniques. These findings confirm the viability of compact MLP models for robust longitudinal speed estimation using low-cost onboard sensors, paving the way for embedded deployment in production vehicles. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

