}

@CONFERENCE{Kirnos2026,
	author = {Kirnos, Vasiliy P. and Mogulev, Maksim A. and Priorov, Andrey L.},
	title = {Impact of Temporal Desynchronization of Sensor Data on the Accuracy of Modern SLAM Algorithms},
	year = {2026},
	journal = {2026 Systems of Signal Synchronization, Generating and Processing in Telecommunications, SYNCHROINFO 2026 - Conference Proceedings},
	pages = {},
	doi = {10.1109/SYNCHROINFO70145.2026.11613315},
	url = {https://www.scopus.com/pages/publications/105046506190?origin=resultslist},
	abstract = {This paper investigates how temporal desynchronization between heterogeneous sensor streams affects the accuracy of modern Simultaneous Localization and Mapping (SLAM) algorithms. We propose a reproducible methodology for injecting controlled time shifts between camera, LiDAR, inertial measurement unit (IMU) and wheel-odometry data while keeping the underlying trajectory and environment unchanged. Using this methodology, we evaluate four representative SLAM configurations visual-inertial (ORB-SLAM3 / VINS-Mono), pure LiDAR (FAST-LIO2 / LIO-RF), odometry-centric, and tightly coupled multi-sensor fusion on two complementary datasets (Norlab RTS-GT and EuRoC MAV) with the Absolute Pose Error (APE) and Relative Pose Error (RPE) metrics. Experiments with time offsets of 10, 50 and 100 ms reveal three characteristic regimes: (i) visual-inertial and single-sensor LiDAR systems are largely insensitive to constant delays up to 100 ms; (ii) odometry-centric SLAM remains robust on average but develops heavier error tails; (iii) the tightly coupled fusion configuration exhibits a pronounced non-monotonic response, where a 10 ms shift reduces APE RMSE by 28.8 % (from 9.24 m to 6.57 m) by compensating a latent calibration bias, whereas larger delays degrade accuracy. These results demonstrate that 'nominally synchronized' multi-sensor SLAM systems may contain hidden temporal offsets and highlight the need for explicit temporal-sensitivity analysis in validation procedures for safety-critical robotic platforms. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{MAN202639,
