@ARTICLE{Yusefi202110054,
	author = {Yusefi, Abdullah and Durdu, Akif and Aslan, Muhammet Fatih and Sungur, Cemil},
	title = {LSTM and filter based comparison analysis for indoor global localization in UAVs},
	year = {2021},
	journal = {IEEE Access},
