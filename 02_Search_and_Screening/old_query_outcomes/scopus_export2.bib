@ARTICLE{Yin2021837,
	author = {Yin, Huan and Wang, Yue and Tang, Li and Ding, Xiaqing and Huang, Shoudong and Xiong, Rong},
	title = {3D LiDAR Map Compression for Efficient Localization on Resource Constrained Vehicles},
