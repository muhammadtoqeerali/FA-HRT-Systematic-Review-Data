@ARTICLE{Cheon201824325,
	author = {Cheon, Jung Hee and Han, Kyoohyung and Hong, Seong-Min and Kim, Hyoun Jin and Kim, Junsoo and Kim, Suseong and Seo, Hosung and Shim, Hyungbo and Song, Yongsoo},
	title = {Toward a Secure Drone System: Flying with Real-Time Homomorphic Authenticated Encryption},
	year = {2018},
