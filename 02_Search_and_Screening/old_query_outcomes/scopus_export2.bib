	author = {Wang, Yanbo and Fan, Yaxian and Wang, Jingchuan and Chen, Weidong},
	title = {Long-term navigation for autonomous robots based on spatio-temporal map prediction},
	year = {2024},
	journal = {Robotics and Autonomous Systems},
	volume = {179},
