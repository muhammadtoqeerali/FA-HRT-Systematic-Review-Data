@ARTICLE{Zhang2026,
	author = {Zhang, Du and Pan, Peifen and Wang, Shengliang and Zhang, Baocheng},
	title = {A height-constrained PPP-RTK/INS/UWB method for vehicle precise positioning in all scenarios},
	year = {2026},
	journal = {GPS Solutions},
	volume = {30},
	number = {3},
	pages = {},
	doi = {10.1007/s10291-026-02089-7},
	url = {https://www.scopus.com/pages/publications/105041158374?origin=resultslist},
	abstract = {Global Navigation Satellite System (GNSS) plays a crucial role in autonomous driving, train control systems, and other applications. Precise Point Positioning-Real Time Kinematic (PPP-RTK), which combines the advantages of Real-Time Kinematic (RTK) and Precise Point Positioning (PPP), enables rapid high-precision positioning with sparse reference stations. Although Inertial Navigation System (INS) effectively compensates for GNSS positioning deficiencies during temporary signal blockages, it tends to accumulate errors rapidly over time in long tunnel environments. Ultra-wideband (UWB) can provide decimeter‑level positioning accuracy in enclosed spaces, but this accuracy strongly relies on densely deployed anchors, leading to high infrastructure costs. To reduce the number of UWB anchors and GNSS reference stations while maintaining high positioning accuracy, this study proposes a novel height-constrained adaptive loosely-coupled GNSS PPP-RTK/INS/UWB integration method for vehicle precise positioning in all scenarios. On the one hand, by utilizing prior vehicle height information and UWB anchors’ elevation data to constrain the positioning model, the method enhances PPP-RTK convergence speed when exiting tunnels and improves UWB three-dimensional positioning accuracy inside tunnels. On the other hand, through an adaptive loosely-coupled downweighting method with INS temporal reliability constraint, decimeter-level positioning is achieved across all scenarios with sparsely distributed GNSS reference stations and sparsely deployed UWB anchors in tunnels. Experimental results demonstrate root mean square error (RMSE) values of 0.13, 0.12, and 0.25 m in the north, east, and up directions in complex urban environments outside tunnels, and 0.28, 0.59, and 0.30 m inside tunnels. Compared to traditional methods, the proposed approach improves UWB horizontal positioning accuracy by 73.76% while inside the tunnel, reduces PPP-RTK convergence time to 1–2 s after exiting the tunnel, and achieves three-dimensional errors below 1 m for 98.90% of epochs across all scenarios. While maintaining decimeter-level positioning accuracy, this research significantly extends the practical UWB anchor spacing from lesss than 50 m to 250 m in fully obstructed environments, reducing infrastructure costs by approximately 70%. This provides an economically efficient solution for continuous all-scenario vehicle positioning, particularly suitable for train positioning and autonomous driving applications. © The Author(s), under exclusive licence to Springer-Verlag GmbH Germany, part of Springer Nature 2026.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
