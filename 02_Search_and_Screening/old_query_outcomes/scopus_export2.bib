	title = {Evaluation of Real-Time Vehicle Localization Accuracy Using Vision-Based Deep Learning and Sensor Fusion in GPS-Denied Scenarios},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {187451 - 187466},
	doi = {10.1109/ACCESS.2025.3627600},
	url = {https://www.scopus.com/pages/publications/105020699067?origin=resultslist},
	abstract = {This study proposes a novel real-time vehicle localization framework designed specifically for GPS-denied environments, emphasizing heterogeneous fusion of visual and inertial information. Unlike conventional systems that separately process camera and IMU data, the proposed method integrates multi-camera panoramic image stitching, deep convolutional coordinate estimation, and inertial measurement unit (IMU) assisted motion correction within a unified architecture. The system’s innovation lies in a real-time synchronization mechanism that enables continuous bird’s-eye view generation and position prediction, supported by Kalman-based adaptive fusion for drift suppression. A high-resolution UAV-generated parking map serves as the reference for visual matching, providing robust localization even under occlusion and illumination variations. Experimental validation in structured parking scenarios demonstrates that the proposed framework achieves higher positioning accuracy and stability than conventional vision-only methods, while maintaining lightweight computational complexity suitable for intelligent parking and autonomous navigation applications. The proposed method offers a robust and cost-effective localization solution for autonomous vehicles operating in GPS-denied scenarios. © 2013 IEEE.},
