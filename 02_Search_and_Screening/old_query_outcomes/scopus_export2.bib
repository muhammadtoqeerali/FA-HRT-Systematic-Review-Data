@ARTICLE{Tabassum2023,
	author = {Tabassum, Tarafder Elmi and Xu, Zhengjia and Petrunin, Ivan and Rana, Zeeshan A.},
	title = {Integrating GRU with a Kalman Filter to Enhance Visual Inertial Odometry Performance in Complex Environments},
	year = {2023},
