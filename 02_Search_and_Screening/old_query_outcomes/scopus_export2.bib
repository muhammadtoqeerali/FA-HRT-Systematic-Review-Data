	author = {El Hajjami, Lhoussain and Mellouli, El Mehdi and Žuraulis, Vidas and Berrada, Mohammed},
	title = {A novel robust adaptive neuro-sliding mode steering controller for autonomous ground vehicles},
	year = {2023},
