@ARTICLE{Bian2019,
	author = {Bian, Jiang and Hui, Xiaolong and Zhao, Xiaoguang and Tan, Min},
	title = {A monocular vision–based perception approach for unmanned aerial vehicle close proximity transmission tower inspection},
	year = {2019},
