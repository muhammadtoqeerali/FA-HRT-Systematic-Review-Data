@ARTICLE{Wang2026,
	author = {Wang, Ning and Hou, Yuli and Qiu, Chidong and You, Zaijin},
	title = {Swarming-Embedded Markov Decision Process for Cooperative Path Planning of Underactuated Uncrewed Surface Vehicle Swarms},
	year = {2026},
