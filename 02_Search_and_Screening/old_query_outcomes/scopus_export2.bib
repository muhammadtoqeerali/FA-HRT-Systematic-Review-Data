@ARTICLE{Shi20245995,
	author = {Shi, Pengcheng and Xiao, Yilin and Chen, Wenqing and Li, Jiayuan and Zhang, Yongjun},
	title = {A New Horizon: Employing Map Clustering Similarity for LiDAR-Based Place Recognition},
	year = {2024},
