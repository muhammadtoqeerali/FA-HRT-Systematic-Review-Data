}

@ARTICLE{Huang20243345,
	author = {Huang, Feng and Wen, Weisong and Zhang, Jiachen and Wang, Chaoqun and Hsu, Li-Ta},
	title = {Dynamic Object-Aware LiDAR Odometry Aided by Joint Weightings Estimation in Urban Areas},
	year = {2024},
