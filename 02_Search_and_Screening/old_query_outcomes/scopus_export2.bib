@CONFERENCE{Han20261322,
	author = {Han, Mingqiao and Wang, Chenxiao and Lei, Lei and Yang, Guidong and Ding, Yulong and Chen, Xi and Chen, Ben M.},
	title = {SLAM for Underwater Autonomous Unmanned Systems: Sensors, Framework and Limitations},
	year = {2026},
