@CONFERENCE{Ryu2024520,
	author = {Ryu, KangSoo and Lee, Taehoon and Lee, Byungjin and Sung, Sangkyung},
	title = {Development of LIO-Based Navigation Simulator under Low-Visibility Indoor Environment with Situational Measurement Error Modeling},
	year = {2024},
	journal = {15th Asia-Pacific International Symposium on Aerospace Technology, APISAT 2024},
	volume = {1},
	pages = {520 - 528},
	url = {https://www.scopus.com/pages/publications/105014908720?origin=resultslist},
	abstract = {The utilization of unmanned vehicles is increasing across various fields, including challenging sensor environments such as heavy industrial settings and fire scenarios. In particular, the performance of GNSS and camera sensors, widely used in unmanned vehicle applications, is significantly limited in low-visibility indoor smoky environments. Therefore, combining an Inertial Navigation System (INS) and LiDAR is essential to build an effective navigation system under such conditions. This paper addresses the challenge of developing navigation systems in environments that are difficult to replicate in reality by proposing a method to develop and evaluate an INS and LiDAR integrated navigation system through a simulator that simulates a smoky environment. The simulated environment and corresponding noise model are meticulously designed based on data collected from actual environments and physical principles, enabling realistic simulations. Specifically, the noise model incorporates characteristics such as particle density, environment properties, and sensor occlusion effects observed in actual smoky conditions. This detailed modelling ensures the simulator can accurately replicate the complexities of navigating through low-visibility environments, providing a robust platform for testing and validation. This approach allows for the replication of challenging real-world conditions to test navigation system performance across various scenarios. By using a simulated environment, researchers can systematically vary parameters such as smoke density, lighting conditions, and sensor placement, which would be difficult to control in real-world experiments. This flexibility enhances the ability to identify weaknesses and optimize the navigation system's performance before deployment in actual environments. The simulator's data is managed within the ROS2 ecosystem, ensuring compatibility and ease of integration with existing robotic platforms. In this environment, LiDAR-Inertial Odometry (LIO) navigation algorithms are employed to optimize the data from each sensor. ROS2 provides several advantages, including real-time data processing, modularity, and the ability to incorporate additional sensors or algorithms easily. The system's performance is evaluated through various experiments, which include scenarios with different levels of visibility and varying movements. These experiments help in fine-tuning the algorithms to ensure they can handle the unpredictable nature of real-world smoky conditions effectively. In conclusion, this study significantly contributes to developing safer and more efficient indoor navigation systems by providing a detailed and realistic simulation environment for testing and optimizing INS and LiDAR integration. The proposed simulator offers a practical solution for overcoming the challenges associated with real-world testing in harsh sensor environments, paving the way for advanced autonomous systems capable of operating in diverse and demanding conditions. Future work will further enhance the simulator's realism and explore integrating additional sensor modalities to improve navigation accuracy and robustness. The ongoing research aims to push the boundaries of autonomous navigation, ensuring these systems can perform reliably in the most challenging and unpredictable environments, such as search and rescue missions, firefighting operations, and industrial automation tasks. © 2024 15th Asia-Pacific International Symposium on Aerospace Technology, APISAT 2024. All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Stannartz202360005,
	author = {Stannartz, Niklas and Schutte, Stefan and Kuhn, Markus and Bertram, Torsten},
	title = {Toward Precise Ambiguity-Aware Cross-Modality Global Self-Localization},
	year = {2023},
	journal = {IEEE Access},
	volume = {11},
	pages = {60005 - 60027},
	doi = {10.1109/ACCESS.2023.3286310},
	url = {https://www.scopus.com/pages/publications/85163192231?origin=resultslist},
	abstract = {There are significant advances in GNSS-free cross-modality self-localization of self-driving vehicles. Recent methods focus on learnable features for both cross-modal global localization via place recognition (PR) and local pose tracking, however they lack means of combining them in a complete localization pipeline. That is, a pose retrieved from PR has to be validated if it actually represents the true pose. Performing this validation without GNSS measurements makes the localization problem significantly more challenging. In this contribution, we propose a method to precisely localize the ego-vehicle in a high resolution map without GNSS prior. Furthermore, sensor and map data may be of different dimensions (2D / 3D) and modality, i.e. radar, lidar or aerial imagery. We initialize our system with multiple hypotheses retrieved from a PR method and infer the correct hypothesis over time. This multi-hypothesis approach is realized using a Gaussian sum filter which enables an efficient tracking of a low number of hypotheses and further facilitates the inference of our deep sensor-to-map matching network at arbitrarily distant regions simultaneously. We further propose a method to estimate the probability that none of the currently tracked hypotheses is correct. We achieve successful global localization in extensive experiments on the MulRan dataset, outperforming comparative methods even if none of the initial poses from PR was close to the true pose. Due to the flexibility of the approach, we can show state-of-the-art accuracy in lidar-to-aerial-imagery localization on a custom dataset using our pipeline with only minor modifications of the matching model.  © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Nam20233809,
	author = {Nam, Dinh Van and Gon-Woo, Kim},
	title = {Learning Type-2 Fuzzy Logic for Factor Graph Based-Robust Pose Estimation With Multi-Sensor Fusion},
	year = {2023},
	journal = {IEEE Transactions on Intelligent Transportation Systems},
	volume = {24},
	number = {4},
	pages = {3809 - 3821},
	doi = {10.1109/TITS.2023.3234595},
	url = {https://www.scopus.com/pages/publications/85148468918?origin=resultslist},
	abstract = {Although a wide variety of high-performance state estimation techniques have been introduced recently, the robustness and extension to actual conditions of the estimation systems have been challenging. This paper presents a robust adaptive state estimation framework based on the Type-2 fuzzy inference system and factor graph optimization for autonomous mobile robots. We use the hybrid solution to connect the advantages of the tightly and loosely coupled technique by providing an inertial sensor and other extrinsic sensors such as LiDARs and cameras. In order to tackle the uncertainty input covariance and sensor failures problems, a learnable observation model is introduced by joining the Type-2 FIS and factor graph optimization. In particular, the use of Type-2 Takagi-Sugeno FIS can learn the uncertainty by using particle swarm optimization before adding the observation model to the factor graph. The proposed design consists of four parts: sensor odometry, up-sampling, FIS based-learning observation model, and factor graph-based smoothing. We evaluate our system by using a mobile robot platform equipped with a sensor setup of multiple stereo cameras, an IMU, and a LiDAR sensor. We imitate the LiDAR odometry in structure environments without needing other bulky motion capture systems to learn the observation model of the visual-inertial estimators. The experimental results are deployed in real-world environments to present the accuracy and robustness of the algorithm.  © 2000-2011 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
