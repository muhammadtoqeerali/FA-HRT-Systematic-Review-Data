	doi = {10.1109/ICCA69928.2026.11617971},
	url = {https://www.scopus.com/pages/publications/105047327936?origin=resultslist},
	abstract = {Underwater Autonomous Unmanned Systems (UAUS) increasingly rely on Simultaneous Localization and Mapping (SLAM) for closed loop autonomy in missions such as infrastructure inspection, ocean mapping, and environmental monitoring. Underwater operation imposes distinctive sensing constraints: global positioning is generally unavailable, optical perception degrades severely in turbid water, and acoustic sensing, while useful under low visibility, often exhibits structured artifacts, heavy tailed noise, low update rates, and nonnegligible latency. As a result, underwater SLAM is often limited not only by estimator design, but by how reliably measurement constraints can be formed and maintained under changing conditions. This review examines underwater SLAM for UAUS from the perspective of constraint reliability under regime dependent sensing. We summarize common sensing modalities and the operating envelopes and failure mechanisms that shape their usable constraints, then review representative SLAM frameworks through data synchronization and association, local pose estimation, and loop closure with global optimization. Finally, motivated by failures in turbid vision and noisy acoustic mapping, we discuss key limitations and future directions in uncertainty aware front ends, adaptive multi sensor fusion, robust global estimation, and evaluation protocols aligned with field deployment. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Fan202626584,
	author = {Fan, Jing and Wang, Yan and Chen, Xuanyou and Zhang, Quan and Niu, Xiaoji},
	title = {VDR-Aided GNSS Carrier-Phase Outlier Resistance for Urban Vehicle Navigation: A Robust Approach Immune to Prior Pose Error},
	year = {2026},
	journal = {IEEE Internet of Things Journal},
	volume = {13},
	number = {12},
	pages = {26584 - 26598},
	doi = {10.1109/JIOT.2026.3676892},
	url = {https://www.scopus.com/pages/publications/105034138253?origin=resultslist},
	abstract = {Reliable and continuous precise global navigation satellite system (GNSS) positioning serves as a cornerstone for intelligent transportation, robotic systems, and emerging Internet of Things (IoT) applications. However, achieving such reliability in urban environments remains challenging due to frequent carrier-phase outliers. Conventional antioutlier methods are highly dependent on the accuracy of prior absolute pose from inertial navigation system (INS) or other aiding sources. Once the pose estimates degrade, outlier detection may fail or misclassify GNSS measurements, leading to further degradation in positioning results, forming a vicious cycle. To address this problem, this article proposes a novel carrier-phase outlier-resistance method that is immune to prior pose error. A two-degree-of-freedom time-differenced carrier-phase (TDCP)/vehicle dead-reckoning (VDR) model is designed to eliminate dependence on prior pose accuracy by leveraging high-precision VDR relative poses and conducting a detailed error analysis of the TDCP and VDR models. Based on this model, we construct a two-step framework that integrates an improved random sample consensus (RANSAC) approach with a multiepoch finite state machine (FSM) for reliable outlier detection. Experimental results in complex urban scenarios demonstrate that the proposed method achieves a horizontal position error (CEP95) of approximately 1 m, improving by 63.6% and 56.7% over the IGG-III and Tukey robust methods, respectively, while maintaining the maximum horizontal position error below 2 m. Ablation experiments show that the proposed method maintains strong outlier resistance even with prior absolute position disturbances up to 300 m. Cycle-slip simulations demonstrate high detection recall even when up to 75% of satellites are contaminated by outliers. © 2026 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

