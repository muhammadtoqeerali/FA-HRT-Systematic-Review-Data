	pages = {2310 - 2315},
	doi = {10.1109/CDC.2018.8619401},
	url = {https://www.scopus.com/pages/publications/85062195668?origin=resultslist},
	abstract = {This paper presents a novel state estimation approach for linear dynamic systems with measurements corrupted by outliers. Most common methods for outlier accommodation in state estimation utilize the Neyman-Pearson (NP) test combined with a Kalman filter (KF). In the NP-KF approach, residuals are discarded when their absolute value is greater than a designer specified threshold. Alternatively, the method of this paper selects measurements within an optimization framework to minimize the risk of incurring outlier affected measurements, while satisfying a performance specification. A motivating application is connected and autonomous vehicles operating in sensor-rich environments, where large numbers of sensor measurements are available relative to the observability and performance specification requirements; therefore, all the sensor data may not be needed to achieve the system accuracy specification. Using more data than is required to meet the specification exposes the state estimate to unneeded risk of outlier inclusion. Our approach chooses a subset of measurements which have minimum risk while achieving a lower bounded information matrix on the state estimate. The main contributions of this article are (1) presenting a more computationally efficient algorithm for selecting the optimal measurement set, and (2) demonstrating the approach in comparison with the traditional NP-KF approach using realworld GPS Doppler and differential pseudorange data acquired on a moving platform in a challenging environment. © 2018 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

