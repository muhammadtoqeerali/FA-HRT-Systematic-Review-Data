	author = {Tan, Wenbi and Thio, Tzer Hwai Gilbert and Siaw, Fei Lu and Li, Xinzhi and Shen, Fuyu and Yang, Jiazai and Zou, Tongyong and Jia, Youdong},
	title = {A Lightweight Infrared Thermal Image Recognition Network with Thermal Noise Suppression and Dynamic Feature Fusion for Transformer Oil Leakage Detection},
