}

@ARTICLE{Tao20263280,
	author = {Tao, Xiaowen and Zhao, Jian and Zhu, Bing and Jiang, Hongyi and Meng, Pengxiang and Han, Jiayi and Qi, Yuanyang},
	title = {MVP: A Multisensor Vehicle-Mounted Positioning Framework for Autonomous Driving},
	year = {2026},
	journal = {IEEE Transactions on Transportation Electrification},
	volume = {12},
	number = {2},
	pages = {3280 - 3291},
	doi = {10.1109/TTE.2025.3646819},
	url = {https://www.scopus.com/pages/publications/105025935157?origin=resultslist},
	abstract = {Positioning technology plays a critical role in environmental perception and serves as the foundation for decision-making and motion control in autonomous vehicles. Existing positioning frameworks often face challenges such as limited accuracy, high costs, or poor adaptability to diverse environments. To address these issues, this article proposes a multisensor vehicle-mounted positioning (MVP) framework for autonomous driving, leveraging the complementary strengths of multiple sensors and advanced graph optimization techniques. The proposed MVP framework integrates data from inertial measurement units (IMUs), cameras, and global positioning systems (GPSs) to achieve robust and precise positioning. Through nonlinear optimization, the system tightly integrates vision-based odometry with IMU data to enhance short-term motion estimation, even in challenging scenarios such as feature-sparse environments and abrupt maneuvers. Furthermore, the incorporation of a novel outlier rejection mechanism significantly boosts positioning accuracy and adaptability, ensuring robust performance in complex and dynamic conditions. To ensure global positioning consistency, the framework employs adaptive fusion of visual-inertial odometry (VIO) and GPS data, enhanced by real-time kinematic (RTK) processing, through global pose graph optimization. This approach effectively balances positioning accuracy and cost while enhancing the system’s adaptability to diverse operating environments. Experimental validation shows promising results with 0.7359 m mean absolute pose error (APE) on the KITTI dataset (79.60% improvement over ORB-SLAM) and 0.20-m accuracy in real-world campus testing. Results demonstrate that the MVP framework outperforms existing approaches in terms of accuracy, stability, and cost-effectiveness, making it a promising solution for real-world autonomous driving applications such as campus shuttles, depot logistics, and low-speed urban operation domains. © 2015 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Zhou202697118,
	author = {Zhou, Junjie and Zhao, Xi and Liu, Junhao and Xu, Xinyu and Yang, Aoxuan and Pu, Fan},
	title = {Robust State Estimation for Maneuvering UAVs: A Set Transformer-Based Adaptive UKF Approach},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {97118 - 97142},
	doi = {10.1109/ACCESS.2026.3703071},
	url = {https://www.scopus.com/pages/publications/105041959851?origin=resultslist},
	abstract = {Reliable state estimation is critical for Uncrewed Aerial Vehicles (UAVs) navigating complex urban environments. However, traditional filters and recent recurrent neural network (RNN) based estimators often fail or exhibit severe lag during aggressive maneuvers due to rigid process noise covariance (Q) assumptions and sequence-induced hysteresis. To address these limitations, this paper proposes the A-KIT UKF, a novel framework bridging deep learning with classical Bayesian estimation. By utilizing a Set Transformer to process sliding windows of measurement residuals as permutation-invariant, unordered sets, the architecture instantaneously identifies maneuver signatures. This fundamentally eliminates the temporal lag inherent in traditional adaptive algorithms and LSTM-based networks, enabling real-time, axis-decoupled covariance scaling. Practically, this ensures that UAVs can execute aggressive collision-avoidance maneuvers in obstacle-rich urban canyons without sacrificing vertical stability or suffering from trajectory overshoot. High-fidelity simulations involving stochastic wind and high-g maneuvers confirm the method's absolute superiority. By treating sliding windows of residuals as permutation-invariant sets, this architectural shift eliminates the temporal lag inherent in LSTM-based networks. Evaluated under identical experimental constraints, the A-KIT UKF significantly reduces the position Root Mean Square Error (RMSE) to 0.8010 m during sustained high-g coordinated turns (an 88.2% improvement over the standard EKF). Furthermore, the network's anisotropic scaling explicitly prevents coupled multi-axis oscillations, improving attitude estimation accuracy by up to 55.2% in transient maneuvers. With a highly lightweight parameter footprint and an ultra-low neural network inference latency of 0.60 ms (with a total filter step time of 2.61 ms) on an Intel Core i7-13700H CPU @ 2.40GHz and an NVIDIA GeForce RTX 4060 GPU, this approach provides a robust, real-time, and efficient solution for next-generation Uncrewed Aerial Vehicle (UAV) vehicles operating in GPS-degraded, obstacle-rich environments.  © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Zhang2026,
	author = {Zhang, Wei and Li, Yunhui and Zhu, Rujiang and Zhang, Yifan and Han, Keli and Miao, Zhonghua},
	title = {SRSE-Fusion: A self-adaptive robot state estimation framework via multimodal perception},
	year = {2026},
	journal = {Computers and Electronics in Agriculture},
	volume = {252},
	pages = {},
	doi = {10.1016/j.compag.2026.112057},
	url = {https://www.scopus.com/pages/publications/105042783999?origin=resultslist},
	abstract = {Reliable robot state estimation leveraging the complementary characteristics of multi-sensor data is essential for the autonomy of agricultural robots. However, inherent perceptual discrepancies, scene dependencies, and range limitations of heterogeneous sensors often degrade the accuracy and stability of multi-modal fusion in complex environments. This paper proposes SRSE-Fusion, a self-adaptive robot state estimator that integrates IMU, cameras, LiDAR, and GNSS data within a unified factor graph optimization framework. To enhance fusion reliability, we develop a hybrid coupling architecture that synergizes the benefits of both loose and tight coupling. Furthermore, a dynamic performance evaluation strategy is introduced based on odometry uncertainty analysis, enabling the system to assess sensor status in real-time and adaptively adjust sensor confidence weights during the optimization. Experimental results on public datasets and field tests in orchards demonstrate that the proposed method significantly improves localization robustness. The system achieves a root mean square error below 0.867 m and a mean error below 0.731 m, effectively overcoming the challenges of sensor uncertainty and environmental variability in precision agriculture applications. © 2026 Elsevier B.V.},
