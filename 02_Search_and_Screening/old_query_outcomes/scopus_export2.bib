@ARTICLE{Li2024128,
	author = {Li, Qipeng and Zhuang, Yuan and Huai, Jianzhu and Wang, Xuan and Wang, Binliang and Cao, Yue},
	title = {A robust data-model dual-driven fusion with uncertainty estimation for LiDAR–IMU localization system},
	year = {2024},
