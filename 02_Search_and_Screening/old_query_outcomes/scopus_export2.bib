@CONFERENCE{Deng20261354,
	author = {Deng, Zhaotian and Li, Ji and Zhang, Weixin},
	title = {Reliability Aware Gaussian Splatting for Dynamic Sensor Platform SLAM},
	year = {2026},
	journal = {2026 7th International Conference on Computer Vision, Image and Deep Learning, CVIDL 2026},
	pages = {1354 - 1359},
	doi = {10.1109/CVIDL70130.2026.11637703},
	url = {https://www.scopus.com/pages/publications/105049133737?origin=resultslist},
	abstract = {D Gaussian Splatting (3DGS) provides an explicit scene representation and efficient differentiable rendering, making it suitable for visual SLAM with dense reconstruction requirements. Existing large scale 3DGS SLAM methods improve mapping quality and global reconstruction, while pose estimation and Gaussian refinement remain sensitive to unstable observations caused by moving sensor platforms, depth noise, weak textures, and uncertain loop constraints. This paper proposes a reliability aware 3DGS framework for dynamic sensor platform SLAM. Dynamic sensor platform SLAM in this work refers to SLAM performed on continuously moving platforms, including vehicle mounted and quadruped robot platforms, where viewpoint changes, body vibration, and depth uncertainty can disturb rendering based pose optimization and map refinement. The proposed framework improves reliability at three stages. Prior guided stable tracking combines pose priors, depth valid masks, and candidate pose selection to reduce ambiguous pose updates. Confidence aware loop optimization adjusts loop covariance according to feature matching reliability. Color recovery refines Gaussian colors after structure refinement while keeping geometry and poses fixed. Experiments on KITTI odometry and self collected laboratory sequences show consistent gains over existing large scale 3DGS SLAM methods. The proposed method improves PSNR by 0.09 to 0.32 dB, increases MS-SSIM by 0.004 to 0.015, and reduces LPIPS by 0.010 to 0.138 on the tested sequences. These results indicate that reliability aware design improves trajectory consistency and rendering quality for SLAM on dynamic sensor platforms. © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Baek202643651,
	author = {Baek, Jaeuk and Jeong, Seokho and Choi, Donggyu and Lee, Changeun},
	title = {Self-Alignment-by-Tracking With a Mobile Single Robot},
	year = {2026},
	journal = {IEEE Access},
	volume = {14},
	pages = {43651 - 43663},
	doi = {10.1109/ACCESS.2026.3672927},
	url = {https://www.scopus.com/pages/publications/105032765762?origin=resultslist},
	abstract = {In this paper, we address multiple object tracking (MOT) using a single mobile robot without any prior knowledge of its location or orientation. In scenarios where both objects and the robot are moving, continuous object tracking becomes challenging due to the lack of a consistent coordinate system. To overcome this, we propose a self-alignment-by-tracking mechanism to maintain spatio-temporal consistency. We formulate an optimization problem aimed at maximizing multiple object tracking accuracy (MOTA), but its combinatorial nature makes it difficult to solve directly. To address this, we decompose the problem into two subproblems: 1) consecutive spatial alignment of objects over time sequences to a common reference coordinate system and 2) object tracking within the same coordinate system for temporal consistency. Compared to conventional tracking processes, our proposed self-alignment-by-tracking mechanism requires an additional step of spatial alignment before the data association step, which may introduce inter-frame delays. However, we mitigate this issue by employing a geometry-based sorting mechanism, allowing us to search only a subset of the sorted neighboring objects. In addition, robust spatial alignment can be achieved by generating pseudo-environment objects through a closed-form expression, ensuring reliability even under challenging matching conditions. We analyze theoretical computational complexity, along with Monte Carlo simulations and real-world experiments, which validate the superiority of our proposed MOT process in terms of both accuracy and computational efficiency. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Pan2026,
	author = {Pan, Siyu and Hu, Yaohua and Ohya, Akihisa and Yorozu, Ayanori},
