}

@ARTICLE{Wang2026,
	author = {Wang, Yaxin and Qi, Yuming and Zhang, Liguo and Wang, Hanping and Yang, Yi},
	title = {Anomaly-based credibility assessment of digital twin driving signals using an attention-enhanced LSTM autoencoder},
	year = {2026},
	journal = {Journal of the Brazilian Society of Mechanical Sciences and Engineering},
	volume = {48},
