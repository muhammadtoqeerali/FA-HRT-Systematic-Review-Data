@ARTICLE{Vezeteu2026,
	author = {Vezeteu, Eugeniu and El Issaoui, Aimad and Hyyti, Heikki and Muhojoki, Jesse and Hyyppä, Eric and Manninen, Petri and Hakala, Teemu and Kukko, Antero and Kaartinen, Harri and Kyrki, Ville and Hyyppä, Juha},
	title = {Robust tightly coupled MLS–ALS fusion with 2D and 3D LiDAR using local geometric uncertainty for accurate 3D mapping},
	year = {2026},
	journal = {Science of Remote Sensing},
	volume = {13},
	pages = {},
	doi = {10.1016/j.srs.2026.100449},
	url = {https://www.scopus.com/pages/publications/105041220000?origin=resultslist},
	abstract = {Accurate, high-resolution 3D maps are essential for applications such as forestry, infrastructure monitoring, and autonomous navigation. Airborne laser scanning (ALS) provides large-scale coverage but suffers from canopy occlusions, whereas mobile laser scanning (MLS) captures detailed ground-level structure but is susceptible to drift when Global Navigation Satellite System-Inertial Navigation System (GNSS-INS) measurements degrade. Although ALS–MLS fusion is promising, most existing approaches rely on loosely coupled pipelines or feature-based alignment methods that require manual parameter tuning, depend on feature quality, and are not well-suited for real-time operation. On these mapping platforms, 3D LiDAR provides full motion observability but often with lower range accuracy and sparser sampling. In contrast, certain 2D LiDAR sensors offer higher range precision and point density but lack one degree of freedom, limiting direct 3D reconstruction. In this study, we propose a tightly coupled multi-sensor fusion framework that integrates IMU, 3D LiDAR, 2D LiDAR, GNSS-INS derived SE(3) poses, and prior ALS maps for online localisation and mapping. The system is built on a LiDAR-inertial backbone, where 2D LiDAR measurements complement 3D LiDAR with higher point density and range precision. GNSS-INS or ALS maps provide global priors for MLS drift correction. All measurements are jointly optimised in a single-state maximum a posteriori formulation using robust, data-adaptive geometric uncertainty weighting based on local planarity. Sensor contributions are combined through accumulated Hessians and gradients with an adaptive self-balancing mechanism that removes manual parameter tuning. Experiments over 5 km of forest roads demonstrate high localisation accuracy compared to the reference baseline. Using dense ALS priors, the system achieves ≈ 0.04 m absolute error and ≈ 0.17% relative error, while sparse ALS priors yield ≈ 0.18 m and ≈ 0.39%, respectively. The source code of the proposed method is publicly available. <sup>1</sup> 1 https://github.com/eugeniu1994/MAP_LIO.git . © 2026 The Authors.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Zhang2026755,
	author = {Zhang, Xiao and Song, Changhao and Liang, Zhenyu and Niu, Zhuoyue and Zhang, Jiaying and Cheng, Jack C.P.},
	title = {BIM-vSLAM: Bridging BIM and visual SLAM with plane-based representation for automated registration and image-based reconstruction},
	year = {2026},
	journal = {ISPRS Journal of Photogrammetry and Remote Sensing},
	volume = {239},
	pages = {755 - 773},
	doi = {10.1016/j.isprsjprs.2026.06.026},
	url = {https://www.scopus.com/pages/publications/105042586788?origin=resultslist},
	abstract = {Robust localization in cluttered indoor environments is essential for embodied Artificial Intelligence (AI). Traditional localization systems rely on expert-generated maps, which increases costs and limits adaptability to dynamic settings. Building Information Models (BIMs) are commonly recognized formats that represent fixed architectural elements. However, integrating BIM with Simultaneous Localization and Mapping (SLAM) remains challenging due to divergent data structures. BIM encodes environments as semantically rich planar objects, whereas SLAM constructs maps from sparse, localized feature clusters that capture fine-grained details but lack explicit planar context. This representational gap hinders robust correspondence and risks misalignment in complex indoor scenes. This paper proposes a lightweight visual SLAM system that bridges this gap using planes as a unifying representation. We transform BIM into a hierarchical, topometric semantic map with planar features delineating rooms and corridors. Simultaneously, we reformulate the SLAM map as a lightweight geometric model of horizontal and vertical planes, replacing conventional occupancy grids or point clouds. This plane-based representation leverages scene structure to reduce computational complexity while maximizing estimation accuracy. The representation is tightly integrated into the SLAM system, enabling precise short-term tracking and mapping between keyframes, and facilitating global alignment with persistent BIM architectural features (e.g., walls and doors) to mitigate drift. Both local and global components are unified within a graph optimization framework. Experiments on challenging indoor benchmarks demonstrate state-of-the-art accuracy and efficiency. The system achieves higher global BIM registration recall rate with 3 times faster than SOTA image-based methods and point-cloud registration, it further reduces Absolute Pose Error by 90% and delivers faster map reconstruction with significantly lower storage. Source code is available at https://github.com/csongae/BIM-vSLAM. © 2026 International Society for Photogrammetry and Remote Sensing, Inc. (ISPRS). Published by Elsevier B.V. All rights are reserved, including those for text and data mining, AI training, and similar technologies.},
	type = {Article},
