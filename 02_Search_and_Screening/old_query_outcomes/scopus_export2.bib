@ARTICLE{Li2024790,
	author = {Li, Yanbin and Qin, Zixiong and Li, Ziruo and Shi, Xiaogang and Chi, Wenzheng},
	title = {A Robot Localization Deviation Detection Method Based on ResNet},
	year = {2024},
	journal = {IEEE International Conference on Robotics and Biomimetics, ROBIO},
	number = {2024},
	pages = {790 - 795},
	doi = {10.1109/ROBIO64047.2024.10907369},
	url = {https://www.scopus.com/pages/publications/105001494006?origin=resultslist},
	abstract = {Simultaneous location and mapping (SLAM) based on particle filtering is a technique that uses probabilistic methods to solve the problem of robot localization and mapping in unknown environments. It represents the probability density function of state by using a set of particles, which denotes the probability distribution of the position of the robot and map state. The divergence of particles typically indicates that the estimated pose of the robot is starting to deviate, leading to a decrease in mapping and localization accuracy. In order to detect the degree of particle divergence, we have designed a neural network based on Residual Network (ResNet) architecture specifically for detecting particle distribution. Through supervised learning, this model has been endowed with the ability to analyze particle distribution and determine the particle divergence. To achieve this, we have proposed a dedicated dataset in which we have designed a method to create scale-invariant images based on particle coordinates. The model achieves an accuracy rate of 95.1 % on the test set, and we have also demonstrated its optimality through ablation experiments. © 2024 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Li2024985,
	author = {Li, Ruocheng and Lyu, Jingshuo and Wang, Aobo and Yu, Rui and Wu, Delong and Xin, Bin},
	title = {FLAGDroneRacing: An Autonomous Drone Racing System},
	year = {2024},
