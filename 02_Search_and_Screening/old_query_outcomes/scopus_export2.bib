	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 14; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Wang2024,
	author = {Wang, Dongjia and Lian, Baowang and Liu, Yangyang and Gao, Bo and Zhang, Shiduo},
	title = {Resilient Cooperative Localization Based on Factor Graphs for Multirobot Systems},
	year = {2024},
	journal = {Remote Sensing},
