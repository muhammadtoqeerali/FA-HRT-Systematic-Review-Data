}

@CONFERENCE{Zhang2026346,
	author = {Zhang, Zhi and Fang, Chenxin and Toya, Teruki and Zhan, Zhihao and Kong, Wanzeng and Ozawa, Kenji},
	title = {Deep Radar Bird's-Eye View Localization via SE(2)-Consistent Data Augmentation and Spatial Pose Constraints},
	year = {2026},
	journal = {2026 IEEE 9th International Conference on Big Data and Artificial Intelligence, BDAI 2026},
	pages = {346 - 351},
	doi = {10.1109/BDAI70753.2026.11655180},
	url = {https://www.scopus.com/pages/publications/105049156927?origin=resultslist},
	abstract = {Reliable localization for autonomous vehicles and mobile robots essentially requires estimating their global pose consistently across diverse environments. Existing localization methods commonly estimate pose from camera- or LiDAR-derived geometric cues, for example through odometry-based motion estimation or scene-to-map matching. However, these visual and point-cloud cues can degrade substantially in fog and other adverse weather, making the resulting global pose estimates less reliable. Millimeter-wave radar is generally less affected by such weather than cameras and LiDAR, motivating its use as a robust localization sensor. However, accurate radar absolute pose regression (APR) from bird's-eye-view (BEV) representations remains challenging for both translation and orientation estimation. The training sequences carry limited pose diversity, and the sparse single-channel radar BEV, without the color and texture of camera images or the height and accuracy of LiDAR point clouds, amplifies this weakness, so a model often fits the training data closely yet generalizes poorly to unseen runs. Beyond these data-level limitations, standard APR frameworks typically lack explicit discrete spatial priors. We address these issues in turn. In the proposed SE(2)-consistent augmentation, small in-plane rigid transformations are applied to Cartesian BEV images while the pose labels are updated by the induced synchronized pose compensation, forming an image-pose consistency loop that enriches the otherwise limited training distribution and strengthens generalization; following NIDALoc and NeuroLoc, grid-cell partition and head-direction classification then supply the missing discrete spatial priors. On the Oxford Radar RobotCar dataset, our radar-only model reduces orientation error by 59% relative to the RadarLoc baseline, with a modest increase in translation error. In an ablation against our own backbone, the cell constraints alone improve translation while slightly lowering orientation accuracy; combined with the augmentation, both translation and orientation improve.  © 2026 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

