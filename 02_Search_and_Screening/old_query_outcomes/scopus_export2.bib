@ARTICLE{Jin2026,
	author = {Jin, Mohan and Zang, Nan and Cheng, Jianhua and Bai, Runze and Chen, Sicheng and Li, Peng},
	title = {MUD-SLAM: Measurement Uncertainty-Driven Loop Closing Method for Robust LiDAR–IMU SLAM in Complex Environments},
