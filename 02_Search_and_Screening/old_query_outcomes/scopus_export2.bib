@ARTICLE{Dong2026,
	author = {Dong, Ke and Li, Qingquan and Liao, Jianghai and Chen, Jianfan and Wang, Xin and Meng, Fanyi and Zhang, Dejin},
	title = {SIR-LocSUE: source usability evaluation for integrated localization based on scenario intrinsic representation},
	year = {2026},
