	abstract = {The absolute positioning accuracy of the mobile robot is reduced due to the deformation of flexible components such as tires, manipulator links, and manipulator joints. To address this issue, we propose a novel offline compensation method that simultaneously considers the flexible deformation of both tires and manipulator. First, a rigid–flexible coupling model of the entire system is established and validated through experiments. The analysis indicates that while the flexibility of the manipulator links has a minor impact on accuracy, the flexible deformations of the manipulator joints and the chassis significantly affect positioning accuracy. Secondly, in response to tires deformations, a hybrid prediction model based on an attention mechanism, convolutional neural network, and gated recurrent unit network is established. This model enables prediction of tires deformation and translates it into changes in the manipulator base coordinate pose. Thirdly, to address the flexibility deformation of the manipulator joints, a joint error model is established to calibrate the joint angles of the robot under different poses. Based on inverse kinematics, compensation is applied to the end-effector position error of the manipulator. Lastly, through error compensation for the self-made six-degree-of-freedom robot, the mean, variance, and maximum values of the positioning error were reduced by 75.78%, 96.48%, and 77.47%, respectively, under no-load conditions using the regression prediction method, validating the correctness and effectiveness of this method. © 2025},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 8}
}

@ARTICLE{Urrea2025,
	author = {Urrea, Claudio},
	title = {Hybrid Deep Learning-Reinforcement Learning for Adaptive Human-Robot Task Allocation in Industry 5.0},
	year = {2025},
	journal = {Systems},
	volume = {13},
	number = {8},
	pages = {},
	doi = {10.3390/systems13080631},
	url = {https://www.scopus.com/pages/publications/105014474704?origin=resultslist},
	abstract = {Human-Robot Collaboration (HRC) is pivotal for flexible, worker-centric manufacturing in Industry 5.0, yet dynamic task allocation remains difficult because operator states—fatigue and skill—fluctuate abruptly. I address this gap with a hybrid framework that couples real-time perception and double-estimating reinforcement learning. A Convolutional Neural Network (CNN) classifies nine fatigue–skill combinations from synthetic physiological cues (heart-rate, blink rate, posture, wrist acceleration); its outputs feed a Double Deep Q-Network (DDQN) whose state vector also includes task-queue and robot-status features. The DDQN optimises a multi-objective reward balancing throughput, workload and safety and executes at 10 Hz within a closed-loop pipeline implemented in MATLAB R2025a and RoboDK v5.9. Benchmarking on a 1000-episode HRC dataset (2500 allocations·episode<sup>−1</sup>) shows the hybrid CNN+DDQN controller raises throughput to 60.48 ± 0.08 tasks·min<sup>−1</sup> (+21% vs. rule-based, +12% vs. SARSA, +8% vs. Dueling DQN, +5% vs. PPO), trims operator fatigue by 7% and sustains 99.9% collision-free operation (one-way ANOVA, p < 0.05; post-hoc power 1 − β = 0.87). Visual analyses confirm responsive task reallocation as fatigue rises or skill varies. The approach outperforms strong baselines (PPO, A3C, Dueling DQN) by mitigating Q-value over-estimation through double learning, providing robust policies under stochastic human states and offering a reproducible blueprint for multi-robot, Industry 5.0 factories. Future work will validate the controller on a physical Doosan H2017 cell and incorporate fairness constraints to avoid workload bias across multiple operators. © 2025 by the author.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 11; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Chen2025,
	author = {Chen, Siyu and Feng, Tingping and Luo, Xiangwen and Li, Junmin and Luo, Yang and Teng, Yangxin and Peng, Yao and Yang, Simon X.},
