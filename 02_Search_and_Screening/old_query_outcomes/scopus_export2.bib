@ARTICLE{Gao2025,
	author = {Gao, Xuyu and Yang, Yuting and He, Di and Ma, Ziwei and Yu, Wenxian and Yang, Ke},
	title = {SensNav: A Multisensor Vehicle Navigation Dataset for Campus and Urban Environments With a Long Tunnel},
	year = {2025},
	journal = {IEEE Transactions on Instrumentation and Measurement},
	volume = {74},
	pages = {},
	doi = {10.1109/TIM.2025.3582308},
	url = {https://www.scopus.com/pages/publications/105010131808?origin=resultslist},
	abstract = {The rapid development of the mechanical industry, automated manufacturing, and artificial intelligence accelerate the evolution of autonomous driving systems. Decision-making algorithms for autonomous vehicles require extensive environmental information captured by multiple sensors to execute vehicle control commands in complex and dynamic environments. Consequently, multisensor datasets serve as valuable References and training resources for autonomous driving research. However, existing datasets suffer from significant limitations in long tunnel coverage, diverse campus environments, raw global navigation satellite system (GNSS) data, sky-view fisheye camera imagery, and data lightweight. To address these gaps, we developed a customized multisensor vehicle-mounted platform and established the SensNav dataset. The SensNav dataset is characterized by: 1) a long trajectory of 18.62 km, including a 5.2 km tunnel; 2) various campus scenes under both day and night conditions, featuring open-sky areas, tree-lined avenues, and regions shaded by buildings; 3) raw GNSS measurements from a 10 Hz receiver and a 20 Hz receiver; and 4) a skyview fisheye camera. Specifically, the campus dataset contains three types of inertial measurement units (IMUs), a forwardfacing RGB camera, a fisheye camera, and two GNSS receivers, while the urban dataset comprises two GNSS receivers and two IMUs. A high-precision-integrated GNSS/inertial navigation system (INS) was employed, and postprocessing techniques were applied to obtain accurate ground-truth trajectories. This dataset provides critical experimental support for emerging research on GNSS positioning enhancement, multisensor fusion algorithms, and navigation system evaluation under complex operational conditions. © 1963-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@CONFERENCE{Alamanos2024107,
	author = {Alamanos, Ioannis and Moustris, George P. and Tzafestas, Costas S.},
	title = {Localization and Offline Mapping of High-Voltage Substations in Rough Terrain Using a Ground Vehicle},
	year = {2024},
	journal = {2024 32nd Mediterranean Conference on Control and Automation, MED 2024},
	pages = {107 - 112},
	doi = {10.1109/MED61351.2024.10566151},
	url = {https://www.scopus.com/pages/publications/85198225708?origin=resultslist},
	abstract = {This paper proposes an efficient hybrid localization framework for the autonomous navigation of an unmanned ground vehicle in uneven or rough terrain, as well as techniques for detailed processing of 3D point cloud data. The framework is an extended version of FAST-LIO2 algorithm aiming at robust localization in known point cloud maps using Lidar and inertial data. The system is based on a hybrid scheme which allows the robot to not only localize in a pre-built map, but concurrently perform simultaneous localization and mapping to explore unknown scenes, and build extended maps aligned with the existing map. Our framework has been developed for the task of autonomous ground inspection of high-voltage electrical substations residing in rough terrain. We present the application of our algorithm in field trials, using a pre-built map of the substation, but also analyze techniques that aim to isolate the ground and its traversable regions, to allow the robot to approach points of interest within the map and perform inspection tasks using visual and thermal data.  © 2024 IEEE.},
