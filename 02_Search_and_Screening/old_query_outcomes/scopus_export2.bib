}

@ARTICLE{Bell2023379,
	author = {Bell, Zachary I. and Sun, Runhan and Volle, Kyle and Ganesh, Prashant and Nivison, Scott A. and Dixon, Warren E.},
	title = {Target Tracking Subject to Intermittent Measurements Using Attention Deep Neural Networks},
	year = {2023},
	journal = {IEEE Control Systems Letters},
