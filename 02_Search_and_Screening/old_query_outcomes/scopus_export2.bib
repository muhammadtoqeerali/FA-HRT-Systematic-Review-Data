	author = {Khemiri, Karim and Ferhi, Mokhtar and Djebali, Ridha},
	title = {Adaptive LSTM-EKF Based Fault and State Estimation in Mobile Robots under Dynamic Noisy Conditions},
	year = {2025},
	journal = {2025 IEEE 4th International Conference on Signal, Control and Communication, SCC 2025},
	pages = {},
	doi = {10.1109/SCC66964.2025.11424910},
	url = {https://www.scopus.com/pages/publications/105036220854?origin=resultslist},
	abstract = {This study introduces an adaptive hybrid estimation method that combines a Long Short-Term Memory (LSTM) network with an Extended Kalman Filter (EKF) to jointly estimate a robot's trajectory and evolving motor faults. The LSTM captures nonlinear temporal patterns from noisy data, while the EKF refines these predictions using a physical model. An adaptive weighting mechanism, based on the inverse of each estimator's error variance, ensures optimal fusion of both approaches. Applied to a differential-drive robot with gradual faults and abrupt direction changes, the method demonstrates superior accuracy and robustness compared to standalone estimators.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Qian2025,
	author = {Qian, Long and Lin, Xinchuang and Niu, Xiaoguang and Huang, Qihai and Li, Leilei and Guo, Guangyi and Wang, Zexin and Chen, Ruizhi},
	title = {Avnet: learning attitude and velocity for vehicular dead reckoning using smartphone by adapting an invariant EKF},
	year = {2025},
	journal = {Satellite Navigation},
	volume = {6},
	number = {1},
	pages = {},
	doi = {10.1186/s43020-025-00168-7},
	url = {https://www.scopus.com/pages/publications/105008729754?origin=resultslist},
	abstract = {Smartphone-based vehicle navigation has become the primary choice in everyday life due to low cost and real-time traffic updates. However, for vehicle navigation applications in the Global Navigation Satellite System (GNSS)-denied scenario such as parking lot and tunnel, it is quite difficult to maintain robust and continuous positioning based on consumer-grade sensors. In this paper, a novel method is proposed for accurate vehicular dead-reckoning based only on a smartphone inertial measurement unit. Robust vehicle dead reckoning can improve positioning performance in GNSS-degraded areas or where high-precision positioning sources are available at low-frequencies. The key components of the method are a Kalman filter with data-driven parameters adapter and a deep neural network that provides data-driven measurement estimation. A combined convolutional neural network and gated recurrent unit deep learning network, termed AVNet, is proposed to estimate the attitude and velocity of the vehicle. The learned measurements are integrated into an invariant Kalman filter to estimate Three-Dimensional (3D) attitude, velocity and position. The method was tested on custom datasets collected in a parking lot, and a 0.4 % relative horizontal translation error was achieved on average. © The Author(s) 2025.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9; All Open Access; Gold Open Access; Green Open Access}
}

@ARTICLE{Zhu2025960,
	author = {Zhu, Fangcheng and Ren, Yunfan and Yin, Longji and Kong, Fanze and Liu, Qingbo and Xue, Ruize and Liu, Wenyi and Cai, Yixi and Lu, Guozheng and Li, Haotian and Zhang, Fu},
	title = {Swarm-LIO2: Decentralized Efficient LiDAR-Inertial Odometry for Aerial Swarm Systems},
	year = {2025},
	journal = {IEEE Transactions on Robotics},
	volume = {41},
