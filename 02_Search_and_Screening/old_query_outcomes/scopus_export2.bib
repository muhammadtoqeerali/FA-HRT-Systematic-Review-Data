@ARTICLE{Jiang2026,
	author = {Jiang, Xuelei and Che, Yuchao and Wang, Yaojian and Ge, Nan and Jia, Shiduo},
	title = {Application of improved Extended Kalman Filter to fuse multi-sensor data for optimizing closed-loop control of cable joint robot walking mechanism},
	year = {2026},
