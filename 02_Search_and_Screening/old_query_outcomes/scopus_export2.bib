}

@CONFERENCE{Zheng202511,
	author = {Zheng, Dejun and Hu, Jianzhong and Zhou, Qianfei and Xu, Feiyun},
	title = {A State Recognition Method of Industrial Robots Based on Adaptive Class Weight Gated Convolutional Neural Network},
	year = {2025},
	journal = {2025 5th International Conference on Mechanical Automation and Electronic Information Engineering, MAEIE 2025},
	pages = {11 - 16},
	doi = {10.1109/MAEIE68099.2025.11406011},
	url = {https://www.scopus.com/pages/publications/105036576620?origin=resultslist},
	abstract = {Industrial robot state recognition is critical for predictive maintenance and operational safety, yet faces data imbalance, limited samples, and label noise in transition regions. This paper proposes an adaptive class-weighted gated convolutional neural network integrating three innovations: (1) purity-based sliding window algorithm filtering label noise by extracting windows with homogeneous state labels (purity ≥0.75), reducing transition contamination; (2) gated convolutional architecture with channel attention adaptively suppressing noise while emphasizing discriminative time-frequency features from motor currents; (3) adaptive focal loss incorporating dynamic class weighting to address sample-level difficulty and class-level imbalance. Experimental validation on a SCARA robot executing three trajectories with 10 kHz current sampling achieved 96.08% test accuracy across four states - 18% improvement over standard CNN. Ablation studies revealed gated convolution contributed the largest gain, while channel attention enhanced stability. All predictions exceeding 90% confidence were correct, demonstrating reliable uncertainty quantification. Results validate effectiveness for industrial robot condition monitoring, though future work should address generalization to diverse conditions, multi-modal sensor fusion, and continuous transition modeling for real-world deployment. © 2025 IEEE.},
