}

@ARTICLE{Cremona20221123,
	author = {Cremona, Javier and Comelli, Román and Pire, Taihú},
	title = {Experimental evaluation of Visual-Inertial Odometry systems for arable farming},
	year = {2022},
	journal = {Journal of Field Robotics},
