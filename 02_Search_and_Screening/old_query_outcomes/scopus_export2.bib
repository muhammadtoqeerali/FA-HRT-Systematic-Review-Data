@ARTICLE{Li20237093,
	author = {Li, Guangqiang and Hou, Junyi and Chen, Zhong and Yu, Lei and Fei, Shumin},
	title = {Robust stereo inertial odometry based on self-supervised feature points},
	year = {2023},
	journal = {Applied Intelligence},
