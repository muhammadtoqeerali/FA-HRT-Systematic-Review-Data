@ARTICLE{Choi2026,
	author = {Choi, Jun-Hyeon and Seo, Dong-Su and An, Ye-Chan and Eum, Tae-Wook and Kim, Jin-Ho and Kwon, Gi-Hyeon and Kuc, Tae-Yong and Pyo, Jeong-Won},
	title = {Context-Aware Semantic Localization with Adaptive Sensor Fusion Under Adverse Conditions},
	year = {2026},
	journal = {Sensors},
