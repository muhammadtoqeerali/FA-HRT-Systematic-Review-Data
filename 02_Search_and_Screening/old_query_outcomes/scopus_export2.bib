	pages = {},
	doi = {10.1016/j.measurement.2025.119973},
	url = {https://www.scopus.com/pages/publications/105024708662?origin=resultslist},
	abstract = {Robust localization source selection is crucial for mobile robotic system localization. However, the infinite diversity of localization scenarios makes the source selection particularly challenging. Here, a scenario intrinsic representation (SIR) is defined and an innovative localization source usability evaluation method is proposed based on the SIR. The novel idea of utilizing limited geometric and physical features to represent localization scenarios instead of enumerating them overcomes the challenge posed by infinite scenario diversity. The SIR is constructed through tri-source fusion, including sensor measurement, prior information, and visual-language large model (VLLM) interpretation. With the SIR, an LSTM-based deep-learning model for source usability evaluation is further developed to select localization sources in various scenarios. Experimental results show that the source selection success rate exceeds 84.2% for stereo Visual Odometry (VO) / Inertial Navigation System (INS) / Global Navigation Satellite System (GNSS) integration across multiple challenging localization scenarios. The missed detection rates for unusable images and GNSS measurements are limited below 5.9% and 14.1%, respectively. Resilient integrated localization based on source usability evaluation effectively mitigates performance degradation caused by unreliable sources, with the Relative Pose Error (RPE) and Absolute Trajectory Error (ATE) of the estimated trajectory reduced by over 46.2% and 53.9%, respectively. This work provides a general framework for source selection across diverse scenarios, breaking the traditional scenario-label-dependent source selecting paradigm and enhancing the accuracy and robustness of multi-sensor fusion localization substantially. © 2025 Elsevier Ltd},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
