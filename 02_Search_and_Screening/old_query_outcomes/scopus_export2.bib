	note = {Cited by: 0}
}

@CONFERENCE{Adnan2025,
	author = {Adnan, Muhammad and Durrani, Yaseer Arafat and Yousaf, Muhammad Haroon},
	title = {Decentralized Swarm Formation of Miniature Robots using the SCOPE Strategy},
	year = {2025},
	journal = {2025 27th International Multitopic Conference, INMIC 2025},
	pages = {},
	doi = {10.1109/INMIC65900.2025.11348372},
	url = {https://www.scopus.com/pages/publications/105034435935?origin=resultslist},
	abstract = {The noncentralized coordination is a must in multirobot systems in order to get the scalable and fault-tolerant swarm behavior. The communication bottlenecks, the single points of failure, and the limited scalability are the reasons why centralized control is not appropriate in dynamic or communication-constrained environments. In order to solve these problems, the authors introduce SCOPE (Scalable, Communication-free Offset-based Path-planning and Estimation), which is a new and fully decentralized swarm formation strategy. The SCOPE framework marks the crucial contribution that allows small autonomous robots to create and keep up exact geometric formations without any robot communication or a main controller. Each TurtleBot3 robot works separately in its own ROS namespace and employs a modular control stack: Adaptive Monte Carlo Localization (AMCL) for probabilistic pose estimation, Navfn for global path planning, and the Dynamic Window Approach (DWA) for real-time obstacle avoidance. To compute relative formation positions without a central controller or leader, the authors introduce a new virtual target offset method. The simulations demonstrated that the proposed system is effective by accomplishing 92% of the obstacles avoided, 89% of the formation accuracy, 95% of the shortest path adherence, and 91% of the path-following precision. In simulations, four TurtleBot3 Burgers were used, and three were used in hardware (limited availability) dynamic formation control. These outcomes strengthen the idea of the proposed decentralized architecture being suitable for real-world scenarios such as warehouse automation, decentralized logistics, and autonomous material handling. ©2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Li2025,
	author = {Li, Jia and Li, Wen and Su, Jinya and Li, Shihua},
	title = {Disturbance Estimation Kalman Filter for UAV Relative Height Estimation by Sensor Fusion},
	year = {2025},
	journal = {ICAC 2025 - 30th International Conference on Automation and Computing},
	pages = {},
	doi = {10.1109/ICAC65379.2025.11196712},
	url = {https://www.scopus.com/pages/publications/105021489321?origin=resultslist},
	abstract = {Accurate ground-relative height estimation for quadrotor UAVs in terrain-following flight is important but is often degraded by various disturbances such as process model uncertainties and external disturbances (e.g., wind, ground effect, payload variations). To address this challenge, this work proposes a Disturbance Estimation Kalman Filter (DEKF) to estimate and compensate the adverse effects of lumped disturbances, integrating multiple sensors including depth camera (for relative height and ground slope detection), barometer (for relative height and velocity) and IMU (for acceleration). Two distinct process modeling approaches, one using IMU acceleration, the other using thrust force, as process model input, are assessed and qualitatively compared. The proposed algorithms are quantitatively compared in high-fidelity AirSim simulation on both planar and trapezoidal surfaces. Comparative results show that the proposed DEKF achieves lower relative height estimation RMSE than the classical Kalman Filter under step and ramp wind disturbances introduced into the simulation environment, as well as accelerometer measurement bias or drift. Video demonstration is available at https://youtu.be/Qk2mgeDFKxs. © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Ma20252043,
	author = {Ma, Ziwei and He, Di and Li, Yiqian},
	title = {Quality-Driven Feature Adaptation for Robust Visual SLAM in Challenging Environments},
	year = {2025},
	journal = {Proceedings of the International Technical Meeting of the Satellite Division of The Institute of Navigation, ION GNSS+},
	number = {2025},
	pages = {2043 - 2054},
	doi = {10.33012/2025.20452},
	url = {https://www.scopus.com/pages/publications/105030231197?origin=resultslist},
	abstract = {Visual Simultaneous Localization and Mapping (SLAM) is a foundational technology for autonomous systems, but its performance is often hindered by varying environmental conditions such as lighting changes, image blur, and dynamic scenes. To enhance the robustness of visual SLAM under such challenging environments, this paper proposes a novel approach that evaluates image quality across different regions of each image frame and computes confidence masks for feature points. By combining multiple image quality metrics, a weighted score is assigned to each feature point. These weights are integrated into the pose estimation process to adaptively prioritize reliable feature points. Extensive experiments on the EuRoC and ICL-NUIM datasets demonstrate that the proposed method significantly improves pose accuracy, particularly in sequences with difficult environmental conditions, offering a promising solution for enhancing the reliability and robustness of visual SLAM systems. © 2025 ION GNSS. All rights re served.},
