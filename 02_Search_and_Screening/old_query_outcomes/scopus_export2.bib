	doi = {10.1109/JSEN.2024.3446998},
	url = {https://www.scopus.com/pages/publications/85202749894?origin=resultslist},
	abstract = {Light detection and ranging (LiDAR)-based simultaneous localization and mapping (SLAM) exhibits excellent performance in large-scale real-world scenarios and is widely applied in robot navigation systems. However, the adaptability of LiDAR-based SLAM algorithms in different environments remains a challenge. The fixed parameter settings and local information-based weighting strategies can influence the performance and reliability of LiDAR-based SLAM algorithms across various environments and application scenarios. To address the above issues, this article introduces a method based on point cloud normals to evaluate the degree of environmental degradation. This approach adaptively weights point clouds and dynamically adjusts optimization hyperparameters. Specifically, we first utilize distinct lookup tables for ground and nonground points based on the scanning structure of the LiDAR, allowing for the rapid computation of the point cloud normals. Subsequently, we used the weighted covariance matrix (WCM) of normal vectors to assess the degree of environmental degradation. Finally, based on the degradation level, we dynamically adjust optimization hyperparameters and compute the weight of each point. The proposed method demonstrates higher accuracy and robustness in diverse environments through validation on the KITTI benchmark and real-world scenarios. © 2001-2012 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 6}
}

@ARTICLE{Zhao2025168732,
	author = {Zhao, Xiaoming and Yang, Ye and Niu, Yunhong and Li, Xinlei},
	title = {Uncertainty-Aware Multi-Modal Learning for Autonomous Pallet Handling in Dynamic Warehouse Scenarios},
	year = {2025},
	journal = {IEEE Access},
	volume = {13},
	pages = {168732 - 168742},
	doi = {10.1109/ACCESS.2025.3613729},
	url = {https://www.scopus.com/pages/publications/105017385048?origin=resultslist},
	abstract = {Autonomous pallet transport in dynamic warehouses, where human workers and automated guided vehicles (AGVs) coexist, remains highly challenging due to sensory heterogeneity, environmental uncertainty, and strict real-time requirements. To address these issues, we propose an adaptive learning framework that integrates multi-modal sensory inputs, an Interactive Multiple Model (IMM) Kalman filter for trajectory forecasting, and Proximal Policy Optimization (PPO) for policy learning. A hybrid fusion strategy—combining early latent projection and shrinkage-enhanced cross-attention—ensures temporal-spatial alignment and suppresses noisy modalities, while a multi-objective reward balances safety, efficiency, and task success. Experiments in a high-fidelity warehouse simulator show that our method achieves a 78.5 % success rate, reducing collisions by 29 % and improving trajectory stability by 38% compared to PPO, MPC, SAC, and Transformer-based baselines. Real-time evaluation further confirms an average cycle latency of 33.3 ms, meeting industrial deployment standards. These results demonstrate that the proposed IMM-PPO framework effectively unifies predictive filtering, uncertainty-aware fusion, and reinforcement learning, enabling robust and intelligent automation for real-world logistics scenarios. © 2013 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access; Green Open Access}
}

@CONFERENCE{Manoharan20241670,
