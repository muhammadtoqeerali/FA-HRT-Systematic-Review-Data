@ARTICLE{Tang2026,
	author = {Tang, Jiaqiao and Shen, Kai and Wang, Tengfei and Liu, Bo and Tu, Qinglan},
	title = {Goal-directed synergistic fusion navigation for robust localization under cross-scenario spatial uncertainty},
	year = {2026},
	journal = {Satellite Navigation},
