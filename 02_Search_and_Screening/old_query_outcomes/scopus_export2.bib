	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 23}
}

@ARTICLE{Donati2022,
	author = {Donati, Cesare and Mammarella, Martina and Comba, Lorenzo and Biglia, Alessandro and Gay, Paolo and Dabbene, Fabrizio},
	title = {3D Distance Filter for the Autonomous Navigation of UAVs in Agricultural Scenarios},
	year = {2022},
