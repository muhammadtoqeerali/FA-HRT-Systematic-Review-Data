@ARTICLE{Liu2019193,
	author = {Liu, Zhixiang and Zhang, Youmin and Yuan, Chi and Ciarletta, Laurent and Theilliol, Didier},
	title = {Collision Avoidance and Path Following Control of Unmanned Aerial Vehicle in Hazardous Environment},
