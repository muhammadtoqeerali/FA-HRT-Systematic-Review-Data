@ARTICLE{Bajoria2026,
	author = {Bajoria, Sparsh and Kanrar, Sayandeep and Pandey, Harsh and De, Paurab and Akash, Aman and Hassija, Vikas and Chamola, Vinay},
	title = {A Survey on LLM-Enabled UAV Digital Twins for Internet of Vehicles Systems},
	year = {2026},
