@CONFERENCE{Maharmeh2025427,
	author = {Maharmeh, Elias and Alsayed, Zayed and Nashashibi, Fawzi},
	title = {PL-RAS: A Robust Localization System with Real Time Protection Level Calculation and Adaptive Kernel for Enhanced Integrity},
	year = {2025},
