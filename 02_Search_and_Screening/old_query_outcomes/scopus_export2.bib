@CONFERENCE{Xie2026493,
	author = {Xie, Tong and Qi, Yijiahao and Wen, Jinqi and Wan, Zishen and Dong, Yanchi and Wang, Zihao and Cai, Shaofei and Liang, Yitao and Jia, Tianyu and Wang, Yuan and Wang, Runsheng and Li, Meng},
	title = {CREATE: Cross-Layer Resilience Characterization and Optimization for Efficient yet Reliable Embodied AI Systems},
