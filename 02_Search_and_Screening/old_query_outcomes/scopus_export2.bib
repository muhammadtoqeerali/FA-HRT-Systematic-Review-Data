	pages = {},
	doi = {10.1016/j.patcog.2026.114630},
	url = {https://www.scopus.com/pages/publications/105048499816?origin=resultslist},
	abstract = {Unsupervised LiDAR motion estimation has attracted significant attention in pattern recognition and robotic vision. However, ensuring robust performance under adverse conditions — particularly structured noise like heavy snowfall — remains a challenging problem. Existing models struggle with domain generalization due to the sensitivity of feature extractors to spatial outliers, limiting their reliability in complex real-world scenarios. In this work, we present an unsupervised LiDAR motion estimation framework via patch-aware feature reweighting to mitigate the domain shift between clear and snowy conditions. Our approach prioritizes reliability-aware reweighting to reduce the influence of snowflake noise and outlier points on pose estimation, while balancing computational efficiency for real-time applications. To achieve this, we introduce a Patch Spatial Measure (PSM) module that evaluates point dispersion within patches to identify sparse and scattered noise. Furthermore, we propose a Patch Point Weight Predictor (PPWP) to assign adaptive confidence scores to individual points, enhancing the discriminative capability of local features. In this module, we leverage multi-modal feature fusion to refine point-wise weight prediction and employ an intensity-guided mechanism to rapidly suppress near-field snow with low computational overhead. Our model is trained under clear weather data and rigorously tested across diverse scenarios, including snowy and dynamic environments. Extensive experiments show that our method achieves improved robustness and generalization under snowy conditions without relying on ground-truth supervision. © 2026},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Lee202610549,
	author = {Lee, Dong Kyu and Pak, Jung Min and Kim, Du Yong and Ahn, Choon Ki},
	title = {An Unscented Information-Form Finite-Memory Approach for Simultaneous Localization and Calibration With Application to Uncrewed Aerial Vehicles},
	year = {2026},
	journal = {IEEE Transactions on Automation Science and Engineering},
	volume = {23},
	pages = {10549 - 10561},
	doi = {10.1109/TASE.2026.3696798},
	url = {https://www.scopus.com/pages/publications/105040138336?origin=resultslist},
	abstract = {Uncrewed aerial vehicle (UAV) localization is typically performed through sensor fusion to leverage the complementary strengths of multiple sensors. However, establishing reliable localization redundancy with a single sensor remains fundamentally important for system reliability. In particular, external forces during flight, such as collisions, wind effects, or payload changes, induce significant discrepancies between control commands and the actual motion, making robust localization an inherently challenging task. This study explores a simultaneous localization and calibration (SLAC) algorithm for UAVs that improves localization accuracy by directly estimating the unknown external disturbances and compensating for their effects. A finite-memory SLAC (FM-SLAC) algorithm uses only recent information from a finite interval and has shown strong robustness in two-dimensional localization for mobile robots. However, in three-dimensional (3D) UAV localization, it exhibited numerical instability during the computation of the large matrix inversions included in the filter gain. To overcome this drawback, this study proposes a novel unscented information-form finite-memory approach for SLAC (UIFM-SLAC). By employing an unscented transformation (UT), an unscented finite-memory SLAC (UFM-SLAC) is developed to avoid the calculation of the Jacobian matrix and the inverse of large matrices required in the conventional FM-SLAC. Furthermore, an information form is integrated into the framework to establish the UIFM-SLAC, which reduces dependence on initial estimates, thereby eliminating numerical instabilities in high-dimensional models and mitigating accuracy loss caused by the linearization of nonlinear dynamics. Experimental comparisons with standard and state-of-the-art algorithms for robust UAV localization were conducted, and the results demonstrated the superior accuracy and robustness of the UIFM-SLAC. © 2026 IEEE. All rights reserved.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

