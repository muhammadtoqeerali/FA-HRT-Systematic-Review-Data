@ARTICLE{Puriyanto20253047,
	author = {Puriyanto, Riky Dwi and Fathurrahman, Haris Imam Karim and Rahani, Faisal Fajri and Solikhah, Efa Wakhidatus and Musa, Zalili Binti},
	title = {Implementation of Fuzzy Kalman Filter in Indoor Localization Using Ultra-Wideband Sensor},
	year = {2025},
