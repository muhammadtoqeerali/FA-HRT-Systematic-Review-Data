@ARTICLE{Du2023,
	author = {Du, Xiaolei and Liu, Huabo and Yu, Haisheng},
	title = {Event-Triggered Robust Fusion Estimation for Multi-Sensor Time-Delay Systems with Packet Drops},
	year = {2023},
	journal = {Applied Sciences (Switzerland)},
