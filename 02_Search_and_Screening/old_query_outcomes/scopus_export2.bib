@CONFERENCE{Lee2026261,
	author = {Lee, Yong-Ha and Lee, Jae-Un and Won, Jong-Hoon},
	title = {Uncertainty-Aware GRU-Enhanced INS for Robust Navigation in AI-based Autonomous Vehicles},
	year = {2026},
