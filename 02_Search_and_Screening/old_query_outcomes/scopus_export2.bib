@CONFERENCE{Wu20241032,
	author = {Wu, Xin'Ao and Yang, Chenxi and Guo, Yiyang and Zhuang, Hanyang and Wang, Chunxiang and Yang, Ming},
	title = {Active Vehicle Re-localization Based on Non-repetitive LiDAR with Gimbal Motion Strategy},
