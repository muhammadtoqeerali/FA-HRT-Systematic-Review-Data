	pages = {},
	doi = {10.1016/j.engappai.2026.115684},
	url = {https://www.scopus.com/pages/publications/105045589884?origin=resultslist},
	abstract = {Reliable state estimation is essential for autonomous multi-robot systems operating in global navigation satellite system (GNSS)-denied or GNSS-degraded environments. Decentralized cooperative localization enables robots to share observations for mutual position estimation, but practical deployments face unknown cross-correlations caused by multi-hop propagation and conflicting observations from unreliable sensors or disturbances, which can lead to estimation errors and reduced accuracy. This paper proposes conflict-aware evidence fusion for decentralized cooperative localization. The method models heterogeneous sensor observations as continuous evidence representations and quantifies conflicts between observations and predicted beliefs. A credibility assessment mechanism evaluates the reliability of information sources using Bayesian updating, and an entropy-based measure quantifies the information quality of each observation. These components are integrated into a weighted conservative fusion scheme that adjusts different information sources in state estimation. The key novelty lies not in the individual components but in their integration: conflict, credibility, and information quality are jointly converted into a conservative, covariance-intersection-compatible discount applied before fusion, so that unreliable or conflicting sources reduce the total information injected into the estimate rather than merely redistributing weights. The proposed artificial-intelligence method is developed for engineering applications in decentralized multi-robot systems, including robot swarms, autonomous vehicles, and distributed sensing networks operating in navigation-denied environments. Simulation experiments and real-world multi-robot dataset evaluations show that the proposed approach improves localization accuracy and estimation consistency compared with existing cooperative localization methods. Copyright © 2026. Published by Elsevier Ltd.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

