@ARTICLE{Liu2026,
	author = {Liu, Donglei and Wang, Shunli and Li, Xiaoxia and Fan, Yongcun and Fernandez, Carlos and Blaabjerg, Frede},
	title = {A novel physical extraction multi-step neural network algorithm for power lithium-ion battery state of charge and available capacity estimation},
	year = {2026},
