@ARTICLE{Mazhar20216321,
	author = {Mazhar, Osama and Babuska, Robert and Kober, Jens},
	title = {GEM: Glare or Gloom, i Can Still See You - End-to-End Multi-Modal Object Detection},
	year = {2021},
