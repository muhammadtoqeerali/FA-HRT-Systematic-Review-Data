	pages = {},
	doi = {10.1109/TITS.2026.3723178},
	url = {https://www.scopus.com/pages/publications/105048735876?origin=resultslist},
	abstract = {Cooperative decision-making within an uncrewed surface vehicle swarm (USVS) poses significant challenges due to heterogeneous constraints from collective swarming and individual underactuation. In this paper, an innovative swarming-embedded partially observable Markov decision process within deep reinforcement learning framework is proposed to enable cooperative path planning of underactuated USVS in dynamic environments. The swarming mechanism is embedded by incorporating collective behaviors, i.e., aggregation, separation, and alignment, into Markov decision process, facilitating kinetic cooperation among USVS members. To ensure compatibility with underactuated dynamics, a velocity-tracking law is integrated into state-action transitions, enabling closed-loop optimization that unifies planning and control. A comprehensive reward function is further designed to be multi-objective, not only promoting target pursuit, obstacle avoidance, and swarm cohesion, but also balancing potential conflicts in the swarm. To support scalable and cost-effective deployment, virtual environments based on real-world scenarios are constructed in Unity3D, providing a flexible training and testing platform. Comprehensive validations across fixed and random missions in congested and open waters demonstrate substantial superiority, achieving 62–64% success rates compared to MADDPG’s 0.7–59.9% and SAC’s 36.1–40.2%, 2.5–3 times faster convergence, and 15.4–31.3% graceful degradation from 4- to 20-USV configurations whereas baselines collapse completely at large scales. Such capabilities revolutionize the USVS for practical maritime transportation operations like autonomous convoying, port surveillance, and multi-modal freight transfer. © 2000-2011 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Tejada Peralta2026,
	author = {Tejada Peralta, Ana Fabiola Patricia and Bakzadeh, Roya and Siahidouzazar, Sina and Roghanchi, Pedram},
