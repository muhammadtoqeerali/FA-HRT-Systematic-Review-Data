@ARTICLE{Malle2022113543,
	author = {Malle, Nicolaj Haarhoj and Nyboe, Frederik Falk and Ebeid, Emad Samuel Malki},
	title = {Onboard Powerline Perception System for UAVs Using mmWave Radar and FPGA-Accelerated Vision},
	year = {2022},
