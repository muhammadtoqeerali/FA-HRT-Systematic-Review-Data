@ARTICLE{Xu2026,
	author = {Xu, Zhenghui and Wei, Shimin and Li, Jian and Tang, Ling},
	title = {DG-KILO: A Kinematic-Inertial-LiDAR Odometry Based on Degradation Optimization and Ground Constraints for State Estimation of Legged Robots},
	year = {2026},
	journal = {IEEE Transactions on Instrumentation and Measurement},
	volume = {75},
	pages = {},
	doi = {10.1109/TIM.2026.3660431},
	url = {https://www.scopus.com/pages/publications/105030888696?origin=resultslist},
	abstract = {High-precision state estimation is crucial for autonomous navigation of legged robots. However, in challenging unstructured environments, existing legged LiDAR simultaneous localization and mapping (SLAM) algorithms often encounter sensor degradation and significant localization drift due to indistinct geometric structures, sparse scene features, and inherent legged robot vibrations. To address this issue, we propose a novel kinematic-inertial-LiDAR odometry framework that incorporates degradation optimization and ground constraints (DE-KILO), utilizing an error-state Kalman filter (ESKF) for leg odometry estimation. Firstly, to enhance localization accuracy in unstructured scenes, we introduce a degradation optimization method that identifies degradation by analyzing scan-to-map information, subsequently addressing it by extracting intensity features along the degradation direction and fusing them with geometric features. Secondly, to mitigate z-axis drift caused by the inherent vibrations of legged robots, we propose a ground constraint strategy that constructs ground residual constraints by combining height residuals from foot-ground contact height detection with coplanar residuals from coplanar detection. Finally, a factor graph optimization tightly fuses leg odometry, LiDAR-inertial odometry (LIO), ground constraint, and loop closure detection to ensure global consistency. Extensive validation on public datasets and indoor quadruped robot experiments demonstrates that our proposed method achieves a 30.86% improvement in absolute trajectory error (ATE), a 76.92% improvement in relative trajectory error (RTE), and significantly reduced z-axis drift compared with state-of-the-art legged robot state estimation algorithms, thereby demonstrating superior localization precision and robustness. We will release the code of our method at https://github.com/CookieAnt/DG-KILO.git  © 2026 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

@ARTICLE{He2026,
	author = {He, Zijia and Chen, Sijia and Gao, Yuan and Dong, Wei},
	title = {A Multi-Camera Coordinated Localization Approach for Robust State Estimation of Flying Robots},
	year = {2026},
	journal = {IEEE Robotics and Automation Letters},
	pages = {},
	doi = {10.1109/LRA.2026.3685470},
	url = {https://www.scopus.com/pages/publications/105036535294?origin=resultslist},
	abstract = {Ground-air-based visual localization for UAVs, which typically relies on a single camera to track artificial markers, is often hampered by a limited field of view and sensitivity to illumination. Although active camera scheduling can mitigate these issues to some extent, it often incurs high motion costs and intermittent tracking losses during large-scale or agile UAV maneuvers. This paper presents a coordinated ground-air localization approach based on multi-camera scheduling to achieve continuous and full-coverage tracking. We equip UAVs with active infrared markers arranged in a distinctive structure, enabling robust 6D relative state estimation through a coarse-to-fine feature extraction and geometric matching. Building on this, we propose a predictive sparse scheduling framework that jointly optimizes camera activation and control over a receding horizon, explicitly balancing observation quality with actuation effort. Experimental results show our method achieves high-precision, robust localization under strong illumination interference. Compared to a fixed-camera baseline, the approach reduces the target loss rate by 29.74%, and decreases camera rotations by 70.32% compared to a basic active-vision method, demonstrating both efficient and reliable performance. © 2016 IEEE.},
	type = {Article},
	publication_stage = {Article in press},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Si202626122,
	author = {Si, Pengju and Yang, Shenzhi and Shi, Yongzhe and Wang, Huan and Fu, Zhumu and Wang, Jun and Cui, Wei},
	title = {RF-Nav: A Robust Fusion-Based GNSS-Visual-Inertial Navigation System},
	year = {2026},
	journal = {IEEE Internet of Things Journal},
	volume = {13},
	number = {12},
	pages = {26122 - 26132},
	doi = {10.1109/JIOT.2026.3674593},
	url = {https://www.scopus.com/pages/publications/105033248553?origin=resultslist},
	abstract = {The accurate vehicle navigation plays a critical role in vehicle-to-everything (V2X) applications, including connected transportation systems, intelligent traffic management, and autonomous driving. To address the stringent demands of these scenarios, the integration of the Global Navigation Satellite Systems (GNSS) with the visual-inertial navigation system (VINS) has emerged as a pivotal advancement. Despite these strides, navigation systems remain susceptible to abnormal data. This data, originating from unpredictable external environments and internal device fallibility, poses a threat of substantial errors and system drift. In this article, we present robust fusion-based navigation (RF-Nav), a robust fusion-based GNSS-VINS navigation system with enhanced data processing and dynamic factor correction. The framework innovates with a dual-pronged approach: it first applies adaptive gamma correction with bilateral filtering and contrast-limited adaptive histogram equalization (AGCBF-CLAHE) to refine raw images; then, it deploys a long short-term memory (LSTM) denoising network enhanced with an advanced wavelet threshold for inertial measurement unit (IMU) data refinement. This dual enhancement of visual and IMU data integrity is further bolstered by a dynamic factor confidence correction mechanism, rooted in factor graph optimization (FGO), designed to counteract the adverse effects of abnormal data. Extensive experiments on large-scale public and real-field datasets demonstrate that RF-Nav exhibits superior robustness and accuracy in various environments. © 2014 IEEE.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Chou2026,
	author = {Chou, Keng Wei and Huang, Yao Jiun and Li, Kang},
	title = {Enhancing Safety-Integrity of Localization Systems in Lane-Keeping Scenarios Using a Self-Supervised Spatial Temporal Deep Network},
	year = {2026},
	journal = {IET Intelligent Transport Systems},
	volume = {20},
	number = {1},
	pages = {},
	doi = {10.1049/itr2.70249},
	url = {https://www.scopus.com/pages/publications/105041018822?origin=resultslist},
	abstract = {Accurate and reliable real-time localization for lane-keeping underpins safe navigation in autonomous vehicles. However, these systems are frequently exposed to sensor faults induced by environmental disturbances, which can result in critical integrity failures. To address this, we present a comprehensive fault detection and exclusion (FDE) framework that proactively identifies and removes faulty signals before sensor fusion, thereby preserving pose-estimation accuracy in lane-keeping scenarios. The framework incorporates a straightforward yet effective spatial-temporal localization diagnosis (STLD) model—combining lightweight CNNs for localized short-term feature extraction with GRUs for long-term dependency modelling—to deliver robust fault detection with minimal computational overhead. Trained self-supervised via systematic error injection and alert limit-based labelling, STLD requires no manual fault annotation. On the KITTI benchmark with injected multipath, drift, loss and LiDAR errors, our FDE framework effectively reduces localization failures compared with SPRT and lowers the average mean pose error across all error injection scenarios from 12.56 m without FDE to 1.20 m. These results validate the effectiveness of the proposed FDE framework in enhancing localization robustness and precision under varied fault scenarios. © 2026 The Author(s). IET Intelligent Transport Systems published by John Wiley & Sons Ltd on behalf of The Institution of Engineering and Technology.},
	type = {Article},
	publication_stage = {Final},
