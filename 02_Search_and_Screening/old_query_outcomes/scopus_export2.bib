@CONFERENCE{Zhang2020205,
	author = {Zhang, Lin and Chen, Xin and Kong, Fanxin and Cardenas, Alvaro A.},
	title = {Real-Time Attack-Recovery for Cyber-Physical Systems Using Linear Approximations},
	year = {2020},
