	title = {Tightly-coupled INS/CNS/PNS integrated navigation based on adaptive multi-model fusion},
	year = {2025},
	journal = {IECON Proceedings (Industrial Electronics Conference)},
	pages = {},
	doi = {10.1109/IECON58223.2025.11221233},
	url = {https://www.scopus.com/pages/publications/105024675817?origin=resultslist},
	abstract = {Reliable navigation in GNSS-denied nighttime environments remains a significant challenge for unmanned systems. Measurement uncertainty and environmental disturbances can degrade navigation accuracy. To mitigate these issues, a tightly coupled integrated navigation method is proposed, combining inertial navigation systems (INS), polarization navigation systems (PNS), and celestial navigation systems (CNS). A measurement model is developed utilizing raw vector measurements from the star sensor and the polarization sensor. Furthermore, an adaptive multi-model fusion architecture based on an interactive multiple-model (IMM) framework is introduced. The measurement noise covariance matrices and adaptive weights are dynamically updated through measurement innovations. Field experiment results demonstrate that the proposed method significantly enhances navigation accuracy, robustness, and adaptability. © 2025 IEEE.},
