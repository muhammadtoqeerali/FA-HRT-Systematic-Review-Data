   Moreno Blanc, Javier/0000-0001-5417-0054
   Palacín, Jordi/0000-0001-8210-3262
   Martínez, Dani/0000-0001-5814-5489},
Unique-ID = {WOS:000375153900019},
}

@inproceedings{ WOS:000389805900058,
Author = {Klein, Frederico B. and Stepanova, Karla and Cangelosi, Angelo},
Editor = {Hirose, A and Ozawa, S and Doya, K and Ikeda, K and Lee, M and Liu, D},
Title = {Implementation of a Modular Growing When Required Neural Gas
   Architecture for Recognition of Falls},
Booktitle = {NEURAL INFORMATION PROCESSING, ICONIP 2016, PT I},
Series = {Lecture Notes in Computer Science},
Year = {2016},
Volume = {9947},
Pages = {526-534},
Note = {23rd International Conference on Neural Information Processing (ICONIP),
   Kyoto, JAPAN, OCT 16-21, 2016},
Organization = {Asia Pacific Neural Network Soc; Japanese Neural Network Soc},
Abstract = {In this paper we aim for the replication of a state of the art
   architecture for recognition of human actions using skeleton poses
   obtained from a depth sensor. We review the usefulness of accurate human
   action recognition in the field of robotic elderly care, focusing on
   fall detection. We attempt fall recognition using a chained Growing When
   Required neural gas classifier that is fed only skeleton joints data. We
   test this architecture against Recurrent SOMs (RSOMs) to classify the
   TST Fall detection database ver. 2, a specialised dataset for fall
   sequences. We also introduce a simplified mathematical model of falls
   for easier and faster bench-testing of classification algorithms for
   fall detection.
   The outcome of classifying falls from our mathematical model was
   successful with an accuracy of 97.12 +/- 1.65\% and from the TST Fall
   detection database ver. 2 with an accuracy of 90.2 +/- 2.68\% when a
   filter was added.},
DOI = {10.1007/978-3-319-46687-3\_58},
ISSN = {0302-9743},
EISSN = {1611-3349},
ISBN = {978-3-319-46687-3; 978-3-319-46686-6},
ResearcherID-Numbers = {Cangelosi, Angelo/D-6784-2011
   Stepanova, Karla/LUY-7664-2024},
ORCID-Numbers = {Belmonte Klein, Frederico/0000-0003-4316-0496
   Cangelosi, Angelo/0000-0002-4709-2243
   },
Unique-ID = {WOS:000389805900058},
}

@inproceedings{ WOS:001011040500031,
Author = {Cerqueira, Rodolfo and Pereira, Jose and Ribeiro, Nuno Ferrete and
   Santos, Cristina P.},
Editor = {Lopes, AC and Pires, G and Pinto, VH and Lima, JL and Fonseca, P},
Title = {Engineering a Safer Future: Electronic Design and Validation of a
   Cane-Type Robot for Fall Prevention},
Booktitle = {2023 IEEE INTERNATIONAL CONFERENCE ON AUTONOMOUS ROBOT SYSTEMS AND
   COMPETITIONS, ICARSC},
Series = {IEEE International Conference on Autonomous Robot Systems and
   Competitions ICARSC},
Year = {2023},
Pages = {193-198},
Note = {IEEE International Conference on Autonomous Robot Systems and
   Competitions (ICARSC), Tomar, PORTUGAL, APR 26-27, 2023},
Organization = {IEEE; Portuguese Robot Soc; IEEE Portugal Sect; Soc Portuguese Robot;
   IEEE Robot \& Automat Soc, Portugal Chapter; Inst Politecnico Tomar; U
   Porto; Univ Aveiro; Inst Politecnico Braganca},
Abstract = {Assistive devices have played a vital role in improving the quality of
   life of elderly and mobility-impaired individuals, and with the recent
   advancements in technology, robotic assistive devices have been
   developed to provide finer assistance. This paper proposes an electronic
   architecture for a cane-type robot designed to assist users during gait
   and provide stability during daily activities. The system is composed of
   both software and hardware components, comprising sensory input units,
   data processing units, and actuator control units, among other
   capabilities, that enable the robot to detect the user's motion
   intention and move accordingly. To validate the effectiveness of the
   proposed system, healthy subjects were involved in reallife environment
   testing, showcasing promising results. The canetype robot achieved an
   accuracy rate of 97\% in detecting user movement intention and 90\% in
   recognising the user's gait phase. This system has great potential for
   use in rehabilitation and activities of daily living, with the ability
   to provide assistance while also reducing the risk of falls. With
   further development and testing, the proposed electronic architecture
   for a cane-type robot could improve the lives of those who require
   mobility assistance.},
DOI = {10.1109/ICARSC58346.2023.10129613},
ISSN = {2573-9360},
EISSN = {2573-9387},
ISBN = {979-8-3503-0121-2},
ResearcherID-Numbers = {/P-3771-2014
   Santos, Cristina/L-8716-2014
   Ferrete Ribeiro, Nuno/AAP-9872-2020},
ORCID-Numbers = {Fernandes Pereira, José Luís/0009-0007-1974-1131
   Cerqueira, Rodolfo/0009-0005-4809-8320
   Ferrete Ribeiro, Nuno/0000-0003-4177-2587},
