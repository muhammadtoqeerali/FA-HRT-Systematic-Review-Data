@inproceedings{ WOS:000298805800021,
Author = {Suzuki, Shinji and Hirata, Yasuhisa and Kosuge, Kazuhiro and Onodera,
   Hiroshi},
Book-Group-Author = {IEEE},
Title = {Walking Support based on Cooperation between Wearable-Type and Cane-Type
   Walking Support Systems},
Booktitle = {2011 IEEE/ASME INTERNATIONAL CONFERENCE ON ADVANCED INTELLIGENT
   MECHATRONICS (AIM)},
Series = {IEEE ASME International Conference on Advanced Intelligent Mechatronics},
Year = {2011},
Pages = {122-127},
Note = {IEEE/ASME International Conference on Advanced Intelligent Mechatronics,
   Budapest, HUNGARY, JUL 03-07, 2011},
Organization = {IEEE Robot \& Automat Soc (RA); IEEE Ind Elect Soc (IES); Amer Soc Mech
   Engn (ASME) Dynam Syst \& Control Div (DSC); Budapest Univ Technol \&
   Economi; Hungarian Acad Sci, Comp \& Automat Res Inst},
Abstract = {In this paper, we propose a new walking support system based on
   cooperation between wearable-type and cane-type walking support systems
   for supporting hemiplegia patients. In this system, we want to realize
   several functions such as swing phase support, navigation, fall
   prevention and sit-to-stand assist by controlling each walking support
   system cooperatively. As the first challenge of our research, in this
   paper, the wearable-type walking support system assists a leg motion
   during swing phase based on the motion of the cane-type walking support
   system moved by the user.},
