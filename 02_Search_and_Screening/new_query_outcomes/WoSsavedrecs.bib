@article{ WOS:000886743600001,
Author = {Toney-Bolger, Megan E. and Chang, Young-Hui},
Title = {The motor and the brake of the trailing leg in human walking:
   transtibial amputation limits ankle-knee torque covariation},
Journal = {EXPERIMENTAL BRAIN RESEARCH},
Year = {2023},
Volume = {241},
Number = {1},
Pages = {161-174},
Month = {JAN},
Abstract = {Lower-limb amputation limits inherent motor abundance in the locomotor
   system and impairs walking mechanics. Able-bodied walkers vary ankle
   torque to adjust step-to-step leg force production as measured by
   resultant ground reaction forces. Simultaneously, knee torque covaries
   with ankle torque to act as a brake, resulting in consistent peak leg
   power output measured by external mechanical power generated on the
   center of mass. Our objective was to test how leg force control during
   gait is affected by joint torque variance structure in the amputated
   limb. Within the framework of the uncontrolled manifold analysis, we
   measured the Index of Motor Abundance (IMA) to quantify joint torque
   variance structure of amputated legs and its effect on leg force, where
   IMA > 0 indicates a stabilizing structure. We further evaluated the
   extent to which IMA in amputated legs used individual (INV) and
   coordinated (COV) joint control strategies. Amputated legs produced IMA
   and INV values similar to intact legs, indicating that torque deviations
   of the prosthetic ankle can modulate leg force at the end of stance
   phase. However, we observed much lower COV values in the amputated leg
   relative to intact legs indicating that biological knee joint torque of
   the amputated leg does not covary with prosthetic ankle torque. This
   observation suggests inter-joint coordination during gait is
   significantly limited as a result of transtibial amputation and may help
   explain the higher rate of falls and impaired balance recovery in this
   population, pointing to a greater need to focus on inter-joint
   coordination within the amputated limb.},
DOI = {10.1007/s00221-022-06513-5},
EarlyAccessDate = {NOV 2022},
ISSN = {0014-4819},
EISSN = {1432-1106},
ORCID-Numbers = {Chang, Young-Hui/0000-0001-7987-6459},
Unique-ID = {WOS:000886743600001},
}

@article{ WOS:000415044300007,
Author = {Shawen, Nicholas and Lonini, Luca and Mummidisetty, Chaithanya Krishna
   and Shparii, Ilona and Albert, Mark V. and Kording, Konrad and
   Jayaraman, Arun},
Title = {Fall Detection in Individuals With Lower Limb Amputations Using Mobile
   Phones: Machine Learning Enhances Robustness for Real-World Applications},
Journal = {JMIR MHEALTH AND UHEALTH},
Year = {2017},
Volume = {5},
Number = {10},
Month = {OCT},
Abstract = {Background: Automatically detecting falls with mobile phones provides an
   opportunity for rapid response to injuries and better knowledge of what
   precipitated the fall and its consequences. This is beneficial for
   populations that are prone to falling, such as people with lower limb
   amputations. Prior studies have focused on fall detection in able-bodied
   individuals using data from a laboratory setting. Such approaches may
   provide a limited ability to detect falls in amputees and in real-world
   scenarios.
   Objective: The aim was to develop a classifier that uses data from
   able-bodied individuals to detect falls in individuals with a lower limb
   amputation, while they freely carry the mobile phone in different
   locations and during free-living.
   Methods: We obtained 861 simulated indoor and outdoor falls from 10
   young control (non-amputee) individuals and 6 individuals with a lower
   limb amputation. In addition, we recorded a broad database of activities
   of daily living, including data from three participants' free-living
   routines. Sensor readings (accelerometer and gyroscope) from a mobile
   phone were recorded as participants freely carried it in three common
   locations-on the waist, in a pocket, and in the hand. A set of 40
   features were computed from the sensors data and four classifiers were
   trained and combined through stacking to detect falls. We compared the
   performance of two population-specific models, trained and tested on
   either able-bodied or amputee participants, with that of a model trained
   on able-bodied participants and tested on amputees. A simple
   threshold-based classifier was used to benchmark our machine-learning
   classifier.
   Results: The accuracy of fall detection in amputees for a model trained
   on control individuals (sensitivity: mean 0.989, 1.96{*} standard error
   of the mean {[}SEM] 0.017; specificity: mean 0.968, SEM 0.025) was not
   statistically different (P=. 69) from that of a model trained on the
   amputee population (sensitivity: mean 0.984, SEM 0.016; specificity:
   mean 0.965, SEM 0.022). Detection of falls in control individuals
   yielded similar results (sensitivity: mean 0.979, SEM 0.022;
   specificity: mean 0.991, SEM 0.012). A mean 2.2 (SD 1.7) false alarms
   per day were obtained when evaluating the model (vs mean 122.1, SD 166.1
   based on thresholds) on data recorded as participants carried the phone
   during their daily routine for two or more days. Machine-learning
   classifiers outperformed the threshold-based one (P<.001).
   Conclusions: A mobile phone-based fall detection model can use data from
   non-amputee individuals to detect falls in individuals walking with a
   prosthesis. We successfully detected falls when the mobile phone was
   carried across multiple locations and without a predetermined
   orientation. Furthermore, the number of false alarms yielded by the
   model over a longer period of time was reasonably low. This moves the
   application of mobile phone-based fall detection systems closer to a
   real-world use case scenario.},
DOI = {10.2196/mhealth.8201},
Article-Number = {e151},
ISSN = {2291-5222},
ResearcherID-Numbers = {Kording, Konrad/A-1233-2007
   Lonini, Luca/AAI-7032-2020
   Mummidisetty, Chaithanya/U-7708-2019},
ORCID-Numbers = {Jayaraman, Arun/0000-0002-9302-6693
   Kording, Konrad/0000-0001-8408-4499
   Lonini, Luca/0000-0002-9358-1718
   Shawen, Nicholas/0000-0003-0351-9011
   },
Unique-ID = {WOS:000415044300007},
}

@inproceedings{ WOS:000427598700092,
Author = {Fukui, Yusuke and Akiyama, Yasuhiro and Yamada, Yoji and Okamoto, Shogo},
Book-Group-Author = {IEEE},
Title = {The Change of Gait Motion When Curving a Corner Owing to the Motion
   Restriction Caused by a Wearable Device},
Booktitle = {2017 IEEE INTERNATIONAL CONFERENCE ON SYSTEMS, MAN, AND CYBERNETICS
   (SMC)},
Series = {IEEE International Conference on Systems Man and Cybernetics Conference
   Proceedings},
Year = {2017},
Pages = {525-530},
Note = {IEEE International Conference on Systems, Man, and Cybernetics (SMC),
   Banff, CANADA, OCT 05-08, 2017},
Organization = {IEEE},
Abstract = {Many wearable robots are not fully capable of fitting the motion of the
   wearer, owing to their limited degrees-of-freedom (DOF). This limitation
   disturbs motions such as corner curving, which are required in daily
   life. In this study, the effect of the DOF restriction on the corner
   curving motion was observed and analyzed. The gait motions, when curving
   a round corner with and without the restriction of out-of-sagittal plane
   motion, were compared using a wearable device which could restrict hip
   adduction/abduction and rotation. The result suggested that the
   restriction not only decreased the range of motion of hip
   adduction/abduction and rotation, but also changed the center of mass
   (COM) trajectory. Owing to the disturbance applied during the stepping
   motion of the outer leg, the COM trajectory moved further from the
   corner in the trials with restriction. Thus, the distance between COM
   and the base of support of the inner foot became larger during the swing
   phase of the outer leg, which possibly increased the risk of loss of
   balance. Furthermore, it was also suggested that an assistive torque,
   which does not consider curving motion, possibly increases such risk.},
ISSN = {1062-922X},
ISBN = {978-1-5386-1645-1},
ResearcherID-Numbers = {OKAMOTO, Shogo/QDN-1368-2026
   Akiyama, Yasuhiro/AAV-6248-2021},
Unique-ID = {WOS:000427598700092},
}

@inproceedings{ WOS:000494431300090,
Author = {Pereira, Ana and Ribeiro, Nuno Ferrete and Santos, Cristina P.},
Book-Group-Author = {IEEE},
Title = {A Preliminary Strategy for Fall Prevention in the ASBGo Smart Walker},
Booktitle = {2019 6TH IEEE PORTUGUESE MEETING IN BIOENGINEERING (ENBENG)},
Year = {2019},
Note = {6th IEEE Portuguese Meeting on Bioengineering (ENBENG), ISEL, Lisbon,
   PORTUGAL, FEB 22-23, 2019},
Organization = {IEEE; Inst Super Engn Lisboa; IEEE Potugal Sect, IEEE Engn Med \& Biol
   Soc Portugal Chapter; IEEE Potugal Sect; Fraunhofer Portugal; INESCTEC;
   Politecnico Lisboa; Inst Telecomunicacoes; EPAL, Grupo Aguas Portugal;
   Bruker},
Abstract = {Fall-related injuries affect a large part of the population and related
   costs. Thus, there is a concern in studying a fall prevention strategy
   to minimize the consequences of falls. Walkers are assistive devices
   used to improve the balance, stability and reduce the load on the lower
   limb of the user. In this sense, there is a concern to improve the
   safety in smart walkers and, consequently, to prevent falls in these
   devices. However, in this field, the only approach is to stop the walker
   in risk situations. So, the aim of this paper is to define a preliminary
   strategy to prevent a fall event in the Adaptive System Behaviour Group
   (ASBGo) Smart Walker. For ASBGo Smart Walker, two modes of security are
   discussed in this paper. One approach is based on monitoring the center
   of mass and changing the trajectory when a near fall is detected. The
   other mechanism consists only in to stop the walker when a dangerous
   situation is detected. The first or the second mode are activated
   depending if the user drives the walker with the forearm on forearm
   support or not.},
DOI = {10.1109/enbeng.2019.8692533},
ResearcherID-Numbers = {Ferrete Ribeiro, Nuno/AAP-9872-2020
   Santos, Cristina/L-8716-2014},
ORCID-Numbers = {Ferrete Ribeiro, Nuno/0000-0003-4177-2587
   Santos, Cristina/0000-0003-0023-7203},
Unique-ID = {WOS:000494431300090},
}

@article{ WOS:001837810100049,
Author = {Feng, Mingfei and Liu, Jiaqi and Xu, Jian and Fang, Hongbin},
Title = {Feature Extraction and Selection in Walking Surface Classification:
   Evaluating the Effectiveness of Multiple Sensor Configurations},
Journal = {IEEE SENSORS JOURNAL},
Year = {2026},
Volume = {26},
Number = {15},
Pages = {22914-22927},
Month = {AUG 1},
Abstract = {Accurate classification of walking surfaces is critical for wearable
   biomedical and health informatics systems, particularly in applications
   such as gait analysis, fall prevention, and prosthetic control. However,
   a systematic evaluation of how different sensing modalities and their
   feature representations contribute to this measurement task remains
   lacking. In this study, we propose a multisensor evaluation framework to
   quantify the effectiveness of diverse signal features and sensor fusions
   for surface classification. We conduct biomechanical tests on healthy
   individuals walking naturally across four terrains: concrete road,
   synthetic track, grass, and sand. After performing signal processing,
   feature extraction, feature-level data fusion, and feature selection, we
   employ a random forest (RF) classifier to identify the surfaces. We
   thoroughly examine the effects of various sensor and training
   configurations on classification performance. Experimental results show
   that meaningful feature extraction and selection can enable accurate
   surface detection with a minimal feature set. In addition, sensor fusion
   combined with feature selection can enhance performance, with the
   exception of the combination of insole and inertial sensors. Key
   features from different sensor configurations are identified, achieving
   a classification accuracy of 95.2\% +/- 3.3\% with inertial sensors
   alone and 97.8\% +/- 2.4\% with the combination of all sensors.},
DOI = {10.1109/JSEN.2026.3701505},
ISSN = {1530-437X},
EISSN = {1558-1748},
Unique-ID = {WOS:001837810100049},
}

@article{ WOS:000800355500001,
Author = {Sujatha Ravindran, Akshay and Malaya, Christopher A. and John, Isaac and
   Francisco, Gerard E. and Layne, Charles and Contreras-Vidal, Jose L.},
Title = {Decoding neural activity preceding balance loss during standing with a
   lower-limb exoskeleton using an interpretable deep learning model},
Journal = {JOURNAL OF NEURAL ENGINEERING},
Year = {2022},
Volume = {19},
Number = {3},
Month = {JUN 1},
Abstract = {Objective: Falls are a leading cause of death in adults 65 and older.
   Recent efforts to restore lower-limb function in these populations have
   seen an increase in the use of wearable robotic systems; however, fall
   prevention measures in these systems require early detection of balance
   loss to be effective. Prior studies have investigated whether kinematic
   variables contain information about an impending fall, but few have
   examined the potential of using electroencephalography (EEG) as a
   fall-predicting signal and how the brain responds to avoid a fall.
   Approach: To address this, we decoded neural activity in a balance
   perturbation task while wearing an exoskeleton. We acquired EEG,
   electromyography (EMG), and center of pressure (COP) data from seven
   healthy participants during mechanical perturbations while standing. The
   timing of the perturbations was randomized in all trials. Main results:
   We found perturbation evoked potentials (PEP) components as early as
   75-134 ms after the onset of the external perturbation, which preceded
   both the peak in EMG (similar to 180 ms) and the COP (similar to 350
   ms). A convolutional neural network trained to predict balance
   perturbations from single-trial EEG had a mean F-score of 75.0 +/- 4.3
   \%. Clustering GradCAM-based model explanations demonstrated that the
   model utilized components in the PEP and was not driven by artifacts.
   Additionally, dynamic functional connectivity results agreed with model
   explanations; the nodal connectivity measured using phase difference
   derivative was higher in the occipital-parietal region in the early
   stage of perturbations, before shifting to the parietal, motor, and back
   to the frontal-parietal channels. Continuous-time decoding of COP
   trajectories from EEG, using a gated recurrent unit model, achieved a
   mean Pearson's correlation coefficient of 0.7 +/- 0.06. Significance:
   Overall, our findings suggest that EEG signals contain short-latency
   neural information related to an impending fall, which may be useful for
   developing brain-machine interface systems for fall prevention in
   robotic exoskeletons.},
DOI = {10.1088/1741-2552/ac6ca9},
Article-Number = {036015},
ISSN = {1741-2560},
EISSN = {1741-2552},
ResearcherID-Numbers = {Contreras-Vidal, Jose/AAW-9299-2020
   Layne, Charles/AAV-5437-2021
   Sujatha Ravinan, Akshay/X-4479-2019},
ORCID-Numbers = {Contreras-Vidal, Jose/0000-0002-6499-1208
   Sujatha Ravinan, Akshay/0000-0001-7213-9587},
Unique-ID = {WOS:000800355500001},
}

@inproceedings{ WOS:000468941800144,
Author = {Hamza, Khaled Kadry and Zhang, Xiaodong and Mu, Xiaoqi and Odekhe,
   Randolph and Alhassan, Ahmad Bala},
Book-Group-Author = {IEEE},
Title = {Modeling and Simulation of Transporting Elderly Posture of
   Multifunctional Elderly-Assistant and Walking-Assistant Robot},
Booktitle = {2018 IEEE 8TH ANNUAL INTERNATIONAL CONFERENCE ON CYBER TECHNOLOGY IN
   AUTOMATION, CONTROL, AND INTELLIGENT SYSTEMS (IEEE-CYBER)},
Series = {IEEE Annual International Conference on Cyber Technology in Automation
   Control and Intelligent Systems},
Year = {2018},
Pages = {822-826},
Note = {8th IEEE Annual International Conference on Cyber Technology in
   Automation, Control, and Intelligent Systems (IEEE-CYBER), Tianjin,
   PEOPLES R CHINA, JUL 19-23, 2018},
Organization = {IEEE; IEEE Robot \& Automat Soc; Nankai Univ; Chinese Assoc Automat,
   Tech Comm Robot; CINGAI; Hebei Univ Technol; K C Wong Educ Fdn},
Abstract = {The author's lab proposed a new multifunctional robot that can help the
   elderly people to making his daily activities and improving the life
   quality for the elderly. The robot has two major functions: running as
   an intelligent wheelchair, and walking like a smart cane. For improving
   its wheelchair properties, the modeling, simulation and vibration
   analysis of the elderly-robot system transporting elderly posture of
   elderly-assistant and walking assistant robot (EVVR) is investigated in
   this paper. The dynamic model composed of two parts: elderly body which
   modeled as two rigid masses, one for the head and the other for the body
   connected together by spring-damper system, and robot which modeled as a
   lumped mass with springs and dampers. The elderly-robot system is
   subjected to disturbance inputs from the road roughness, its vibration
   characteristics are analyzed by MATLAB simulation. The simulation
   results show the stability and the performance of the robot with fall
   prevention.},
ISSN = {2379-7711},
ISBN = {978-1-5386-7057-6},
ResearcherID-Numbers = {Alhassan, Ahmad/AAJ-5566-2021
   },
