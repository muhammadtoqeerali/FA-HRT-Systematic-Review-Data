Unique-ID = {WOS:000582693600204},
}

@inproceedings{ WOS:001748576700239,
Author = {Lan, Shan and Zhao, Yanwei and Yu, Jinhong and Yang, Junjie and Han,
   Jianda and Huo, Weiguang},
Book-Group-Author = {IEEE},
Title = {A Terrain-Aware Active Stumble Prevention Strategy of Lower Limb
   Exoskeletons},
Booktitle = {2025 IEEE INTERNATIONAL CONFERENCE ON ROBOTICS AND BIOMIMETICS, ROBIO},
Series = {IEEE International Conference on Robotics and Biomimetics},
Year = {2025},
Pages = {1534-1539},
Note = {21st International Conference on Robotics and Biomimetics-ROBIO,
   Chengdu, PEOPLES R CHINA, DEC 03-07, 2025},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {Lower limb exoskeletons have been extensively developed to assist older
   people in performing daily activities. Due to insufficient sensory and
   motor functions, the elderly usually face a high risk of stumbling when
   walking on complex terrains, such as various stairs and curbs. Existing
   fall prevention strategies are commonly passive or reactive (i.e.,
   activating post-stumble), and cannot ensure active safety protection. To
   address this issue, we propose an active stumble prevention framework
   that integrates terrain perception with active assistive control of
   lower limb exoskeletons. This framework allows the exoskeleton to
   preemptively modify the user's gait before stumbling. The proposed
   terrain estimation approach leverages point clouds from a depth camera
   to precisely discern terrain types and compute key parameters, including
   stair height, distance to stair, and slope angle. Derived from these
   parameters, a reference foot trajectory is designed based on a Bezier
   curve. Finally, an adaptive weighted fusion approach is employed online
   to generate appropriate reference knee joint angles for the exoskeleton
   based on the current foot position and reference foot trajectory. The
   accuracy of the developed terrain estimation approach was evaluated via
   experiments conducted both indoors and outdoors. Both simulations and
   experiments demonstrated the efficacy of the adaptive weighted fusion
   method. Online experiments performed using a knee exoskeleton
   effectively prevented user stumbles, showing the method's effectiveness
   and safety.},
DOI = {10.1109/ROBIO66223.2025.11375932},
ISSN = {2994-3566},
ISBN = {979-8-3315-5748-5; 979-8-3315-5747-8},
Unique-ID = {WOS:001748576700239},
}

@inproceedings{ WOS:000416951900033,
Author = {Tee, Kian Sek and Zhi, Chun E. and Saim, Hashim and Zakaria, Wan
   Nurshazwani Wan and Khialdin, Safinaz Binti Mohd and Isa, Hazlita and
   Awad, M. I. and Soon, Chin Fhong},
Editor = {Audah, L and AbdWahab, MH and Jamail, NAM and Mohd, MNH and Hanafi, D and Soon, CF},
Title = {Fall Prevention Walker during Rehabilitation},
Booktitle = {ADVANCES IN ELECTRICAL AND ELECTRONIC ENGINEERING: FROM THEORY TO
   APPLICATIONS},
Series = {AIP Conference Proceedings},
Year = {2017},
Volume = {1883},
Note = {International Conference on Electrical and Electronic Engineering
   (IC3E), Johor Bahru, MALAYSIA, AUG 14-15, 2017},
Abstract = {This paper proposes on the design of a walker for the prevention of
   falling among elderlies or patients during rehabilitation whenever they
   use a walker to assist them. Fall happens due to impaired balance or
   gait problem. The assistive device is designed by applying stability
   concept and an accelerometric fall detection system is included. The
   accelerometric fall detection system acts as an alerting device that
   acquires body accelerometric data and detect fall. Recorded
   accelerometric data could be useful for further assessment. Structural
   strength of the walker was verified via iterations of simulation using
   finite element analysis, before being fabricated. Experiments were
   conducted to identify the fall patterns using accelerometric data. The
   design process and detection of fall pattern demonstrates the design of
   a walker that could support the user without fail and alerts the helper,
   thus salvaging the users from injuries due to fall and unattended
   situation.},
