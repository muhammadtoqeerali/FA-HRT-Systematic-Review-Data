ResearcherID-Numbers = {Katsura, Seiichiro/F-4513-2010
   Yi, Jingang/B-4069-2011},
ORCID-Numbers = {Trkov, Mitja/0000-0001-8556-7214
   },
Unique-ID = {WOS:000426448500245},
}

@article{ WOS:000474628100022,
Author = {Phi Van Lam and Fujimoto, Yasutaka},
Title = {A Robotic Cane for Balance Maintenance Assistance},
Journal = {IEEE TRANSACTIONS ON INDUSTRIAL INFORMATICS},
Year = {2019},
Volume = {15},
Number = {7},
Pages = {3998-4009},
Month = {JUL},
Abstract = {This paper proposes a robotic cane that helps users to stand and
   maintain their balance while standing and walking. The design is based
   on an inverted pendulum model, uses a smart omnidirectional wheel, and
   is linearized by the Lie algebra method (LAM) combined with a nonlinear
   disturbance observer that estimates the external force applied by the
   user. The hardware and mathematical model of the robotic cane are
   analyzed in detail. The hardware design is complete, and considers the
   weight and battery capacity. The performance of the controller is
   confirmed in three-dimensional simulations and in physical experiments.
   The robotic cane tolerates a large fluctuation angle from its
   equilibrium point. It also has a fall prevention function, which is
   among the most desirable functions of any walking assistance device, and
   responds quickly to a human force. The balance maintenance functions are
   as follows: self-balance, standing and walking assistance, fall
   prevention, and a mechatronic safety mode. In experimental measurements
   of the cane in use, the gyroscope sensor insignificant vibrations on the
   user's bodies, verifying the effectiveness of the robotic cane in daily
   life activities. The performance of LAM is also compared with that of
   the linear quadratic regulator.},
DOI = {10.1109/TII.2019.2903893},
ISSN = {1551-3203},
EISSN = {1941-0050},
ResearcherID-Numbers = {Fujimoto, Yasutaka/B-5576-2012},
ORCID-Numbers = {Fujimoto, Yasutaka/0000-0002-8106-5425},
Unique-ID = {WOS:000474628100022},
}

@article{ WOS:000969262800001,
Author = {Mizuno, Tomomi and Tokuda, Katsumi},
Title = {Reducing falls among visually impaired individuals on railway platforms:
   Field research on environmental challenges and solutions},
Journal = {HELIYON},
Year = {2023},
Volume = {9},
Number = {3},
Month = {MAR},
Abstract = {The aim of this study is to assess the extent to which visually impaired
   people are at risk of falling from railway station platforms and to
   identify opportunities for improvement. A barrier-finding fieldwork
   approach was used to conduct this study. A total of 412 stations'
   platforms were examined to provide recommendations for enhancing
   platform safety.The study found that four major factors contribute to
   accidents in which visually impaired individuals may fall from railway
   station platforms. These factors include ``the spatial layout of the
   platform{''}, ``the warning tactile pavers{''}, ``the Fall Prevention
   Hoods{''}, and ``the fall prevention fences and platform screen doors
   ``.Based on the findings of the study, several measures are recommended
   to enhance the safety and accessibility of railway station platforms for
   visually impaired individuals. These measures include closing the gap
   between the platform and the train, installing Fall Prevention Hoods at
   lower heights near the feet so that they can be detected using a guide
   cane, and avoid the placement of directional tactile pavers close to the
   front end of the train cars or at the platform edge facing train car
   couplings, etc.},
DOI = {10.1016/j.heliyon.2023.e14666},
Article-Number = {e14666},
EISSN = {2405-8440},
ORCID-Numbers = {MIZUNO, TOMOMI/0000-0002-7213-0483},
Unique-ID = {WOS:000969262800001},
}

@inproceedings{ WOS:001455002900019,
Author = {Hall, Jenna and Bae, Ji Beom and Visser, Joshua and Abedi, Hajar and
   Shaker, George},
Book-Group-Author = {IEEE},
Title = {Validating mm-Wave Radar System for Fall Detection and Recovery in
   Washrooms},
Booktitle = {2024 IEEE HEALTHCARE INNOVATIONS AND POINT OF CARE TECHNOLOGIES, HI-POCT},
Year = {2024},
Pages = {73-76},
Note = {2024 Conference on Healthcare Innovations and Point of Care
   Technologies, Tucson, AZ, SEP 19-20, 2024},
Organization = {Institute of Electrical and Electronics Engineers Inc},
Abstract = {Falls are a leading cause of death among individuals over 65, making
   timely detection crucial for preventing fatalities and improving
   recovery. Washrooms, despite being high-risk areas for falls, are
   underrepresented in fall detection research. This study aims to validate
   a non-contact fall-detection system capable of continuous and reliable
   monitoring in cluttered washroom environments, including scenarios
   involving common walking aids. The system uses Single Input Multiple
   Output Frequency-Modulated Continuous Wave (SIMO FMCW) radar to detect
   falls from both sitting and standing positions. Four participants
   simulated falls and fall recoveries in various scenarios, such as
   sitting on a toilet or wheelchair, standing with a walker, and standing
   freely. The system's ability to differentiate between falls and
   recoveries was also tested, as recovered falls are significant for fall
   history and injury risk. The radar system demonstrated an average fall
   detection accuracy of 100\% and a recovery detection accuracy of 92.5\%.
   The findings support the use of SIMO FMCW radar as an effective,
   non-contact emergency alert system for washroom falls. This affordable
   and convenient system offers a life-saving solution for fall monitoring
   in personal spaces, ensuring safety while respecting privacy.},
DOI = {10.1109/HI-POCT64255.2024.10876204},
ISBN = {979-8-3315-0803-6; 979-8-3315-0804-3},
ORCID-Numbers = {Abedi, Hajar/0000-0002-4089-0373},
Unique-ID = {WOS:001455002900019},
}

@article{ WOS:001324235600001,
Author = {Rice, Laura A. and Yehya, Malaak and Yi, Jennifer and Koziel, Stephen
   and Peterson, Elizabeth W.},
Title = {Translation, extension, and evaluation of usability, usefulness, and
   safety of a fall prevention and management program for people living
   with spinal cord injury and multiple sclerosis who use wheelchairs or
   scooters full time},
Journal = {FRONTIERS IN REHABILITATION SCIENCES},
Year = {2024},
Volume = {5},
Month = {SEP 18},
Abstract = {Background Falls are prevalent among people living with Multiple
   Sclerosis (PwMS) and Spinal Cord Injury (PwSCI) who use wheelchairs or
   scooters (WC/S) full time, however, there is a scarcity of
   evidence-based fall prevention and management programs.Objective To
   describe the systematic translation of an in-person fall prevention and
   management program (Individualized Reduction Of FaLLs - iROLL) for PwMS
   to an online platform, extending its scope to include PwSCI, and to
   evaluate the preliminary useability, usefulness, and safety of the
   intervention.Methods iROLL was systematically translated to an online
   platform (iROLL-O). PwMS and PwSCI who use a WC/S full time, experienced
   at least one fall within the past 36 months, and could transfer
   independently or with minimal to moderate assistance, enrolled in
   iROLL-O. Usability, usefulness, and safety were evaluated through 1:1
   semi-structured interviews, gathering feedback on: perceived impact of
   the intervention on falls and functional mobility, program experiences,
   adverse events, and recommendations for improvement.Results Five
   participants successfully completed the iROLL-O program. No safety
   concerns were raised by participants. Themes emerging from the
   semi-structured interviews included: (1) barriers and facilitators to
   program access, (2) motivation for participation, (3) program outcomes,
   and (4) program content and structure. Participants reported reduced
   concerns about falling, enhanced functional mobility skills, and
   highlighted the supportive nature of synchronous group meetings for
   learning.Conclusion No adverse events occurred during the implementation
   of iROLL-O and participants found the program to be useable and useful.
   Further testing is needed to examine efficacy among a large and diverse
   population.},
DOI = {10.3389/fresc.2024.1406938},
Article-Number = {1406938},
EISSN = {2673-6861},
ResearcherID-Numbers = {Rice, Laura/AGK-5983-2022
   },
ORCID-Numbers = {Koziel, Stephen/0000-0002-3856-1415},
Unique-ID = {WOS:001324235600001},
}

@inproceedings{ WOS:000494431300103,
Author = {Mouta, Pedro and Ribeiro, Nuno Ferrete and Goncalves, Luis and Santos,
   Cristina P.},
Book-Group-Author = {IEEE},
Title = {An Overview of Fall-Related Systems Developed in Canes},
Booktitle = {2019 6TH IEEE PORTUGUESE MEETING IN BIOENGINEERING (ENBENG)},
Year = {2019},
Note = {6th IEEE Portuguese Meeting on Bioengineering (ENBENG), ISEL, Lisbon,
   PORTUGAL, FEB 22-23, 2019},
Organization = {IEEE; Inst Super Engn Lisboa; IEEE Potugal Sect, IEEE Engn Med \& Biol
   Soc Portugal Chapter; IEEE Potugal Sect; Fraunhofer Portugal; INESCTEC;
   Politecnico Lisboa; Inst Telecomunicacoes; EPAL, Grupo Aguas Portugal;
   Bruker},
Abstract = {The number of falls is growing as the main cause of injuries and deaths
   in the geriatric community. As a result, also the cost of treating the
   injuries associated with falls is increasing. Thus, the development of
   fall detection and prediction systems with the capability of real-time
   monitoring without user restriction is imperative. For this reason,
   canes can be a great choice to embed fall-related systems. This paper
   aims to achieve a complete state-of-the-art concerning the development
   of fall detection and prediction algorithms implemented in canes. In
   order to accomplish this goal, a comprehensive search was performed.
   This search includes the IEEE, Scopus and Web of Science databases
   regarding developed systems in the literature. Also, a commercial search
   on Google and a patent search on Espacenet and the United States Patent
   and Trademark Office was performed. To this day, it has not been
   developed any type of cane related system which focuses on the temporal
   window preceding a fall and that accesses the risk of falling, even
   though a considerable amount of fall detection systems have already been
   presented.},
DOI = {10.1109/enbeng.2019.8692546},
ResearcherID-Numbers = {Ferrete Ribeiro, Nuno/AAP-9872-2020
   Goncalves, L/A-6425-2009
   Santos, Cristina/L-8716-2014},
ORCID-Numbers = {Ferrete Ribeiro, Nuno/0000-0003-4177-2587
   Santos, Cristina/0000-0003-0023-7203},
Unique-ID = {WOS:000494431300103},
}

@inproceedings{ WOS:000469086600148,
Author = {Mu, Xiaoqi and Zhang, Xiaodong and Osivue, Odekhe Randolph and Han,
   Huanjie and Kadry, Hamza Khaled and Wang, Yabin},
Editor = {Li, C and Wang, D and Cabrera, D and Zhou, Y and Zhang, C},
Title = {Dynamic Modeling and Control Method of Walking Posture of
   Multifunctional Elderly-assistant and Walking-assistant Robot for
   Preventing Elderly Fall},
Booktitle = {2018 INTERNATIONAL CONFERENCE ON SENSING, DIAGNOSTICS, PROGNOSTICS, AND
   CONTROL (SDPC)},
Year = {2018},
Pages = {806-809},
Note = {International Conference on Sensing, Diagnostics, Prognostics, and
   Control (SDPC), NW Polytechn Univ, Xian, PEOPLES R CHINA, AUG 15-17,
   2018},
Organization = {IEEE Comp Soc; Chongqing Technol \& Business Univ; Beijing Inst Technol;
   IEEE; Carleton Univ; Unmanned Syst Res Inst; Res Ctr Unmanned Syst
   Strategy Dev; Reliabil Soc; iSMMM; Beijing Aerosp Measurement \& Control
   Technol Co Ltd; AVIC SAMRI; COMAC Shanghai Aircraft Customer Serv Co
   Ltd; Avic Xian Flight Automat Control Res Inst; Chinese Journal
   Aeronaut; Life Predict Technologies Inc; Chinese Acad Sci, Inst Automat;
   Sensors},
Abstract = {A new multifunctional elderly-assistant and walking-assistant robot has
   been proposed in our lab to assist the elderly completing daily life and
   outdoor activities. The robot has two major functions, running as an
   intelligent wheelchair, and walking like a smart cane. When the robot
   assumes walking posture and the elderly is falling over, the robot
   adjusts to an appropriate position and supports the elderly giving
   balance thereby preventing fall. As a prerequisite condition that the
   robot supports the human balance, stability of the robot should be
   ensured. A dynamic model is proposed to present the stability of
   human-robot system. A feedforward-feedback compound control method is
   used to support the human balance and ensure stability of the robot.
   Model and simulation of the control system is conducted using
   Matlab/Simulink. The simulation results show the performance of fall
   prevention by the robot and provide a basis for the actual control
   system. The research process provides a reference for the stability of
   the elderly-assistant and walking-assistant robot system.},
