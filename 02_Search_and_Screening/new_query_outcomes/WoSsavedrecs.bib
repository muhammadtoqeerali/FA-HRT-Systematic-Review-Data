@inproceedings{ WOS:001260268300021,
Author = {Zachariae, Andreas and Widera, Julia and Plahl, Frederik and Hein,
   Bjoern and Wurll, Christian},
Editor = {Lee, SG and An, J and Chong, NY and Strand, M and Kim, JH},
Title = {Human Emergency Detection During Autonomous Hospital Transports},
Booktitle = {INTELLIGENT AUTONOMOUS SYSTEMS 18, VOL 2, IAS18-2023},
Series = {Lecture Notes in Networks and Systems},
Year = {2024},
Volume = {794},
Pages = {233-245},
Note = {18th International Conference on Intelligent Autonomous Systems (IAS),
   Suwon, SOUTH KOREA, JUL 04-07, 2023},
Abstract = {Human transports in hospitals are labor-intensive and primarily
   performed in beds to save time. This transfer method does not promote
   the mobility or autonomy of the patient. To relieve the caregivers from
   this time-consuming task, a mobile robot is developed to autonomously
   transport humans around the hospital. It provides different transfer
   modes including walking and sitting in a wheelchair. The problem that
   this paper focuses on is to detect emergencies and ensure the well-being
   of the patient during the transport. For this purpose, the patient is
   tracked and monitored with a camera system. OpenPose is used for Human
   Pose Estimation and a trained classifier for emergency detection. We
   collected and published a dataset of 18,000 images in lab and hospital
   environments. It differs from related work because we have a moving
   robot with different transfer modes in a highly dynamic environment with
   multiple people in the scene using only RGB-D data. To improve the
   critical recall metric, we apply threshold moving and a time delay. We
   compare different models with an AutoML approach. This paper shows that
   emergencies while walking are best detected by a SVM with a recall of
   95.8 \% on single frames. In the case of sitting transport, the best
   model achieves a recall of 62.2 \%. The contribution is to establish a
   baseline on this new dataset and to provide a proof of concept for the
   human emergency detection in this use case.},
DOI = {10.1007/978-3-031-44981-9\_21},
ISSN = {2367-3370},
EISSN = {2367-3389},
ISBN = {978-3-031-44980-2; 978-3-031-44981-9},
ORCID-Numbers = {Zachariae, Andreas/0000-0001-6770-7893
   Plahl, Frederik/0009-0009-7114-8671},
Unique-ID = {WOS:001260268300021},
}

@article{ WOS:000461725000025,
Author = {Aprigliano, F. and Monaco, V and Micera, S.},
Title = {External sensory-motor cues while managing unexpected slippages can
   violate the planar covariation law},
Journal = {JOURNAL OF BIOMECHANICS},
Year = {2019},
Volume = {85},
Pages = {193-197},
Month = {MAR 6},
Abstract = {This study was aimed at investigating the intersegmental coordination of
   six older adults while managing unexpected slippages delivered during
   steady walking, and wearing an Active Pelvis Orthosis (APO). The APO was
   setup either to assist volunteers at the hip levels during balance loss
   or to be transparent. The Planar Covariation Law (PCL) of the lower limb
   elevation angles was the main tool used to assess the intersegmental
   coordination of both limbs (i.e., the perturbed and unperturbed ones).
   Results revealed that, after the onset of the perturbation, elevation
   angles of both limbs do not covary, a part from the robot-mediated
   assistance. These new evidences suggest that external sensory-motor cues
   can alter the temporal synchronization of elevation angles, thus
   violating the PCL. (C) 2019 Elsevier Ltd. All rights reserved.},
DOI = {10.1016/j.jbiomech.2019.01.003},
ISSN = {0021-9290},
EISSN = {1873-2380},
ResearcherID-Numbers = {MONACO, Vito/AAD-6610-2021
   Micera, Silvestro/AAD-6630-2021},
ORCID-Numbers = {MONACO, Vito/0000-0003-1210-7553
   Micera, Silvestro/0000-0003-4396-8217},
Unique-ID = {WOS:000461725000025},
}

@inproceedings{ WOS:000426850800055,
Author = {Khalili, Mahsa and Borisoff, Jaimie F. and Van der Loos, H. F. Machiel},
Editor = {Amirabdollahian, F and Burdet, E and Masia, L},
Title = {Developing Safe Fall Strategies for Lower Limb Exoskeletons},
Booktitle = {2017 INTERNATIONAL CONFERENCE ON REHABILITATION ROBOTICS (ICORR)},
Series = {International Conference on Rehabilitation Robotics ICORR},
Year = {2017},
Pages = {314-319},
Note = {International Conference on Rehabilitation Robotics (ICORR), London,
   ENGLAND, JUL 17-20, 2017},
Abstract = {One of the main challenges in the use of a powered lower limb
   exoskeleton (LLE) is to ensure that balance is maintained throughout the
   operation of the device. Since no control strategy has yet been
   implemented that prevents falls in the case of a loss of balance, head
   or other serious injuries may occur during independent use of LLEs in
   the event of a fall. These safety concerns limit LLEs in the community
   to supervised use only.
   Using the backward fall as a model, we used optimization techniques to
   develop safe fall control strategies in order to avoid head impact and
   mitigate the impact velocity of the hips. From available human
   biomechanics data, we first developed an optimization methodology to
   study falls of healthy people. The results showed similar kinematic and
   dynamic characteristics to findings of previous studies on real-life
   human falls. Second, we extended the optimization methodology to include
   characteristics of a hypothetical LLE and to generate optimal joint
   trajectories and optimal torque profiles for the fall duration. The
   results revealed that by applying the optimal fall strategy, the
   severity of a simulated fall was minimized compared to when the device
   fell with locked joints (i.e., how currently used exoskeletons fall):
   head impact was avoided and hip impact velocity was reduced by more than
   50\%.},
ISSN = {1945-7898},
ISBN = {978-1-5386-2296-4},
ResearcherID-Numbers = {Van der Loos, HF Machiel/A-3693-2012
   },
ORCID-Numbers = {Van der Loos, HF Machiel/0000-0003-1355-980X
   Khalili, Mahsa/0000-0002-0510-2554},
Unique-ID = {WOS:000426850800055},
}

@inproceedings{ WOS:000259998200192,
Author = {Hirata, Yasuhisa and Komatsuda, Shinji and Kosuge, Kazuhiro},
Editor = {Chatila, R and Kelly, A and Merlet, JP},
Title = {Fall Prevention Control of Passive Intelligent Walker Based on Human
   Model},
Booktitle = {2008 IEEE/RSJ INTERNATIONAL CONFERENCE ON ROBOTS AND INTELLIGENT
   SYSTEMS, VOLS 1-3, CONFERENCE PROCEEDINGS},
Year = {2008},
Pages = {1222-1228},
Note = {IEEE/RSJ International Conference on Intelligent Robots and Systems,
   Nice, FRANCE, SEP 22-26, 2008},
Organization = {IEEE; Robot Soc Japan; IEEE Robot \& Automat Soc; IEEE Ind Elect Soc;
   Soc Instrument \& Control Engineers; Inst Natl Rech Informat \& Automat;
   CNRS; Inst Control, Robot \& Syst},
Abstract = {As aging progresses, fall accident of the person walker is an acute
   problem. It is necessary to know the situation of the user's fall to
   prevent it. In this paper, we propose a method for estimating the user's
   fall by modeling of the user in real time as a solid body link model,
   and pay attention to the center of gravity of the model. We also propose
   a method for controlling a passive intelligent walker to prevent the
   user's fall according to the support polygon and the walking
   characteristic of the user. We experimented with passive intelligent
   walker in which we implement the proposed fall prevention control and
   show the effectiveness or the proposal method.},
DOI = {10.1109/IROS.2008.4651173},
ISBN = {978-1-4244-2057-5},
ResearcherID-Numbers = {Kosuge, Kazuhiro/FZO-2678-2022},
ORCID-Numbers = {Hirata, Yasuhisa/0000-0002-5931-0471
   Kosuge, Kazuhiro/0000-0002-2060-2936},
Unique-ID = {WOS:000259998200192},
}

@article{ WOS:000527786700191,
Author = {Singh, Hardeep and Scovil, Carol Y. and Yoshida, Karen and Oosman, Sarah
   and Kaiser, Anita and Craven, Catharine and Jaglal, Susan and Musselman,
   Kristin E.},
Title = {Factors that influence the risk of falling after spinal cord injury: a
   qualitative photo-elicitation study with individuals that use a
   wheelchair as their primary means of mobility},
Journal = {BMJ OPEN},
Year = {2020},
Volume = {10},
Number = {2},
Month = {FEB},
Abstract = {Introduction Falls are a concern for wheelchair users with spinal cord
   injury (SCI). Falls can negatively impact the physical and psychological
   well-being of fallers. To date, the perspectives of wheelchair users
   with lived experiences of SCI on the contributors to falls has been
   understudied. Information about factors that influence fall risk would
   guide the development of effective fall prevention strategies.
   Objectives To gain a comprehensive understanding of the factors that
   influenced the risk of falling as perceived by wheelchair users with
   SCI.
   Design A qualitative study using photo-elicitation interviews.
   Setting A Canadian SCI rehabilitation hospital and the participants'
   home/community environments.
   Participants Twelve wheelchair users living in the community with
   chronic SCI.
   Methods Participants captured photographs of situations, places or
   things that they perceived increased and decreased their risk of
   falling. Semistructured photo-elicitation interviews were conducted to
   discuss the content of the photographs and explore perceptions of fall
   risk factors. A hybrid thematic analysis and the Biological,
   Behavioural, Social, Economic, and Environmental model were used as a
   framework to organise/synthesise the data.
   Results Overall, the findings indicated that the risk of falling was
   individualised, complex and dynamic to each person's life situation.
   Four main themes were revealed in our analysis: (1) Falls and fall risk
   caused by multiple interacting factors; (2) Dynamic nature of fall risk;
   (3) Single factors were targeted to reduce falls and fall-related
   injuries; and (4) Fall prevention experiences and priorities.
   Conclusions Each wheelchair user encountered numerous fall risk factors
   in their everyday lives. Information from this study can be used to set
   priorities for fall prevention. Fall prevention initiatives should
   consider a wheelchair user's fall risks in a holistic manner,
   acknowledging that a person's current situation, as well as anticipating
   their fall risks and fall prevention needs, will change over time.},
DOI = {10.1136/bmjopen-2019-034279},
Article-Number = {e034279},
ISSN = {2044-6055},
ResearcherID-Numbers = {Craven, Beverley Catharine/D-5001-2015},
ORCID-Numbers = {Craven, Beverley Catharine/0000-0001-8234-6803},
Unique-ID = {WOS:000527786700191},
}

@article{ WOS:001567080500001,
Author = {Aoki, Souta and Itami, Taku},
Title = {Light intensity-based obstacle detection system for manual wheelchair
   users},
Journal = {COGENT ENGINEERING},
Year = {2025},
Volume = {12},
Number = {1},
Month = {DEC 31},
Abstract = {As the population of individuals with physical disabilities in Japan
   rises, wheelchairs remain crucial support tools. However, wheelchair
   users face significant injury risks, highlighting the need for effective
   fall prevention strategies. While research has mainly focused on
   electric wheelchairs, manual wheelchairs also play a vital role,
   offering benefits in reducing muscle atrophy. Thus, developing a fall
   prevention system that enhances safety and supports physical activity
   among manual wheelchair users is essential. Therefore, in this research,
   we propose an algorithm capable of measuring both distance and height,
   independent of the actual size or distance of the obstacle. This
   algorithm ascertains distance and height by specifying the range
   irradiated to the obstacle, using the light intensity data obtained from
   the emitted line laser. In order to validate the algorithm's efficacy,
   we conducted distance measurements to an actual obstacle, adhering to
   the standard height of 20 mm. As a result, it was confirmed that this
   algorithm can generally measure distance and height regardless of the
   color of the obstacle.},
DOI = {10.1080/23311916.2025.2555395},
Article-Number = {2555395},
ISSN = {2331-1916},
ResearcherID-Numbers = {Itami, Taku/ISS-6424-2023},
ORCID-Numbers = {Itami, Taku/0009-0007-4610-3207},
Unique-ID = {WOS:001567080500001},
}

@article{ WOS:001675776700001,
Author = {Wang, Peilin and Cao, Yaru and Chen, Ziyuan and Ma, Bo and Han, Yunyun
   and Liang, Jiejunyi},
Title = {Predictive torque assistance for balance recovery: a task-level feature
   model for knee exoskeletons},
Journal = {EXPERT SYSTEMS WITH APPLICATIONS},
Year = {2026},
Volume = {309},
Month = {MAY 5},
Abstract = {Human bipedal stance is inherently unstable due to a high center of
   mass, making balance recovery from perturbations a critical but
   challenging task. For exoskeletons to assist effectively, their
   assistive torque must be precisely synchronized in timing, magnitude,
   and dynamic pattern with the body's own intrinsic joint torque;
   otherwise, robotic intervention risks being perceived as a destabilizing
   disturbance. Current methods, however, rely on reactive signals like
   joint angles or muscle activity, which inherently lag behind the body's
   anticipatory balance mechanisms, and lack a model of the body's natural
   torque regulation. Here, we introduced a novel, predictive framework for
   knee exoskeleton control, which proposed a task-level feature based on
   real-time center-of-mass (CoM) kinematics to characterize imbalance.
   Using this feature within a delayed feedback model derived from
   sensorimotor transformation theory, we accurately predict the required
   knee joint torque approximately 110 ms in advance, effectively
   compensating for neural transmission delays. This model provides a
   generalizable and computationally efficient strategy for torque
   estimation without complex biomechanical simulations. Test on the knee
   exoskeleton demonstrates that this synchronized assistance strategy
   significantly reduces muscle activation in the assisted knee and
   maintains natural movement kinematics without inducing compensatory
   actions. By enabling proactive, physiologically congruent torque
   delivery, our approach provides a critical advancement toward
   exoskeletons that work in harmony with human balance control, paving the
   way for more effective and user-friendly assistive devices.},
DOI = {10.1016/j.eswa.2026.131264},
EarlyAccessDate = {JAN 2026},
Article-Number = {131264},
ISSN = {0957-4174},
EISSN = {1873-6793},
ResearcherID-Numbers = {Han, Yunyun/O-2092-2013
   },
ORCID-Numbers = {Wang, Peilin/0009-0006-4521-4370
   Han, Yunyun/0000-0003-2336-167X
   Chen, Ziyuan/0009-0006-6248-572X},
Unique-ID = {WOS:001675776700001},
}

@inproceedings{ WOS:000400841200049,
Author = {Masood, Jawad and Mateos, Luis A. and Ortiz, Jesus and Toxiri, Stefano
   and O'Sullivan, Leonard and Caldwell, Darwin},
Editor = {GonzalezVargas, J and Ibanez, J and ContrerasVidal, JL and VanDerKooij, H and Pons, JL},
Title = {Active Safety Functions for Industrial Lower Body Exoskeletons: Concept
   and Assessment},
Booktitle = {WEARABLE ROBOTICS: CHALLENGES AND TRENDS},
Series = {Biosystems and Biorobotics},
Year = {2017},
Volume = {16},
Pages = {299-303},
Note = {2nd International Symposium on Wearable Robotics (WeRob), Segovia,
   SPAIN, OCT 18-21, 2016},
Abstract = {Exoskeleton technology can assist human effort performing manual
   handling tasks in industrial environments. Safety is vital both for the
   commercial and legal acceptance of industrial exoskeletons. We consider
   such systems as safety critical as they directly involve humans. Active
   safety functions can enhance the safety of exoskeletons and prevent
   accidents and injuries. We present the conceptual and evaluation
   criteria for Fall Detection, Active Balancing, Active Detachment,
   Collision Detection and Automatic MotorBraking. This evaluation
   highlights the safety critical scenarios which can be helpful in future
   hazard and risk assessment of exoskeletons, and also for safety
   certification evaluation.},
