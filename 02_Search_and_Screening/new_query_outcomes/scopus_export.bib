@CONFERENCE{Wang20261215,
	author = {Wang, Yifan and Li, Lei and Wang, Youlong and Yang, Chengyuan and Chan, Sherwin Stephen and Chen, Jiaye and Yan, Xiaoyue and Wang, Hao and Gong, Xuesheng and Lin, Jun and Hu, Hongping and Ang, Wei Tech},
	title = {Drba: Dynamic Robotic Balance Assistant - An Assist-as-Needed Gait and Balance Rehabilitation Robot for Versatile Training},
