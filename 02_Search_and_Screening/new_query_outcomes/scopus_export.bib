@CONFERENCE{Inkol202054,
	author = {Inkol, Keaton A. and McPhee, John},
	title = {Assessing Control of Fixed-Support Balance Recovery in Wearable Lower-Limb Exoskeletons Using Multibody Dynamic Modelling},
