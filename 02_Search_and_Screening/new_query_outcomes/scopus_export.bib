}

@CONFERENCE{Zhao202255,
	author = {Zhao, Yanzhe and Zhang, Yashi and Tang, Shukai},
	title = {Multi-sensor-based Lower Limb Rehabilitation Assistant Internet of Things System},
	year = {2022},
