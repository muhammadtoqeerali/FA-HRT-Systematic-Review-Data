@CONFERENCE{Lastovicka-Medin2022,
	author = {Lastovicka-Medin, Gordana and Deretic, Matija and Cvijetic, Tijana and Vesovic, Ksenija},
	title = {Magneto-mimicry & Body movement tracing by magnetic sensors, phone as DAQ and Phyphox as the sensor data base, browser and graphical analyzer: Case study of repetitive and irregular pattern},
	year = {2022},
	journal = {2022 11th Mediterranean Conference on Embedded Computing, MECO 2022},
	pages = {},
	doi = {10.1109/MECO55406.2022.9797072},
	url = {https://www.scopus.com/pages/publications/85133964088?origin=resultslist},
	abstract = {In this paper we present research on the application of the external magnets to the body in conjunction to the mobile phone as a data acquisition, data logger, data storage, data evaluator and graphical analyzer; all this supported by the sensors built into the phone and by an open-source smart-phone app Phyphox. A set of experiments is presented where the research question is whether the external magnets when attached to the body could enhance the detection of the anomalous/irregular patterns of body movement including the sudden changes while walking. The analysis is based on the evaluation of the time series data, also referred to as time-stamped data (a sequence of data points indexed in time order so distinctive features can be monitored at different points in time as well). These data points consist of successive measurements made from the same source over a time interval and are used to track change over time. The results presented in this paper support the beneficial side of applying the magneto-mimicry in tracing and tracking the human motions by attaching the small magnets to a part of the body of interest. The results also support the use of the magnets in biomedical research, particularly in research linked to the development of prosthetics and exoskeletons. © 2022 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
