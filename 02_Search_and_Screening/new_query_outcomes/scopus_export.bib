}

@ARTICLE{Cheng2008197,
	author = {Cheng, Kenneth C. and Bateni, Hamid and Maki, Brian E.},
	title = {Reducing adverse effects of walkers on stability},
	year = {2008},
	journal = {Assistive Technology Research Series},
	volume = {21},
	pages = {197 - 204},
	url = {https://www.scopus.com/pages/publications/84865494523?origin=resultslist},
	abstract = {Walkers are often prescribed to increase stability, but may actually increase fall risk in certain situations. One specific concern is the potential for the walker to restrict the lateral stepping movements that play a critical role in responding to loss of balance. Such restrictions could lead to falls if the user is unable to recover balance by pushing on the walker. We performed three studies of pickup walkers to examine this problem and explore potential solutions. All studies used sudden, unpredictable platform translation to evoke lateral stepping reactions in healthy young adults (22-29yrs). In the first study (perturbation of bipedal stance), the step foot collided with a walker post in 60% of trials. These collisions led to a significant reduction (26-37%) in lateral step length. In the second study (perturbation of gait), collisions occurred in 3-36% of trials, depending on the timing of the perturbation in relation to the gait cycle. The third study tested two new walker designs that reduced limitations on lateral foot movement by: 1) replacing the horizontal bars (near the walker base) with arched struts; 2) replacing these bars and also extending the distance between the front and rear walker posts (by 21cm). Testing of stance-perturbation responses showed that the collision frequency was significantly lower with the two new designs (5-14%), in comparison to a standard walker (31%). These initial results suggest that relatively simple design modifications may significantly improve walker safety; however, further testing with older adults and walker users is needed. © 2008 The authors. All rights reserved.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

