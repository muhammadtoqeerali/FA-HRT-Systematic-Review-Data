@ARTICLE{Sangsirilak20241,
	author = {Sangsirilak, Sirinrat and Sangsirilak, Akekalak and Yingyongyuth, Chalermsri and Suksawang, Kamolrat and Nontabot, Warittha},
	title = {EFFECTIVENESS OF HOME VISITS FOR DWELLING ADJUSTMENTS IN PREVENTING FALLS AMONG OLDER ADULTS: AN INTERVENTIONAL STUDY},
	year = {2024},
	journal = {Suranaree Journal of Science and Technology},
	volume = {31},
