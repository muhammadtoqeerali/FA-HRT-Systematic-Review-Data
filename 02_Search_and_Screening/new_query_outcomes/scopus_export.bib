@ARTICLE{Vassallo2004266,
	author = {Vassallo, Michael and Vignaraja, Raj and Sharma, Jagdish C. and Briggs, Roger and Allen, Stephen C.},
	title = {Predictors for falls among hospital inpatients with impaired mobility},
	year = {2004},
	journal = {Journal of the Royal Society of Medicine},
	volume = {97},
