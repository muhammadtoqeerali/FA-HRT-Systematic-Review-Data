}

@ARTICLE{Manavalan2026,
	author = {Manavalan, Gokul and Arnon, Yuval and Nithyaa, A.N. and Arnon, Shlomi},
	title = {Smart Sensor-Driven Gait Rehabilitation Walker Using Machine Learning for Predictive Home-Based Therapy},
	year = {2026},
	journal = {Sensors},
