@ARTICLE{Ejaz2023,
	author = {Ejaz, Nazia and Khan, Saad Jawaid and Azim, Fahad and Faiz, Mehwish and Teuțan, Emil and Pleșa, Alin and Ianosi-Andreeva-Dimitrova, Alexandru and Stan, Sergiu-Dan},
	title = {Examining Gait Characteristics in People with Osteoporosis Utilizing a Non-Wheeled Smart Walker through Spatiotemporal Analysis},
