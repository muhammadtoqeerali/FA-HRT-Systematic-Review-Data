@BOOK{Nagano2022423,
	author = {Nagano, Hanatsu and Sparrow, William Anthony and Begg, Rezaul},
	title = {Exercise and the elderly: Gait and balance},
	year = {2022},
	journal = {Exercise to Prevent and Manage Chronic Disease Across the Lifespan},
	pages = {423 - 435},
	doi = {10.1016/B978-0-323-89843-0.00005-2},
	url = {https://www.scopus.com/pages/publications/85137584119?origin=resultslist},
	abstract = {In demographically aging societies, effective exercise interventions for senior adults are urgently needed to support healthy aging. Gait impairment is one of the negative characteristics of age-associated declines in physical function, which increases the risk of falls-related injuries. Tripping and consequent balance loss are the primary cause of falls-related injuries during locomotion. Exercise programs that can enhance balance and increase swing foot-ground clearance can help to minimize tripping over obstacles and falling risks. In addition to conventional exercise training programs to improve physical functions, technology-based intervention can help to target specific neurological issues such as altered foot-ground clearance due to stroke. Biofeedback-based gait training has recently attracted wide attention for assisting with falls prevention especially as part of effective rehabilitation from stroke. The technology utilizes a 3D motion capture system and visualizes a walker’s swing foot clearance in real-time, in which poststroke individuals learn to walk with safer foot clearance. A key event during the swing phase of walking is minimum foot clearance (MFC) that has close links with tripping risks. Gait training exercise has been shown to improve MFC and minimize tripping risk, with prolonged retention effects over a month. Biofeedback gait training benefits have been demonstrated in both poststroke and healthy older adults. Other technology-based interventions such as wearable assistive systems can be also considered in addition to conventional strength training, when devising exercise programs for older adults with mobility limitations. Exercise for older adults can support healthy aging by reducing falls risk and associated injuries. © 2022 Elsevier Inc. All rights reserved.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@ARTICLE{Patidar2026105,
	author = {Patidar, Vipin and Goyal, Laxmi Kant and Gaur, Rakhi and Mudgal, Shiv Kumar},
	title = {Artificial Intelligence and Robotics in Geriatric Practice: Clinical Applications, Benefits, and Challenges},
	year = {2026},
	journal = {Journal of the Indian Academy of Geriatrics},
	volume = {22},
	number = {2},
	pages = {105 - 108},
	doi = {10.4103/jiag.jiag_31_26},
	url = {https://www.scopus.com/pages/publications/105042528116?origin=resultslist},
	abstract = {Sustainability-oriented innovation approaches to geriatric care are becoming increasingly essential as the number of older people is advancing at a breakneck pace. Artificial intelligence (AI) and robotic devices are being used more nowadays to address concerns related to multimorbidity, cognitive decline, functional disability, and social isolation in older populations. This commentary highlights specific approaches and applications by outlining key findings on the use of robots and AI in the care of the elderly. Application of robotic technologies, such as socially assistive service and rehabilitation robots, helps in improving psychosocial well-being, functional recovery, and decreasing the burden of caregivers. Many of the recent AI-based systems have proven helpful in risk prediction, dementia screening, telegeriatrics, and fall detection among the elderly. PARO (AIST, Japan), ElliQ (Intuition Robotics, Israel), wearable fall detection approaches, speech-based AI models, and rehabilitation exoskeletons are a few examples of social robotic technologies that demonstrate the translational potential of these advancements. Ethical problems, data bias, privacy risks, and implementation difficulties persist despite such promising results. The future study should focus on age-inclusive AI, essential clinical validation, and incorporating these technologies into individual-centric geriatric care. © 2026 Journal of the Indian Academy of Geriatrics.},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0; All Open Access; Gold Open Access}
}

@ARTICLE{Molitor2024,
	author = {Molitor, Stephanie L. and Neptune, Richard R.},
	title = {Lower-limb joint quasi-stiffness in the frontal and sagittal planes during walking at different step widths},
	year = {2024},
	journal = {Journal of Biomechanics},
	volume = {162},
	pages = {},
	doi = {10.1016/j.jbiomech.2023.111897},
	url = {https://www.scopus.com/pages/publications/85179755031?origin=resultslist},
	abstract = {Quasi-stiffness describes the intersegmental joint moment–angle relationship throughout the progression of a task. Previous work has explored sagittal-plane ankle quasi-stiffness and its application for the development of powered lower-limb assistive devices. However, frontal-plane quasi-stiffness remains largely unexplored but has important implications for the development of exoskeletons since clinical populations often walk with wider steps and rely on frontal-plane balance recovery strategies at the hip and ankle. This study aimed to characterize frontal-plane hip and ankle quasi-stiffness during walking and determine how step width affects quasi-stiffness in both the frontal and sagittal planes. Kinematic and kinetic data were collected and quasi-stiffness values computed for healthy young adults (n = 15) during treadmill walking across a range of step widths. We identified specific subphases of the gait cycle that exhibit linear and quadratic frontal-plane quasi-stiffness approximations for the hip and ankle, respectively. In addition, we found that at wider step widths, sagittal-plane ankle quasi-stiffness increased during early stance (∼12–35% gait cycle), sagittal-plane hip quasi-stiffness decreased in late stance (∼40–55% gait cycle) and frontal-plane hip quasi-stiffness decreased during terminal stance (∼48–65% gait cycle). These results provide a framework for further exploration of frontal-plane quasi-stiffness, lend insight into how quasi-stiffness may relate to balance control at various step widths, and motivate the development of stiffness-modulating assistive devices to improve balance related outcomes. © 2023 Elsevier Ltd},
	pmid = {38103312},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 8}
}

