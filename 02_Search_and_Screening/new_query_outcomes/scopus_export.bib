}

@CONFERENCE{Goh2025,
	author = {Goh, Chung-Hyun and Anthony, Jacob and Ballard, Chad},
	title = {INTEGRATING VARIABLE GRAVITY, BALANCE CONTROL, AND REINFORCEMENT LEARNING FOR AN ADAPTIVE ROBOTIC REHABILITATION SYSTEM (ROBOREHAB)},
	year = {2025},
	journal = {Proceedings of the ASME Design Engineering Technical Conference},
	volume = {5},
	pages = {},
	doi = {10.1115/DETC2025-168499},
	url = {https://www.scopus.com/pages/publications/105024065102?origin=resultslist},
	abstract = {Rehabilitation for individuals with lower limb impairments, such as those caused by stroke, spinal cord injuries, and musculoskeletal disorders, is often limited by the lack of adaptive and personalized training systems. Traditional rehabilitation techniques, including hydrotherapy and therapist-assisted gait training, are resource-intensive and provide limited customization. This study presents an integrated robotic rehabilitation system that combines variable gravity assistance with reinforcement learning (RL)-based control to enhance gait training, balance recovery, and sit-to-stand transitions. The RL-based controller significantly reduced gait trajectory errors by 66%, while balance recovery time improved by 55%, demonstrating enhanced movement stability. The variable gravity system enabled real-time weight support adjustments, contributing to a 72% reduction in stride deviation and a 66% decrease in joint torque variability, leading to smoother motion execution. The system was developed using a redesigned robotic leg assembly, motion capture-based reinforcement learning, and Simulink-based simulations for validation. Experimental results confirm that the RL-controlled robotic leg closely replicates natural knee and hip joint trajectories, ensuring more effective and adaptive rehabilitation compared to traditional fixed-gravity exoskeletons. These findings suggest that integrating RL-based control with variable gravity assistance enhances personalized rehabilitation outcomes and provides a scalable, cost-effective alternative to existing methods. Future work will focus on full-scale clinical trials, IoT-based remote monitoring, and further RL optimization for real-world patient applications. Copyright © 2025 by ASME.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Dupret2023388,
	author = {Dupret, Ina and Gräske, Johannes and Venn, Rebecca and Renaud, Dagmar},
	title = {Initial results of the evaluation of a digital rollator; [Erste Ergebnisse der Evaluation eines digitalen Rollators]},
	year = {2023},
	journal = {Zeitschrift fur Gerontologie und Geriatrie},
	volume = {56},
	number = {5},
	pages = {388 - 394},
	doi = {10.1007/s00391-022-02118-3},
	url = {https://www.scopus.com/pages/publications/85139472718?origin=resultslist},
	abstract = {Background: Rollators are preferred to compensate physiological limitations and to maintain mobility in old age; however, environmental obstacles or limited perception of fall hazards can lead to fall events. Objective: The present study evaluates an electronic box that is used to supplement conventional rollators with various technical assistance systems (e.g. call for help to contact persons, fall detection). The rollator equiped with the electronic box (DigiRoll) was tested for its suitability for everyday use during the pilot phase of the study, with the aim of further development. Methods: In a qualitative design, the DigiRoll was tested in a pilot phase with 10 participants. Individuals were interviewed in focus groups and individual interviews. In addition, ethnographic observations were made. The data evaluation was carried out using qualitative content analysis. Results: The test persons showed great interest in the development of the assistance systems to increase the feeling of safety. At the same time, the necessity of adapting the DigiRoll to individual needs became clear, depending on the living situation, the type of impairment and personal habits. Conclusion: The DigiRoll has the potential to provide sustainable support for people with reduced mobility by increasing the users’ sense of safety. Other contextual factors such as access to suitable rollators and safe walkways cannot be influenced by the DigiRoll. © 2022, The Author(s).},
	pmid = {36205777},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3; All Open Access; Green Open Access; Hybrid Gold Open Access}
}

