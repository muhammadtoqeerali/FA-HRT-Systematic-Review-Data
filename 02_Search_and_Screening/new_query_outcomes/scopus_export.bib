}

@ARTICLE{Hayakawa2014,
	author = {Hayakawa, Takehito and Hashimoto, Shigeatsu and Kanda, Hideyuki and Hirano, Noriko and Kurihara, Yumi and Kawashima, Takako and Fukushima, Tetsuhito},
