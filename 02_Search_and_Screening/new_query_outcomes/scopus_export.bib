@ARTICLE{Wang2025,
	author = {Wang, Chang and Cao, Jian and Zhang, Jianhua and Wang, Junhui and Yang, Qiang and Men, Song},
	title = {The improved extrapolated center of mass enhances the safety of exoskeleton system},
