}

@ARTICLE{Graham20162619,
	author = {Graham, David F. and Modenese, Luca and Trewartha, Grant and Carty, Christopher P. and Constantinou, Maria and Lloyd, David G. and Barrett, Rod S.},
	title = {Hip joint contact loads in older adults during recovery from forward loss of balance by stepping},
	year = {2016},
	journal = {Journal of Biomechanics},
	volume = {49},
	number = {13},
	pages = {2619 - 2624},
	doi = {10.1016/j.jbiomech.2016.05.033},
	url = {https://www.scopus.com/pages/publications/84973575231?origin=resultslist},
	abstract = {Hip joint contact loads during activities of daily living are not generally considered high enough to cause acute bone or joint injury. However there is some evidence that hip joint loads may be higher in stumble recovery from loss of balance. A common laboratory method used to evaluate balance recovery performance involves suddenly releasing participants from various static forward lean magnitudes (perturbation intensities). Prior studies have shown that when released from the same perturbation intensity, some older adults are able to recover with a single step, whereas others require multiple steps. The main purpose of this study was to use a musculoskeletal model to determine the effect of three balance perturbation intensities and the use of single versus multiple recovery steps on hip joint contact loads during recovery from forward loss of balance in community dwelling older adults (n=76). We also evaluated the association of peak hip contact loads with perturbation intensity, step length and trunk flexion angle at foot contact at each participant׳s maximum recoverable lean angle (MRLA). Peak hip joint contact loads were computed using muscle force estimates obtained using Static Optimisation and increased as lean magnitude was increased and were on average 32% higher for Single Steppers compared to Multiple Steppers. At the MRLA, peak hip contact loads ranged from 4.3 to 12.7 body weights and multiple linear stepwise regression further revealed that initial lean angle, step length and trunk angle at foot contact together explained 27% of the total variance in hip joint contact load. Overall findings indicated that older adults experience peak hip joint contact loads during maximal balance recovery by stepping that in some cases exceeded loads reported to cause mechanical failure of cadaver femurs. While step length and trunk flexion angle are strong predictors of step recovery performance they are at best moderate predictors of peak hip joint loading. © 2016 Elsevier Ltd},
	pmid = {27288331},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 11; All Open Access; Green Open Access}
}

@CONFERENCE{Itagaki2026,
	author = {Itagaki, Hirofumi and Bolli, Roberto and Kamienski, Emily and Wayne, Peter and Asadap, H. Harry},
	title = {An Autonomous Eldercare Companion Robot with a Reconfigurable Base-of-Support and Active Harness for Fall Prevention, Mobility Assistance, and Tai Chi Exercise},
	year = {2026},
	journal = {IEEE/ASME International Conference on Advanced Intelligent Mechatronics, AIM},
	pages = {},
	doi = {10.1109/AIM65483.2026.11658077},
	url = {https://www.scopus.com/pages/publications/105049154872?origin=resultslist},
	abstract = {Problems related to eldercare are a growing global concern: as the population of older adults increases, the number of available caregivers is declining. One solution is to delay the transition to nursing care by extending elderly persons' ability to age-in-place, which involves continuing activities of daily living (sit-to-stand, locomotion, exercise, etc.) while avoiding fall-related injuries. Accordingly, this paper presents the design and control of an autonomous buddy robot, consisting of an omnidirectional mobile base with a reconfigurable base-of-support (BoS) and a powered upper structure, to seamlessly support a wide variety of tasks with a single system. A discrete active harness physically prevents falls by catching users, without encumbering their motion when not in use. The variable BoS enables both narrow-footprint maneuverability in confined spaces and large-footprint stability for transfer or balance assistance. We formulate a unified control framework that combines omnidirectional motion and continuous BoS reshaping via artificial potential fields to i) keep the user's center-of-mass inside the BoS, and ii) avoid collisions with the user's feet and environmental obstacles. A hardware prototype was built and evaluated in hardware-in-the-loop simulations and preliminary experiments during Tai Chi balance exercise. Results confirm that the robot autonomously supports the user, reflexively enlarges or contracts its BoS, and prevents predicted falls without contacting the user's lower limbs. © 2026 IEEE.},
