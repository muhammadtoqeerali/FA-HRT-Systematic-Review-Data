	pages = {119 - 135},
	doi = {10.4324/9781003740575-8},
	url = {https://www.scopus.com/pages/publications/105041589456?origin=resultslist},
	abstract = {The integration of assistive robotics in elderly care offers a transformative solution to aging-related challenges, especially in developing nations. This chapter explores AI-driven innovations that enhance elderly independence by addressing mobility limitations, cognitive decline, and social isolation. Key technologies—such as robotic exoskeletons, automated fall detection systems, and interactive robotic companions—are analyzed for their role in improving well-being and autonomy. AI capabilities like adaptive learning and personalized interaction further tailor these systems to individual needs. Case studies from developing countries reveal measurable gains in safety, independence, and quality of life. However, adoption is hindered by affordability issues, weak infrastructure, low digital literacy, and cultural resistance. The chapter proposes strategies including cost-effective design, culturally aware programming, and collaborative policy frameworks to overcome these barriers. Ethical concerns related to privacy, data security, and emotional impact are also examined. Emphasizing a human-centric model, the study argues that robotics should complement rather than replace caregivers. It recommends community engagement, intergenerational training, and public–private partnerships to ensure sustainable and inclusive elderly care. © 2026 selection and editorial matter, Sheeba Khalid, Glenn W. Muschert and Driss Ed. Daran; individual chapters, the contributors.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@CONFERENCE{Novin20213299,
	author = {Novin, Roya Sabbagh and Yazdani, Amir and Merryweather, Andrew and Hermans, Tucker},
	title = {Risk-Aware Decision Making For Service Robots to Minimize Risk of Patient Falls in Hospitals},
	year = {2021},
	journal = {Proceedings - IEEE International Conference on Robotics and Automation},
	volume = {2021-May},
	pages = {3299 - 3305},
	doi = {10.1109/ICRA48506.2021.9560871},
	url = {https://www.scopus.com/pages/publications/85124789833?origin=resultslist},
	abstract = {Planning under uncertainty is a crucial capability for autonomous systems to operate reliably in uncertain and dynamic environments. The concern of safety becomes even more critical in healthcare settings where robots interact with human patients. In this paper, we propose a novel risk-aware planning framework to minimize the risk of falls by providing a patient with an assistive device. Our approach combines learning-based prediction with model-based control to plan for the fall prevention task. This provides advantages compared to end-to-end learning methods in which the robot's performance is limited to specific scenarios, or purely model-based approaches that use relatively simple function approximators and are prone to high modeling errors. We compare various risk metrics and the results from simulated scenarios show that using the proposed cost function, the robot can plan interventions to avoid high fall score events. © 2021 IEEE},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9; All Open Access; Green Open Access}
}

@ARTICLE{Ji2018169,
	author = {Ji, Jiancheng and Guo, Shuai and Song, Tao and Xi, Fengfeng Jeff},
	title = {Design and analysis of a novel fall prevention device for lower limbs rehabilitation robot},
