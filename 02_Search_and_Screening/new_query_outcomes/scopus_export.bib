@CONFERENCE{Cho20252239,
	author = {Cho, Younggeol and Solak, Gokhan and Nocentini, Olivia and Lorenzini, Marta and Fortuna, Andrea and Ajoudani, Arash},
	title = {Anticipatory Fall Detection in Humans with Hybrid Directed Graph Neural Networks and Long Short-Term Memory},
