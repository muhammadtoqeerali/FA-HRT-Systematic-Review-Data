@ARTICLE{Sanchez-Comas20201,
	author = {Sanchez-Comas, Andres and Synnes, Kåre and Hallberg, Josef},
	title = {Hardware for recognition of human activities: A review of smart home and AAL related technologies},
	year = {2020},
