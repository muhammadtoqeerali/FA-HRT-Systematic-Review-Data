@ARTICLE{Lanl20251534,
	author = {Lanl, Shan and Zhao, Yanwei and Yu, Jinhong and Yang, Junjie and Han, Jianda and Huo, Weiguang},
	title = {A Terrain-Aware Active Stumble Prevention Strategy of Lower Limb Exoskeletons},
	year = {2025},
	journal = {IEEE International Conference on Robotics and Biomimetics, ROBIO},
	pages = {1534 - 1539},
	doi = {10.1109/ROBIO66223.2025.11375932},
	url = {https://www.scopus.com/pages/publications/105034719370?origin=resultslist},
	abstract = {Lower limb exoskeletons have been extensively developed to assist older people in performing daily activities. Due to insufficient sensory and motor functions, the elderly usually face a high risk of stumbling when walking on complex terrains, such as various stairs and curbs. Existing fall prevention strategies are commonly passive or reactive (i.e., activating post-stumble), and cannot ensure active safety protection. To address this issue, we propose an active stumble prevention framework that integrates terrain perception with active assistive control of lower limb exoskeletons. This framework allows the exoskeleton to preemptively modify the user's gait before stumbling. The proposed terrain estimation approach leverages point clouds from a depth camera to precisely discern terrain types and compute key parameters, including stair height, distance to stair, and slope angle. Derived from these parameters, a reference foot trajectory is designed based on a Bezier curve. Finally, an adaptive weighted fusion approach is employed online to generate appropriate reference knee joint angles for the exoskeleton based on the current foot position and reference foot trajectory. The accuracy of the developed terrain estimation approach was evaluated via experiments conducted both indoors and outdoors. Both simulations and experiments demonstrated the efficacy of the adaptive weighted fusion method. Online experiments performed using a knee exoskeleton effectively prevented user stumbles, showing the method's effectiveness and safety.  © 2025 IEEE.},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Wang2023,
	author = {Wang, Duojin and Gu, Xiaoping and Yu, Hongliu},
	title = {Sensors and algorithms for locomotion intention detection of lower limb exoskeletons},
	year = {2023},
	journal = {Medical Engineering and Physics},
	volume = {113},
	pages = {},
	doi = {10.1016/j.medengphy.2023.103960},
	url = {https://www.scopus.com/pages/publications/85148541320?origin=resultslist},
	abstract = {In recent years, lower limb exoskeletons (LLEs) have received much attention due to the potential to help people with paraplegia regain the ability of upright-legged locomotion. However, one major hindrance to converting prototypes into actual products is the lack of a balance recovery function. Locomotion intentions can be the first step for balance assistance. Therefore, its significance continues to grow. Many researchers focus on this topic, but there is a lack of a general discussion on the research phenomenon. Therefore, the purpose of this work is to systematize these data and benefit future research. This review is divided into two parts, the location of sensors/devices and the evaluation criteria of algorithms, which are the main components of locomotion intentions. We found that sensor/device placement is still concentrated in the lower limbs, but most researchers have found the importance of the chest. The peak power of the signal collected from the chest may be overestimated because it undergoes higher vertical velocity and acceleration during a rotation. However, despite the differences in peak power between the upper and lower back, high correlations were found for the tasks, especially from sitting to standing. Since peak power is based on vertical acceleration and velocity, it can be considered a metric that is more robust to changes in sensor location. Therefore, data acquisition from the chest is effective. In this paper, it is pointed out that sensors placed on the chest may have a tendency to change, as some researchers have realized in the field of locomotion intention recognition. In the evaluation criteria, we also found that deep learning algorithm (such as Back Propagation Artificial Neural Network (BPANN)) is outstanding, and Support Vector Machine (SVM) is the most cost-effective algorithm. In terms of accuracy, sensitivity, and specificity, BPANN achieved nearly 100%. SVM has different types; the best one achieves 98% accuracy, 100% sensitivity, and 100% specificity. But it also has 87.8% accuracy, which is not stable. Convolutional Neural Networks (CNN) can be used for image classification and have an accuracy of around 87%. Compared to the above two algorithms, CNN may have lower performance. Other algorithms also have higher accuracy, sensitivity, and specificity. These evaluation criteria, however, were not all ideal at the same time. Based on these results, we also point out the existing problems. In general, the application of these algorithms to LLE can contribute to its intention recognition, which can be helpful in balancing research. Finally, this can help make LLE more suitable for daily use. © 2023 IPEM},
	pmid = {36966000},
	type = {Review},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 28}
}

