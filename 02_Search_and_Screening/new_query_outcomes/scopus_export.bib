	url = {https://www.scopus.com/pages/publications/70349986385?origin=resultslist},
	abstract = {Balance-recovery reactions that involve very rapid stepping or reach-to-grasp limbmovements play a critical role in preventing falls, by arresting the falling motion inducedby sudden "loss of balance" due to slips, trips or other balance perturbations. Thesereactions are the only recourse in responding to large perturbations, but are also prevalenteven when the perturbation is relatively small. Recent research indicates that age-relateddeterioration in the neural, sensory and/or musculo-skeletal systems may impair theability to execute these reactions effectively, even in healthy and active older adults. Thisreview summarizes this research and discusses the practical implications for fall-prevention programs. Specific interventions that are discussed include: 1) a perturbationbasedbalance-training program, which targets specific stepping and reaching motorcontrolproblems known to be associated with increased risk of falling; 2) balanceenhancingfootwear inserts, which are designed to improve control of stepping reactionsby countering effects due to age-related loss of cutaneous footsole sensation; 3) design ofmobility aids to reduce restrictions on lateral stepping movements; and 4) design ofhandrails to optimize ability to grasp the rail and generate stabilizing forces. Evidence todate supports the efficacy of these interventions, and suggests that they are largely readyfor transfer to clinical practice and usage in daily life. Some of the handrail findings have,in fact, already been incorporated into a number of building codes, and the footwearinsole (SoleSensor®) has been commercially licensed. Lastly, we describe our mostrecent work directed at developing a balance orthosis utilizing functional electricalmuscle simulation and two new interventions that are aimed at improving ability to directattention to salient features of the environment (i.e. objects that can obstruct limbmovements or act as handholds that can be grasped or touched for support): 1) handrailcueing systems; and 2) computer-based programs to train rapid processing of visualinformation. Testing of these latest interventions is currently in progress. © 2008 by Nova Science Publishers, Inc. All rights reserved.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@CONFERENCE{Di2014,
