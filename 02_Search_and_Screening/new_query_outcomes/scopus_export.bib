	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 9; All Open Access; Bronze Open Access}
}

@ARTICLE{Stevens20091464,
	author = {Stevens, Judy A. and Thomas, Karen and Teh, Leesia and Greenspan, Arlene I.},
	title = {Unintentional fall injuries associated with walkers and canes in older adults treated in U.S. emergency departments},
	year = {2009},
	journal = {Journal of the American Geriatrics Society},
