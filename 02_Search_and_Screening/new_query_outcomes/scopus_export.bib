@CONFERENCE{Duraes2021246,
	author = {Duraes, Ruben and Ribeiro, Nuno Ferrete and Ferreira, Rafael Neto and Seabra, Eurico and Santos, Cristina P.},
	title = {Product Design and Mechanical Validation of a Cane-Type Robot for Fall Prevention},
	year = {2021},
