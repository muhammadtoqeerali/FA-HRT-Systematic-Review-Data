@ARTICLE{Park2022,
	author = {Park, Jang-Ho and Lee, Youngjae and Madigan, Michael L. and Kim, Sunwook and Nussbaum, Maury A. and Srinivasan, Divya},
	title = {Wearing a back-support exoskeleton impairs single-step balance recovery performance following a forward loss of balance – An exploratory study},
