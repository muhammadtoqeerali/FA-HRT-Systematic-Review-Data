}

@ARTICLE{Maimaitijiang2026153,
	author = {Maimaitijiang, Ehesan and Khan, Shams and Mamatjan, Yasin},
	title = {An IoT-Driven Health Monitoring System for Enhanced Wheelchair Accessibility},
	year = {2026},
	journal = {Signals and Communication Technology},
	volume = {Part F2435},
	pages = {153 - 164},
	doi = {10.1007/978-3-032-18834-2_11},
	url = {https://www.scopus.com/pages/publications/105049576006?origin=resultslist},
	abstract = {Background: Wheelchair users often experience major health-related incidents, resulting in an increased number of injuries and hospitalizations, thereby reducing independence. Current assistive solutions are generally proprietary, expensive, not retrofittable, or limited to monitoring a single function. Methods: In this paper, we introduce a low-cost, AI-driven, Internet-of-Things (IoT)-integrated monitoring and alerting system specifically designed as a universal retrofittable solution for wheelchair users who require close monitoring. We implemented this system using a Raspberry Pi 5, a smart wearable device (Samsung Galaxy Watch 5 smartwatch), Inertial Measurement Unit (IMU) sensors, and a camera module for local edge AI facial detection. It provides users with fall detection, vital sign monitoring, and anomaly alerts in real-time. Our system performance was quantitatively evaluated using industry-standard techniques for end-to-end latency, load testing, computational resource efficiency, and code quality via SonarQube (ISO) static analysis. Results: The AI-driven prototype demonstrated rapid end-to-end alert latency (mean < 150 ms), robust operation under load conditions (<5% packet loss at 5% simulated losses), efficient power and resource usage (≈14 h battery life with standard 10 Ah power bank), and high software maintainability (technical debt < 5%, zero critical security vulnerabilities). Lastly, the system integrates FDA-cleared smartwatch sensors to collect reliable physiological data, thereby enhancing accuracy and wheelchair applicability while prioritizing user convenience. Conclusion: Our IoT-driven assistive monitoring system brings together several key form-factor advantages, such as a compact, wheelchair-mountable footprint alongside affordability, modular expandability, and rigorously engineered software to enhance day-to-day accessibility for wheelchair users. © The Author(s), under exclusive license to Springer Nature Switzerland AG 2026.},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

