@ARTICLE{Hamza20201666,
	author = {Hamza, Mukhtar Fatihu and Ghazilla, Raja Ariffin Raja and Muhammad, Bashir Bala and Yap, Hwa Jen},
	title = {Balance and stability issues in lower extremity exoskeletons: A systematic review},
	year = {2020},
	journal = {Biocybernetics and Biomedical Engineering},
	volume = {40},
