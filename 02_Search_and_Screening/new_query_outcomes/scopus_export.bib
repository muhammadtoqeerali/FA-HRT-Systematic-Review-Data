@ARTICLE{Kuo2011443,
	author = {Kuo, I-Han and Jayawardena, Chandimal and Broadbent, Elizabeth and MacDonald, Bruce A.},
	title = {Multidisciplinary Design Approach for Implementation of Interactive Services: Communication Initiation and user Identification for Healthcare Service Robots},
